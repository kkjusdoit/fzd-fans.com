---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import BirthdayCountdown from '../components/BirthdayCountdown.astro';
import { getCollection } from 'astro:content';

const arena = await getCollection('arena');
const quotes = await getCollection('quotes');
// const friends = await getCollection('friends'); // 暂时隐藏
const warrior = await getCollection('warrior');
const tributes = await getCollection('tributes');
const links = await getCollection('links');
const stars = await getCollection('stars');
const ugc = await getCollection('ugc');

// 精选投稿
const featuredUgc = ugc.filter(item => item.slug.startsWith('zh/') && item.data.featured).slice(0, 2);

// 只筛选中文内容 (slug 以 'zh/' 开头)
const allContent = [
  ...arena.filter(m => m.slug.startsWith('zh/')).map(m => ({ ...m, category: 'arena', categoryName: '职业生涯' })),
  ...stars.filter(s => s.slug.startsWith('zh/')).map(s => ({ ...s, category: 'stars', categoryName: '天际樊星' })),
  ...quotes.filter(q => q.slug.startsWith('zh/')).map(q => ({ ...q, category: 'quotes', categoryName: '语录与梗' })),
  // ...friends.filter(f => f.slug.startsWith('zh/')).map(f => ({ ...f, category: 'friends', categoryName: '贵人与朋友' })), // 暂时隐藏
  ...warrior.filter(w => w.slug.startsWith('zh/')).map(w => ({ ...w, category: 'warrior', categoryName: '孤勇者' })),
  ...tributes.filter(t => t.slug.startsWith('zh/')).map(t => ({ ...t, category: 'tributes', categoryName: '评价与祝福' })),
  ...links.filter(l => l.slug.startsWith('zh/')).map(l => ({ ...l, category: 'links', categoryName: '媒体链接' })),
];

// 经典语录
const featuredQuotes = [
  "我把一辈子交给国家了，不是说不干就不干的",
  "老拿冠军就老请呗",
  "比赛可以有输赢，但绝对不会服输，这就是体育精神",
  "巴黎很好，未来一定更好",
];

// 称号列表
const nicknames = [
  { name: "小胖", desc: "最亲切的称呼" },
  { name: "十年铁血一单", desc: "坚守一单位置" },
  { name: "樊百万", desc: "地表十二人三连冠" },
  { name: "中国之壁", desc: "坚不可摧的防守" },
  { name: "国乒责任神", desc: "三大赛单打外战100%" },
  { name: "广州樊先生", desc: "深藏功名做慈善" },
  { name: "乒乓球先生", desc: "乒乓球先生！欢迎来到多特蒙德" },
];

// 应援口号
const slogans = [
  "樊振东，每个赛场见",
  "大雪压青松，青松挺且直",
  "聚沙成塔路，樊星闪耀时",
  "樊振东，闪耀洛杉矶",
];
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-badge">🏓 民间互联网记忆工程</div>
    <h1>樊振东的互联网档案馆</h1>
    <p class="intro">
      这不是教科书式的百科，而是需要集思广益、不断完善的杂志。<br/>
      记录的重点不是<span class="highlight">战绩</span>，而是更耀眼的<span class="highlight">意志、人品、纯真、良善、机智、幽默</span>，<br/>
      以及他<span class="highlight">在喧嚣中的清醒与坚守、直面荆棘时的捍卫与孤勇</span>。
              

    </p>
    <div class="hero-stats">
      <div class="stat-item">
        <span class="stat-num">{allContent.length}</span>
        <span class="stat-label">篇档案</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-num">6</span>
        <span class="stat-label">个分类</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-num">∞</span>
        <span class="stat-label">樊星的支持</span>
      </div>
    </div>
  </section>

  <!-- 生日倒计时 -->
  <BirthdayCountdown />

  <!-- 滚动应援 -->
  <section class="slogan-marquee">
    <div class="marquee-content">
      {[...slogans, ...slogans].map(s => (
        <span class="slogan-item">✨ {s}</span>
      ))}
    </div>
  </section>

  <!-- 称号墙 -->
  <section class="nicknames-section">
    <h2>🏅 称号墙</h2>
    <div class="nicknames-grid">
      {nicknames.map(n => (
        <div class="nickname-card">
          <span class="nickname-name">{n.name}</span>
          <span class="nickname-desc">{n.desc}</span>
        </div>
      ))}
    </div>
    <a href="/stars/nicknames" class="view-more">查看全部称号 →</a>
  </section>

  <!-- 经典语录轮播 -->
  <section class="quotes-highlight">
    <h2>💬 经典语录</h2>
    <div class="quotes-carousel" id="quotesCarousel">
      {featuredQuotes.map((q, i) => (
        <blockquote class={`quote-card ${i === 0 ? 'active' : ''}`} data-index={i}>
          "{q}"
        </blockquote>
      ))}
    </div>
    <div class="carousel-dots">
      {featuredQuotes.map((_, i) => (
        <button class={`dot ${i === 0 ? 'active' : ''}`} data-index={i} aria-label={`切换到第${i + 1}条语录`}></button>
      ))}
    </div>
    <a href="/quotes" class="view-more">更多语录与梗 →</a>
  </section>

  <!-- 档案分类 -->
  <section class="categories">
    <h2>📚 档案分类</h2>
    <div class="category-grid">
      <a href="/arena" class="category-card arena">
        <span class="cat-icon">🏆</span>
        <span class="cat-title">职业生涯</span>
        <span class="cat-count">1 篇</span>
        <span class="cat-desc">粤圆之夜、巴黎奥运、超级金满贯之路</span>
      </a>
      <a href="/stars" class="category-card stars">
        <span class="cat-icon">⭐</span>
        <span class="cat-title">天际樊星</span>
        <span class="cat-count">{stars.length} 篇</span>
        <span class="cat-desc">称号、技术特点、传奇地位</span>
      </a>
      <a href="/quotes" class="category-card quotes">
        <span class="cat-icon">💬</span>
        <span class="cat-title">语录与梗</span>
        <span class="cat-count">{quotes.length} 篇</span>
        <span class="cat-desc">鸡蛋灌饼、永不起床、减肥日常</span>
      </a>
      <!-- 贵人与朋友 暂时隐藏
      <a href="/friends" class="category-card friends">
        <span class="cat-icon">🤝</span>
        <span class="cat-title">贵人与朋友</span>
        <span class="cat-count">篇</span>
        <span class="cat-desc">吴敬平、王涛、欢乐谷小分队</span>
      </a>
      -->
      <a href="/warrior" class="category-card warrior">
        <span class="cat-icon">⚔️</span>
        <span class="cat-title">孤勇者</span>
        <span class="cat-count">{warrior.length} 篇</span>
        <span class="cat-desc">独自面对风雨的勇气与抗争</span>
      </a>
      <a href="/tributes" class="category-card tributes">
        <span class="cat-icon">💝</span>
        <span class="cat-title">评价与祝福</span>
        <span class="cat-count">{tributes.length} 篇</span>
        <span class="cat-desc">来自各方的评价与美好祝愿</span>
      </a>
      <a href="/links" class="category-card links">
        <span class="cat-icon">🔗</span>
        <span class="cat-title">媒体链接</span>
        <span class="cat-count">{links.length} 篇</span>
        <span class="cat-desc">官方媒体、自媒体、视频合集</span>
      </a>
      <a href="/ugc" class="category-card ugc">
        <span class="cat-icon">✍️</span>
        <span class="cat-title">投稿</span>
        <span class="cat-count">{ugc.length} 篇</span>
        <span class="cat-desc">技战术分析、球迷来信</span>
      </a>
    </div>
  </section>

  <!-- 精选投稿 -->
  <section class="ugc-featured">
    <h2>✍️ 投稿精选</h2>
    
    <!-- 繁星寄语 - 球迷来信 -->
    <div class="ugc-category-block">
      <h3 class="ugc-category-title">💌 繁星寄语</h3>
      <div class="letter-highlight">
        <a href="/ugc/letter-mature-love-fzd" class="letter-card">
          <div class="letter-icon">💌</div>
          <div class="letter-content">
            <h3>爱他，就别替他活——请以成熟的方式爱樊振东</h3>
            <p class="letter-excerpt">"真正的支持，是在运动员做出选择时予以尊重，在真相未明时保持克制。"</p>
            <span class="letter-author">—— 佚名</span>
          </div>
          <span class="letter-arrow">→</span>
        </a>
        <a href="/ugc/letter-grandmaster-binwayq" class="letter-card">
          <div class="letter-icon">💌</div>
          <div class="letter-content">
            <h3>我的朋友樊振东</h3>
            <p class="letter-excerpt">"12年一个轮回，如今的樊振东，早已入宗师境..."</p>
            <span class="letter-author">—— BinwayQ</span>
          </div>
          <span class="letter-arrow">→</span>
        </a>
        <a href="/ugc/letter-to-fzd-gaalgaal" class="letter-card" style="margin-top: 1rem;">
          <div class="letter-icon">💌</div>
          <div class="letter-content">
            <h3>给樊振东的一封信</h3>
            <p class="letter-excerpt">"当我想起你，最先跳入我脑海的，是你在巴黎奥运会夺得冠军后的那一幕..."</p>
            <span class="letter-author">—— Gaalgaal</span>
          </div>
          <span class="letter-arrow">→</span>
        </a>
      </div>
    </div>

    <!-- 东风论剑 - 技战术分析 -->
    <div class="ugc-category-block">
      <h3 class="ugc-category-title">⚔️ 东风论剑</h3>
      <div class="letter-highlight">
        <a href="/ugc/fzd-vs-wcc-iq-domination" class="letter-card tactical">
          <div class="letter-icon">🏓</div>
          <div class="letter-content">
            <h3>樊振东 4-2 王楚钦：球商碾压的胜利</h3>
            <p class="letter-excerpt">"这不是纯技术的胜利，是纯球商的碾压！樊振东乒乓球的理解是碾压式存在的！"</p>
            <span class="letter-author">—— 公众号「你懂球吗」</span>
          </div>
          <span class="letter-arrow">→</span>
        </a>
      </div>
    </div>

    <a href="/ugc" class="view-more">查看全部投稿 →</a>
  </section>

  <!-- 精选内容 -->
  <section class="featured">
    <h2>✨ 精选档案</h2>
    <div class="featured-grid">
      <Card 
        title="退出世界排名" 
        href="/warrior/world-ranking-withdrawal" 
        tag="孤勇者"
        description="面对不公，选择抗争"
        image="/img/樊振东退世界排名.avif"
      />
      <Card 
        title="经典梗合集" 
        href="/quotes/memes" 
        tag="语录与梗"
        description="鸡蛋灌饼、永不起床、减肥日常..."
      />
      <Card 
        title="评价与祝福" 
        href="/tributes" 
        tag="评价与祝福"
        description="来自各方的评价与美好祝愿"
      />
    </div>
  </section>

  <!-- 全部档案 -->
  <section class="all-content">
    <h2>📖 全部档案</h2>
    <div class="content-grid">
      {allContent.map(item => (
        <Card 
          title={item.data.title}
          href={`/${item.category}/${item.slug.replace('zh/', '')}`}
          description={item.data.description}
          tag={item.categoryName}
        />
      ))}
    </div>
  </section>

  <!-- 底部口号 -->
  <section class="footer-slogan">
    <div class="slogan-main">樊振东 每个赛场见</div>
    <div class="slogan-sub">聚沙成塔路，樊星闪耀时</div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    text-align: center;
    padding: 4rem 1rem 3rem;
    background: linear-gradient(135deg, #e3f2fd 0%, #fff 100%);
    border-radius: 0 0 2rem 2rem;
  }
  .hero-badge {
    display: inline-block;
    background: #1e88e5;
    color: #fff;
    padding: 0.4rem 1rem;
    border-radius: 2rem;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }
  .hero h1 {
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
    background: linear-gradient(135deg, #1e88e5, #0d47a1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .intro {
    color: #555;
    max-width: 650px;
    margin: 0 auto;
    line-height: 1.8;
    font-size: 1.05rem;
  }
  .highlight {
    color: #1e88e5;
    font-weight: 500;
  }
  .hero-stats {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    margin-top: 2rem;
    padding: 1.5rem;
    background: #fff;
    border-radius: 1rem;
    box-shadow: 0 4px 20px rgba(30, 136, 229, 0.1);
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }
  .stat-item { text-align: center; }
  .stat-num {
    display: block;
    font-size: 2rem;
    font-weight: bold;
    color: #1e88e5;
  }
  .stat-label { color: #888; font-size: 0.9rem; }
  .stat-divider {
    width: 1px;
    height: 40px;
    background: #eee;
  }

  /* 给樊振东的一封信 */
  .letter-highlight {
    padding: 1.5rem 1rem;
    max-width: 700px;
    margin: 0 auto;
  }
  .letter-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: linear-gradient(135deg, #e3f2fd 0%, #fff 100%);
    border: 1px solid #bbdefb;
    border-radius: 16px;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.3s;
    box-shadow: 0 4px 16px rgba(30, 136, 229, 0.08);
  }
  .letter-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(30, 136, 229, 0.15);
    border-color: #1e88e5;
  }
  .letter-icon {
    font-size: 2.5rem;
    flex-shrink: 0;
  }
  .letter-content {
    flex: 1;
  }
  .letter-content h3 {
    font-size: 1.2rem;
    color: #1e88e5;
    margin-bottom: 0.5rem;
  }
  .letter-excerpt {
    color: #666;
    font-size: 0.95rem;
    line-height: 1.6;
    font-style: italic;
    margin-bottom: 0.5rem;
  }
  .letter-author {
    color: #999;
    font-size: 0.85rem;
  }
  .letter-arrow {
    font-size: 1.5rem;
    color: #1e88e5;
    flex-shrink: 0;
  }

  /* 滚动应援 */
  .slogan-marquee {
    overflow: hidden;
    background: #1e88e5;
    padding: 0.8rem 0;
    margin: 2rem 0;
  }
  .marquee-content {
    display: flex;
    animation: marquee 20s linear infinite;
    white-space: nowrap;
  }
  .slogan-item {
    color: #fff;
    padding: 0 2rem;
    font-size: 1rem;
  }
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* 称号墙 */
  .nicknames-section {
    padding: 2rem 1rem;
    text-align: center;
  }
  .nicknames-section h2 { margin-bottom: 1.5rem; }
  .nicknames-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    max-width: 800px;
    margin: 0 auto;
  }
  .nickname-card {
    background: linear-gradient(135deg, #e3f2fd, #fff);
    border: 1px solid #bbdefb;
    border-radius: 2rem;
    padding: 0.6rem 1.2rem;
    display: flex;
    flex-direction: column;
    transition: all 0.2s;
  }
  .nickname-card:hover {
    transform: scale(1.05);
    box-shadow: 0 4px 12px rgba(30, 136, 229, 0.15);
  }
  .nickname-name {
    font-weight: bold;
    color: #1e88e5;
    font-size: 1rem;
  }
  .nickname-desc {
    font-size: 0.75rem;
    color: #888;
  }
  .view-more {
    display: inline-block;
    margin-top: 1.5rem;
    color: #1e88e5;
    text-decoration: none;
    font-size: 0.9rem;
  }
  .view-more:hover { text-decoration: underline; }

  /* 经典语录轮播 */
  .quotes-highlight {
    background: #fafafa;
    padding: 2rem 1rem;
    text-align: center;
  }
  .quotes-highlight h2 { margin-bottom: 1.5rem; }
  .quotes-carousel {
    position: relative;
    max-width: 600px;
    margin: 0 auto;
    min-height: 100px;
  }
  .quote-card {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background: #fff;
    border-left: 4px solid #1e88e5;
    padding: 1.5rem 2rem;
    margin: 0;
    font-style: italic;
    color: #444;
    font-size: 1.1rem;
    line-height: 1.6;
    border-radius: 0 12px 12px 0;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    text-align: left;
    opacity: 0;
    transform: translateX(30px);
    transition: all 0.5s ease;
    pointer-events: none;
  }
  .quote-card.active {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }
  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .carousel-dots .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: none;
    background: #ddd;
    cursor: pointer;
    transition: all 0.3s;
    padding: 0;
  }
  .carousel-dots .dot:hover {
    background: #90caf9;
  }
  .carousel-dots .dot.active {
    background: #1e88e5;
    transform: scale(1.2);
  }

  /* 档案分类 */
  .categories {
    padding: 3rem 1rem;
  }
  .categories h2 {
    text-align: center;
    margin-bottom: 2rem;
  }
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
    max-width: 1000px;
    margin: 0 auto;
  }
  .category-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.5rem 1rem;
    background: #fff;
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    transition: all 0.2s;
    border: 2px solid transparent;
  }
  .category-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
  }
  .category-card.arena:hover { border-color: #ffd700; }
  .category-card.stars:hover { border-color: #64b5f6; }
  .category-card.quotes:hover { border-color: #4ecdc4; }
  .category-card.friends:hover { border-color: #45b7d1; }
  .category-card.warrior:hover { border-color: #96ceb4; }
  .category-card.tributes:hover { border-color: #ff9ff3; }
  .category-card.links:hover { border-color: #a29bfe; }
  .category-card.ugc:hover { border-color: #64b5f6; }
  .cat-icon { font-size: 2rem; margin-bottom: 0.5rem; }
  .cat-title { font-weight: bold; font-size: 1.1rem; }
  .cat-count {
    font-size: 0.8rem;
    color: #1e88e5;
    margin: 0.3rem 0;
  }
  .cat-desc {
    font-size: 0.8rem;
    color: #888;
    text-align: center;
    line-height: 1.4;
  }

  /* 精选投稿 */
  .ugc-featured {
    padding: 2rem 1rem;
    text-align: center;
  }
  .ugc-featured h2 { margin-bottom: 1.5rem; }
  .ugc-featured .letter-highlight {
    max-width: 700px;
    margin: 0 auto;
    padding: 0;
  }
  .ugc-category-block {
    margin-bottom: 2rem;
  }
  .ugc-category-title {
    font-size: 1.1rem;
    color: #666;
    margin-bottom: 1rem;
    font-weight: 500;
  }
  .letter-card.tactical {
    background: linear-gradient(135deg, #f0f8ff 0%, #fff 100%);
    border-color: #b8d4e8;
  }
  .letter-card.tactical:hover {
    border-color: #4a90d9;
  }
  .ugc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    max-width: 800px;
    margin: 0 auto;
  }
  .ugc-card {
    background: #fff;
    border-radius: 12px;
    padding: 1.5rem;
