---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import BirthdayCountdown from '../components/BirthdayCountdown.astro';
import { getCollection } from 'astro:content';

const arena = await getCollection('arena');
const quotes = await getCollection('quotes');
// const friends = await getCollection('friends'); // 暂时隐藏
const warrior = await getCollection('warrior');
const tributes = await getCollection('tributes');
const links = await getCollection('links');
const stars = await getCollection('stars');
const ugc = await getCollection('ugc');

// 精选投稿
const featuredUgc = ugc.filter(item => item.slug.startsWith('zh/') && item.data.featured).slice(0, 2);

// 只筛选中文内容 (slug 以 'zh/' 开头)
const allContent = [
  ...arena.filter(m => m.slug.startsWith('zh/')).map(m => ({ ...m, category: 'arena', categoryName: '职业生涯' })),
  ...stars.filter(s => s.slug.startsWith('zh/')).map(s => ({ ...s, category: 'stars', categoryName: '天际樊星' })),
  ...quotes.filter(q => q.slug.startsWith('zh/')).map(q => ({ ...q, category: 'quotes', categoryName: '语录与梗' })),
  // ...friends.filter(f => f.slug.startsWith('zh/')).map(f => ({ ...f, category: 'friends', categoryName: '贵人与朋友' })), // 暂时隐藏
  ...warrior.filter(w => w.slug.startsWith('zh/')).map(w => ({ ...w, category: 'warrior', categoryName: '孤勇者' })),
  ...tributes.filter(t => t.slug.startsWith('zh/')).map(t => ({ ...t, category: 'tributes', categoryName: '评价与祝福' })),
  ...links.filter(l => l.slug.startsWith('zh/')).map(l => ({ ...l, category: 'links', categoryName: '媒体链接' })),
];

// 经典语录
const featuredQuotes = [
  "我把一辈子交给国家了，不是说不干就不干的",
  "老拿冠军就老请呗",
  "比赛可以有输赢，但绝对不会服输，这就是体育精神",
  "巴黎很好，未来一定更好",
];

// 称号列表
const nicknames = [
  { name: "小胖", desc: "最亲切的称呼" },
  { name: "十年铁血一单", desc: "坚守一单位置" },
  { name: "樊百万", desc: "地表十二人三连冠" },
  { name: "中国之壁", desc: "坚不可摧的防守" },
  { name: "国乒责任神", desc: "三大赛单打外战100%" },
  { name: "广州樊先生", desc: "深藏功名做慈善" },
  { name: "乒乓球先生", desc: "乒乓球先生！欢迎来到多特蒙德" },
];

// 应援口号
const slogans = [
  "樊振东，每个赛场见",
  "大雪压青松，青松挺且直",
  "聚沙成塔路，樊星闪耀时",
  "樊振东，闪耀洛杉矶",
];

// 超级全满贯勋章矩阵
const grandSlamBadges = [
  {
    icon: '🥇',
    title: '巴黎奥运双金',
    sub: '男单金牌 + 男团金牌',
    desc: '男子超级全满贯加冕，一战定乾坤'
  },
  {
    icon: '🏆',
    title: '世界杯四冠王',
    sub: '4届单打总冠军',
    desc: '历史纪录保持者，传奇统治力'
  },
  {
    icon: '🥇',
    title: '世乒赛两连冠',
    sub: '休斯敦 + 德班男单',
    desc: '接连捧得圣·勃莱德杯，无可撼动'
  },
  {
    icon: '🌟',
    title: '超级全满贯',
    sub: '9 大单打赛事全冠军',
    desc: '奥运/世乒/世界杯/全运/全锦/乒超/亚运/亚锦/亚洲杯'
  }
];

// 生涯五部曲编年史
const chronicleChapters = [
  {
    era: '2012 — 2016',
    tag: '第一章',
    title: '破土初啼 · 天才少年的风暴',
    summary: '广州少年八一队拼命三郎，以标志性反手霸王拧横空出世。以16岁之龄成为乒联巡回赛最年轻男单冠军，19岁首夺世界杯单打世界冠军。',
    quote: '只要上场，就绝不给自己留退路。',
    link: '/arena',
    linkText: '查看早期生涯与突破 →'
  },
  {
    era: '2017 — 2021',
    tag: '第二章',
    title: '烈火淬钢 · 樊百万与沉淀蜕变',
    summary: '历经杜塞尔多夫决胜局两分惜败的淬炼，在地表最强12人斩获三连冠豪取“樊百万”。东京奥运夺得男团金牌，休斯敦世锦赛登顶开启新时代。',
    quote: '比赛可以有输赢，但绝对不会服输，这就是体育精神。',
    link: '/stars',
    linkText: '探索技术与传奇地位 →'
  },
  {
    era: '2022 — 2024 初',
    tag: '第三章',
    title: '孤勇持刃 · 喧嚣中的清醒风骨',
    summary: '在体坛纷扰与畸形饭圈乱象面前，他选择站在阳光与规则下。面对不公毅然退出世界排名，誓以最纯粹的竞技精神正本清源。',
    quote: '我把一辈子交给国家了，不是说不干就不干的。',
    link: '/warrior/world-ranking-withdrawal',
    linkText: '阅读《退出世界排名》专篇 →'
  },
  {
    era: '2024.08',
    tag: '第四章 · 巅峰加冕',
    title: '巴黎封神 · 孤军绝境的大满贯加冕',
    summary: '上半区失守，国乒单打希望全部系于一身。在八强面对超神发挥的张本智和0-2绝境下，换湿透球衣调整、鏖战抢七 11-7 惊天翻盘！决赛一鼓作气夺冠，成就超级全满贯！',
    quote: '打到最后，想的就是哪怕死在球台边也要拿下这分。',
    link: '/matches',
    linkText: '回顾巴黎全胜战绩库 →',
    featured: true
  },
  {
    era: '2024 至今',
    tag: '第五章',
    title: '自由绽放 · 走向更辽阔的赛场',
    summary: '伯纳乌现场为皇马呐喊助威，与足网巨星梦幻联动；远赴德甲联赛开启全新竞技旅程。功成名就之后，他让世界看到了一个更自洽、更广阔的樊振东。',
    quote: '巴黎很好，未来一定更好。',
    link: '/tributes/bundesliga-journey',
    linkText: '查看德甲留洋与新征程 →'
  }
];
---

<BaseLayout>
  <!-- Hero Section 冠军殿堂 -->
  <section class="hero-temple">
    <div class="hero-temple-glow"></div>
    <div class="container hero-temple-inner">
      <div class="hero-badge-pill">
        <span class="pill-spark">🏓</span>
        <span>世界乒坛男子超级全满贯得主 · 民间互联网记忆工程</span>
      </div>

      <div class="hero-titles">
        <span class="hero-pretitle">THE GRAND SLAM ARCHIVE</span>
        <h1 class="hero-main-title">樊振东的传奇档案馆</h1>
      </div>

      <p class="hero-manifesto">
        这不是教科书式的冰冷百科，而是一座持续生长的数字记忆殿堂。<br class="desktop-break"/>
        记录的重点不仅是绝冠天下的<span class="hl-gold">战绩</span>，更是更耀眼的<span class="hl-gold">意志、人品、纯真、良善、机智与幽默</span>，<br class="desktop-break"/>
        以及他在喧嚣中的<span class="hl-crimson">清醒与坚守</span>、直面荆棘时的<span class="hl-crimson">捍卫与孤勇</span>。
      </p>

      <!-- 全满贯四大勋章矩阵 -->
      <div class="grand-slam-grid">
        {grandSlamBadges.map(badge => (
          <div class="slam-badge-card">
            <div class="badge-icon-box">{badge.icon}</div>
            <div class="badge-text-box">
              <div class="badge-title">{badge.title}</div>
              <div class="badge-sub">{badge.sub}</div>
              <div class="badge-desc">{badge.desc}</div>
            </div>
          </div>
        ))}
      </div>

      <!-- 硬核核心数据大屏 -->
      <div class="temple-stats-bar">
        <div class="temple-stat">
          <span class="stat-big-num">23,700+</span>
          <span class="stat-name">场战绩收录</span>
        </div>
        <div class="stat-sep"></div>
        <div class="temple-stat">
          <span class="stat-big-num">100%</span>
          <span class="stat-name">三大赛单打外战胜率</span>
        </div>
        <div class="stat-sep"></div>
        <div class="temple-stat">
          <span class="stat-big-num">4 冠</span>
          <span class="stat-name">世界杯单打历史纪录</span>
        </div>
        <div class="stat-sep"></div>
        <div class="temple-stat">
          <span class="stat-big-num">9 大赛</span>
          <span class="stat-name">超级全满贯成就</span>
        </div>
      </div>

      <!-- 快捷入口胶囊 -->
      <div class="hero-action-pills">
        <a href="#epic-battle" class="hero-action-pill primary">⚡ 亲历巴黎封神战役</a>
        <a href="#chronicle" class="hero-action-pill">📖 探索生涯五部曲</a>
        <a href="/matches" class="hero-action-pill">🏓 查询生涯比赛库</a>
        <a href="/games" class="hero-action-pill">🎮 樊星游乐场</a>
      </div>
    </div>
  </section>

  <!-- 生日倒计时 -->
  <BirthdayCountdown />

  <!-- 史诗战役专栏：巴黎封神 逆转张本智和 -->
  <section class="epic-battle-section" id="epic-battle">
    <div class="container">
      <div class="epic-battle-card">
        <div class="battle-top-bar">
          <div class="epic-battle-badge">🔥 巴黎奥运史诗之战 · 世纪翻盘</div>
          <div class="battle-location-tag">2024.08.01 · 南巴黎竞技场4号馆</div>
        </div>

        <div class="battle-main-grid">
          <div class="battle-summary-col">
            <h2 class="battle-h2">樊振东 4 - 3 张本智和</h2>
            <p class="battle-subtext">男单 1/4 决赛 · 国乒半区失守，一人扛起整座大厦的向死而生</p>
            
            <div class="battle-quote-bubble">
              <span class="quote-symbol">“</span>
              <p>当时0-2落后，我换了一件球衣。我告诉自己，比赛才刚刚开始，哪怕战斗到最后一刻，我也要死在球台上！</p>
              <span class="quote-sign">—— 樊振东 赛后直言</span>
            </div>

            <div class="battle-buttons">
              <a href="/matches" class="battle-btn primary">🏓 查询本场详细比分与战绩</a>
              <a href="/ugc/fzd-vs-wcc-iq-domination" class="battle-btn secondary">⚔️ 战术球商复盘</a>
            </div>
          </div>

          <div class="battle-timeline-col">
            <div class="timeline-box-title">7 局惊心动魄比分走势</div>
            <div class="games-flow-list">
              <div class="flow-item lost">
                <span class="f-num">第1局</span>
                <span class="f-score">2 - 11</span>
                <span class="f-status">逆风开局</span>
              </div>
              <div class="flow-item lost">
                <span class="f-num">第2局</span>
                <span class="f-score">9 - 11</span>
                <span class="f-status">大比分 0-2 绝境</span>
              </div>
              <div class="flow-item win shifted">
                <div class="shift-badge">👕 换球衣 · 调整心态 · 破釜沉舟</div>
                <span class="f-num">第3局</span>
                <span class="f-score">11 - 4</span>
                <span class="f-status">霸王拧发力，强势扳回</span>
              </div>
              <div class="flow-item win">
                <span class="f-num">第4局</span>
                <span class="f-score">11 - 7</span>
                <span class="f-status">正手爆冲，追成 2-2</span>
              </div>
              <div class="flow-item lost">
                <span class="f-num">第5局</span>
                <span class="f-score">4 - 11</span>
                <span class="f-status">对手再次领先</span>
              </div>
              <div class="flow-item win">
                <span class="f-num">第6局</span>
                <span class="f-score">11 - 7</span>
                <span class="f-status">死守反击，拖入决胜局！</span>
              </div>
              <div class="flow-item win crowned">
                <div class="crown-badge">👑 决胜抢七 · 封神时刻</div>
                <span class="f-num">第7局</span>
                <span class="f-score">11 - 7</span>
                <span class="f-status">终局绝杀！展臂狂欢！</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 生涯五部曲：沉浸式编年史 -->
  <section class="chronicle-section" id="chronicle">
    <div class="container">
      <div class="chronicle-header">
        <div class="section-badge">📜 传奇叙事主线</div>
        <h2>樊振东职业生涯五部曲</h2>
        <p class="section-sub">从羊城神童到超级全满贯，见证一代乒坛宗师的淬炼、坚守与从容</p>
      </div>

      <div class="chronicle-list">
        {chronicleChapters.map((ch, idx) => (
          <div class:list={['chronicle-card', { 'featured-chapter': ch.featured }]}>
            <div class="chapter-badge-col">
              <span class="chapter-tag">{ch.tag}</span>
              <span class="chapter-era">{ch.era}</span>
              <div class="chapter-step-dot">{idx + 1}</div>
            </div>
            <div class="chapter-body-col">
              <h3 class="chapter-title">{ch.title}</h3>
              <p class="chapter-summary">{ch.summary}</p>
              <div class="chapter-quote-bar">
                <span class="quote-icon">“</span>
                <span class="quote-text">{ch.quote}</span>
              </div>
              <a href={ch.link} class="chapter-link-btn">{ch.linkText}</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 访问体验与小程序推荐 -->
  <section class="access-notice-section">
    <div class="notice-card">
      <div class="notice-content">
        <span class="notice-badge">💡 访问体验提示</span>
        <h3>网页加载缓慢或图片打不开？</h3>
        <p>
          由于本站部署于海外节点，受部分地区网络环境影响，国内访问可能会出现<strong>缓慢、加载失败或图片打不开</strong>等问题，手机端体验较不稳定。
        </p>
        <p class="recommend-text">
          为了获得更稳定流畅的阅读与互动体验，我们强烈推荐使用微信扫描下方二维码，体验小程序版<strong>「樊星宇宙」</strong>。
        </p>
        <div class="notice-tags">
          <span>⚡ 国内加速 · 毫秒级加载</span>
          <span>📖 生涯数据与战绩本地丝滑筛选</span>
          <span>🎮 互动答题与小游戏直接体验</span>
        </div>
      </div>
      <div class="notice-qrcode">
        <img src="/img/miniprogram-qrcode.jpg" alt="樊星宇宙微信小程序" />
        <span class="qrcode-tip">微信扫码或长按识别</span>
      </div>
    </div>
  </section>

  <!-- 滚动应援 -->
  <section class="slogan-marquee">
    <div class="marquee-content">
      {[...slogans, ...slogans].map(s => (
        <span class="slogan-item">✨ {s}</span>
      ))}
    </div>
  </section>

  <!-- 称号墙 -->
  <section class="nicknames-section">
    <h2>🏅 称号墙</h2>
    <div class="nicknames-grid">
      {nicknames.map(n => (
        <div class="nickname-card">
          <span class="nickname-name">{n.name}</span>
          <span class="nickname-desc">{n.desc}</span>
        </div>
      ))}
    </div>
    <a href="/stars/nicknames" class="view-more">查看全部称号 →</a>
  </section>

  <!-- 经典语录轮播 -->
  <section class="quotes-highlight">
    <h2>💬 经典语录</h2>
    <div class="quotes-carousel" id="quotesCarousel">
      {featuredQuotes.map((q, i) => (
        <blockquote class={`quote-card ${i === 0 ? 'active' : ''}`} data-index={i}>
          "{q}"
        </blockquote>
      ))}
    </div>
    <div class="carousel-dots">
      {featuredQuotes.map((_, i) => (
        <button class={`dot ${i === 0 ? 'active' : ''}`} data-index={i} aria-label={`切换到第${i + 1}条语录`}></button>
      ))}
    </div>
    <a href="/quotes" class="view-more">更多语录与梗 →</a>
  </section>

  <!-- 档案分类 -->
  <section class="categories">
    <h2>📚 档案分类</h2>
    <div class="category-grid">
      <a href="/arena" class="category-card arena">
        <span class="cat-icon">🏆</span>
        <span class="cat-title">职业生涯</span>
        <span class="cat-count">1 篇</span>
        <span class="cat-desc">粤圆之夜、巴黎奥运、超级金满贯之路</span>
      </a>
      <a href="/stars" class="category-card stars">
        <span class="cat-icon">⭐</span>
        <span class="cat-title">天际樊星</span>
        <span class="cat-count">{stars.length} 篇</span>
        <span class="cat-desc">称号、技术特点、传奇地位</span>
      </a>
      <a href="/quotes" class="category-card quotes">
        <span class="cat-icon">💬</span>
        <span class="cat-title">语录与梗</span>
        <span class="cat-count">{quotes.length} 篇</span>
        <span class="cat-desc">鸡蛋灌饼、永不起床、减肥日常</span>
      </a>
      <!-- 贵人与朋友 暂时隐藏
      <a href="/friends" class="category-card friends">
        <span class="cat-icon">🤝</span>
        <span class="cat-title">贵人与朋友</span>
        <span class="cat-count">篇</span>
        <span class="cat-desc">吴敬平、王涛、欢乐谷小分队</span>
      </a>
      -->
      <a href="/warrior" class="category-card warrior">
        <span class="cat-icon">⚔️</span>
        <span class="cat-title">孤勇者</span>
        <span class="cat-count">{warrior.length} 篇</span>
        <span class="cat-desc">独自面对风雨的勇气与抗争</span>
      </a>
      <a href="/tributes" class="category-card tributes">
        <span class="cat-icon">💝</span>
        <span class="cat-title">评价与祝福</span>
        <span class="cat-count">{tributes.length} 篇</span>
        <span class="cat-desc">来自各方的评价与美好祝愿</span>
      </a>
      <a href="/links" class="category-card links">
        <span class="cat-icon">🔗</span>
        <span class="cat-title">媒体链接</span>
        <span class="cat-count">{links.length} 篇</span>
        <span class="cat-desc">官方媒体、自媒体、视频合集</span>
      </a>
      <a href="/ugc" class="category-card ugc">
        <span class="cat-icon">✍️</span>
        <span class="cat-title">投稿</span>
        <span class="cat-count">{ugc.length} 篇</span>
        <span class="cat-desc">技战术分析、球迷来信</span>
      </a>
    </div>
  </section>

  <!-- 精选投稿 -->
  <section class="ugc-featured">
    <h2>✍️ 投稿精选</h2>
    
    <!-- 繁星寄语 - 球迷来信 -->
    <div class="ugc-category-block">
      <h3 class="ugc-category-title">💌 繁星寄语</h3>
      <div class="letter-highlight">
        <a href="/ugc/letter-mature-love-fzd" class="letter-card">
          <div class="letter-icon">💌</div>
          <div class="letter-content">
            <h3>爱他，就别替他活——请以成熟的方式爱樊振东</h3>
            <p class="letter-excerpt">"真正的支持，是在运动员做出选择时予以尊重，在真相未明时保持克制。"</p>
            <span class="letter-author">—— 七蛋王者</span>
          </div>
