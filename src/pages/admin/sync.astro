---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="同步图片">
  <div class="sync-container">
    <h1>🔄同步图片</h1>
    <p class="subtitle">同步后默认状态为<b>已审核 (reviewed=1)</b>。</p>

    <div class="auto-sync-section">
      <button id="autoSyncBtn" class="sync-btn auto">⚡️ 自动同步 (Fetched from Cloudflare)</button>
      <p class="hint">直接从图床 API 获取所有文件并同步</p>
    </div>

    <div id="status" class="status-box" style="display: none;"></div>
  </div>
</BaseLayout>

<style>
  .sync-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 1rem;
    text-align: center;
  }

  h1 {
    color: #1e88e5;
    margin-bottom: 1rem;
  }

  .subtitle {
    color: #666;
    margin-bottom: 2rem;
  }

  .sync-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    background: #fcfcfc;
    border-radius: 12px;
    border: 1px solid #eee;
  }

  .auto-sync-section {
    margin-bottom: 2rem;
  }

  .divider {
    margin: 2rem 0;
    color: #999;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .divider::before, .divider::after {
    content: "";
    flex: 1;
    border-bottom: 1px solid #e0e0e0;
    margin: 0 1rem;
  }

  textarea {
    width: 100%;
    padding: 1rem;
    border: 2px solid #e0e0e0;
    border-radius: 12px;
    font-family: monospace;
    font-size: 0.9rem;
    resize: vertical;
    transition: all 0.2s;
  }

  textarea:focus {
    outline: none;
    border-color: #1e88e5;
    box-shadow: 0 0 0 4px rgba(30, 136, 229, 0.1);
  }

  .sync-btn {
    background: #1e88e5;
    color: white;
    border: none;
    padding: 1rem 3rem;
    font-size: 1.1rem;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.2s;
    align-self: center;
  }

  .sync-btn:hover {
    background: #1565c0;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(30, 136, 229, 0.3);
  }

  .sync-btn:disabled {
    background: #ccc;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .status-box {
    margin-top: 2rem;
    padding: 1.5rem;
    border-radius: 12px;
    text-align: left;
    white-space: pre-wrap;
    font-family: monospace;
  }

  .status-box.loading { background: #e3f2fd; color: #0d47a1; }
  .status-box.success { background: #e8f5e9; color: #2e7d32; }
  .status-box.error { background: #ffebee; color: #c62828; }
</style>

<script>
  const autoSyncBtn = document.getElementById('autoSyncBtn') as HTMLButtonElement;
  const statusBox = document.getElementById('status') as HTMLDivElement;

  function setStatus(type, msg) {
    statusBox.style.display = 'block';
    statusBox.className = `status-box ${type}`;
    statusBox.textContent = msg;
  }

  // Auto Sync
  autoSyncBtn?.addEventListener('click', async () => {
    autoSyncBtn.disabled = true;
    autoSyncBtn.textContent = '正在获取图床数据...';
    setStatus('loading', '正在连接图床 API 获取文件列表...');

    try {
      const response = await fetch('/api/sync-auto', { method: 'POST' });
      const result = await response.json();

      if (response.ok) {
        setStatus('success', `⚡️ 自动同步成功！\n\n远程文件总数: ${result.totalFound}\n新增入库: ${result.added}\n激活可见: ${result.activated}\n已存在: ${result.skipped}`);
      } else {
        throw new Error(result.error || 'Server Error');
      }
    } catch (err) {
      setStatus('error', `❌ 自动同步失败: ${(err as Error).message}`);
    } finally {
      autoSyncBtn.disabled = false;
      autoSyncBtn.textContent = '⚡️ 自动同步 (Fetched from Cloudflare)';
    }
  });

</script>
