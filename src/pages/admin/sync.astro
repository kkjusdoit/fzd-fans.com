---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="同步图片">
  <div class="sync-container">
    <h1>🔄同步图片</h1>
    <p class="subtitle">同步后默认状态为<b>已审核 (reviewed=1)</b>。</p>

    <div class="diagnostic-section">
      <button id="diagnosticBtn" class="sync-btn diagnostic">🔍 运行诊断</button>
      <p class="hint">检查环境变量、数据库连接和图床 API 状态</p>
    </div>

    <div class="auto-sync-section">
      <button id="autoSyncBtn" class="sync-btn auto">⚡️ 自动同步 (Fetched from Cloudflare)</button>
      <p class="hint">直接从图床 API 获取所有文件并同步</p>
    </div>

    <div id="status" class="status-box" style="display: none;"></div>
  </div>
</BaseLayout>

<style>
  .sync-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 1rem;
    text-align: center;
  }

  h1 {
    color: #1e88e5;
    margin-bottom: 1rem;
  }

  .subtitle {
    color: #666;
    margin-bottom: 2rem;
  }

  .sync-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    background: #fcfcfc;
    border-radius: 12px;
    border: 1px solid #eee;
  }

  .auto-sync-section {
    margin-bottom: 2rem;
  }

  .divider {
    margin: 2rem 0;
    color: #999;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .divider::before, .divider::after {
    content: "";
    flex: 1;
    border-bottom: 1px solid #e0e0e0;
    margin: 0 1rem;
  }

  textarea {
    width: 100%;
    padding: 1rem;
    border: 2px solid #e0e0e0;
    border-radius: 12px;
    font-family: monospace;
    font-size: 0.9rem;
    resize: vertical;
    transition: all 0.2s;
  }

  textarea:focus {
    outline: none;
    border-color: #1e88e5;
    box-shadow: 0 0 0 4px rgba(30, 136, 229, 0.1);
  }

  .sync-btn {
    background: #1e88e5;
    color: white;
    border: none;
    padding: 1rem 3rem;
    font-size: 1.1rem;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.2s;
    align-self: center;
  }

  .sync-btn.diagnostic {
    background: #ff9800;
  }

  .sync-btn.diagnostic:hover {
    background: #f57c00;
  }

  .sync-btn:hover {
    background: #1565c0;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(30, 136, 229, 0.3);
  }

  .sync-btn:disabled {
    background: #ccc;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .diagnostic-section {
    margin-bottom: 1.5rem;
  }

  .status-box {
    margin-top: 2rem;
    padding: 1.5rem;
    border-radius: 12px;
    text-align: left;
    white-space: pre-wrap;
    font-family: monospace;
  }

  .status-box.loading { background: #e3f2fd; color: #0d47a1; }
  .status-box.success { background: #e8f5e9; color: #2e7d32; }
  .status-box.error { background: #ffebee; color: #c62828; }
</style>

<script>
  const autoSyncBtn = document.getElementById('autoSyncBtn') as HTMLButtonElement;
  const diagnosticBtn = document.getElementById('diagnosticBtn') as HTMLButtonElement;
  const statusBox = document.getElementById('status') as HTMLDivElement;

  function setStatus(type, msg) {
    statusBox.style.display = 'block';
    statusBox.className = `status-box ${type}`;
    statusBox.textContent = msg;
  }

  async function parseApiResponse(response, apiName) {
    const contentType = response.headers.get('content-type') || 'unknown';
    const text = await response.text();
    const snippet = text.slice(0, 240).replace(/\s+/g, ' ').trim();

    if (!contentType.includes('application/json')) {
      throw new Error(
        `${apiName} 返回了非 JSON 响应\n状态: ${response.status} ${response.statusText}\nContent-Type: ${contentType}${snippet ? `\n响应片段: ${snippet}` : ''}`
      );
    }

    try {
      return JSON.parse(text);
    } catch {
      throw new Error(
        `${apiName} 返回了无效 JSON\n状态: ${response.status} ${response.statusText}\nContent-Type: ${contentType}${snippet ? `\n响应片段: ${snippet}` : ''}`
      );
    }
  }

  // Diagnostic Check
  diagnosticBtn?.addEventListener('click', async () => {
    diagnosticBtn.disabled = true;
    diagnosticBtn.textContent = '正在诊断...';
    setStatus('loading', '正在检查系统状态...\n');

    try {
      const response = await fetch('/api/debug-sync', { 
        method: 'GET',
        headers: {
          'Accept': 'application/json'
        },
        credentials: 'same-origin',
        cache: 'no-store'
      });

      const result = await parseApiResponse(response, '/api/debug-sync');

      if (response.ok && result.success) {
        const r = result.results;
        let msg = '✅ 诊断完成\n\n';
        
        msg += '📋 环境变量检查:\n';
        for (const [key, value] of Object.entries(r.envCheck as any)) {
          msg += `  ${key}: ${value}\n`;
        }
        
        msg += '\n💾 数据库检查:\n';
        msg += `  状态：${r.dbCheck.status}\n`;
        if (r.dbCheck.photoCount !== undefined) {
          msg += `  照片数量：${r.dbCheck.photoCount}\n`;
        }
        if (r.dbCheck.error) {
          msg += `  错误：${r.dbCheck.error}\n`;
        }
        
        msg += '\n🌐 图床 API 检查:\n';
        if (r.apiCheck.status) {
          msg += `  状态：${r.apiCheck.status}\n`;
        }
        if (r.apiCheck.ok !== undefined) {
          msg += `  响应：${r.apiCheck.ok ? '✅ 成功' : '❌ 失败'}\n`;
        }
        if (r.apiCheck.response) {
          msg += `  文件数：${r.apiCheck.response.filesCount}\n`;
          msg += `  总数：${r.apiCheck.response.totalCount}\n`;
        }
        if (r.apiCheck.error) {
          msg += `  错误：${r.apiCheck.error}\n`;
        }
        if (r.apiCheck.errorBody) {
          msg += `  响应体：${r.apiCheck.errorBody}\n`;
        }
        
        setStatus('success', msg);
      } else {
        throw new Error(result.error || '诊断失败');
      }
    } catch (err) {
      setStatus('error', `❌ 诊断失败：${(err as Error).message}`);
    } finally {
      diagnosticBtn.disabled = false;
      diagnosticBtn.textContent = '🔍 运行诊断';
    }
  });

  // Auto Sync
  autoSyncBtn?.addEventListener('click', async () => {
    autoSyncBtn.disabled = true;
    autoSyncBtn.textContent = '正在获取图床数据...';
    setStatus('loading', '正在连接图床 API 获取文件列表...');

    try {
      const response = await fetch('/api/sync-auto', { 
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        // 确保同站请求，避免 CSRF 保护
        credentials: 'same-origin',
        cache: 'no-store',
        body: '{}'
      });

      const result = await parseApiResponse(response, '/api/sync-auto');

      if (response.ok) {
        setStatus('success', `⚡️ 自动同步成功！\n\n远程文件总数：${result.totalFound}\n新增入库：${result.added}\n激活可见：${result.activated}\n已存在：${result.skipped}`);
      } else {
        throw new Error(result.error || 'Server Error');
      }
    } catch (err) {
      setStatus('error', `❌ 自动同步失败：${(err as Error).message}\n\n💡 提示：请先点击"运行诊断"按钮检查系统状态`);
    } finally {
      autoSyncBtn.disabled = false;
      autoSyncBtn.textContent = '⚡️ 自动同步 (Fetched from Cloudflare)';
    }
  });

</script>
