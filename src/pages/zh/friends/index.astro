---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Card from '../../../components/Card.astro';
import { getCollection } from 'astro:content';

const friends = await getCollection('friends');
---

<BaseLayout title="贵人与朋友">
  <section class="page-header">
    <h1>🤝 贵人与朋友</h1>
    <p>那些陪伴樊振东成长的人</p>
  </section>

  <section class="content-grid">
    {friends.map(friend => (
      <Card 
        title={friend.data.title}
        href={`/zh/friends/${friend.slug.replace('zh/', '')}`}
        description={friend.data.description}
        tag={friend.data.tags?.[0]}
      />
    ))}
  </section>
</BaseLayout>

<style>
  .page-header { text-align: center; padding: 2rem 0; }
  .page-header h1 { margin-bottom: 0.5rem; }
  .page-header p { color: #666; }
  .content-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
    padding: 2rem 0;
  }
</style>
