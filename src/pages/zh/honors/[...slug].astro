---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const honors = await getCollection('honors');
  return honors.map(entry => ({
    params: { slug: entry.slug.replace('zh/', '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout title={entry.data.title}>
  <article class="content-page">
    <header>
      <div class="tags">
        {entry.data.tags?.map(tag => <span class="tag">{tag}</span>)}
      </div>
      <h1>{entry.data.title}</h1>
      {entry.data.description && <p class="desc">{entry.data.description}</p>}
    </header>
    <div class="content">
      <Content />
    </div>
    <footer>
      <a href="/zh/honors">← 返回荣誉战绩</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .content-page { max-width: 800px; margin: 0 auto; padding: 2rem 0; }
  header { margin-bottom: 2rem; }
  .tags { display: flex; gap: 0.5rem; margin-bottom: 1rem; }
  .tag { background: #c41e3a; color: #fff; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.8rem; }
  h1 { margin-bottom: 0.5rem; }
  .desc { color: #666; }
  .content { line-height: 1.8; }
  .content :global(h2) { margin-top: 2rem; color: #c41e3a; }
  footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #eee; }
</style>
