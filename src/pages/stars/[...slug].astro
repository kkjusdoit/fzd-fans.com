---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const stars = await getCollection('stars');
  return stars.map(entry => ({
    params: { slug: entry.slug.replace('zh/', '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const isSlogans = entry.slug.includes('slogans');
---

<BaseLayout title={entry.data.title}>
  <article class={`content-page ${isSlogans ? 'slogans-page' : ''}`}>
    <header>
      <div class="tags">
        {entry.data.tags?.map(tag => <span class="tag">{tag}</span>)}
      </div>
      <h1>{entry.data.title}</h1>
      {entry.data.description && <p class="desc">{entry.data.description}</p>}
    </header>
    <div class="content">
      <Content />
    </div>
    <footer>
      <a href="/stars">← 返回天际樊星</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .content-page { max-width: 800px; margin: 0 auto; padding: 2rem 0; }
  header { margin-bottom: 2rem; }
  .tags { display: flex; gap: 0.5rem; margin-bottom: 1rem; }
  .tag { background: #1e88e5; color: #fff; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.8rem; }
  h1 { margin-bottom: 0.5rem; }
  .desc { color: #666; }
  .content { line-height: 1.8; }
  .content :global(h2) { margin-top: 2rem; color: #1e88e5; }
  .content :global(blockquote) { border-left: 3px solid #1e88e5; padding-left: 1rem; color: #666; font-style: italic; margin: 1rem 0; }
  footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #eee; }

  /* 应援横幅样式 */
  .slogans-page .content :global(blockquote) {
    border-left: none;
    background: linear-gradient(135deg, #1e88e5 0%, #e63946 50%, #1e88e5 100%);
    color: #fff;
    font-style: normal;
    font-weight: bold;
    font-size: 1.2rem;
    text-align: center;
    padding: 1rem 2rem;
    margin: 1.2rem 0;
    border-radius: 4px;
    box-shadow: 
      0 4px 12px rgba(30, 136, 229, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
    position: relative;
    letter-spacing: 0.1em;
  }

  .slogans-page .content :global(blockquote)::before,
  .slogans-page .content :global(blockquote)::after {
    content: '★';
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    color: #ffd700;
    font-size: 1rem;
  }

  .slogans-page .content :global(blockquote)::before {
    left: 0.8rem;
  }

  .slogans-page .content :global(blockquote)::after {
    right: 0.8rem;
  }

  .slogans-page .content :global(blockquote p) {
    margin: 0;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
  }
</style>
