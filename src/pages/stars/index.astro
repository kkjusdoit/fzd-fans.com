---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';

const allStars = await getCollection('stars');
const stars = allStars.filter(item => item.slug.startsWith('zh/'));
---

<BaseLayout title="天际樊星">
  <section class="page-header">
    <h1>⭐ 天际樊星</h1>
    <div class="official-links">
      <a href="https://weibo.com/u/7888222767" target="_blank" rel="noopener noreferrer">
        樊振东微博
      </a>
      <span class="separator">|</span>
      <a href="https://weibo.com/fanzhendongglobal" target="_blank" rel="noopener noreferrer">
        球迷官方微博：樊振东球迷会-天际樊星
      </a>
    </div>
  </section>

  <section class="content-grid">
    {stars.map(star => {
      const slug = star.slug.replace('zh/', '');
      const href = slug === 'porsche-letters' ? '/stars/porsche-letters' : `/stars/${slug}`;
      return (
        <Card 
          title={star.data.title}
          href={href}
          description={star.data.description}
          tag={star.data.tags?.[0]}
        />
      );
    })}
  </section>
</BaseLayout>

<style>
  .page-header {
    text-align: center;
    padding: 2rem 0;
  }
  .page-header h1 { margin-bottom: 0.5rem; }
  .page-header p { color: #666; }
  .official-links {
    margin-top: 1rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .official-links a {
    color: #0066cc;
    text-decoration: none;
    font-weight: 500;
  }
  .official-links a:hover {
    text-decoration: underline;
  }
  .official-links .separator {
    color: #999;
  }
  .content-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
    padding: 2rem 0;
  }
</style>
