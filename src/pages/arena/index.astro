---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Timeline from '../../components/Timeline.astro';
import { getCollection } from 'astro:content';

const arena = await getCollection('arena');
---

<BaseLayout title="重要时刻">
  <section class="page-header">
    <h1>🏆 职业生涯大事记</h1>
    <p>从少年天才到世界冠军的成长之路</p>
  </section>

  <section class="timeline-section">
    <Timeline items={arena} />
  </section>
</BaseLayout>

<style>
  .page-header {
    text-align: center;
    padding: 2rem 0;
    margin-bottom: 2rem;
  }
  .page-header h1 { 
    margin-bottom: 0.5rem;
    font-size: 2rem;
  }
  .page-header p { 
    color: #666;
    font-size: 1.1rem;
  }
  .timeline-section {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 0;
  }
</style>
