---
// 静态页面，客户端获取数据
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageUploader from '../components/ImageUploader.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'zh';
const t = useTranslations(lang);
---

<BaseLayout title={t('imgupload.title')}>
  <div class="page-header">
    <div class="warning-banner">
      ⚠️ 温馨提示：图库包含多张高清大图，建议在 Wi-Fi 环境下浏览
    </div>
    <h1>📸 {t('imgupload.title')}</h1>
    <p class="page-subtitle">
      {t('imgupload.subtitle')}
    </p>
  </div>

  <!-- 上传组件 -->
  <ImageUploader lang={lang} />

  <!-- 照片墙 -->
  <div class="photo-wall">
    <h2>所有照片 (<span id="photo-count">--</span>)</h2>
    
    <div id="loading-indicator" class="loading-state">
      <div class="spinner"></div>
      <p>正在加载照片...</p>
    </div>

    <div class="gallery-grid" id="gallery-grid">
      <!--JS 渲染内容-->
    </div>

    <div id="empty-state" class="empty-state" style="display: none;">
      <p>还没有照片，或照片不符合规范。</p>
    </div>

    <div class="load-more-container" style="display: none;">
      <button id="load-more-btn" class="load-more-btn">
        加载更多
      </button>
    </div>
  </div>

  <!-- 版权与免责声明 -->
  <div class="disclaimer-footer">
    <h3>⚖️ 版权与免责声明</h3>
    <p>
      本站所有图片均由用户自行上传，版权归原作者所有。<br/>
      上传者需确保拥有图片版权或已获得授权。
    </p>
    <p>
      如发现任何侵犯您权益的内容，或描述有误需要更正/删除，<br/>
      请及时联系我们进行处理，我们将会在第一时间配合删除或更正。
    </p>
  </div>
</BaseLayout>

<script>
  // @ts-nocheck
  document.addEventListener('DOMContentLoaded', async () => {
    const galleryGrid = document.getElementById('gallery-grid');
    const loadingIndicator = document.getElementById('loading-indicator');
    const emptyState = document.getElementById('empty-state');
    const photoCountSpan = document.getElementById('photo-count');
    const loadMoreBtn = document.getElementById('load-more-btn');
    const loadMoreContainer = loadMoreBtn?.parentElement;

    let allPhotos = [];
    let currentLimit = 20;
    const PAGE_SIZE = 20;
    
    const ALLOWED_EXTS = ['.jpg', '.jpeg', '.png', '.gif', '.webp'];

    try {
      const response = await fetch('/api/photos');
      if (!response.ok) throw new Error('Failed to fetch photos');
      
      const data = await response.json();
      
      // Client-side filtering
      allPhotos = data.filter(photo => {
        if (!photo || !photo.url) return false;
        const ext = photo.url.substring(photo.url.lastIndexOf('.')).toLowerCase();
        return ALLOWED_EXTS.includes(ext);
      });

      photoCountSpan.textContent = allPhotos.length;
      loadingIndicator.style.display = 'none';

      if (allPhotos.length === 0) {
        emptyState.style.display = 'block';
      } else {
        renderBatch(allPhotos.slice(0, currentLimit));
        
        if (allPhotos.length > currentLimit) {
          loadMoreContainer.style.display = 'block';
          loadMoreBtn.textContent = `加载更多 (${allPhotos.length - currentLimit})`;
        }
      }

    } catch (error) {
      console.error('Error loading photos:', error);
      loadingIndicator.innerHTML = '<p style="color: red;">加载失败，请刷新重试</p>';
    }

    // Render helper
    function renderBatch(photos) {
      photos.forEach(photo => {
        const div = document.createElement('div');
        div.className = 'photo-item';
        div.innerHTML = `
          <a href="${photo.url}" target="_blank" rel="noopener noreferrer" class="photo-link">
            <div class="photo-wrapper" data-url="${photo.url}">
              <img src="${photo.url}" alt="${photo.name}" loading="lazy" />
            </div>
          </a>
          <div class="photo-info">
            <div class="button-group">
              <a href="/api/download?url=${encodeURIComponent(photo.url)}&filename=${encodeURIComponent(photo.name)}" class="action-btn download-btn" title="下载原图" target="_blank">
                ⬇️
              </a>
            </div>
          </div>
        `;
        galleryGrid.appendChild(div);
      });
    }

    // Load More Handler
    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        const nextLimit = currentLimit + PAGE_SIZE;
        const nextBatch = allPhotos.slice(currentLimit, nextLimit);
        
        renderBatch(nextBatch);
        currentLimit = nextLimit;
        
        const remaining = allPhotos.length - currentLimit;
        if (remaining <= 0) {
          loadMoreContainer.style.display = 'none';
        } else {
          loadMoreBtn.textContent = `加载更多 (${remaining})`;
        }
      });
    }
  });
</script>

<style>
  /* Reuse previous styles */
  .photo-wall {
    max-width: 1400px;
    margin: 3rem auto;
    padding: 0 1rem;
  }

  .photo-wall h2 {
    text-align: center;
    color: #333;
    margin-bottom: 2rem;
    font-size: 1.8rem;
  }

  .loading-state {
    text-align: center;
    padding: 3rem;
    color: #666;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 4px solid #f3f3f3;
    border-top: 4px solid #1e88e5;
    border-radius: 50%;
    margin: 0 auto 1rem;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .gallery-grid {
    column-count: 4;
    column-gap: 1.5rem;
  }

  .photo-item {
    break-inside: avoid;
    margin-bottom: 1.5rem;
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    /* Fix for column layout overlap */
    display: inline-block;
    width: 100%;
  }

  .photo-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.1);
  }

  .photo-wrapper {
    position: relative;
    overflow: hidden;
    cursor: zoom-in;
    /* Limit height for tall images, show top part */
    height: 300px;
    background-color: #f5f5f5;
  }

  .photo-wrapper img {
    width: 100%;
    height: 100%;
    display: block;
    transition: transform 0.5s ease;
    object-fit: cover;
    object-position: top;
  }

  .photo-item:hover .photo-wrapper img {
    transform: scale(1.05);
  }

  .page-header {
    text-align: center;
    padding: 3rem 1rem 2rem;
    background: linear-gradient(135deg, #e3f2fd 0%, #fff 100%);
    border-radius: 0 0 2rem 2rem;
    margin-bottom: 2rem;
    position: relative;
  }

  .warning-banner {
    background: #fff3e0;
    color: #e65100;
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    border-radius: 8px;
    display: inline-block;
    margin-bottom: 20px;
    border: 1px solid #ffe0b2;
    animation: fadeInDown 0.5s ease;
  }

  .load-more-container {
    text-align: center;
    margin: 3rem 0;
  }

  .load-more-btn {
    background: #fff;
    border: 2px solid #1e88e5;
    color: #1e88e5;
    padding: 0.8rem 2.5rem;
    border-radius: 2rem;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s;
    font-weight: 500;
  }

  .load-more-btn:hover {
    background: #1e88e5;
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(30, 136, 229, 0.2);
  }

  @keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .page-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, #1e88e5, #0d47a1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .page-subtitle {
    color: #666;
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .photo-info {
    padding: 0.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    border-top: 1px solid #f0f0f0;
  }

  .button-group {
    display: flex;
    gap: 0.5rem;
  }

  .action-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.1rem;
    padding: 4px;
    border-radius: 4px;
    transition: background 0.2s;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .action-btn:hover {
    background: #f0f0f0;
  }

  .disclaimer-footer {
    max-width: 800px;
    margin: 4rem auto 2rem;
    padding: 2rem;
    background: #f5f5f5;
    border-radius: 12px;
    text-align: center;
    color: #666;
    font-size: 0.85rem;
  }

  .disclaimer-footer h3 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
    color: #444;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .disclaimer-footer p {
    margin: 0.5rem 0;
    line-height: 1.6;
  }

  .disclaimer-footer code {
    background: #e0e0e0;
    padding: 2px 6px;
    border-radius: 4px;
    font-family: monospace;
    color: #c62828;
  }
  
  .empty-state {
    text-align: center;
    padding: 2rem;
    color: #999;
  }

  @media (max-width: 1200px) {
    .gallery-grid {
      column-count: 3;
    }
  }

  @media (max-width: 900px) {
    .gallery-grid {
      column-count: 2;
    }
  }

  @media (max-width: 600px) {
    .gallery-grid {
      column-count: 1;
    }
    
    .page-header h1 {
      font-size: 1.8rem;
    }
  }
</style>
