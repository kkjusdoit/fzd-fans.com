---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="打爆一切">
  <div id="game-container">
    <div id="game-intro">
      <h1>💥 打爆一切</h1>
      <p>所有的谣言、荒谬、污蔑、诋毁、无稽之谈如热气球般升起，请点击一一击碎它们</p>
      <button id="start-btn">开始</button>
      <p class="sound-tip">🔊 建议开启声音 有惊喜</p>
    </div>
    <div id="game-area" style="display: none;">
      <div id="hud">
        <a href="/" id="back-btn">← 返回</a>
        <div id="score">💥 <span id="count">0</span> / <span id="total">19</span></div>
      </div>
    </div>
    <div id="game-end" style="display: none;">
      <a href="/" id="end-back-btn">← 返回首页</a>
      <div class="final-message">
        <p class="quote">2026，樊振东打爆一切！</p>
        <p class="footnote">如今的樊振东，连太阳都黑不了</p>
        <button id="replay-btn">再来一次</button>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  #game-container {
    min-height: 80vh;
    position: relative;
  }
  #game-intro, #game-end {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 70vh;
    text-align: center;
  }
  #game-intro h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
    background: linear-gradient(45deg, #c41e3a, #ff6b6b);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  #game-intro p { color: #666; margin-bottom: 2rem; font-size: 1.1rem; }
  #game-intro .sound-tip { color: #999; font-size: 0.9rem; margin-top: 1rem; }
  #start-btn, #replay-btn {
    background: linear-gradient(45deg, #c41e3a, #e63950);
    color: white;
    border: none;
    padding: 1rem 3rem;
    font-size: 1.3rem;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 4px 20px rgba(196, 30, 58, 0.4);
  }
  #start-btn:hover, #replay-btn:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 30px rgba(196, 30, 58, 0.6);
  }
  #game-end {
    background: linear-gradient(to bottom, #1a1a3e 0%, #2d1b4e 50%, #4a2c5a 100%);
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 1000;
  }
  #end-back-btn {
    position: fixed;
    top: 20px;
    left: 20px;
    color: white;
    font-size: 1rem;
    background: rgba(0,0,0,0.5);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    text-decoration: none;
    transition: all 0.3s;
    z-index: 1001;
  }
  #end-back-btn:hover {
    background: rgba(255,255,255,0.2);
  }
  .final-message {
    animation: zoomIn 1.5s ease-out;
    text-align: center;
    padding: 2rem;
  }
  .final-message .quote {
    font-size: 2.5rem;
    color: #ffd700;
    margin-bottom: 1.5rem;
    max-width: 700px;
    line-height: 1.6;
    text-shadow: 0 0 40px rgba(255, 215, 0, 0.6);
  }
  .final-message .author {
    color: #aaa;
    font-size: 1.3rem;
    margin-bottom: 3rem;
  }
  .final-message .footnote {
    color: rgba(255, 215, 0, 0.7);
    font-size: 1.1rem;
    margin-top: -0.5rem;
    margin-bottom: 2rem;
    font-style: italic;
  }
  @keyframes zoomIn {
    from { opacity: 0; transform: scale(0.3); }
    to { opacity: 1; transform: scale(1); }
  }
</style>

<style is:global>
  #game-area {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: linear-gradient(to bottom, #1a1a3e 0%, #2d1b4e 50%, #4a2c5a 100%);
    z-index: 1000;
    overflow: hidden;
  }
  #hud {
    position: fixed;
    top: 20px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
    z-index: 1001;
  }
  #back-btn {
    color: white;
    font-size: 1rem;
    background: rgba(0,0,0,0.5);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    text-decoration: none;
    transition: all 0.3s;
  }
  #back-btn:hover {
    background: rgba(255,255,255,0.2);
  }
  #score {
    color: white;
    font-size: 1.5rem;
    background: rgba(0,0,0,0.6);
    padding: 0.5rem 1.5rem;
    border-radius: 30px;
  }
  #game-hint {
    position: fixed;
    top: 70px;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255,255,255,0.6);
    font-size: 0.9rem;
    text-align: center;
    max-width: 80%;
    z-index: 1001;
    pointer-events: none;
  }
  #sound-hint {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255,255,255,0.5);
    font-size: 0.85rem;
    text-align: center;
    z-index: 1001;
    pointer-events: none;
  }

  /* 热气球样式 */
  .balloon {
    position: fixed;
    cursor: pointer;
    user-select: none;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: filter 0.2s;
  }
  .balloon:hover {
    filter: brightness(1.2);
  }
  .balloon:hover .balloon-body {
    transform: scale(1.05);
  }

  .balloon-body {
    position: relative;
    width: 100px;
    height: 120px;
    border-radius: 50% 50% 45% 45%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 
      inset -15px -10px 30px rgba(0,0,0,0.3),
      inset 10px 10px 20px rgba(255,255,255,0.2),
      0 10px 40px rgba(0,0,0,0.4);
    transition: transform 0.2s;
  }
  .balloon-body::before {
    content: '';
    position: absolute;
    top: 15px;
    left: 20px;
    width: 20px;
    height: 25px;
    background: rgba(255,255,255,0.3);
    border-radius: 50%;
  }

  .balloon-text {
    color: white;
    font-size: 0.7rem;
    font-weight: bold;
    text-align: center;
    padding: 8px;
    text-shadow: 1px 1px 3px rgba(0,0,0,0.8);
    line-height: 1.2;
    max-width: 85px;
    word-break: break-all;
  }

  .balloon-rope {
    width: 2px;
    height: 30px;
    background: linear-gradient(to bottom, #8b4513, #654321);
  }

  .balloon-basket {
    width: 30px;
    height: 20px;
    background: linear-gradient(to bottom, #8b4513, #654321);
    border-radius: 0 0 5px 5px;
    border: 2px solid #5a3a1a;
    box-shadow: inset 0 -5px 10px rgba(0,0,0,0.3);
  }

  /* 不同颜色的气球 */
  .balloon.color-0 .balloon-body { background: linear-gradient(135deg, #ff6b6b, #c41e3a); }
  .balloon.color-1 .balloon-body { background: linear-gradient(135deg, #74b9ff, #0984e3); }
  .balloon.color-2 .balloon-body { background: linear-gradient(135deg, #ffeaa7, #fdcb6e); }
  .balloon.color-3 .balloon-body { background: linear-gradient(135deg, #a29bfe, #6c5ce7); }
  .balloon.color-4 .balloon-body { background: linear-gradient(135deg, #55efc4, #00b894); }
  .balloon.color-5 .balloon-body { background: linear-gradient(135deg, #fd79a8, #e84393); }
  .balloon.color-6 .balloon-body { background: linear-gradient(135deg, #fab1a0, #e17055); }

  /* 爆炸动画 */
  .balloon.exploding {
    animation: balloonExplode 0.4s forwards;
    pointer-events: none;
  }
  @keyframes balloonExplode {
    0% { transform: scale(1); opacity: 1; }
    30% { transform: scale(1.4); }
    100% { transform: scale(0); opacity: 0; }
  }

  /* 爆炸碎片 */
  .fragment {
    position: fixed;
    pointer-events: none;
    z-index: 2000;
  }

  /* 爆炸闪光 */
  .explosion-flash {
    position: fixed;
    border-radius: 50%;
    pointer-events: none;
    z-index: 1999;
  }

  /* 冲击波 */
  .shockwave {
    position: fixed;
    border-radius: 50%;
    border: 3px solid rgba(255, 255, 255, 0.8);
    pointer-events: none;
    z-index: 1998;
  }

  /* 爆炸文字 */
  .boom-text {
    position: fixed;
    font-size: 2rem;
    font-weight: bold;
    pointer-events: none;
    z-index: 2001;
    text-shadow: 0 0 10px currentColor, 0 0 20px currentColor;
  }

  /* 烟花效果 */
  .firework {
    position: fixed;
    pointer-events: none;
    z-index: 1002;
  }
  .firework-particle {
    position: fixed;
    border-radius: 50%;
    pointer-events: none;
    z-index: 1002;
  }
  .firework-trail {
    position: fixed;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 1002;
  }
</style>

<script>
  // 音效
  const explosionSound = new Audio('/audio/new_explosion.wav');
  const endSound = new Audio('/audio/fanzhendong.wav');
  explosionSound.volume = 0.3;
  endSound.volume = 0.6;

  const rumors = [
    "新加坡赛前和林昀儒看霉霉演唱会被网暴",
    "巴黎奥运前和朋友加油打气被骂提前开香槟",
    "身份证曝光",
    "陌生女子闯入房间",
    "重庆冠军赛赛后发言时一分多钟的大喊大叫",
    "输了不行赢了也没那么行",
    "出国是不扛大旗？",
    "全球总教练，泄密技术？",
    "一单两分难建功",
    "2024年无缘最佳运动员",
    "逼退世排无球可打",
    "把自己位置摆得有点高，真把自己当东哥了？",
    "WTT霸王条款",
    "没你爆他",
    "对家人进行骚扰谩骂，扬言焚烧照片和海报",
    "威海全锦赛夺冠后领奖台的尴尬",
    "巴黎奥运时被诅咒一起输",
    "踩断球拍背后主谋？",
    "肚子痛塑料袋子装热水捂着当医疗保障",
    "巴黎奥运会除了赞助商安踏没人希望东子赢",
    "仁川和波尔一起看足球比赛被指责",
    "八一队解散无家可归",
    "向鹏输给弗朗西斯卡背锅",
    "王楚钦输给弗朗西斯卡背锅",
    "世界乒联排名积分赋0",
    "去德甲打球为了挣钱？",
    "新冠阳后38天打41场比赛",
    "多次商业赛无随行主管教练",
    "研究队友一整年？",
    "专挑对手接不着的地方打？",
  ];

  let brokenCount = 0;
  let totalRumors = rumors.length;
  let gameArea: HTMLElement | null;
  let balloons: { element: HTMLElement; x: number; y: number; minY: number; speed: number; sway: number; swayOffset: number }[] = [];
  let animationId: number;
  let usedZones: Set<number> = new Set(); // 记录已使用的水平区域

  // 检测是否为移动设备
  const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) || window.innerWidth < 768;
  // 移动端速度倍数（更快）
  const speedMultiplier = isMobile ? 4 : 1;

  const startBtn = document.getElementById('start-btn');
  const replayBtn = document.getElementById('replay-btn');
  const gameIntro = document.getElementById('game-intro');
  const gameEnd = document.getElementById('game-end');

  function startGame() {
    brokenCount = 0;
    balloons = [];
    usedZones.clear();
    gameArea = document.getElementById('game-area');

    if (gameIntro) gameIntro.style.display = 'none';
    if (gameEnd) gameEnd.style.display = 'none';
    if (gameArea) {
      gameArea.style.display = 'block';
      gameArea.innerHTML = `
        <div id="hud">
          <a href="/" id="back-btn">← 返回</a>
          <div id="score">💥 <span id="count">0</span> / <span id="total">${totalRumors}</span></div>
        </div>
        <div id="game-hint">所有的谣言、荒谬、污蔑、诋毁、无稽之谈如热气球般升起，请点击一一击碎它们</div>
        <div id="sound-hint">🔊 建议开启声音 有惊喜</div>
      `;
    }

    // 移动端更快生成，间隔更短
    const spawnInterval = isMobile ? 150 : 500;
    rumors.forEach((text, i) => {
      setTimeout(() => spawnBalloon(text, i), i * spawnInterval);
    });

    // 开始动画循环
    animateBalloons();
  }

  // 获取不重叠的水平位置
  function getUniqueX(balloonWidth: number): number {
    const screenWidth = window.innerWidth;
    const padding = 30;
    const zoneWidth = balloonWidth + 20; // 气球宽度 + 间距
    const numZones = Math.floor((screenWidth - padding * 2) / zoneWidth);
    
    // 如果所有区域都用过了，重置
    if (usedZones.size >= numZones) {
      usedZones.clear();
    }
    
    // 找一个未使用的区域
    let zone: number;
    do {
      zone = Math.floor(Math.random() * numZones);
    } while (usedZones.has(zone));
    
    usedZones.add(zone);
    
    // 在区域内加一点随机偏移
    const baseX = padding + zone * zoneWidth;
    const offset = Math.random() * 15;
    return baseX + offset;
  }

  function spawnBalloon(text: string, index: number) {
    if (!gameArea) return;

    const balloon = document.createElement('div');
    balloon.className = `balloon color-${index % 7}`;
    balloon.innerHTML = `
      <div class="balloon-body">
        <span class="balloon-text">${text}</span>
      </div>
      <div class="balloon-rope"></div>
      <div class="balloon-basket"></div>
    `;

    // 使用分区算法获取不重叠的水平位置
    const balloonWidth = isMobile ? 80 : 100;
    const x = getUniqueX(balloonWidth);
    // 错开起始高度，避免同时出现
    const y = window.innerHeight + 50 + (index % 5) * 80;
    // 随机停止高度 (在屏幕上半部分的某个位置)，也错开
    const minY = 80 + (index % 4) * 60 + Math.random() * (window.innerHeight * 0.3);

    balloon.style.left = x + 'px';
    balloon.style.top = y + 'px';

    balloon.addEventListener('click', () => explodeBalloon(balloon, index));

    gameArea.appendChild(balloon);

    // 记录气球数据，移动端速度更快
    balloons.push({
      element: balloon,
      x: x,
      y: y,
      minY: minY,
      speed: (0.8 + Math.random() * 0.6) * speedMultiplier,
      sway: isMobile ? 8 : 15 + Math.random() * 20, // 移动端减少摇摆
      swayOffset: Math.random() * Math.PI * 2
    });
  }

  function animateBalloons() {
    const time = Date.now() / 1000;

    balloons.forEach(b => {
      if (!b.element.classList.contains('exploding')) {
        // 只有还没到达目标高度时才上升
        if (b.y > b.minY) {
          b.y -= b.speed;
        }
        const swayX = Math.sin(time * 1.5 + b.swayOffset) * b.sway;
        b.element.style.left = (b.x + swayX) + 'px';
        b.element.style.top = b.y + 'px';
      }
    });

    animationId = requestAnimationFrame(animateBalloons);
  }

  function explodeBalloon(balloon: HTMLElement, index: number) {
    if (balloon.classList.contains('exploding')) return;

    // 播放爆炸音效
    explosionSound.currentTime = 0;
    explosionSound.play().catch(() => {});

    createExplosion(balloon, index);
    balloon.classList.add('exploding');
    brokenCount++;

    const countEl = document.getElementById('count');
    if (countEl) countEl.textContent = brokenCount.toString();

    setTimeout(() => {
      balloon.remove();
      balloons = balloons.filter(b => b.element !== balloon);

      if (brokenCount >= totalRumors) {
        cancelAnimationFrame(animationId);
        endGame();
      }
    }, 400);
  }

  function createExplosion(balloon: HTMLElement, colorIndex: number) {
    const rect = balloon.getBoundingClientRect();
    const centerX = rect.left + rect.width / 2;
    const centerY = rect.top + 60;

    const colors = [
      ['#ff6b6b', '#c41e3a', '#ff8787'],
      ['#74b9ff', '#0984e3', '#a0d2ff'],
      ['#ffeaa7', '#fdcb6e', '#fff3b0'],
      ['#a29bfe', '#6c5ce7', '#c4bfff'],
      ['#55efc4', '#00b894', '#81fff0'],
      ['#fd79a8', '#e84393', '#ffb3d1'],
      ['#fab1a0', '#e17055', '#ffd0c4']
    ];
    const fragmentColors = colors[colorIndex % 7];

    // 移动端减少特效数量
    const fragmentCount = isMobile ? 10 : 25;
    const sparkCount = isMobile ? 6 : 16;
    const smokeCount = isMobile ? 2 : 5;

    // 爆炸闪光
    const flash = document.createElement('div');
    flash.className = 'explosion-flash';
    flash.style.cssText = `left:${centerX - 60}px;top:${centerY - 60}px;width:120px;height:120px;background:radial-gradient(circle, white 0%, ${fragmentColors[0]} 50%, transparent 70%);opacity:1`;
    document.body.appendChild(flash);

    let flashOp = 1;
    let flashScale = 1;
    function animateFlash() {
      flashOp -= 0.15;
      flashScale += 0.4;
      flash.style.opacity = flashOp.toString();
      flash.style.transform = `scale(${flashScale})`;
      if (flashOp > 0) {
        requestAnimationFrame(animateFlash);
      } else {
        flash.remove();
      }
    }
    animateFlash();

    // 冲击波（移动端简化）
    if (!isMobile) {
      const shockwave = document.createElement('div');
      shockwave.className = 'shockwave';
      shockwave.style.cssText = `left:${centerX - 10}px;top:${centerY - 10}px;width:20px;height:20px;border-color:${fragmentColors[0]}`;
      document.body.appendChild(shockwave);

      let swScale = 1;
      let swOp = 1;
      function animateShockwave() {
        swScale += 0.8;
        swOp -= 0.05;
        shockwave.style.transform = `scale(${swScale})`;
        shockwave.style.opacity = swOp.toString();
        if (swOp > 0) {
          requestAnimationFrame(animateShockwave);
        } else {
          shockwave.remove();
        }
      }
      animateShockwave();
    }

    // 爆炸文字
    const boomTexts = ['💥', '砰!', 'BOOM', '爆!'];
    const boomText = document.createElement('div');
    boomText.className = 'boom-text';
    boomText.textContent = boomTexts[Math.floor(Math.random() * boomTexts.length)];
    boomText.style.cssText = `left:${centerX}px;top:${centerY}px;color:${fragmentColors[0]}`;
    document.body.appendChild(boomText);

    let btOp = 1;
    let btY = centerY;
    let btScale = 0.5;
    function animateBoomText() {
      btOp -= 0.06;
      btY -= 4;
      btScale = Math.min(btScale + 0.2, 1.5);
      boomText.style.cssText = `left:${centerX}px;top:${btY}px;color:${fragmentColors[0]};opacity:${btOp};transform:translate(-50%, -50%) scale(${btScale})`;
      if (btOp > 0) {
        requestAnimationFrame(animateBoomText);
      } else {
        boomText.remove();
      }
    }
    animateBoomText();

    // 碎片（移动端减少数量）
    for (let i = 0; i < fragmentCount; i++) {
      const fragment = document.createElement('div');
      fragment.className = 'fragment';

      const size = 5 + Math.random() * 15;
      const isRound = Math.random() > 0.4;

      fragment.style.cssText = `width:${size}px;height:${size}px;background:${fragmentColors[Math.floor(Math.random() * fragmentColors.length)]};border-radius:${isRound ? '50%' : Math.random() * 8 + 'px'};left:${centerX}px;top:${centerY}px`;

      document.body.appendChild(fragment);

      const angle = Math.random() * Math.PI * 2;
      const velocity = 6 + Math.random() * 12;
      let vx = Math.cos(angle) * velocity;
      let vy = Math.sin(angle) * velocity - 4;
      let px = centerX;
      let py = centerY;
      let opacity = 1;

      function animateFragment() {
        px += vx;
        vy += 0.5;
        py += vy;
        opacity -= 0.04;

        fragment.style.cssText = `width:${size}px;height:${size}px;background:${fragmentColors[0]};border-radius:${isRound ? '50%' : '4px'};left:${px}px;top:${py}px;opacity:${opacity}`;

        if (opacity > 0) {
          requestAnimationFrame(animateFragment);
        } else {
          fragment.remove();
        }
      }
      animateFragment();
    }

    // 火花（移动端减少）
    for (let i = 0; i < sparkCount; i++) {
      const spark = document.createElement('div');
      spark.className = 'fragment';
      const sparkSize = 3 + Math.random() * 3;
      spark.style.cssText = `width:${sparkSize}px;height:${sparkSize}px;background:${i % 2 === 0 ? '#fff' : '#ffd700'};border-radius:50%;left:${centerX}px;top:${centerY}px`;

      document.body.appendChild(spark);

      const angle = (Math.PI * 2 * i) / sparkCount;
      const velocity = 8 + Math.random() * 6;
      let px = centerX;
      let py = centerY;
      let opacity = 1;
      let vx = Math.cos(angle) * velocity;
      let vy = Math.sin(angle) * velocity;

      function animateSpark() {
        px += vx;
        py += vy;
        vy += 0.3;
        opacity -= 0.07;

        spark.style.cssText = `width:${sparkSize}px;height:${sparkSize}px;background:${i % 2 === 0 ? '#fff' : '#ffd700'};border-radius:50%;left:${px}px;top:${py}px;opacity:${opacity}`;

        if (opacity > 0) {
          requestAnimationFrame(animateSpark);
        } else {
          spark.remove();
        }
      }
      animateSpark();
    }

    // 烟雾（移动端减少）
    for (let i = 0; i < smokeCount; i++) {
      const smoke = document.createElement('div');
      smoke.className = 'fragment';
      const smokeX = centerX - 15 + (Math.random() - 0.5) * 30;
      let smokeY = centerY - 15 + (Math.random() - 0.5) * 30;
      smoke.style.cssText = `width:30px;height:30px;background:radial-gradient(circle, rgba(100,100,100,0.5) 0%, transparent 70%);border-radius:50%;left:${smokeX}px;top:${smokeY}px`;

      document.body.appendChild(smoke);

      let smokeOp = 0.5;
      let smokeScale = 1;

      function animateSmoke() {
        smokeOp -= 0.025;
        smokeScale += 0.08;
        smokeY -= 1.5;
        smoke.style.cssText = `width:30px;height:30px;background:radial-gradient(circle, rgba(100,100,100,${smokeOp}) 0%, transparent 70%);border-radius:50%;left:${smokeX}px;top:${smokeY}px;transform:scale(${smokeScale})`;

        if (smokeOp > 0) {
          requestAnimationFrame(animateSmoke);
        } else {
          smoke.remove();
        }
      }
      animateSmoke();
    }
  }

  // 烟花效果
  let fireworkInterval: number;
  const fireworkColors = [
    ['#ff6b6b', '#ff8787', '#ffa8a8'],
    ['#ffd700', '#ffec8b', '#fff8dc'],
    ['#74b9ff', '#a0d2ff', '#d0e8ff'],
    ['#a29bfe', '#c4bfff', '#e0ddff'],
    ['#55efc4', '#81fff0', '#b0fff8'],
    ['#fd79a8', '#ffb3d1', '#ffd6e7'],
    ['#00ff88', '#66ffaa', '#99ffcc'],
  ];

  function createFirework() {
    const x = Math.random() * window.innerWidth;
    const startY = window.innerHeight;
    const targetY = 100 + Math.random() * (window.innerHeight * 0.4);
    const colors = fireworkColors[Math.floor(Math.random() * fireworkColors.length)];

    // 上升的火花
    const rocket = document.createElement('div');
    rocket.className = 'firework-trail';
    rocket.style.cssText = `left:${x}px;top:${startY}px;background:${colors[0]};box-shadow:0 0 6px ${colors[0]}`;
    document.body.appendChild(rocket);

    let rocketY = startY;
    const rocketSpeed = 8 + Math.random() * 4;

    function animateRocket() {
      rocketY -= rocketSpeed;
      rocket.style.top = rocketY + 'px';

      // 拖尾
      if (Math.random() > 0.5) {
        const trail = document.createElement('div');
        trail.className = 'firework-trail';
        trail.style.cssText = `left:${x + (Math.random() - 0.5) * 4}px;top:${rocketY}px;background:${colors[1]};opacity:0.8`;
        document.body.appendChild(trail);
        setTimeout(() => trail.remove(), 200);
      }

      if (rocketY > targetY) {
        requestAnimationFrame(animateRocket);
      } else {
        rocket.remove();
        explodeFirework(x, targetY, colors);
      }
    }
    animateRocket();
  }

  function explodeFirework(x: number, y: number, colors: string[]) {
    const particleCount = 30 + Math.floor(Math.random() * 20);

    for (let i = 0; i < particleCount; i++) {
      const particle = document.createElement('div');
      particle.className = 'firework-particle';
      const size = 3 + Math.random() * 4;
      const color = colors[Math.floor(Math.random() * colors.length)];
      particle.style.cssText = `left:${x}px;top:${y}px;width:${size}px;height:${size}px;background:${color};box-shadow:0 0 ${size * 2}px ${color}`;
      document.body.appendChild(particle);

      const angle = (Math.PI * 2 * i) / particleCount + (Math.random() - 0.5) * 0.5;
      const velocity = 3 + Math.random() * 5;
      let vx = Math.cos(angle) * velocity;
      let vy = Math.sin(angle) * velocity;
      let px = x;
      let py = y;
      let opacity = 1;
      let life = 60 + Math.random() * 40;

      function animateParticle() {
        px += vx;
        vy += 0.08; // 重力
        py += vy;
        vx *= 0.98; // 阻力
        opacity -= 1 / life;

        particle.style.left = px + 'px';
        particle.style.top = py + 'px';
        particle.style.opacity = opacity.toString();

        if (opacity > 0) {
          requestAnimationFrame(animateParticle);
        } else {
          particle.remove();
        }
      }
      animateParticle();
    }
  }

  function startFireworks() {
    // 立即放几个
    for (let i = 0; i < 2; i++) {
      setTimeout(() => createFirework(), i * 500);
    }
    // 持续放烟花，间隔拉长
    fireworkInterval = setInterval(() => {
      createFirework();
    }, 1200);
  }

  function stopFireworks() {
    if (fireworkInterval) {
      clearInterval(fireworkInterval);
    }
  }

  function endGame() {
    setTimeout(() => {
      if (gameArea) gameArea.style.display = 'none';
      if (gameEnd) gameEnd.style.display = 'flex';
      // 播放结束音效
      endSound.currentTime = 0;
      endSound.play().catch(() => {});
      startFireworks();
    }, 500);
  }

  startBtn?.addEventListener('click', startGame);
  replayBtn?.addEventListener('click', () => {
    stopFireworks();
    startGame();
  });
</script>
