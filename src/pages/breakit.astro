---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="打爆一切">
  <div id="game-container">
    <div id="game-intro">
      <h1>💥 打爆一切</h1>
      <p>所有的污蔑、诋毁、打压如热气球般升起，点击击碎它们</p>
      <button id="start-btn">开始</button>
    </div>
    <div id="game-area" style="display: none;">
      <div id="hud">
        <a href="/" id="back-btn">← 返回</a>
        <div id="score">💥 <span id="count">0</span> / <span id="total">19</span></div>
      </div>
    </div>
    <div id="game-end" style="display: none;">
      <a href="/" id="end-back-btn">← 返回首页</a>
      <div class="final-message">
        <p class="quote">"我不需要证明什么，我只需要做好自己。"</p>
        <p class="author">—— 樊振东</p>
        <button id="replay-btn">再来一次</button>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  #game-container {
    min-height: 80vh;
    position: relative;
  }
  #game-intro, #game-end {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 70vh;
    text-align: center;
  }
  #game-intro h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
    background: linear-gradient(45deg, #c41e3a, #ff6b6b);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  #game-intro p { color: #666; margin-bottom: 2rem; font-size: 1.1rem; }
  #start-btn, #replay-btn {
    background: linear-gradient(45deg, #c41e3a, #e63950);
    color: white;
    border: none;
    padding: 1rem 3rem;
    font-size: 1.3rem;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 4px 20px rgba(196, 30, 58, 0.4);
  }
  #start-btn:hover, #replay-btn:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 30px rgba(196, 30, 58, 0.6);
  }
  #game-end {
    background: linear-gradient(to bottom, #1a1a3e 0%, #2d1b4e 50%, #4a2c5a 100%);
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 1000;
  }
  #end-back-btn {
    position: fixed;
    top: 20px;
    left: 20px;
    color: white;
    font-size: 1rem;
    background: rgba(0,0,0,0.5);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    text-decoration: none;
    transition: all 0.3s;
    z-index: 1001;
  }
  #end-back-btn:hover {
    background: rgba(255,255,255,0.2);
  }
  .final-message {
    animation: zoomIn 1.5s ease-out;
    text-align: center;
    padding: 2rem;
  }
  .final-message .quote {
    font-size: 2.5rem;
    color: #ffd700;
    margin-bottom: 1.5rem;
    max-width: 700px;
    line-height: 1.6;
    text-shadow: 0 0 40px rgba(255, 215, 0, 0.6);
  }
  .final-message .author {
    color: #aaa;
    font-size: 1.3rem;
    margin-bottom: 3rem;
  }
  @keyframes zoomIn {
    from { opacity: 0; transform: scale(0.3); }
    to { opacity: 1; transform: scale(1); }
  }
</style>

<style is:global>
  #game-area {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: linear-gradient(to bottom, #1a1a3e 0%, #2d1b4e 50%, #4a2c5a 100%);
    z-index: 1000;
    overflow: hidden;
  }
  #hud {
    position: fixed;
    top: 20px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
    z-index: 1001;
  }
  #back-btn {
    color: white;
    font-size: 1rem;
    background: rgba(0,0,0,0.5);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    text-decoration: none;
    transition: all 0.3s;
  }
  #back-btn:hover {
    background: rgba(255,255,255,0.2);
  }
  #score {
    color: white;
    font-size: 1.5rem;
    background: rgba(0,0,0,0.6);
    padding: 0.5rem 1.5rem;
    border-radius: 30px;
  }

  /* 热气球样式 */
  .balloon {
    position: fixed;
    cursor: pointer;
    user-select: none;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: filter 0.2s;
  }
  .balloon:hover {
    filter: brightness(1.2);
  }
  .balloon:hover .balloon-body {
    transform: scale(1.05);
  }

  .balloon-body {
    position: relative;
    width: 100px;
    height: 120px;
    border-radius: 50% 50% 45% 45%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 
      inset -15px -10px 30px rgba(0,0,0,0.3),
      inset 10px 10px 20px rgba(255,255,255,0.2),
      0 10px 40px rgba(0,0,0,0.4);
    transition: transform 0.2s;
  }
  .balloon-body::before {
    content: '';
    position: absolute;
    top: 15px;
    left: 20px;
    width: 20px;
    height: 25px;
    background: rgba(255,255,255,0.3);
    border-radius: 50%;
  }

  .balloon-text {
    color: white;
    font-size: 0.7rem;
    font-weight: bold;
    text-align: center;
    padding: 8px;
    text-shadow: 1px 1px 3px rgba(0,0,0,0.8);
    line-height: 1.2;
    max-width: 85px;
    word-break: break-all;
  }

  .balloon-rope {
    width: 2px;
    height: 30px;
    background: linear-gradient(to bottom, #8b4513, #654321);
  }

  .balloon-basket {
    width: 30px;
    height: 20px;
    background: linear-gradient(to bottom, #8b4513, #654321);
    border-radius: 0 0 5px 5px;
    border: 2px solid #5a3a1a;
    box-shadow: inset 0 -5px 10px rgba(0,0,0,0.3);
  }

  /* 不同颜色的气球 */
  .balloon.color-0 .balloon-body { background: linear-gradient(135deg, #ff6b6b, #c41e3a); }
  .balloon.color-1 .balloon-body { background: linear-gradient(135deg, #74b9ff, #0984e3); }
  .balloon.color-2 .balloon-body { background: linear-gradient(135deg, #ffeaa7, #fdcb6e); }
  .balloon.color-3 .balloon-body { background: linear-gradient(135deg, #a29bfe, #6c5ce7); }
  .balloon.color-4 .balloon-body { background: linear-gradient(135deg, #55efc4, #00b894); }
  .balloon.color-5 .balloon-body { background: linear-gradient(135deg, #fd79a8, #e84393); }
  .balloon.color-6 .balloon-body { background: linear-gradient(135deg, #fab1a0, #e17055); }

  /* 爆炸动画 */
  .balloon.exploding {
    animation: balloonExplode 0.4s forwards;
    pointer-events: none;
  }
  @keyframes balloonExplode {
    0% { transform: scale(1); opacity: 1; }
    30% { transform: scale(1.4); }
    100% { transform: scale(0); opacity: 0; }
  }

  /* 爆炸碎片 */
  .fragment {
    position: fixed;
    pointer-events: none;
    z-index: 100;
  }

  /* 爆炸闪光 */
  .explosion-flash {
    position: fixed;
    border-radius: 50%;
    pointer-events: none;
    z-index: 99;
  }

  /* 冲击波 */
  .shockwave {
    position: fixed;
    border-radius: 50%;
    border: 3px solid rgba(255, 255, 255, 0.8);
    pointer-events: none;
    z-index: 98;
  }

  /* 爆炸文字 */
  .boom-text {
    position: fixed;
    font-size: 2rem;
    font-weight: bold;
    pointer-events: none;
    z-index: 101;
    text-shadow: 0 0 10px currentColor, 0 0 20px currentColor;
  }
</style>

<script>
  const rumors = [
    "新加坡赛前和林昀儒看霉霉演唱会被网暴",
    "巴黎奥运前和朋友加油打气被骂提前开香槟",
    "身份证曝光",
    "陌生女子闯入房间，不让报警",
    "重庆冠军赛赛后发言时一分多钟的大喊大叫",
    "输了不行赢了也没那么行",
    "出国是不扛大旗",
    "全球总教练，泄密技术",
    "研究队友一整年,专挑对手接不着的地方打",
    "最强但不是最棒，最棒的另有安排",
    "釜山世乒赛一单两分难建功",
    "2024年无缘最佳运动员",
    "逼退世排无球可打",
    "把自己位置摆得有点高，真把自己当东哥了",
    "WTT霸权",
    ”没你爆他",
    "对家人进行骚扰谩骂，扬言焚烧照片和海报",
    "威海全锦赛夺冠后领奖台的尴尬",
    "巴黎奥运时被诅咒一起输",
    ”踩断球拍背后主谋",
    ”釜山世乒赛肚子痛塑料袋子装热水捂着当医疗保障",
    ”巴黎奥运会除了赞助商安踏没人希望东子赢",
    ”仁川和波尔一起看足球比赛被指责",
    ”八一队解散",
    "向鹏输给弗朗西斯卡背锅”,
    “王楚钦输给弗朗西斯卡背锅”,
    "世界乒联排名积分赋0“,
    "去德甲打球为了挣钱",
    "新冠阳后都能38天打41场比赛",
    “隔空传功",
    “隔空传功",
    “隔空传功",
    “隔空传功",

  ];

  let brokenCount = 0;
  let totalRumors = rumors.length;
  let gameArea: HTMLElement | null;
  let balloons: { element: HTMLElement; x: number; y: number; minY: number; speed: number; sway: number; swayOffset: number }[] = [];
  let animationId: number;

  const startBtn = document.getElementById('start-btn');
  const replayBtn = document.getElementById('replay-btn');
  const gameIntro = document.getElementById('game-intro');
  const gameEnd = document.getElementById('game-end');

  function startGame() {
    brokenCount = 0;
    balloons = [];
    gameArea = document.getElementById('game-area');

    if (gameIntro) gameIntro.style.display = 'none';
    if (gameEnd) gameEnd.style.display = 'none';
    if (gameArea) {
      gameArea.style.display = 'block';
      gameArea.innerHTML = `
        <div id="hud">
          <a href="/" id="back-btn">← 返回</a>
          <div id="score">💥 <span id="count">0</span> / <span id="total">${totalRumors}</span></div>
        </div>
      `;
    }

    // 依次生成热气球
    rumors.forEach((text, i) => {
      setTimeout(() => spawnBalloon(text, i), i * 600);
    });

    // 开始动画循环
    animateBalloons();
  }

  function spawnBalloon(text: string, index: number) {
    if (!gameArea) return;

    const balloon = document.createElement('div');
    balloon.className = `balloon color-${index % 7}`;
    balloon.innerHTML = `
      <div class="balloon-body">
        <span class="balloon-text">${text}</span>
      </div>
      <div class="balloon-rope"></div>
      <div class="balloon-basket"></div>
    `;

    // 随机水平位置
    const x = 50 + Math.random() * (window.innerWidth - 200);
    const y = window.innerHeight + 50; // 从屏幕底部开始
    // 随机停止高度 (在屏幕上半部分的某个位置)
    const minY = 80 + Math.random() * (window.innerHeight * 0.6);

    balloon.style.left = x + 'px';
    balloon.style.top = y + 'px';

    balloon.addEventListener('click', () => explodeBalloon(balloon, index));

    gameArea.appendChild(balloon);

    // 记录气球数据
    balloons.push({
      element: balloon,
      x: x,
      y: y,
      minY: minY, // 停止上升的位置
      speed: 0.3 + Math.random() * 0.3, // 更慢的上升速度
      sway: 15 + Math.random() * 20, // 左右摇摆幅度
      swayOffset: Math.random() * Math.PI * 2 // 摇摆相位
    });
  }

  function animateBalloons() {
    const time = Date.now() / 1000;

    balloons.forEach(b => {
      if (!b.element.classList.contains('exploding')) {
        // 只有还没到达目标高度时才上升
        if (b.y > b.minY) {
          b.y -= b.speed;
        }
        const swayX = Math.sin(time * 1.5 + b.swayOffset) * b.sway;
        b.element.style.left = (b.x + swayX) + 'px';
        b.element.style.top = b.y + 'px';
      }
    });

    animationId = requestAnimationFrame(animateBalloons);
  }

  function explodeBalloon(balloon: HTMLElement, index: number) {
    if (balloon.classList.contains('exploding')) return;

    createExplosion(balloon, index);
    balloon.classList.add('exploding');
    brokenCount++;

    const countEl = document.getElementById('count');
    if (countEl) countEl.textContent = brokenCount.toString();

    setTimeout(() => {
      balloon.remove();
      balloons = balloons.filter(b => b.element !== balloon);

      if (brokenCount >= totalRumors) {
        cancelAnimationFrame(animationId);
        endGame();
      }
    }, 400);
  }

  function createExplosion(balloon: HTMLElement, colorIndex: number) {
    const rect = balloon.getBoundingClientRect();
    const centerX = rect.left + rect.width / 2;
    const centerY = rect.top + 60;

    const colors = [
      ['#ff6b6b', '#c41e3a', '#ff8787'],
      ['#74b9ff', '#0984e3', '#a0d2ff'],
      ['#ffeaa7', '#fdcb6e', '#fff3b0'],
      ['#a29bfe', '#6c5ce7', '#c4bfff'],
      ['#55efc4', '#00b894', '#81fff0'],
      ['#fd79a8', '#e84393', '#ffb3d1'],
      ['#fab1a0', '#e17055', '#ffd0c4']
    ];
    const fragmentColors = colors[colorIndex % 7];

    // 爆炸闪光
    const flash = document.createElement('div');
    flash.className = 'explosion-flash';
    flash.style.left = (centerX - 60) + 'px';
    flash.style.top = (centerY - 60) + 'px';
    flash.style.width = '120px';
    flash.style.height = '120px';
    flash.style.background = `radial-gradient(circle, white 0%, ${fragmentColors[0]} 50%, transparent 70%)`;
    flash.style.opacity = '1';
    document.body.appendChild(flash);

    let flashOp = 1;
    let flashScale = 1;
    function animateFlash() {
      flashOp -= 0.1;
      flashScale += 0.3;
      flash.style.opacity = flashOp.toString();
      flash.style.transform = `scale(${flashScale})`;
      if (flashOp > 0) {
        requestAnimationFrame(animateFlash);
      } else {
        flash.remove();
      }
    }
    animateFlash();

    // 冲击波
    const shockwave = document.createElement('div');
    shockwave.className = 'shockwave';
    shockwave.style.left = (centerX - 10) + 'px';
    shockwave.style.top = (centerY - 10) + 'px';
    shockwave.style.width = '20px';
    shockwave.style.height = '20px';
    shockwave.style.borderColor = fragmentColors[0];
    document.body.appendChild(shockwave);

    let swScale = 1;
    let swOp = 1;
    function animateShockwave() {
      swScale += 0.8;
      swOp -= 0.05;
      shockwave.style.transform = `scale(${swScale})`;
      shockwave.style.opacity = swOp.toString();
      if (swOp > 0) {
        requestAnimationFrame(animateShockwave);
      } else {
        shockwave.remove();
      }
    }
    animateShockwave();

    // 爆炸文字
    const boomTexts = ['💥', '砰!', 'BOOM', '爆!'];
    const boomText = document.createElement('div');
    boomText.className = 'boom-text';
    boomText.textContent = boomTexts[Math.floor(Math.random() * boomTexts.length)];
    boomText.style.left = centerX + 'px';
    boomText.style.top = centerY + 'px';
    boomText.style.color = fragmentColors[0];
    document.body.appendChild(boomText);

    let btOp = 1;
    let btY = centerY;
    let btScale = 0.5;
    function animateBoomText() {
      btOp -= 0.04;
      btY -= 3;
      btScale = Math.min(btScale + 0.15, 1.5);
      boomText.style.opacity = btOp.toString();
      boomText.style.top = btY + 'px';
      boomText.style.transform = `translate(-50%, -50%) scale(${btScale})`;
      if (btOp > 0) {
        requestAnimationFrame(animateBoomText);
      } else {
        boomText.remove();
      }
    }
    animateBoomText();

    // 创建更多碎片
    for (let i = 0; i < 25; i++) {
      const fragment = document.createElement('div');
      fragment.className = 'fragment';

      const size = 5 + Math.random() * 18;
      const isRound = Math.random() > 0.4;

      fragment.style.width = size + 'px';
      fragment.style.height = size + 'px';
      fragment.style.background = fragmentColors[Math.floor(Math.random() * fragmentColors.length)];
      fragment.style.borderRadius = isRound ? '50%' : (Math.random() * 8) + 'px';
      fragment.style.left = centerX + 'px';
      fragment.style.top = centerY + 'px';
      fragment.style.boxShadow = `0 0 ${size}px ${fragmentColors[0]}`;

      document.body.appendChild(fragment);

      const angle = Math.random() * Math.PI * 2;
      const velocity = 8 + Math.random() * 15;
      const vx = Math.cos(angle) * velocity;
      const vy = Math.sin(angle) * velocity - 5;
      const gravity = 0.4;
      const rotation = Math.random() * 1080 - 540;

      let px = centerX;
      let py = centerY;
      let vyNow = vy;
      let opacity = 1;
      let rot = 0;

      function animateFragment() {
        px += vx;
        vyNow += gravity;
        py += vyNow;
        opacity -= 0.025;
        rot += rotation / 40;

        fragment.style.left = px + 'px';
        fragment.style.top = py + 'px';
        fragment.style.opacity = opacity.toString();
        fragment.style.transform = `rotate(${rot}deg)`;

        if (opacity > 0) {
          requestAnimationFrame(animateFragment);
        } else {
          fragment.remove();
        }
      }
      animateFragment();
    }

    // 更多火花
    for (let i = 0; i < 16; i++) {
      const spark = document.createElement('div');
      spark.className = 'fragment';
      const sparkSize = 3 + Math.random() * 4;
      spark.style.width = sparkSize + 'px';
      spark.style.height = sparkSize + 'px';
      spark.style.background = i % 2 === 0 ? '#fff' : '#ffd700';
      spark.style.borderRadius = '50%';
      spark.style.left = centerX + 'px';
      spark.style.top = centerY + 'px';
      spark.style.boxShadow = `0 0 ${sparkSize * 2}px #fff, 0 0 ${sparkSize * 4}px #ffd700`;

      document.body.appendChild(spark);

      const angle = (Math.PI * 2 * i) / 16 + Math.random() * 0.3;
      const velocity = 10 + Math.random() * 8;
      let px = centerX;
      let py = centerY;
      let opacity = 1;
      let vx = Math.cos(angle) * velocity;
      let vy = Math.sin(angle) * velocity;

      function animateSpark() {
        px += vx;
        py += vy;
        vy += 0.2; // 轻微重力
        vx *= 0.98; // 阻力
        opacity -= 0.05;

        spark.style.left = px + 'px';
        spark.style.top = py + 'px';
        spark.style.opacity = opacity.toString();

        if (opacity > 0) {
          requestAnimationFrame(animateSpark);
        } else {
          spark.remove();
        }
      }
      animateSpark();
    }

    // 烟雾效果
    for (let i = 0; i < 5; i++) {
      const smoke = document.createElement('div');
      smoke.className = 'fragment';
      smoke.style.width = '30px';
      smoke.style.height = '30px';
      smoke.style.background = 'radial-gradient(circle, rgba(100,100,100,0.6) 0%, transparent 70%)';
      smoke.style.borderRadius = '50%';
      smoke.style.left = (centerX - 15 + (Math.random() - 0.5) * 40) + 'px';
      smoke.style.top = (centerY - 15 + (Math.random() - 0.5) * 40) + 'px';

      document.body.appendChild(smoke);

      let smokeOp = 0.6;
      let smokeScale = 1;
      let smokeY = parseFloat(smoke.style.top);

      function animateSmoke() {
        smokeOp -= 0.015;
        smokeScale += 0.05;
        smokeY -= 1;
        smoke.style.opacity = smokeOp.toString();
        smoke.style.transform = `scale(${smokeScale})`;
        smoke.style.top = smokeY + 'px';

        if (smokeOp > 0) {
          requestAnimationFrame(animateSmoke);
        } else {
          smoke.remove();
        }
      }
      animateSmoke();
    }
  }

  function endGame() {
    setTimeout(() => {
      if (gameArea) gameArea.style.display = 'none';
      if (gameEnd) gameEnd.style.display = 'flex';
    }, 500);
  }

  startBtn?.addEventListener('click', startGame);
  replayBtn?.addEventListener('click', startGame);
</script>
