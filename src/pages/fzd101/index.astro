---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title="FZD 101 - Your Guide to Fan Zhendong">
  <section class="hero">
    <div class="hero-badge">📚 For International Fans</div>
    <h1>FZD 101</h1>
    <p class="subtitle">Everything you need to know about Fan Zhendong — the name, the nicknames, and the person behind the legend.</p>
  </section>

  <!-- 1. How to Pronounce -->
  <section class="section pronunciation" id="pronunciation">
    <h2>🔊 How to Pronounce His Name</h2>
    <p class="intro-text">Many international fans are unsure how to pronounce "Fan Zhendong". Here's how it sounds in Mandarin Chinese.</p>
    
    <div class="pronunciation-card">
      <div class="name-display">
        <span class="chinese">樊振东</span>
        <span class="pinyin">Fán Zhèndōng</span>
      </div>
      
      <div class="audio-buttons">
        <button class="audio-btn" id="playNormal">
          <span class="btn-icon">🔊</span>
          <span class="btn-text">Standard Speed</span>
        </button>
        <button class="audio-btn slow" id="playSlow">
          <span class="btn-icon">🐢</span>
          <span class="btn-text">Slow Version</span>
        </button>
      </div>

      <div class="breakdown">
        <h3>Syllable Breakdown</h3>
        <div class="syllables">
          <div class="syllable">
            <span class="char">Fan</span>
            <span class="sound">/fɑn/</span>
            <span class="hint">Like "fun" but with "ah"</span>
          </div>
          <div class="syllable">
            <span class="char">Zhen</span>
            <span class="sound">/ʈʂən/</span>
            <span class="hint">Like "jun" with a "zh" sound</span>
          </div>
          <div class="syllable">
            <span class="char">Dong</span>
            <span class="sound">/tʊŋ/</span>
            <span class="hint">Like "dong" in "ding-dong"</span>
          </div>
        </div>
      </div>

      <div class="ipa-box">
        <span class="ipa-label">IPA (Advanced):</span>
        <code>/fɑn ʈʂən tʊŋ/</code>
      </div>
    </div>

    <div class="culture-card">
      <span class="culture-icon">🇨🇳</span>
      <p><strong>Cultural Note:</strong> In Chinese culture, the family name "Fan" (樊) comes first. So "Fan Zhendong" means "Zhendong of the Fan family".</p>
    </div>
  </section>

  <!-- 2. Name Meaning -->
  <section class="section meaning" id="meaning">
    <h2>✨ What His Name Means</h2>
    <p class="intro-text">Chinese names carry deep meaning. Let's decode "Zhendong".</p>

    <div class="meaning-cards">
      <div class="meaning-card">
        <span class="hanzi">振</span>
        <span class="pinyin-small">Zhèn</span>
        <p class="meaning-text">To rise, to inspire, to energize</p>
        <p class="meaning-example">"振奋" (zhènfèn) = to inspire/invigorate</p>
      </div>
      <div class="meaning-card">
        <span class="hanzi">东</span>
        <span class="pinyin-small">Dōng</span>
        <p class="meaning-text">East, sunrise, new beginnings</p>
        <p class="meaning-example">"东方" (dōngfāng) = the East</p>
      </div>
    </div>

    <div class="interpretation-box">
      <p class="interpretation">Together, <strong>"Zhendong" (振东)</strong> can be interpreted as <em>"revitalizing the East"</em> — a name full of strength and hope.</p>
      <p class="poetic">A name that carries the weight of rising suns and boundless potential.</p>
    </div>
  </section>

  <!-- 3. Nicknames -->
  <section class="section nicknames" id="nicknames">
    <h2>💕 Nicknames Fans Use</h2>
    <p class="intro-text">In Chinese fan culture, nicknames often express closeness rather than ridicule. Here are the most beloved ones:</p>

    <div class="nickname-grid">
      <!-- Xiao Pang -->
      <div class="nickname-card featured">
        <div class="nickname-header">
          <span class="nickname-chinese">小胖</span>
          <span class="nickname-pinyin">Xiǎo Pàng</span>
        </div>
        <span class="nickname-english">"Little Fatty"</span>
        <div class="nickname-explanation">
          <p class="warning-box">
            <span class="warning-icon">⚠️</span>
            <strong>The "Xiao Pang" Dilemma:</strong> This might sound offensive in English, but it's actually a term of endearment!
          </p>
          <p>In Chinese culture, calling someone "Little Fatty" is affectionate, not body shaming. It represents:</p>
          <ul>
            <li>Being cute and cherubic</li>
            <li>Looking well-fed and healthy</li>
            <li>His adorable round face when he was younger</li>
          </ul>
          <p class="love-note">It's how fans express their love for his cute appearance! 🥰</p>
        </div>
      </div>

      <!-- Dong Ge -->
      <div class="nickname-card">
        <div class="nickname-header">
          <span class="nickname-chinese">东哥</span>
          <span class="nickname-pinyin">Dōng Gē</span>
        </div>
        <span class="nickname-english">"Brother Dong"</span>
        <p class="nickname-desc">A respectful yet familiar way to address him, showing admiration while maintaining closeness.</p>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <p>Now you know the basics! Ready to explore more?</p>
    <div class="cta-buttons">
      <a href={getLocalizedPath('/stars', lang)} class="cta-btn">⭐ Explore Starry Sky</a>
      <a href={getLocalizedPath('/arena', lang)} class="cta-btn secondary">🏆 View Career</a>
    </div>
  </section>

  <audio id="audioNormal" src="/audio/fan-zhen-dong-pronouncition.wav" preload="auto"></audio>
</BaseLayout>


<style>
  .hero {
    text-align: center;
    padding: 4rem 1rem 3rem;
    background: linear-gradient(135deg, #e8f4f8 0%, #fff 100%);
    border-radius: 0 0 2rem 2rem;
  }
  .hero-badge {
    display: inline-block;
    background: #2563eb;
    color: #fff;
    padding: 0.4rem 1rem;
    border-radius: 2rem;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }
  .hero h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, #2563eb, #1e40af);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .subtitle {
    color: #555;
    max-width: 600px;
    margin: 0 auto;
    font-size: 1.1rem;
  }

  .section {
    padding: 3rem 1rem;
    max-width: 900px;
    margin: 0 auto;
  }
  .section h2 {
    font-size: 1.8rem;
    margin-bottom: 1rem;
    color: #1e293b;
  }
  .intro-text {
    color: #64748b;
    margin-bottom: 2rem;
    font-size: 1.05rem;
  }

  /* Pronunciation Section */
  .pronunciation-card {
    background: #fff;
    border-radius: 1rem;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    margin-bottom: 1.5rem;
  }
  .name-display {
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .chinese {
    display: block;
    font-size: 3rem;
    font-weight: bold;
    color: #c41e3a;
    margin-bottom: 0.5rem;
  }
  .pinyin {
    font-size: 1.5rem;
    color: #64748b;
  }
  .audio-buttons {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .audio-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.5rem;
    border: none;
    border-radius: 2rem;
    background: #c41e3a;
    color: #fff;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .audio-btn:hover {
    transform: scale(1.05);
    box-shadow: 0 4px 12px rgba(196, 30, 58, 0.3);
  }
  .audio-btn.slow {
    background: #64748b;
  }
  .audio-btn.slow:hover {
    box-shadow: 0 4px 12px rgba(100, 116, 139, 0.3);
  }
  .btn-icon {
    font-size: 1.2rem;
  }
  .breakdown h3 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
    color: #475569;
  }
  .syllables {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .syllable {
    text-align: center;
    padding: 1rem;
    background: #f8fafc;
    border-radius: 0.5rem;
  }
  .syllable .char {
    display: block;
    font-size: 1.5rem;
    font-weight: bold;
    color: #c41e3a;
  }
  .syllable .sound {
    display: block;
    font-family: monospace;
    color: #64748b;
    margin: 0.3rem 0;
  }
  .syllable .hint {
    font-size: 0.85rem;
    color: #94a3b8;
  }
  .ipa-box {
    margin-top: 1.5rem;
    padding: 1rem;
    background: #f1f5f9;
    border-radius: 0.5rem;
    text-align: center;
  }
  .ipa-label {
    color: #64748b;
    margin-right: 0.5rem;
  }
  .ipa-box code {
    font-size: 1.2rem;
    color: #1e293b;
  }
  .culture-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem;
    background: linear-gradient(135deg, #fef3c7, #fef9c3);
    border-radius: 1rem;
    border-left: 4px solid #f59e0b;
  }
  .culture-icon {
    font-size: 2rem;
  }
  .culture-card p {
    margin: 0;
    color: #78350f;
  }

  /* Meaning Section */
  .meaning-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .meaning-card {
    background: #fff;
    border-radius: 1rem;
    padding: 2rem;
    text-align: center;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }
  .hanzi {
    display: block;
    font-size: 4rem;
    color: #c41e3a;
    margin-bottom: 0.5rem;
  }
  .pinyin-small {
    display: block;
    font-size: 1.2rem;
    color: #64748b;
    margin-bottom: 1rem;
  }
  .meaning-text {
    font-size: 1.1rem;
    color: #1e293b;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }
  .meaning-example {
    font-size: 0.9rem;
    color: #94a3b8;
  }
  .interpretation-box {
    background: linear-gradient(135deg, #fdf2f8, #fce7f3);
    border-radius: 1rem;
    padding: 2rem;
    text-align: center;
  }
  .interpretation {
    font-size: 1.2rem;
    color: #831843;
    margin-bottom: 0.5rem;
  }
  .poetic {
    font-style: italic;
    color: #9d174d;
  }

  /* Nicknames Section */
  .nickname-grid {
    display: grid;
    gap: 1.5rem;
  }
  .nickname-card {
    background: #fff;
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }
  .nickname-card.featured {
    border: 2px solid #c41e3a;
    background: linear-gradient(135deg, #fff5f5, #fff);
  }
  .nickname-card.international {
    border: 2px solid #2563eb;
    background: linear-gradient(135deg, #eff6ff, #fff);
  }
  .nickname-header {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    margin-bottom: 0.5rem;
  }
  .nickname-chinese {
    font-size: 1.8rem;
    font-weight: bold;
    color: #c41e3a;
  }
  .nickname-pinyin {
    font-size: 1rem;
    color: #64748b;
  }
  .nickname-english, .nickname-english-main {
    display: block;
    font-size: 1.1rem;
    color: #475569;
    margin-bottom: 1rem;
  }
  .nickname-english-main {
    font-size: 1.5rem;
    font-weight: bold;
    color: #2563eb;
  }
  .nickname-origin {
    font-size: 0.85rem;
    background: #dbeafe;
    color: #1e40af;
    padding: 0.2rem 0.6rem;
    border-radius: 1rem;
    margin-left: auto;
  }
  .nickname-explanation {
    color: #475569;
    line-height: 1.6;
  }
  .nickname-explanation ul {
    margin: 0.5rem 0;
    padding-left: 1.5rem;
  }
  .warning-box {
    background: #fef3c7;
    border-radius: 0.5rem;
    padding: 1rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .warning-icon {
    font-size: 1.2rem;
  }
  .love-note {
    color: #c41e3a;
    font-weight: 500;
  }
  .tagline {
    font-weight: bold;
    color: #1e40af;
  }
  .nickname-desc {
    color: #64748b;
    margin: 0;
  }

  /* Personality Section */
  .subtitle-personality {
    font-style: italic;
    text-align: center;
  }
  .comparison-container {
    display: flex;
    gap: 1rem;
    align-items: stretch;
    margin-bottom: 2rem;
  }
  .comparison-card {
    flex: 1;
    background: #fff;
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }
  .comparison-card.on-court {
    border-top: 4px solid #ef4444;
  }
  .comparison-card.off-court {
    border-top: 4px solid #3b82f6;
  }
  .comparison-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .comparison-header h3 {
    margin: 0;
    font-size: 1.2rem;
  }
  .comparison-icon {
    font-size: 1.5rem;
  }
  .comparison-image {
    margin-bottom: 1rem;
  }
  .placeholder-img {
    height: 120px;
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
  }
  .placeholder-img.fierce {
    background: linear-gradient(135deg, #fecaca, #fee2e2);
  }
  .placeholder-img.gentle {
    background: linear-gradient(135deg, #bfdbfe, #dbeafe);
  }
  .keywords {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .keyword {
    background: #f1f5f9;
    color: #475569;
    padding: 0.3rem 0.8rem;
    border-radius: 1rem;
    font-size: 0.85rem;
    font-weight: 500;
  }
  .on-court .keyword {
    background: #fee2e2;
    color: #991b1b;
  }
  .off-court .keyword {
    background: #dbeafe;
    color: #1e40af;
  }
  .comparison-desc {
    color: #64748b;
    font-size: 0.95rem;
    margin: 0;
  }
  .vs-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.5rem;
  }
  .vs-divider span {
    background: #e2e8f0;
    color: #64748b;
    padding: 0.5rem 1rem;
    border-radius: 1rem;
    font-weight: bold;
  }
  .personality-traits {
    background: #f8fafc;
    border-radius: 1rem;
    padding: 1.5rem;
  }
  .personality-traits h3 {
    margin-bottom: 1rem;
    color: #1e293b;
  }
  .traits-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.8rem;
  }
  .traits-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #475569;
  }
  .trait-icon {
    font-size: 1.2rem;
  }

  /* CTA Section */
  .cta-section {
    text-align: center;
    padding: 3rem 1rem;
    background: linear-gradient(135deg, #f8fafc, #f1f5f9);
  }
  .cta-section p {
    font-size: 1.2rem;
    color: #475569;
    margin-bottom: 1.5rem;
  }
  .cta-buttons {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .cta-btn {
    display: inline-block;
    padding: 0.8rem 1.5rem;
    border-radius: 2rem;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s;
    background: #c41e3a;
    color: #fff;
  }
  .cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(196, 30, 58, 0.3);
  }
  .cta-btn.secondary {
    background: #fff;
    color: #c41e3a;
    border: 2px solid #c41e3a;
  }
  .cta-btn.secondary:hover {
    background: #fff5f5;
  }

  @media (max-width: 768px) {
    .hero h1 { font-size: 2.5rem; }
    .syllables { grid-template-columns: 1fr; }
    .meaning-cards { grid-template-columns: 1fr; }
    .comparison-container { flex-direction: column; }
    .vs-divider { padding: 0.5rem 0; }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    const audioNormal = document.getElementById('audioNormal');
    const playNormal = document.getElementById('playNormal');
    const playSlow = document.getElementById('playSlow');

    playNormal?.addEventListener('click', function() {
      if (audioNormal) {
        audioNormal.playbackRate = 1.0;
        audioNormal.currentTime = 0;
        audioNormal.play();
      }
    });

    playSlow?.addEventListener('click', function() {
      if (audioNormal) {
        audioNormal.playbackRate = 0.6;
        audioNormal.currentTime = 0;
        audioNormal.play();
      }
    });
  });
</script>
