---
import BaseLayout from '../layouts/BaseLayout.astro';
import DongdokuGame from '../components/dongdoku/DongdokuGame.astro';
---

<BaseLayout 
  title="找咚 (Dongdoku) - 樊振东主题数独解谜小游戏"
  description="经典彩色领地皇后数独游戏！每个领地找出一个咚，行与列各一个，咚咚互不相碰。挑战全网1000+关卡！"
>
  <div class="dongdoku-page-wrap">
    <DongdokuGame lang="zh" />
  </div>
</BaseLayout>

<style>
  .dongdoku-page-wrap {
    min-height: 80vh;
    padding: 0.5rem 0.5rem 1.5rem;
    display: flex;
    justify-content: center;
  }
</style>
