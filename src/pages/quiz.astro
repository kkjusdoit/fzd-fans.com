---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="球迷等级考试">
  <div id="quiz-container">
    <div id="quiz-intro">
      <h1>🏓 球迷等级考试</h1>
      <p>测测你对樊振东了解多少？</p>
      <p class="hint">共10道题，包含选择题和判断题</p>
      <div class="copyright" style="margin-bottom: 2rem; font-size: 0.9rem; color: #888;">
        Caesar Fan 问答游戏 by <a href="https://weibo.com/baiduFZDbar" target="_blank" rel="noopener noreferrer" style="color: #1e88e5; text-decoration: none;">球迷会-天际樊星</a>
      </div>
      <button id="start-btn">开始答题</button>
    </div>
    
    <div id="quiz-area" style="display: none;">
      <div class="quiz-status-bar">
        <div id="progress">
          <span id="current-q">1</span> / <span id="total-q">29</span>
        </div>
        <button id="peek-btn">
          👀 偷瞄一下 (<span id="peek-count">1</span>)
        </button>
      </div>
      <div id="question-card">
        <div id="question-type"></div>
        <h2 id="question-text"></h2>
        <div id="options"></div>
        
        <div id="explanation-box" style="display: none; margin-top: 1.5rem; padding: 1rem; background: #e3f2fd; border-radius: 8px; border-left: 4px solid #1e88e5;">
          <h3 style="margin: 0 0 0.5rem 0; font-size: 1rem; color: #1e88e5;">💡 答案解析</h3>
          <p id="explanation-text" style="margin: 0; color: #555; font-size: 0.95rem; line-height: 1.5;"></p>
        </div>

        <button id="next-btn" style="display: none; margin-top: 1.5rem; width: 100%; padding: 1rem; background: #1e88e5; color: white; border: none; border-radius: 10px; font-size: 1.1rem; cursor: pointer;">
          下一题 →
        </button>
      </div>
    </div>
    
    <div id="quiz-result" style="display: none;">
      <div class="result-card">
        <div id="score-display"></div>
        <div id="rank-display"></div>
        <div id="surpassed-display" style="color: #666; margin-bottom: 1rem; font-size: 1.1rem;"></div>
        <div id="rank-desc"></div>
        <div id="wrong-answers"></div>
        <button id="retry-btn">再考一次</button>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  #quiz-container {
    max-width: 700px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  #quiz-intro {
    text-align: center;
    padding: 4rem 0;
  }
  #quiz-intro h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: #1e88e5;
  }
  #quiz-intro p {
    color: #666;
    margin-bottom: 0.5rem;
  }
  #quiz-intro .hint {
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }
  #start-btn, #retry-btn {
    background: linear-gradient(45deg, #1e88e5, #42a5f5);
    color: white;
    border: none;
    padding: 1rem 2.5rem;
    font-size: 1.2rem;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 4px 15px rgba(30, 136, 229, 0.3);
  }
  #start-btn:hover, #retry-btn:hover {
    transform: scale(1.05);
    box-shadow: 0 6px 20px rgba(30, 136, 229, 0.4);
  }
  
  .quiz-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    padding: 0 0.5rem;
  }
  
  #progress {
    font-size: 1.1rem;
    color: #888;
    margin-bottom: 0;
  }
  
  #peek-btn {
    background: #ff9f43;
    color: white;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    cursor: pointer;
    font-size: 0.9rem;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  
  #peek-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(255, 159, 67, 0.3);
  }
  
  #peek-btn:disabled {
    background: #ccc;
    cursor: not-allowed;
    transform: none;
  }

  #question-card {
    background: #fff;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }
  #question-type {
    display: inline-block;
    background: #f0f0f0;
    color: #666;
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }
  #question-text {
    font-size: 1.3rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    color: #333;
  }
  #options {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .option-btn {
    background: #f8f8f8;
    border: 2px solid #eee;
    padding: 1rem 1.2rem;
    border-radius: 10px;
    font-size: 1rem;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s;
  }
  .option-btn:hover {
    border-color: #1e88e5;
    background: #e3f2fd;
  }
  .option-btn.selected {
    border-color: #1e88e5;
    background: #fff0f0;
  }
  .option-btn.correct {
    border-color: #2ed573;
    background: #e8fff0;
  }
  .option-btn.wrong {
    border-color: #ff4757;
    background: #fff0f0;
  }
  
  .option-btn.peek-highlight {
    border-color: #ff9f43;
    background: #fff8e1;
    position: relative;
  }
  
  .option-btn.peek-highlight::after {
    content: '👈 偷偷告诉你';
    position: absolute;
    right: 1rem;
    color: #ff9f43;
    font-size: 0.8rem;
  }
  
  #quiz-result {
    padding: 3rem 0;
  }
  .result-card {
    background: #fff;
    border-radius: 16px;
    padding: 2.5rem;
    text-align: center;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  }
  #score-display {
    font-size: 3rem;
    font-weight: bold;
    color: #1e88e5;
    margin-bottom: 0.5rem;
  }
  #rank-display {
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
  }
  #rank-desc {
    color: #666;
    margin-bottom: 2rem;
  }
  #wrong-answers {
    text-align: left;
    margin: 2rem 0;
    padding: 1.5rem;
    background: #fafafa;
    border-radius: 12px;
  }
  #wrong-answers h3 {
    color: #1e88e5;
    margin-bottom: 1rem;
    font-size: 1.1rem;
  }
  .wrong-item {
    margin-bottom: 1.2rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid #eee;
  }
  .wrong-item:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }
  .wrong-item .q {
    font-weight: 500;
    margin-bottom: 0.4rem;
  }
  .wrong-item .your-answer {
    color: #ff4757;
    font-size: 0.9rem;
  }
  .wrong-item .correct-answer {
    color: #2ed573;
    font-size: 0.9rem;
  }
</style>

<script>
