  const ranks = [
    { min: 0, max: 2, title: '🌱 路人粉', desc: '刚开始了解小胖，继续加油！' },
    { min: 3, max: 5, title: '⭐ 普通球迷', desc: '有一定了解，但还需要多看比赛哦~' },
    { min: 6, max: 7, title: '🌟 资深球迷', desc: '不错不错，对小胖很熟悉了！' },
    { min: 8, max: 9, title: '💫 大满贯球迷', desc: '厉害！你是真正的樊星！' },
    { min: 10, max: 10, title: '🏆 超级金满贯球迷', desc: '满分！你比小胖还了解小胖！' }
  ];

  let currentIndex = 0;
  let score = 0;
  let peekCount = 1;
  let userAnswers: number[] = [];
  let shuffledQuestions: Question[] = [];

  const startBtn = document.getElementById('start-btn');
  const retryBtn = document.getElementById('retry-btn');
  const peekBtn = document.getElementById('peek-btn');
  const peekCountSpan = document.getElementById('peek-count');
  const quizIntro = document.getElementById('quiz-intro');
  const quizArea = document.getElementById('quiz-area');
  const quizResult = document.getElementById('quiz-result');

  function shuffle<T>(array: T[]): T[] {
    const arr = [...array];
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  function startQuiz() {
    currentIndex = 0;
    score = 0;
    peekCount = 1;
    userAnswers = [];
    // 随机抽选10道题
    shuffledQuestions = shuffle(questions).slice(0, 10);
    
    if (quizIntro) quizIntro.style.display = 'none';
    if (quizResult) quizResult.style.display = 'none';
    if (quizArea) quizArea.style.display = 'block';
    
    // 更新总题数显示
    const totalQ = document.getElementById('total-q');
    if (totalQ) totalQ.textContent = shuffledQuestions.length.toString();
    
    if (peekCountSpan) peekCountSpan.textContent = peekCount.toString();
    if (peekBtn) (peekBtn as HTMLButtonElement).disabled = false;

    showQuestion();
  }

  function showQuestion() {
    const q = shuffledQuestions[currentIndex];
    const currentQ = document.getElementById('current-q');
    const questionType = document.getElementById('question-type');
    const questionText = document.getElementById('question-text');
    const optionsDiv = document.getElementById('options');
    const explanationBox = document.getElementById('explanation-box');
    const nextBtn = document.getElementById('next-btn');
    
    // 重置状态
    if (explanationBox) explanationBox.style.display = 'none';
    if (nextBtn) nextBtn.style.display = 'none';

    if (currentQ) currentQ.textContent = (currentIndex + 1).toString();
    if (questionType) {
        if (q.type === 'choice') questionType.textContent = '单选题';
        else if (q.type === 'truefalse') questionType.textContent = '判断题';
        else if (q.type === 'multi') questionType.textContent = '多选题';
        else if (q.type === 'fill') questionType.textContent = '填空题';
    }
    if (questionText) questionText.textContent = q.question;
    
    if (optionsDiv) {
      optionsDiv.innerHTML = '';
      if (q.type === 'fill') {
        const input = document.createElement('input');
        input.type = 'text';
        input.placeholder = '请输入答案...';
        input.className = 'fill-input';
        input.style.width = '100%';
        input.style.padding = '1rem';
        input.style.marginBottom = '1rem';
        input.style.border = '2px solid #eee';
        input.style.borderRadius = '10px';
        input.style.fontSize = '1rem';
        
        const submitBtn = document.createElement('button');
        submitBtn.className = 'option-btn';
        submitBtn.textContent = '提交答案';
        submitBtn.style.textAlign = 'center';
        submitBtn.style.background = '#1e88e5';
        submitBtn.style.color = 'white';
        submitBtn.onclick = () => {
            const val = input.value.trim();
            if (!val) return;
            
            // 简单的填空检查：包含关键词即算对
            const correctKey = String(q.answer);
            const isCorrect = val.includes(correctKey);
            
            if (isCorrect) {
                input.style.borderColor = '#2ed573';
                input.style.background = '#e8fff0';
                score++;
            } else {
                input.style.borderColor = '#ff4757';
                input.style.background = '#fff0f0';
            }
            
            input.disabled = true;
            submitBtn.disabled = true;
            userAnswers.push(isCorrect ? 1 : 0); // 1 for correct, 0 for wrong (simplified for fill)
            
            showExplanation(q);
            
            if (nextBtn) {
                nextBtn.style.display = 'block';
                nextBtn.textContent = currentIndex === shuffledQuestions.length - 1 ? '查看结果' : '下一题 →';
                nextBtn.onclick = () => {
                    currentIndex++;
                    if (currentIndex < shuffledQuestions.length) {
                        showQuestion();
                    } else {
                        showResult();
                    }
                };
            }
        };
        
        optionsDiv.appendChild(input);
        optionsDiv.appendChild(submitBtn);
      } else if (q.type === 'multi') {
          // 多选题逻辑
          const confirmBtn = document.createElement('button');
          confirmBtn.className = 'option-btn';
          confirmBtn.textContent = '确认选择';
          confirmBtn.style.marginTop = '1rem';
          confirmBtn.style.textAlign = 'center';
          confirmBtn.style.background = '#1e88e5';
          confirmBtn.style.color = 'white';
          confirmBtn.style.display = 'none'; // 初始隐藏，选了才显示
          
          let selectedIndices: number[] = [];
          
          q.options?.forEach((opt, i) => {
            const btn = document.createElement('button');
            btn.className = 'option-btn';
            btn.textContent = opt;
            btn.onclick = () => {
                if (btn.classList.contains('selected')) {
                    btn.classList.remove('selected');
                    selectedIndices = selectedIndices.filter(idx => idx !== i);
                } else {
                    btn.classList.add('selected');
                    selectedIndices.push(i);
                }
                confirmBtn.style.display = selectedIndices.length > 0 ? 'block' : 'none';
            };
            optionsDiv.appendChild(btn);
          });
          
          confirmBtn.onclick = () => {
              const correctAnswers = q.answer as number[];
              const buttons = optionsDiv ? optionsDiv.querySelectorAll('.option-btn') : document.querySelectorAll('.option-btn');
              
              // 排序比较
              selectedIndices.sort();
              const correctSorted = [...correctAnswers].sort();
              const isCorrect = JSON.stringify(selectedIndices) === JSON.stringify(correctSorted);
              
              buttons.forEach((btn, i) => {
                  // 跳过确认按钮
                  if (btn === confirmBtn) return;
                  
                  (btn as HTMLButtonElement).disabled = true;
                  if (correctAnswers.includes(i)) {
                      btn.classList.add('correct');
                  } else if (selectedIndices.includes(i)) {
                      btn.classList.add('wrong');
                  }
              });
              
              confirmBtn.disabled = true;
              confirmBtn.textContent = '已确认';
              if (isCorrect) score++;
              userAnswers.push(isCorrect ? 1 : 0); // 简化记录
              
              showExplanation(q);
              
              if (nextBtn) {
                nextBtn.style.display = 'block';
                nextBtn.textContent = currentIndex === shuffledQuestions.length - 1 ? '查看结果' : '下一题 →';
                nextBtn.onclick = () => {
                    currentIndex++;
                    if (currentIndex < shuffledQuestions.length) {
                        showQuestion();
                    } else {
                        showResult();
                    }
                };
            }
          };
          
          optionsDiv.appendChild(confirmBtn);
      } else {
        // 单选和判断
        q.options?.forEach((opt, i) => {
            const btn = document.createElement('button');
            btn.className = 'option-btn';
            btn.textContent = opt;
            btn.addEventListener('click', () => {
                selectAnswer(i);
                if (nextBtn) {
                    nextBtn.style.display = 'block';
                    nextBtn.textContent = currentIndex === shuffledQuestions.length - 1 ? '查看结果' : '下一题 →';
                    nextBtn.onclick = () => {
                        currentIndex++;
                        if (currentIndex < shuffledQuestions.length) {
                            showQuestion();
                        } else {
                            showResult();
                        }
                    };
                }
            });
            optionsDiv.appendChild(btn);
        });
      }
    }

    if (peekBtn) {
      (peekBtn as HTMLButtonElement).disabled = peekCount <= 0;
    }
  }

  function peekAnswer() {
    if (peekCount <= 0) return;
    
    const q = shuffledQuestions[currentIndex];
    const buttons = document.querySelectorAll('.option-btn');
    
    // 偷瞄逻辑适配
    if (q.type === 'fill') {
        const input = document.querySelector('.fill-input') as HTMLInputElement;
        if (input) {
            input.value = String(q.answer); // 直接填入部分答案
            input.style.border = '2px solid #ff9f43';
        }
    } else if (q.type === 'multi') {
        const correctAnswers = q.answer as number[];
        buttons.forEach((btn, i) => {
            if (correctAnswers.includes(i)) {
                btn.classList.add('peek-highlight');
            }
        });
    } else {
        // 单选/判断
        const ans = q.answer as number;
        if (buttons[ans]) {
            buttons[ans].classList.add('peek-highlight');
        }
    }
    
    // 偷瞄时显示解析
    showExplanation(q);

    peekCount--;
    if (peekCountSpan) peekCountSpan.textContent = peekCount.toString();
    if (peekBtn && peekCount <= 0) {
      (peekBtn as HTMLButtonElement).disabled = true;
    }
  }

  function showExplanation(q: Question) {
    const explanationBox = document.getElementById('explanation-box');
    const explanationText = document.getElementById('explanation-text');
    
    if (explanationBox && explanationText) {
      if (q.explanation) {
        explanationBox.style.display = 'block';
        explanationText.textContent = q.explanation;
      } else {
        explanationBox.style.display = 'none';
      }
    }
  }

  function selectAnswer(index: number) {
    const q = shuffledQuestions[currentIndex];
    const buttons = document.querySelectorAll('.option-btn');
    const nextBtn = document.getElementById('next-btn');
    
    // 禁用所有按钮
    buttons.forEach((btn, i) => {
      (btn as HTMLButtonElement).disabled = true;
      if (i === q.answer) {
        btn.classList.add('correct');
        btn.classList.remove('peek-highlight'); // 移除偷瞄高亮，显示正式结果
      } else if (i === index && index !== q.answer) {
        btn.classList.add('wrong');
      }
    });
    
    if (peekBtn) (peekBtn as HTMLButtonElement).disabled = true;

    // 显示解析
    showExplanation(q);

    userAnswers.push(index);
    if (index === q.answer) {
      score++;
    }
    
    // 显示下一题按钮，不再自动跳转
    if (nextBtn) {
      nextBtn.style.display = 'block';
      nextBtn.textContent = currentIndex === shuffledQuestions.length - 1 ? '查看结果' : '下一题 →';
      nextBtn.onclick = () => {
        currentIndex++;
        if (currentIndex < shuffledQuestions.length) {
          showQuestion();
        } else {
          showResult();
        }
      };
    }
  }

  function showResult() {
    if (quizArea) quizArea.style.display = 'none';
    if (quizResult) quizResult.style.display = 'block';
    
    const scoreDisplay = document.getElementById('score-display');
    const rankDisplay = document.getElementById('rank-display');
    const surpassedDisplay = document.getElementById('surpassed-display');
    const rankDesc = document.getElementById('rank-desc');
    const wrongAnswers = document.getElementById('wrong-answers');
    
    if (scoreDisplay) scoreDisplay.textContent = `${score} / ${shuffledQuestions.length}`;
    
    const rank = ranks.find(r => score >= r.min && score <= r.max);
    if (rank && rankDisplay) rankDisplay.textContent = rank.title;
    if (rank && rankDesc) rankDesc.textContent = rank.desc;

    if (surpassedDisplay) {
      let surpassed = 0;
      if (score === shuffledQuestions.length) {
        surpassed = 99.9;
      } else if (score >= shuffledQuestions.length * 0.9) {
        surpassed = 95 + Math.random() * 4;
      } else if (score >= shuffledQuestions.length * 0.6) {
        surpassed = 60 + (score / shuffledQuestions.length) * 30 + Math.random() * 5;
      } else {
        surpassed = (score / shuffledQuestions.length) * 50 + Math.random() * 10;
      }
      surpassedDisplay.textContent = `击败了全国 ${surpassed.toFixed(1)}% 的樊振东粉丝！`;
    }
    
    // 显示错题
    if (wrongAnswers) {
      const wrongList = shuffledQuestions
        .map((q, i) => ({ q, userAnswer: userAnswers[i], index: i }))
        .filter(item => item.userAnswer !== item.q.answer);
      
      if (wrongList.length === 0) {
        wrongAnswers.innerHTML = '<p style="text-align:center;color:#2ed573;">🎉 全部正确！太厉害了！</p>';
      } else {
        wrongAnswers.innerHTML = `
          <h3>📝 错题回顾 (${wrongList.length}题)</h3>
          ${wrongList.map(item => `
            <div class="wrong-item">
              <div class="q">${item.index + 1}. ${item.q.question}</div>
              <div class="your-answer">❌ 你的答案：${item.q.options[item.userAnswer]}</div>
              <div class="correct-answer">✅ 正确答案：${item.q.options[item.q.answer]}</div>
            </div>
          `).join('')}
        `;
      }
    }
  }

  startBtn?.addEventListener('click', startQuiz);
  retryBtn?.addEventListener('click', startQuiz);
  peekBtn?.addEventListener('click', peekAnswer);
</script>
