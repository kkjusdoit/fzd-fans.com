---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={t('imgupload.title')}>
  <div class="imgupload-container">
    <div class="header-section">
      <h1>{t('imgupload.title')}</h1>
      <p class="subtitle">{t('imgupload.subtitle')}</p>
    </div>

    <!-- 上传区域 -->
    <div class="upload-section">
      <div class="upload-zone" id="uploadZone">
        <div class="upload-icon">📸</div>
        <p class="upload-text">{t('imgupload.drag')}</p>
        <p class="upload-or">{t('imgupload.or')}</p>
        <button class="upload-btn" id="uploadBtn">{t('imgupload.click')}</button>
        <p class="upload-hint">{t('imgupload.paste')}</p>
        <input type="file" id="fileInput" accept="image/*" multiple hidden />
      </div>

      <!-- 上传状态 -->
      <div class="upload-status" id="uploadStatus" style="display: none;">
        <div class="status-icon">⏳</div>
        <p>{t('imgupload.uploading')}</p>
      </div>
    </div>

    <!-- 上传历史 -->
    <div class="history-section" id="historySection" style="display: none;">
      <h2>{t('imgupload.history')}</h2>
      <div class="history-list" id="historyList"></div>
    </div>
  </div>
</BaseLayout>

<style>
  .imgupload-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .header-section {
    text-align: center;
    margin-bottom: 3rem;
  }

  .header-section h1 {
    font-size: 2.5rem;
    background: linear-gradient(135deg, #1e88e5, #0d47a1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: #666;
    font-size: 1.1rem;
  }

  .upload-section {
    margin-bottom: 3rem;
  }

  .upload-zone {
    border: 3px dashed #bbdefb;
    border-radius: 16px;
    padding: 3rem 2rem;
    text-align: center;
    background: linear-gradient(135deg, #e3f2fd 0%, #fff 100%);
    transition: all 0.3s;
    cursor: pointer;
  }

  .upload-zone:hover {
    border-color: #1e88e5;
    background: linear-gradient(135deg, #e3f2fd 0%, #f5f5f5 100%);
  }

  .upload-zone.dragover {
    border-color: #1e88e5;
    background: #e3f2fd;
    transform: scale(1.02);
  }

  .upload-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
  }

  .upload-text {
    font-size: 1.2rem;
    color: #333;
    margin-bottom: 0.5rem;
  }

  .upload-or {
    color: #999;
    margin: 1rem 0;
  }

  .upload-btn {
    background: #1e88e5;
    color: #fff;
    border: none;
    padding: 0.8rem 2rem;
    border-radius: 8px;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .upload-btn:hover {
    background: #1565c0;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(30, 136, 229, 0.3);
  }

  .upload-hint {
    margin-top: 1rem;
    color: #999;
    font-size: 0.9rem;
  }

  .upload-status {
    text-align: center;
    padding: 2rem;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
  }

  .status-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .history-section {
    margin-top: 3rem;
  }

  .history-section h2 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    color: #333;
  }

  .history-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .history-item {
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    gap: 1.5rem;
    align-items: center;
    transition: all 0.2s;
  }

  .history-item:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    transform: translateY(-2px);
  }

  .history-item.success {
    border-left: 4px solid #4caf50;
  }

  .history-item.error {
    border-left: 4px solid #f44336;
  }

  .history-preview {
    width: 120px;
    height: 80px;
    object-fit: cover;
    border-radius: 8px;
    flex-shrink: 0;
  }

  .history-info {
    flex: 1;
  }

  .history-filename {
    font-weight: 600;
    color: #333;
    margin-bottom: 0.5rem;
  }

  .history-meta {
    font-size: 0.85rem;
    color: #999;
    margin-bottom: 0.5rem;
  }

  .history-markdown {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #f5f5f5;
    padding: 0.5rem 0.8rem;
    border-radius: 6px;
    font-family: 'Courier New', monospace;
    font-size: 0.85rem;
    color: #666;
  }

  .history-markdown code {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .copy-btn {
    background: #1e88e5;
    color: #fff;
    border: none;
    padding: 0.4rem 0.8rem;
    border-radius: 4px;
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s;
    flex-shrink: 0;
  }

  .copy-btn:hover {
    background: #1565c0;
  }

  .copy-btn.copied {
    background: #4caf50;
  }

  .error-message {
    color: #f44336;
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }

  @media (max-width: 768px) {
    .header-section h1 {
      font-size: 1.8rem;
    }

    .upload-zone {
      padding: 2rem 1rem;
    }

    .history-item {
      flex-direction: column;
      align-items: flex-start;
    }

    .history-preview {
      width: 100%;
      height: 200px;
    }
  }
</style>

<script>
  const IMGBED_URL = 'https://cb635d57.cloudflare-imgbed-cvs.pages.dev';
  const AUTH_CODE = 'kkjusdoit';

  const uploadZone = document.getElementById('uploadZone');
  const fileInput = document.getElementById('fileInput');
  const uploadBtn = document.getElementById('uploadBtn');
  const uploadStatus = document.getElementById('uploadStatus');
  const historySection = document.getElementById('historySection');
  const historyList = document.getElementById('historyList');

  let uploadHistory: any[] = [];

  // 加载历史记录
  function loadHistory() {
    const saved = localStorage.getItem('fzd-upload-history');
    if (saved) {
      uploadHistory = JSON.parse(saved);
      renderHistory();
    }
  }

  // 保存历史记录
  function saveHistory() {
    localStorage.setItem('fzd-upload-history', JSON.stringify(uploadHistory));
  }

  // 渲染历史记录
  function renderHistory() {
    if (uploadHistory.length === 0) {
      historySection!.style.display = 'none';
      return;
    }

    historySection!.style.display = 'block';
    historyList!.innerHTML = uploadHistory.map((item, index) => `
      <div class="history-item ${item.success ? 'success' : 'error'}">
        ${item.success ? `<img src="${item.url}" alt="${item.filename}" class="history-preview" />` : ''}
        <div class="history-info">
          <div class="history-filename">${item.filename}</div>
          <div class="history-meta">
            ${new Date(item.timestamp).toLocaleString()} · ${formatFileSize(item.size)}
          </div>
          ${item.success ? `
            <div class="history-markdown">
              <code>![${item.filename}](${item.url})</code>
              <button class="copy-btn" data-index="${index}">复制</button>
            </div>
          ` : `
            <div class="error-message">${item.error}</div>
          `}
        </div>
      </div>
    `).join('');

    // 绑定复制按钮事件
    document.querySelectorAll('.copy-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const index = parseInt((e.target as HTMLElement).dataset.index!);
        const item = uploadHistory[index];
        copyToClipboard(`![${item.filename}](${item.url})`, e.target as HTMLElement);
      });
    });
  }

  // 格式化文件大小
  function formatFileSize(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
  }

  // 复制到剪贴板
  async function copyToClipboard(text: string, btn: HTMLElement) {
    try {
      await navigator.clipboard.writeText(text);
      const originalText = btn.textContent;
      btn.textContent = '已复制！';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.textContent = originalText;
        btn.classList.remove('copied');
      }, 2000);
    } catch (err) {
      console.error('复制失败:', err);
    }
  }

  // 上传文件
  async function uploadFile(file: File) {
    const formData = new FormData();
    formData.append('file', file);

    try {
      uploadZone!.style.display = 'none';
      uploadStatus!.style.display = 'block';

      const response = await fetch(`${IMGBED_URL}/upload`, {
        method: 'POST',
        headers: {
          'authCode': AUTH_CODE
        },
        body: formData
      });

      if (!response.ok) {
        throw new Error(`上传失败: ${response.statusText}`);
      }

      const result = await response.json();

      // 添加到历史记录
      uploadHistory.unshift({
        filename: file.name,
        size: file.size,
        url: result.url,
        timestamp: new Date().toISOString(),
        success: true
      });

      saveHistory();
      renderHistory();

    } catch (error) {
      console.error('上传错误:', error);
      
      // 添加错误记录
      uploadHistory.unshift({
        filename: file.name,
        size: file.size,
        timestamp: new Date().toISOString(),
        success: false,
        error: error instanceof Error ? error.message : '上传失败'
      });

      saveHistory();
      renderHistory();
    } finally {
      uploadZone!.style.display = 'block';
      uploadStatus!.style.display = 'none';
    }
  }

  // 处理文件选择
  function handleFiles(files: FileList) {
    Array.from(files).forEach(file => {
      if (file.type.startsWith('image/')) {
        uploadFile(file);
      }
    });
  }

  // 点击上传按钮
  uploadBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    fileInput?.click();
  });

  // 点击上传区域
  uploadZone?.addEventListener('click', () => {
    fileInput?.click();
  });

  // 文件选择
  fileInput?.addEventListener('change', (e) => {
    const files = (e.target as HTMLInputElement).files;
    if (files) {
      handleFiles(files);
    }
  });

  // 拖拽上传
  uploadZone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    uploadZone.classList.add('dragover');
  });

  uploadZone?.addEventListener('dragleave', () => {
    uploadZone.classList.remove('dragover');
  });

  uploadZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    uploadZone.classList.remove('dragover');
    const files = e.dataTransfer?.files;
    if (files) {
      handleFiles(files);
    }
  });

  // 粘贴上传
  document.addEventListener('paste', (e) => {
    const items = e.clipboardData?.items;
    if (items) {
      Array.from(items).forEach(item => {
        if (item.type.startsWith('image/')) {
          const file = item.getAsFile();
          if (file) {
            uploadFile(file);
          }
        }
      });
    }
  });

  // 初始化
  loadHistory();
</script>

</BaseLayout>
