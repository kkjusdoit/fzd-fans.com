---
import BaseLayout from '../layouts/BaseLayout.astro';
// 上线开关:置为 true 后《植物大战饭圈》卡片才会显示(游戏页本身仍可通过直链访问,便于测试)
const SHOW_PVZ_GAME = false;
---

<BaseLayout title="打爆一切">
  <div class="games-page">
    <header class="page-header">
      <h1>🎮 小游戏</h1>
    </header>

    <div class="games-grid">
      <!-- 游戏 1: 植物大战饭圈(测试中,由 SHOW_PVZ_GAME 开关控制) -->
      {SHOW_PVZ_GAME && (
      <a href="/pingpong-defense.html" class="game-card pvz">
        <div class="game-icon">🧟</div>
        <div class="game-info">
          <h2>植物大战饭圈</h2>
          <p>乒乓主题塔防游戏!甩锅僵尸、阴谋论僵尸、水军僵尸涌上草坪,部署乒乓球拍和向日葵,收集冠军金牌与荣誉值,让体育回归体育!</p>
          <span class="play-btn">开始游戏 →</span>
        </div>
      </a>
      )}

      <!-- 游戏 2: 打爆一切 -->
      <a href="/breakit" class="game-card breakit">
        <div class="game-icon">💥</div>
        <div class="game-info">
          <h2>打爆一切</h2>
          <p>所有的谣言、荒谬、污蔑、诋毁、无稽之谈如热气球般升起，请点击一一击碎它们！</p>
          <span class="play-btn">开始游戏 →</span>
        </div>
      </a>

      <!-- 游戏 2: 咚了个咚 -->
      <a href="/game.html" class="game-card dong">
        <div class="game-icon">🏓</div>
        <div class="game-info">
          <h2>咚了个咚</h2>
          <p>樊振东主题消除游戏。收集 icon，消除烦恼，向着巴黎巅峰进发！</p>
          <span class="play-btn">开始游戏 →</span>
        </div>
      </a>

      <!-- 游戏 3: 球迷等级考试 -->
      <a href="/quiz" class="game-card quiz">
        <div class="game-icon">📝</div>
        <div class="game-info">
          <h2>球迷等级考试</h2>
          <p>你是铁杆球迷吗？10道题测测你对樊振东的了解程度！支持偷瞄答案哦~</p>
          <span class="play-btn">开始挑战 →</span>
        </div>
      </a>

      <!-- 游戏 4: 咚咚消消乐 -->
      <a href="/match3.html" class="game-card match3">
        <div class="game-icon">✨</div>
        <div class="game-info">
          <h2>咚咚消消乐</h2>
          <p>经典三消玩法，凑齐三个相同头像即可消除。休闲解压，看看你能过多少关！</p>
          <span class="play-btn">开始游戏 →</span>
        </div>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .games-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  
  .page-header {
    text-align: center;
    margin-bottom: 3rem;
  }
  
  .page-header h1 {
    font-size: 2.5rem;
    color: #1e88e5;
    margin-bottom: 0.5rem;
  }
  
  .page-header p {
    color: #666;
    font-size: 1.1rem;
  }
  
  .games-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  
  @media (min-width: 768px) {
    .games-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  
  .game-card {
    display: flex;
    flex-direction: column;
    background: white;
    border-radius: 16px;
    padding: 2rem;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    transition: all 0.3s ease;
    border: 1px solid #eee;
    height: 100%;
    align-items: center;
    text-align: center;
  }
  
  .game-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(30, 136, 229, 0.15);
    border-color: #bbdefb;
  }
  
  .game-icon {
    font-size: 4rem;
    margin-bottom: 1.5rem;
    background: #f5f5f5;
    width: 100px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: transform 0.3s;
  }
  
  .game-card:hover .game-icon {
    transform: scale(1.1) rotate(5deg);
    background: #e3f2fd;
  }
  
  .game-info h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: #333;
  }
  
  .game-info p {
    color: #666;
    margin-bottom: 1.5rem;
    line-height: 1.6;
    flex-grow: 1;
  }
  
  .play-btn {
    display: inline-block;
    background: #1e88e5;
    color: white;
    padding: 0.6rem 1.5rem;
    border-radius: 50px;
    font-weight: bold;
    font-size: 0.9rem;
    transition: background 0.2s;
  }
  
  .game-card:hover .play-btn {
    background: #1565c0;
  }
  
  /* 特定样式 */
  .breakit .game-icon { color: #f44336; }
  .dong .game-icon { color: #1e88e5; }
</style>
