---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Card from '../../../components/Card.astro';
import { getCollection } from 'astro:content';
import { useTranslations, getLocalizedPath, removeLanguagePrefix } from '../../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
const allWarrior = await getCollection('warrior');
const warrior = allWarrior.filter(item => item.slug.startsWith('en/'));

// Tag translations
const tagMap: Record<string, string> = {
  '德甲': 'Bundesliga',
  '海外征战': 'Overseas',
  'WTT': 'WTT',
  '中国乒协': 'CTTA',
};
---

<BaseLayout title={t('nav.warrior')}>
  <section class="page-header">
    <h1>⚔️ {t('nav.warrior')}</h1>
    <p class="subtitle">Courage and perseverance in the face of adversity</p>
  </section>

  <section class="content-grid">
    {warrior.map(item => (
      <Card 
        title={item.data.titleEn || item.data.title}
        href={getLocalizedPath(`/warrior/${removeLanguagePrefix(item.slug)}`, lang)}
        description={item.data.descriptionEn || item.data.description}
        tag={tagMap[item.data.tags?.[0] || ''] || item.data.tags?.[0]}
      />
    ))}
  </section>
</BaseLayout>

<style>
  .page-header { text-align: center; padding: 2rem 0; }
  .page-header h1 { margin-bottom: 0.5rem; }
  .subtitle { color: #666; }
  .content-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; padding: 2rem 0; }
</style>
