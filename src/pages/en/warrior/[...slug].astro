---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations, getLocalizedPath, removeLanguagePrefix } from '../../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);

// Tag translations
const tagMap: Record<string, string> = {
  '德甲': 'Bundesliga',
  '海外征战': 'Overseas',
  'WTT': 'WTT',
  '中国乒协': 'CTTA',
  'Bundesliga': 'Bundesliga',
  'Overseas': 'Overseas',
  'CTTA': 'CTTA',
};

export async function getStaticPaths() {
  const allWarrior = await getCollection('warrior');
  
  // Group by base slug (without language prefix)
  const grouped = new Map();
  allWarrior.forEach(entry => {
    const baseSlug = entry.slug.replace(/^(zh|en)\//, '');
    if (!grouped.has(baseSlug)) {
      grouped.set(baseSlug, { zh: null, en: null });
    }
    if (entry.slug.startsWith('en/')) {
      grouped.get(baseSlug).en = entry;
    } else {
      grouped.get(baseSlug).zh = entry;
    }
  });
  
  // For English pages, prefer English content, fallback to Chinese
  return Array.from(grouped.entries()).map(([baseSlug, versions]) => ({
    params: { slug: baseSlug },
    props: { entry: versions.en || versions.zh },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const title = entry.data.titleEn || entry.data.title;
const isTranslated = entry.data.translated;
---

<BaseLayout title={title}>
  <article class="content-page">
    <header>
      {!isTranslated && (
        <div class="not-translated-notice">
          <p>⚠️ {t('content.not-translated')}</p>
          <a href={`/warrior/${removeLanguagePrefix(entry.slug)}`}>{t('content.view-chinese')}</a>
        </div>
      )}
      <div class="tags">
        {entry.data.tags?.map(tag => <span class="tag">{tagMap[tag] || tag}</span>)}
      </div>
      <h1>{title}</h1>
      {(entry.data.descriptionEn || entry.data.description) && (
        <p class="desc">{entry.data.descriptionEn || entry.data.description}</p>
      )}
    </header>
    <div class="content"><Content /></div>
    <footer><a href={getLocalizedPath('/warrior', lang)}>{t('back.warrior')}</a></footer>
  </article>
</BaseLayout>

<style>
  .content-page { max-width: 800px; margin: 0 auto; padding: 2rem 0; }
  header { margin-bottom: 2rem; }
  .not-translated-notice { background: #fff3cd; border: 1px solid #ffc107; border-radius: 8px; padding: 1rem; margin-bottom: 1.5rem; text-align: center; }
  .not-translated-notice p { margin: 0 0 0.5rem; color: #856404; }
  .not-translated-notice a { color: #c41e3a; }
  .tags { display: flex; gap: 0.5rem; margin-bottom: 1rem; }
  .tag { background: #c41e3a; color: #fff; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.8rem; }
  h1 { margin-bottom: 0.5rem; }
  .desc { color: #666; }
  .content { line-height: 1.8; }
  .content :global(h2) { margin-top: 2rem; color: #c41e3a; }
  .content :global(blockquote) { border-left: 3px solid #c41e3a; padding-left: 1rem; color: #666; font-style: italic; margin: 1rem 0; }
  footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #eee; }
</style>
