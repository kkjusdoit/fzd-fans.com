---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Card from '../../../components/Card.astro';
import { getCollection } from 'astro:content';
import { useTranslations, getLocalizedPath, removeLanguagePrefix } from '../../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
const allLinks = await getCollection('links');
const links = allLinks
  .filter(item => item.slug.startsWith('en/'))
  .sort((a, b) => {
    const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
    const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
    return dateB - dateA;
  });

// Tag translations
const tagMap: Record<string, string> = {
  '官方': 'Official',
  '媒体': 'Media',
  '报道': 'Reports',
  '视频': 'Video',
  'B站': 'Bilibili',
};
---

<BaseLayout title={t('nav.links')}>
  <section class="page-header">
    <h1>🔗 {t('nav.links')}</h1>
    <p class="subtitle">Official media and video collections</p>
  </section>

  <section class="content-grid">
    {links.map(item => (
      <Card 
        title={item.data.titleEn || item.data.title}
        href={getLocalizedPath(`/links/${removeLanguagePrefix(item.slug)}`, lang)}
        description={item.data.descriptionEn || item.data.description}
        tag={tagMap[item.data.tags?.[0] || ''] || item.data.tags?.[0]}
      />
    ))}
  </section>
</BaseLayout>

<style>
  .page-header { text-align: center; padding: 2rem 0; }
  .page-header h1 { margin-bottom: 0.5rem; }
  .subtitle { color: #666; }
  .content-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; padding: 2rem 0; }
</style>
