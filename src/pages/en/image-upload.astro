---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageUploader from '../../components/ImageUploader.astro';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);

// Get data from Cloudflare D1
let photos = [];
try {
  const runtime = Astro.locals.runtime as any;
  const DB = runtime?.env?.DB;
  
  if (DB) {
    const result = await DB.prepare('SELECT * FROM photos WHERE reviewed = 1 ORDER BY created_at DESC').all();
    if (result && Array.isArray(result.results)) {
      photos = result.results;
    } else {
      console.warn('D1 query returned unexpected format:', JSON.stringify(result));
    }
  } else {
    // Fallback for dev environment or missing binding
    console.warn('D1 Database binding not found');
  }
} catch (error) {
  console.error('Failed to load photos from D1:', error);
}

// Filter supported image formats
const ALLOWED_EXTS = ['.jpg', '.jpeg', '.png', '.gif', '.webp'];

// Defensive programming
if (!Array.isArray(photos)) {
  console.error('Photos is not an array, resetting to empty');
  photos = [];
}

photos = photos.filter((photo: any) => {
  if (!photo || !photo.url) return false;
  const ext = photo.url.substring(photo.url.lastIndexOf('.')).toLowerCase();
  
  if (!ALLOWED_EXTS.includes(ext)) {
     return false;
  }
  
  return true;
});

---

<BaseLayout title={t('imgupload.title')}>
  <div class="page-header">
    <div class="warning-banner">
      ⚠️ Note: Gallery contains high-res images, Wi-Fi recommended.
    </div>
    <h1>📸 {t('imgupload.title')}</h1>
    <p class="page-subtitle">
      {t('imgupload.subtitle')}
    </p>
  </div>

  <!-- Upload Component -->
  <ImageUploader lang={lang} />

  <!-- Photo Wall -->
  <div class="photo-wall">
    <h2>All Photos ({photos.length})</h2>
    
    <div class="gallery-grid" id="gallery-grid">
      {/* Initial render first 20 (SSR) - JS takes over for load more */}
      {photos.slice(0, 20).map((photo: any) => (
        <div class="photo-item">
          <a href={photo.url} target="_blank" rel="noopener noreferrer" class="photo-link">
            <div class="photo-wrapper" data-url={photo.url}>
              <img src={photo.url} alt={photo.name} loading="lazy" />
            </div>
          </a>
          <div class="photo-info">
            <span class="photo-name">{photo.name}</span>
            <div class="button-group">
              <a href={photo.url} download={photo.name} class="action-btn download-btn" title="Download Original" target="_blank">
                ⬇️
              </a>
              <button class="action-btn copy-btn" data-url={photo.url} title="Copy Link">📋</button>
            </div>
          </div>
        </div>
      ))}
      
      {photos.length === 0 && (
        <div class="empty-state">
          <p>No photos yet.</p>
        </div>
      )}
    </div>

    {/* Load More Button */}
    {photos.length > 20 && (
      <div class="load-more-container">
        <button id="load-more-btn" class="load-more-btn">
          Load More ({photos.length - 20})
        </button>
      </div>
    )}
  </div>

  <!-- Disclaimer Footer -->
  <div class="disclaimer-footer">
    <h3>⚖️ Copyright & Disclaimer</h3>
    <p>
      All images are uploaded by users. Copyright belongs to original authors.<br/>
      Uploaders must ensure they own the copyright or have authorization.
    </p>
    <p>
      If you find any content that infringes on your rights, or errors needing correction/deletion,<br/>
      please contact us immediately. We will process removal or correction ASAP.
    </p>
  </div>
</BaseLayout>

<!-- Inject photos for JS -->
<script define:vars={{ allPhotos: photos }}>
  window.PHOTO_DATA = allPhotos;
</script>

<script>
  // @ts-nocheck
  document.addEventListener('DOMContentLoaded', () => {
    // Simple copy functionality
    document.body.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      
      // Copy
      if (target.classList.contains('copy-btn')) {
        e.stopPropagation(); 
        e.preventDefault(); 
        const url = target.dataset.url;
        if (url) {
          await navigator.clipboard.writeText(url);
          const originalText = target.textContent;
          target.textContent = '✅';
          setTimeout(() => { target.textContent = originalText; }, 1000);
        }
      }

      // Download
      if (target.closest('.download-btn')) {
        e.preventDefault();
        const link = target.closest('.download-btn') as HTMLAnchorElement;
        const url = link.href;
        const filename = link.download;
        
        try {
          const response = await fetch(url);
          const blob = await response.blob();
          const blobUrl = window.URL.createObjectURL(blob);
          
          const tempLink = document.createElement('a');
          tempLink.href = blobUrl;
          tempLink.download = filename;
          document.body.appendChild(tempLink);
          tempLink.click();
          document.body.removeChild(tempLink);
          window.URL.revokeObjectURL(blobUrl);
        } catch (err) {
          console.error('Download failed, falling back to direct link:', err);
          window.open(url, '_blank');
        }
      }
    });

    // Pagination logic
    let currentLimit = 20;
    const PAGE_SIZE = 20;
    const loadMoreBtn = document.getElementById('load-more-btn');
    const galleryGrid = document.getElementById('gallery-grid');
    const allPhotos = window.PHOTO_DATA || [];

    if (loadMoreBtn && galleryGrid) {
      loadMoreBtn.addEventListener('click', () => {
        const nextLimit = currentLimit + PAGE_SIZE;
        const nextBatch = allPhotos.slice(currentLimit, nextLimit);
        
        nextBatch.forEach(photo => {
          const div = document.createElement('div');
          div.className = 'photo-item';
          div.innerHTML = `
            <a href="${photo.url}" target="_blank" rel="noopener noreferrer" class="photo-link">
              <div class="photo-wrapper" data-url="${photo.url}">
                <img src="${photo.url}" alt="${photo.name}" loading="lazy" />
              </div>
            </a>
            <div class="photo-info">
              <span class="photo-name">${photo.name}</span>
              <div class="button-group">
                <a href="${photo.url}" download="${photo.name}" class="action-btn download-btn" title="Download Original" target="_blank">
                  ⬇️
                </a>
                <button class="action-btn copy-btn" data-url="${photo.url}" title="Copy Link">📋</button>
              </div>
            </div>
          `;
          galleryGrid.appendChild(div);
        });

        currentLimit = nextLimit;
        
        // Update button status
        const remaining = allPhotos.length - currentLimit;
        if (remaining <= 0) {
          loadMoreBtn.style.display = 'none';
        } else {
          loadMoreBtn.textContent = `Load More (${remaining})`;
        }
      });
    }
  });
</script>

<style>
  /* ... (keeping previous styles by importing or copy-pasting? Since Astro styles are scoped, I should copy paste or ensure global styles are used if common.
     The original file had many styles. I should copy them.)
     Wait, I can just copy the styles from the original file.
  */

  .photo-wall {
    max-width: 1400px;
    margin: 3rem auto;
    padding: 0 1rem;
  }

  .photo-wall h2 {
    text-align: center;
    color: #333;
    margin-bottom: 2rem;
    font-size: 1.8rem;
  }

  .gallery-grid {
    column-count: 4;
    column-gap: 1.5rem;
  }

  .photo-item {
    break-inside: avoid;
    margin-bottom: 1.5rem;
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .photo-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.1);
  }

  .photo-wrapper {
    position: relative;
    overflow: hidden;
    cursor: zoom-in;
    max-height: 500px;
  }

  .photo-wrapper img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.5s ease;
    object-fit: cover;
    object-position: top;
  }

  .photo-item:hover .photo-wrapper img {
    transform: scale(1.05);
  }

  .page-header {
    text-align: center;
    padding: 3rem 1rem 2rem;
    background: linear-gradient(135deg, #e3f2fd 0%, #fff 100%);
    border-radius: 0 0 2rem 2rem;
    margin-bottom: 2rem;
    position: relative;
  }

  .warning-banner {
    background: #fff3e0;
    color: #e65100;
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    border-radius: 8px;
    display: inline-block;
    margin-bottom: 20px;
    border: 1px solid #ffe0b2;
    animation: fadeInDown 0.5s ease;
  }

  .load-more-container {
    text-align: center;
    margin: 3rem 0;
  }

  .load-more-btn {
    background: #fff;
    border: 2px solid #1e88e5;
    color: #1e88e5;
    padding: 0.8rem 2.5rem;
    border-radius: 2rem;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s;
    font-weight: 500;
  }

  .load-more-btn:hover {
    background: #1e88e5;
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(30, 136, 229, 0.2);
  }

  @keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .page-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, #1e88e5, #0d47a1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .page-subtitle {
    color: #666;
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }


  .photo-info {
    padding: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid #f0f0f0;
  }

  .photo-name {
    font-size: 0.9rem;
    color: #444;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 80%;
  }

  .button-group {
    display: flex;
    gap: 0.5rem;
  }

  .action-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.1rem;
    padding: 4px;
    border-radius: 4px;
    transition: background 0.2s;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .action-btn:hover {
    background: #f0f0f0;
  }

  .disclaimer-footer {
    max-width: 800px;
    margin: 4rem auto 2rem;
    padding: 2rem;
    background: #f5f5f5;
    border-radius: 12px;
    text-align: center;
    color: #666;
    font-size: 0.85rem;
  }

  .disclaimer-footer h3 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
    color: #444;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .disclaimer-footer p {
    margin: 0.5rem 0;
    line-height: 1.6;
  }

  .disclaimer-footer code {
    background: #e0e0e0;
    padding: 2px 6px;
    border-radius: 4px;
    font-family: monospace;
    color: #c62828;
  }
  
  .empty-state .small-hint {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: #999;
  }

  @media (max-width: 1200px) {
    .gallery-grid {
      column-count: 3;
    }
  }

  @media (max-width: 900px) {
    .gallery-grid {
      column-count: 2;
    }
  }

  @media (max-width: 600px) {
    .gallery-grid {
      column-count: 1;
    }
    
    .page-header h1 {
      font-size: 1.8rem;
    }
  }
</style>
