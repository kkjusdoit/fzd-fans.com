---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageUploader from '../../components/ImageUploader.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
---

<BaseLayout title={t('nav.imgupload')}>
  <div class="page-header">
    <a href="/en/fzd-gallery" class="back-link">
      <span class="btn-icon">←</span> Back to Gallery
    </a>
  </div>

  <div class="upload-container">
    <ImageUploader lang={lang} />
  </div>
</BaseLayout>

<style>
  .page-header {
    text-align: center;
    padding: 3rem 1rem;
    background: linear-gradient(135deg, #e3f2fd 0%, #fff 100%);
    border-radius: 0 0 2rem 2rem;
    position: relative;
    margin-bottom: 2rem;
  }

  .page-header h1 { 
    margin-bottom: 0.5rem; 
    font-size: 2rem; 
  }

  .page-subtitle { 
    color: #666; 
    margin-bottom: 1.5rem;
    font-size: 1rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    position: absolute;
    top: 1.5rem;
    left: 2rem;
    color: #1e88e5;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s;
    background: rgba(255,255,255,0.8);
    padding: 0.5rem 1rem;
    border-radius: 2rem;
    backdrop-filter: blur(4px);
  }

  .back-link:hover {
    background: #fff;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(30, 136, 229, 0.15);
  }

  .upload-container {
    max-width: 800px;
    margin: 2rem auto;
    padding: 0 1rem;
  }

  @media (max-width: 768px) {
    .back-link {
      position: static;
      display: block;
      margin-bottom: 1rem;
      text-align: left;
    }
    
    .page-header {
      text-align: center;
    }
  }
</style>
