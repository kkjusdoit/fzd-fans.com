---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Games">
  <div class="games-page">
    <header class="page-header">
      <h1>🎮 Games</h1>
      <p>Relax and have fun, supporting Fan Zhendong in another way.</p>
    </header>

    <div class="games-grid">
      <!-- Game 0: Dongdoku -->
      <a href="/en/dongdoku" class="game-card dongdoku">
        <div class="game-icon">🏓</div>
        <div class="game-info">
          <h2>Dongdoku</h2>
          <p>One Dong per region, row, and column. Dongs cannot touch! Over 1000 logic levels with autosave!</p>
          <span class="play-btn">Play Now →</span>
        </div>
      </a>

      <!-- Game 1: Break It All -->
      <a href="/en/breakit" class="game-card breakit">
        <div class="game-icon">💥</div>
        <div class="game-info">
          <h2>Break It All</h2>
          <p>All the rumors, absurdities, and nonsense rise like hot air balloons. Click to burst them one by one!</p>
          <span class="play-btn">Play Now →</span>
        </div>
      </a>

      <!-- Game 2: Dong Le Ge Dong -->
      <a href="/game.html" class="game-card dong">
        <div class="game-icon">🏓</div>
        <div class="game-info">
          <h2>Dong Le Ge Dong</h2>
          <p>Fan Zhendong themed tile-matching game. Collect photos, clear the board, and aim for the Paris peak!</p>
          <span class="play-btn">Play Now →</span>
        </div>
      </a>

      <!-- Game 3: Dong Dong Match -->
      <a href="/match3.html" class="game-card match3">
        <div class="game-icon">✨</div>
        <div class="game-info">
          <h2>Dong Dong Match</h2>
          <p>Classic Match-3 game. Match 3 identical avatars to clear them. Relax and see how high you can score!</p>
          <span class="play-btn">Play Now →</span>
        </div>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .games-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  
  .page-header {
    text-align: center;
    margin-bottom: 3rem;
  }
  
  .page-header h1 {
    font-size: 2.5rem;
    color: #1e88e5;
    margin-bottom: 0.5rem;
  }
  
  .page-header p {
    color: #666;
    font-size: 1.1rem;
  }
  
  .games-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  
  @media (min-width: 768px) {
    .games-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  
  .game-card {
    display: flex;
    flex-direction: column;
    background: white;
    border-radius: 16px;
    padding: 2rem;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    transition: all 0.3s ease;
    border: 1px solid #eee;
    height: 100%;
    align-items: center;
    text-align: center;
  }
  
  .game-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(30, 136, 229, 0.15);
    border-color: #bbdefb;
  }
  
  .game-icon {
    font-size: 4rem;
    margin-bottom: 1.5rem;
    background: #f5f5f5;
    width: 100px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: transform 0.3s;
  }
  
  .game-card:hover .game-icon {
    transform: scale(1.1) rotate(5deg);
    background: #e3f2fd;
  }
  
  .game-info h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: #333;
  }
  
  .game-info p {
    color: #666;
    margin-bottom: 1.5rem;
    line-height: 1.6;
    flex-grow: 1;
  }
  
  .play-btn {
    display: inline-block;
    background: #1e88e5;
    color: white;
    padding: 0.6rem 1.5rem;
    border-radius: 50px;
    font-weight: bold;
    font-size: 0.9rem;
    transition: background 0.2s;
  }
  
  .game-card:hover .play-btn {
    background: #1565c0;
  }
  
  /* 特定样式 */
  .breakit .game-icon { color: #f44336; }
  .dong .game-icon { color: #1e88e5; }
</style>
