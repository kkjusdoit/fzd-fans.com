---
// Static page with client-side fetching
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageUploader from '../../components/ImageUploader.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
---

<BaseLayout title={t('imgupload.title')}>
  <div class="page-header">
    <div class="warning-banner">
      ⚠️ Note: Gallery contains high-res images, Wi-Fi recommended.
    </div>
    <h1>📸 {t('imgupload.title')}</h1>
    <p class="page-subtitle">
      {t('imgupload.subtitle')}
    </p>
  </div>

  <!-- Upload Component -->
  <ImageUploader lang={lang} />

  <!-- Photo Wall -->
  <div class="photo-wall">
    <h2>All Photos (<span id="photo-count">--</span>)</h2>
    
    <div id="loading-indicator" class="loading-state">
      <div class="spinner"></div>
      <p>Loading photos...</p>
    </div>

    <div class="gallery-grid" id="gallery-grid">
      <!-- Content rendered by JS -->
    </div>

    <div id="empty-state" class="empty-state" style="display: none;">
      <p>No photos yet.</p>
    </div>

    <div class="load-more-container" style="display: none;">
      <button id="load-more-btn" class="load-more-btn">
        Load More
      </button>
    </div>
  </div>

  <!-- Disclaimer Footer -->
  <div class="disclaimer-footer">
    <h3>⚖️ Copyright & Disclaimer</h3>
    <p>
      All images are uploaded by users. Copyright belongs to original authors.<br/>
      Uploaders must ensure they own the copyright or have authorization.
    </p>
    <p>
      If you find any content that infringes on your rights, or errors needing correction/deletion,<br/>
      please contact us immediately. We will process removal or correction ASAP.
    </p>
  </div>
</BaseLayout>

<script>
  // @ts-nocheck
  document.addEventListener('DOMContentLoaded', async () => {
    const galleryGrid = document.getElementById('gallery-grid');
    const loadingIndicator = document.getElementById('loading-indicator');
    const emptyState = document.getElementById('empty-state');
    const photoCountSpan = document.getElementById('photo-count');
    const loadMoreBtn = document.getElementById('load-more-btn');
    const loadMoreContainer = loadMoreBtn?.parentElement;

    let allPhotos = [];
    let currentLimit = 20;
    const PAGE_SIZE = 20;
    
    // Filter supported image formats
    const ALLOWED_EXTS = ['.jpg', '.jpeg', '.png', '.gif', '.webp'];

    try {
      const response = await fetch('/api/photos');
      if (!response.ok) throw new Error('Failed to fetch photos');
      
      const data = await response.json();
      
      // Client-side filtering
      allPhotos = data.filter(photo => {
        if (!photo || !photo.url) return false;
        const ext = photo.url.substring(photo.url.lastIndexOf('.')).toLowerCase();
        return ALLOWED_EXTS.includes(ext);
      });

      photoCountSpan.textContent = allPhotos.length;
      loadingIndicator.style.display = 'none';

      if (allPhotos.length === 0) {
        emptyState.style.display = 'block';
      } else {
        renderBatch(allPhotos.slice(0, currentLimit));
        
        if (allPhotos.length > currentLimit) {
          loadMoreContainer.style.display = 'block';
          loadMoreBtn.textContent = `Load More (${allPhotos.length - currentLimit})`;
        }
      }

    } catch (error) {
      console.error('Error loading photos:', error);
      loadingIndicator.innerHTML = '<p style="color: red;">Failed to load photos. Please refresh.</p>';
    }

    // Render helper
    function renderBatch(photos) {
      photos.forEach(photo => {
        const div = document.createElement('div');
        div.className = 'photo-item';
        div.innerHTML = `
          <div class="photo-wrapper">
            <img src="${photo.url}" alt="${photo.name}" loading="lazy" />
          </div>
          <div class="card-footer">
            <span class="file-name" title="${photo.name || ''}">${photo.name || ''}</span>
            <div class="actions">
              <a href="${photo.url}" download="${photo.name}" class="action-btn" title="Download Original" target="_blank">⬇️</a>
              <button class="action-btn copy-btn" data-url="${photo.url}" title="Copy Link">📋</button>
            </div>
          </div>
        `;
        galleryGrid.appendChild(div);
      });
    }

    // Copy Handler (Global delegation)
    document.body.addEventListener('click', async (e) => {
        const target = e.target as HTMLElement;
        if (target.classList.contains('copy-btn')) {
            e.preventDefault();
            e.stopPropagation();
            const url = target.dataset.url;
            if (url) {
                await navigator.clipboard.writeText(url);
                const originalText = target.textContent;
                target.textContent = '✅';
                setTimeout(() => { target.textContent = originalText; }, 1000);
            }
        }
    });

    // Load More Handler
    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        const nextLimit = currentLimit + PAGE_SIZE;
        const nextBatch = allPhotos.slice(currentLimit, nextLimit);
        
        renderBatch(nextBatch);
        currentLimit = nextLimit;
        
        const remaining = allPhotos.length - currentLimit;
        if (remaining <= 0) {
          loadMoreContainer.style.display = 'none';
        } else {
          loadMoreBtn.textContent = `Load More (${remaining})`;
        }
      });
    }
  });
</script>

<style>
  /* Styles copy-pasted/adapted from zh version */
  .photo-wall {
    max-width: 1400px;
    margin: 3rem auto;
    padding: 0 1rem;
  }

  .photo-wall h2 {
    text-align: center;
    color: #333;
    margin-bottom: 2rem;
    font-size: 1.8rem;
  }

  .loading-state {
    text-align: center;
    padding: 3rem;
    color: #666;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 4px solid #f3f3f3;
    border-top: 4px solid #1e88e5;
    border-radius: 50%;
    margin: 0 auto 1rem;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .gallery-grid { column-count: 5; column-gap: 15px; }

  .photo-item {
    break-inside: avoid;
    margin-bottom: 1.5rem;
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    /* Fix for column layout overlap */
    display: inline-block;
    width: 100%;
  }

  .photo-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.1);
  }

  .photo-wrapper { position: relative; cursor: zoom-in; background-color: #f0f0f0; }
  .photo-wrapper img { width: 100%; height: auto; display: block; transition: filter 0.3s ease; }

  .page-header {
    text-align: center;
    padding: 3rem 1rem 2rem;
    background: linear-gradient(135deg, #e3f2fd 0%, #fff 100%);
    border-radius: 0 0 2rem 2rem;
    margin-bottom: 2rem;
    position: relative;
  }

  .warning-banner {
    background: #fff3e0;
    color: #e65100;
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    border-radius: 8px;
    display: inline-block;
    margin-bottom: 20px;
    border: 1px solid #ffe0b2;
    animation: fadeInDown 0.5s ease;
  }

  .load-more-container {
    text-align: center;
    margin: 3rem 0;
  }

  .load-more-btn {
    background: #fff;
    border: 2px solid #1e88e5;
    color: #1e88e5;
    padding: 0.8rem 2.5rem;
    border-radius: 2rem;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s;
    font-weight: 500;
  }

  .load-more-btn:hover {
    background: #1e88e5;
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(30, 136, 229, 0.2);
  }

  @keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .page-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, #1e88e5, #0d47a1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .page-subtitle {
    color: #666;
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .card-footer { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.75rem 0.9rem; border-top: 1px solid #f0f0f0; background: #fff; }
  .file-name { flex: 1; min-width: 0; font-size: 0.92rem; color: #333; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .actions { display: flex; gap: 0.25rem; }
  .action-btn { appearance: none; border: none; background: #fff; color: #333; width: 32px; height: 32px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; box-shadow: 0 0 0 1px #eee inset; cursor: pointer; transition: background 0.2s ease, transform 0.1s ease; text-decoration: none; }
  .action-btn:hover { background: #f6f6f6; }
  .action-btn:active { transform: scale(0.98); }

  .disclaimer-footer {
    max-width: 800px;
    margin: 4rem auto 2rem;
    padding: 2rem;
    background: #f5f5f5;
    border-radius: 12px;
    text-align: center;
    color: #666;
    font-size: 0.85rem;
  }

  .disclaimer-footer h3 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
    color: #444;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .disclaimer-footer p {
    margin: 0.5rem 0;
    line-height: 1.6;
  }

  .disclaimer-footer code {
    background: #e0e0e0;
    padding: 2px 6px;
    border-radius: 4px;
    font-family: monospace;
    color: #c62828;
  }
  
  .empty-state .small-hint {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: #999;
  }

  @media (max-width: 1600px) { .gallery-grid { column-count: 4; } }
  @media (max-width: 1200px) { .gallery-grid { column-count: 3; } }
  @media (max-width: 768px) { .gallery-grid { column-count: 2; } }
  @media (max-width: 480px) { .gallery-grid { column-count: 1; } }
</style>
