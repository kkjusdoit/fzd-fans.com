---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DongdokuGame from '../../components/dongdoku/DongdokuGame.astro';
---

<BaseLayout 
  title="Dongdoku - Fan Zhendong Logic Puzzle Game"
  description="Place one Dong per region, row, and column. Dongs cannot touch. Challenge 1000+ levels!"
  lang="en"
>
  <div class="dongdoku-page-wrap">
    <DongdokuGame lang="en" />
  </div>
</BaseLayout>

<style>
  .dongdoku-page-wrap {
    min-height: 80vh;
    padding: 0.5rem 0.5rem 1.5rem;
    display: flex;
    justify-content: center;
  }
</style>
