---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DongdokuGame from '../../components/dongdoku/DongdokuGame.astro';
---

<BaseLayout 
  title="Dongdoku - Fan Zhendong Logic Puzzle Game"
  description="Place one Dong per region, row, and column. Dongs cannot touch. Challenge 1000+ levels!"
  lang="en"
>
  {import.meta.env.DEV ? <DongdokuGame lang="en" /> : <div class="dongdoku-page-wrap">
    <section class="offline-notice" aria-live="polite">
      <div class="offline-icon">🎮</div>
      <h1>Dongdoku is temporarily offline</h1>
      <p>The game is being repaired and will return after the interaction issue is fixed.</p>
      <a href="/en/games">Back to Games</a>
    </section>
  </div>}
</BaseLayout>

<style>
  .dongdoku-page-wrap {
    min-height: 80vh;
    padding: 0.5rem 0.5rem 1.5rem;
    display: flex;
    justify-content: center;
  }
  .offline-notice { width: min(92vw, 520px); margin: 4rem auto; padding: 3rem 1.5rem; text-align: center; background: #fff; border: 1px solid #ebdcd5; border-radius: 1rem; box-shadow: 0 10px 30px rgba(78,64,55,.1); color: #594a45; }
  .offline-icon { font-size: 3rem; }
  .offline-notice h1 { margin: 1rem 0 .6rem; font-size: 1.6rem; }
  .offline-notice p { margin: 0 0 1.5rem; color: #806f68; }
  .offline-notice a { display: inline-block; padding: .7rem 1.2rem; border-radius: .5rem; background: #1e88e5; color: #fff; text-decoration: none; }
</style>
