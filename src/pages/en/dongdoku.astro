---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DongdokuGame from '../../components/dongdoku/DongdokuGame.astro';
---

<BaseLayout 
  title="Dongdoku - Fan Zhendong Queens Logic Puzzle"
  description="Play Dongdoku online! One Dong per color region, row, and column. Dongs cannot touch! Over 1000 logic levels."
>
  <div class="dongdoku-page-wrap">
    <div class="page-title-header">
      <h1>🏓 Dongdoku</h1>
      <p>One Dong per region, row, and column. Dongs cannot touch!</p>
    </div>
    <DongdokuGame lang="en" />
  </div>
</BaseLayout>

<style>
  .dongdoku-page-wrap {
    min-height: 85vh;
    padding: 1rem 0.5rem 2rem;
  }
  .page-title-header {
    text-align: center;
    margin-bottom: 0.5rem;
  }
  .page-title-header h1 {
    font-size: 2.2rem;
    font-weight: 900;
    margin: 0;
    background: linear-gradient(45deg, #1e88e5, #42a5f5);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .page-title-header p {
    color: #795548;
    margin: 0.3rem 0 0.5rem;
    font-weight: 600;
    font-size: 0.95rem;
  }
</style>
