---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import BirthdayCountdown from '../../components/BirthdayCountdownEn.astro';
import { getCollection } from 'astro:content';
import { useTranslations, getLocalizedPath, removeLanguagePrefix } from '../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);

// 获取所有内容，优先英文，fallback 到中文
const arena = await getCollection('arena');
const quotes = await getCollection('quotes');
const warrior = await getCollection('warrior');
const tributes = await getCollection('tributes');
const links = await getCollection('links');
const stars = await getCollection('stars');
const ugc = await getCollection('ugc');

const categoryMap = {
  arena: { name: t('nav.arena'), icon: '🏆' },
  stars: { name: t('nav.stars'), icon: '⭐' },
  quotes: { name: t('nav.quotes'), icon: '💬' },
  warrior: { name: t('nav.warrior'), icon: '⚔️' },
  tributes: { name: t('nav.tributes'), icon: '💝' },
  links: { name: t('nav.links'), icon: '🔗' },
};

const allContent = [
  ...arena.map(m => ({ ...m, category: 'arena' as const })),
  ...stars.map(s => ({ ...s, category: 'stars' as const })),
  ...quotes.map(q => ({ ...q, category: 'quotes' as const })),
  ...warrior.map(w => ({ ...w, category: 'warrior' as const })),
  ...tributes.map(t => ({ ...t, category: 'tributes' as const })),
  ...links.map(l => ({ ...l, category: 'links' as const })),
];

// 经典语录 (英文版)
const featuredQuotes = [
  "I've given my whole life to the country. It's not something I can just quit.",
  "If I keep winning championships, I'll keep treating everyone!",
  "You can win or lose a match, but you should never give up. That's the spirit of sports.",
  "Paris was great, and the future will be even better.",
];

// 称号列表 (英文版)
const nicknames = [
  { name: "Xiao Pang", desc: "Little Fatty - the most endearing nickname" },
  { name: "Iron-Blooded No.1", desc: "10 years as China's top singles player" },
  { name: "Fan Million", desc: "3-time WTT Grand Smash champion" },
  { name: "Wall of China", desc: "Impenetrable defense" },
  { name: "Mr. Reliable", desc: "100% win rate in singles finals at major events against foreign players" },
  { name: "Kaiser Fan", desc: "Bundesliga nickname" },
];

// 应援口号 (英文版)
const slogans = [
  "Fan Zhendong, see you at every arena",
  "Heavy snow bends the pine, yet the pine stands tall and straight",
  "Building greatness grain by grain, Fan stars shine bright",
  "Fan Zhendong, shine in Los Angeles",
];

// Super Grand Slam Badges (English)
const grandSlamBadges = [
  {
    icon: '🥇',
    title: 'Paris 2024 Double Gold',
    sub: 'Singles + Team Champion',
    desc: 'Crowned with the Super Grand Slam in legendary fashion'
  },
  {
    icon: '🏆',
    title: '4x World Cup Champion',
    sub: '4 Singles World Titles',
    desc: 'All-time historic record holder of the ITTF World Cup'
  },
  {
    icon: '🥇',
    title: '2x World Champion',
    sub: 'Houston + Durban Consecutive',
    desc: 'Unquestioned supremacy on the world table tennis stage'
  },
  {
    icon: '🌟',
    title: 'Super Grand Slam',
    sub: 'All 9 Major Singles Titles',
    desc: 'Olympics, Worlds, World Cup, National Games & more'
  }
];

// Career 5-Chapter Chronicle (English)
const chronicleChapters = [
  {
    era: '2012 — 2016',
    tag: 'Chapter 1',
    title: 'The Prodigy · Storming the World Stage',
    summary: 'From Guangzhou youth to the Bayi team, Fan burst onto the world scene with his signature ferocious backhand flick. At 16, he became the youngest ITTF World Tour singles champion.',
    quote: 'Once I step onto the court, I leave no retreat for myself.',
    link: getLocalizedPath('/arena', lang),
    linkText: 'Explore early milestones →'
  },
  {
    era: '2017 — 2021',
    tag: 'Chapter 2',
    title: 'Tempered in Fire · Resilience & Evolution',
    summary: 'The heartbreak of the 2017 Dusseldorf Worlds fueled his relentless growth. Winning Marvellous 12 titles, Olympic team gold in Tokyo, and crowning at the 2021 Houston Worlds.',
    quote: "You can win or lose a match, but never surrender. That's true sportsmanship.",
    link: getLocalizedPath('/stars', lang),
    linkText: 'Discover playing style & status →'
  },
  {
    era: '2022 — 2024 Early',
    tag: 'Chapter 3',
    title: 'The Lone Warrior · Courage Amidst the Noise',
    summary: 'Standing tall for genuine sporting integrity amidst external distractions. Facing adversity with dignity, withdrawing from rankings to defend the purity of table tennis.',
    quote: "I've given my life to the sport and country. It's not something to abandon lightly.",
    link: getLocalizedPath('/warrior/world-ranking-withdrawal', lang),
    linkText: 'Read ranking withdrawal report →'
  },
  {
    era: 'August 2024',
    tag: 'Chapter 4 · Coronation',
    title: 'Paris Crowning · The Grand Slam Masterpiece',
    summary: 'Bearing the entire weight of Chinese men’s singles in Paris. Down 0-2 against a hyper-focused Harimoto, changing shirts, battling to an epic 11-7 Game 7 triumph and taking gold!',
    quote: "Down to the wire, I told myself: I would rather fight until my last breath on that table.",
    link: getLocalizedPath('/matches', lang),
    linkText: 'Review Paris match records →',
    featured: true
  },
  {
    era: '2024 — Present',
    tag: 'Chapter 5',
    title: 'Beyond Boundaries · A Boundless Journey',
    summary: 'Cheering at the Santiago Bernabéu for Real Madrid, embracing global fans and joining the German Bundesliga. A champion playing with pure joy and poise.',
    quote: 'Paris was great, and the future will be even better.',
    link: getLocalizedPath('/tributes/bundesliga-journey', lang),
    linkText: 'Explore Bundesliga journey →'
  }
];
---

<BaseLayout title={t('site.title')}>
  <!-- Hero Section 冠军殿堂 -->
  <section class="hero-temple">
    <div class="hero-temple-glow"></div>
    <div class="container hero-temple-inner">
      <div class="hero-badge-pill">
        <span class="pill-spark">🏓</span>
        <span>Men's Super Grand Slam Champion · Internet Memory Project</span>
      </div>

      <div class="hero-titles">
        <span class="hero-pretitle">THE GRAND SLAM ARCHIVE</span>
        <h1 class="hero-main-title">Fan Zhendong Archive</h1>
      </div>

      <p class="hero-manifesto">
        This is not a cold encyclopedia, but an ever-growing digital temple of sports history.<br class="desktop-break"/>
        The focus is not only on <span class="hl-gold">world-conquering victories</span>, but on his <span class="hl-gold">willpower, character, innocence, kindness, wit, and humor</span>,<br class="desktop-break"/>
        as well as his <span class="hl-crimson">clarity and perseverance</span> amid the noise, and his <span class="hl-crimson">courage when facing adversity</span>.
      </p>

      <!-- 全满贯四大勋章矩阵 -->
      <div class="grand-slam-grid">
        {grandSlamBadges.map(badge => (
          <div class="slam-badge-card">
            <div class="badge-icon-box">{badge.icon}</div>
            <div class="badge-text-box">
              <div class="badge-title">{badge.title}</div>
              <div class="badge-sub">{badge.sub}</div>
              <div class="badge-desc">{badge.desc}</div>
            </div>
          </div>
        ))}
      </div>

      <!-- 硬核核心数据大屏 -->
      <div class="temple-stats-bar">
        <div class="temple-stat">
          <span class="stat-big-num">23,700+</span>
          <span class="stat-name">Match Records</span>
        </div>
        <div class="stat-sep"></div>
        <div class="temple-stat">
          <span class="stat-big-num">100%</span>
          <span class="stat-name">Major Singles Win Rate (vs Intl)</span>
        </div>
        <div class="stat-sep"></div>
        <div class="temple-stat">
          <span class="stat-big-num">4 Titles</span>
          <span class="stat-name">World Cup Record</span>
        </div>
        <div class="stat-sep"></div>
        <div class="temple-stat">
          <span class="stat-big-num">9 Slams</span>
          <span class="stat-name">Super Grand Slam</span>
        </div>
      </div>

      <!-- 快捷入口胶囊 -->
      <div class="hero-action-pills">
        <a href="#epic-battle" class="hero-action-pill primary">⚡ Relive Paris Miracle</a>
        <a href="#chronicle" class="hero-action-pill">📖 5-Chapter Chronicle</a>
        <a href={getLocalizedPath('/matches', lang)} class="hero-action-pill">🏓 Full Match Database</a>
        <a href={getLocalizedPath('/games', lang)} class="hero-action-pill">🎮 Fan Playground</a>
      </div>
    </div>
  </section>

  <!-- Birthday Countdown -->
  <BirthdayCountdown />

  <!-- 史诗战役专栏：巴黎封神 逆转张本智和 -->
  <section class="epic-battle-section" id="epic-battle">
    <div class="container">
      <div class="epic-battle-card">
        <div class="battle-top-bar">
          <div class="epic-battle-badge">🔥 Paris 2024 Epic Battle · Comeback of the Century</div>
          <div class="battle-location-tag">2024.08.01 · South Paris Arena 4</div>
        </div>

        <div class="battle-main-grid">
          <div class="battle-summary-col">
            <h2 class="battle-h2">Fan Zhendong 4 - 3 Tomokazu Harimoto</h2>
            <p class="battle-subtext">Men's Singles Quarterfinal · Shouldering an entire nation's hope in the ultimate test of wills</p>
            
            <div class="battle-quote-bubble">
              <span class="quote-symbol">“</span>
              <p>Down 0-2, I changed my shirt. I told myself the match had just begun. Even if it meant fighting to my very last breath, I would leave everything on that table!</p>
              <span class="quote-sign">—— Fan Zhendong Post-Match Interview</span>
            </div>

            <div class="battle-buttons">
              <a href={getLocalizedPath('/matches', lang)} class="battle-btn primary">🏓 Match Details & Scores</a>
              <a href={getLocalizedPath('/ugc/fzd-vs-wcc-iq-domination', lang)} class="battle-btn secondary">⚔️ Tactical Breakdown</a>
            </div>
          </div>

          <div class="battle-timeline-col">
            <div class="timeline-box-title">7-Game Heart-Stopping Thriller</div>
            <div class="games-flow-list">
              <div class="flow-item lost">
                <span class="f-num">Game 1</span>
                <span class="f-score">2 - 11</span>
                <span class="f-status">Adverse start</span>
              </div>
              <div class="flow-item lost">
                <span class="f-num">Game 2</span>
                <span class="f-score">9 - 11</span>
                <span class="f-status">Down 0-2 on the brink</span>
              </div>
              <div class="flow-item win shifted">
                <div class="shift-badge">👕 Shirt Change · Reset & Counterattack</div>
                <span class="f-num">Game 3</span>
                <span class="f-score">11 - 4</span>
                <span class="f-status">Fierce backhand counter</span>
              </div>
              <div class="flow-item win">
                <span class="f-num">Game 4</span>
                <span class="f-score">11 - 7</span>
                <span class="f-status">Leveling the match 2-2</span>
              </div>
              <div class="flow-item lost">
                <span class="f-num">Game 5</span>
                <span class="f-score">4 - 11</span>
                <span class="f-status">Opponent claims match point lead</span>
              </div>
              <div class="flow-item win">
                <span class="f-num">Game 6</span>
                <span class="f-score">11 - 7</span>
                <span class="f-status">Resolute defense to force Game 7!</span>
              </div>
              <div class="flow-item win crowned">
                <div class="crown-badge">👑 Game 7 Decider · Crowning Moment</div>
                <span class="f-num">Game 7</span>
                <span class="f-score">11 - 7</span>
                <span class="f-status">Victory! Arms outstretched in glory!</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 生涯五部曲：沉浸式编年史 -->
  <section class="chronicle-section" id="chronicle">
    <div class="container">
      <div class="chronicle-header">
        <div class="section-badge">📜 Epic Narrative Thread</div>
        <h2>Career 5-Chapter Chronicle</h2>
        <p class="section-sub">From prodigy to Super Grand Slam champion—the journey of a modern sports icon</p>
      </div>

      <div class="chronicle-list">
        {chronicleChapters.map((ch, idx) => (
          <div class:list={['chronicle-card', { 'featured-chapter': ch.featured }]}>
            <div class="chapter-badge-col">
              <span class="chapter-tag">{ch.tag}</span>
              <span class="chapter-era">{ch.era}</span>
              <div class="chapter-step-dot">{idx + 1}</div>
            </div>
            <div class="chapter-body-col">
              <h3 class="chapter-title">{ch.title}</h3>
              <p class="chapter-summary">{ch.summary}</p>
              <div class="chapter-quote-bar">
                <span class="quote-icon">“</span>
                <span class="quote-text">{ch.quote}</span>
              </div>
              <a href={ch.link} class="chapter-link-btn">{ch.linkText}</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 滚动应援 -->
  <section class="slogan-marquee">
    <div class="marquee-content">
      {[...slogans, ...slogans].map(s => (
        <span class="slogan-item">✨ {s}</span>
      ))}
    </div>
  </section>

  <!-- 称号墙 -->
  <section class="nicknames-section">
    <h2>{t('home.nicknames.title')}</h2>
    <div class="nicknames-grid">
      {nicknames.map(n => (
        <div class="nickname-card">
          <span class="nickname-name">{n.name}</span>
          <span class="nickname-desc">{n.desc}</span>
        </div>
      ))}
    </div>
    <a href={getLocalizedPath('/stars/nicknames', lang)} class="view-more">{t('home.nicknames.viewAll')}</a>
  </section>

  <!-- 经典语录轮播 -->
  <section class="quotes-highlight">
    <h2>{t('home.quotes.title')}</h2>
    <div class="quotes-carousel" id="quotesCarousel">
      {featuredQuotes.map((q, i) => (
        <blockquote class={`quote-card ${i === 0 ? 'active' : ''}`} data-index={i}>
          "{q}"
        </blockquote>
      ))}
    </div>
    <div class="carousel-dots">
      {featuredQuotes.map((_, i) => (
        <button class={`dot ${i === 0 ? 'active' : ''}`} data-index={i} aria-label={`Switch to quote ${i + 1}`}></button>
      ))}
    </div>
    <a href={getLocalizedPath('/quotes', lang)} class="view-more">{t('home.quotes.viewAll')}</a>
  </section>

  <!-- 档案分类 -->
  <section class="categories">
    <h2>{t('home.categories.title')}</h2>
    <div class="category-grid">
      <a href={getLocalizedPath('/arena', lang)} class="category-card arena">
        <span class="cat-icon">🏆</span>
        <span class="cat-title">{t('nav.arena')}</span>
        <span class="cat-count">1 article</span>
      </a>
      <a href={getLocalizedPath('/stars', lang)} class="category-card stars">
        <span class="cat-icon">⭐</span>
        <span class="cat-title">{t('nav.stars')}</span>
        <span class="cat-count">{stars.length} articles</span>
      </a>
      <a href={getLocalizedPath('/quotes', lang)} class="category-card quotes">
        <span class="cat-icon">💬</span>
        <span class="cat-title">{t('nav.quotes')}</span>
        <span class="cat-count">{quotes.length} articles</span>
      </a>
      <a href={getLocalizedPath('/warrior', lang)} class="category-card warrior">
        <span class="cat-icon">⚔️</span>
        <span class="cat-title">{t('nav.warrior')}</span>
        <span class="cat-count">{warrior.length} articles</span>
      </a>
      <a href={getLocalizedPath('/tributes', lang)} class="category-card tributes">
        <span class="cat-icon">💝</span>
        <span class="cat-title">{t('nav.tributes')}</span>
        <span class="cat-count">{tributes.length} articles</span>
      </a>
      <a href={getLocalizedPath('/links', lang)} class="category-card links">
        <span class="cat-icon">🔗</span>
        <span class="cat-title">{t('nav.links')}</span>
        <span class="cat-count">{links.length} articles</span>
      </a>
      <a href={getLocalizedPath('/ugc', lang)} class="category-card ugc">
        <span class="cat-icon">✍️</span>
        <span class="cat-title">{t('nav.ugc')}</span>
        <span class="cat-count">{ugc.length} articles</span>
      </a>
    </div>
  </section>

  <!-- Featured Submissions -->
  <section class="ugc-featured">
    <h2>✍️ Featured Submissions</h2>
    
    <!-- Fan Letters -->
    <div class="ugc-category-block">
      <h3 class="ugc-category-title">💌 Fan Letters</h3>
      <div class="letter-highlight">
        <a href={getLocalizedPath('/ugc/letter-grandmaster-binwayq', lang)} class="letter-card">
          <div class="letter-icon">💌</div>
          <div class="letter-content">
            <h3>My Friend Fan Zhendong</h3>
            <p class="letter-excerpt">"Twelve years make a cycle. Today's Fan Zhendong has long entered the realm of a grandmaster..."</p>
            <span class="letter-author">—— BinwayQ</span>
          </div>
          <span class="letter-arrow">→</span>
        </a>
        <a href={getLocalizedPath('/ugc/letter-to-fzd-gaalgaal', lang)} class="letter-card" style="margin-top: 1rem;">
          <div class="letter-icon">💌</div>
          <div class="letter-content">
            <h3>A Letter to Fan Zhendong</h3>
            <p class="letter-excerpt">"When I think of you, the first image that jumps into my mind is that moment after you won the championship at the Paris Olympics..."</p>
            <span class="letter-author">—— Gaalgaal</span>
          </div>
          <span class="letter-arrow">→</span>
        </a>
      </div>
    </div>

    <!-- Tactical Analysis -->
    <div class="ugc-category-block">
      <h3 class="ugc-category-title">⚔️ Tactical Analysis</h3>
      <div class="letter-highlight">
        <a href={getLocalizedPath('/ugc/fzd-vs-wcc-iq-domination', lang)} class="letter-card tactical">
          <div class="letter-icon">🏓</div>
          <div class="letter-content">
            <h3>Fan Zhendong 4-2 Wang Chuqin: A Victory of Table Tennis IQ</h3>
            <p class="letter-excerpt">"This wasn't a pure technical victory—it was a complete domination of table tennis IQ!"</p>
            <span class="letter-author">—— WeChat「Do You Know Ball」</span>
          </div>
          <span class="letter-arrow">→</span>
        </a>
      </div>
    </div>

    <a href={getLocalizedPath('/ugc', lang)} class="view-more">View all submissions →</a>
  </section>

  <!-- 全部档案 -->
  <section class="all-content">
    <h2>{t('home.all.title')}</h2>
    <div class="content-grid">
      {allContent.map(item => (
        <Card 
          title={item.data.titleEn || item.data.title}
          href={getLocalizedPath(`/${item.category}/${removeLanguagePrefix(item.slug)}`, lang)}
          description={item.data.descriptionEn || item.data.description}
          tag={categoryMap[item.category].name}
        />
      ))}
    </div>
  </section>

  <!-- 底部口号 -->
  <section class="footer-slogan">
    <div class="slogan-main">{t('home.slogan.main')}</div>
    <div class="slogan-sub">{t('home.slogan.sub')}</div>
  </section>
</BaseLayout>

<style>
  /* ============================================================
     HERO TEMPLE (Grand Slam Archive)
     ============================================================ */
  .hero-temple {
    position: relative;
    background: radial-gradient(circle at 50% 20%, #1e293b 0%, #0f172a 45%, #080d1a 100%);
    color: #f8fafc;
    padding: 5rem 1rem 4.5rem;
    overflow: hidden;
    border-bottom: 1px solid rgba(245, 158, 11, 0.2);
    box-shadow: inset 0 -30px 60px rgba(0, 0, 0, 0.5);
  }

  .hero-temple-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 450px;
    background: radial-gradient(ellipse at center, rgba(245, 158, 11, 0.14) 0%, rgba(220, 38, 38, 0.08) 45%, transparent 70%);
    pointer-events: none;
    z-index: 1;
  }

  .hero-temple-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 1080px;
    margin: 0 auto;
  }

  .hero-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.35);
    color: #fde047;
    padding: 0.45rem 1.2rem;
    border-radius: 9999px;
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    backdrop-filter: blur(8px);
    margin-bottom: 1.5rem;
  }

  .hero-pretitle {
    display: block;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.25em;
    color: #94a3b8;
    margin-bottom: 0.4rem;
    text-transform: uppercase;
  }

  .hero-main-title {
    font-size: 3.2rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    margin-bottom: 1.5rem;
    background: linear-gradient(135deg, #ffffff 0%, #fef08a 40%, #f59e0b 80%, #fbbf24 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 4px 30px rgba(245, 158, 11, 0.25);
  }

  .hero-manifesto {
    color: #cbd5e1;
    max-width: 780px;
    margin: 0 auto 2.5rem;
    line-height: 1.85;
    font-size: 1.08rem;
    font-weight: 400;
  }

  .desktop-break {
    display: inline;
  }

  .hl-gold {
    color: #facc15;
    font-weight: 600;
    text-shadow: 0 0 12px rgba(250, 204, 21, 0.3);
  }

  .hl-crimson {
    color: #f87171;
    font-weight: 600;
    text-shadow: 0 0 12px rgba(248, 113, 113, 0.3);
  }

  /* 全满贯勋章矩阵 */
  .grand-slam-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .slam-badge-card {
    background: rgba(30, 41, 59, 0.7);
    border: 1px solid rgba(245, 158, 11, 0.25);
    border-radius: 16px;
    padding: 1.3rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    backdrop-filter: blur(8px);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }

  .slam-badge-card:hover {
    transform: translateY(-4px);
    border-color: rgba(245, 158, 11, 0.6);
    background: rgba(30, 41, 59, 0.9);
    box-shadow: 0 12px 30px rgba(245, 158, 11, 0.2);
  }

  .badge-icon-box {
    font-size: 2rem;
    margin-bottom: 0.6rem;
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.3));
  }

  .badge-title {
    font-size: 1.05rem;
    font-weight: 800;
