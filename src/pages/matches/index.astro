---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import matchesData from '../../data/matches.json';
import rankingsData from '../../data/rankings.json';
import yearlyData from '../../data/yearly.json';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Pre-compute unique values for filters
const events = [...new Set(matchesData.map(m => m.event))].filter(Boolean);
const periods = [...new Set(matchesData.map(m => m.period))].filter(Boolean);
const levels = [...new Set(matchesData.map(m => m.level))].filter(Boolean);
const opponents = [...new Set(matchesData.map(m => m.opponent).filter(o => o && o !== '——'))].sort();
const partners = [...new Set(matchesData.map(m => m.partner).filter(Boolean))].sort();

// Association ordering by table tennis strength
const assocOrder = ['日本', '韩国', '德国', '瑞典', '法国', '中国台北', '中国香港', '新加坡', '巴西', '葡萄牙', '英格兰', '印度', '斯洛文尼亚', '克罗地亚', '罗马尼亚', '尼日利亚', '埃及'];
const rawAssocs = [...new Set(matchesData.map(m => m.assoc))].filter(a => a && a !== '——');
const assocs = rawAssocs.sort((a, b) => {
  const ia = assocOrder.indexOf(a);
  const ib = assocOrder.indexOf(b);
  if (ia !== -1 && ib !== -1) return ia - ib;
  if (ia !== -1) return -1;
  if (ib !== -1) return 1;
  return a.localeCompare(b, 'zh');
});

// Association → Opponents mapping (for linked dropdowns)
const assocOpponentMap = {};
for (const m of matchesData) {
  if (m.assoc && m.assoc !== '——' && m.opponent && m.opponent !== '——') {
    if (!assocOpponentMap[m.assoc]) assocOpponentMap[m.assoc] = new Set();
    assocOpponentMap[m.assoc].add(m.opponent);
  }
}
// Convert Sets to sorted arrays
for (const k of Object.keys(assocOpponentMap)) {
  assocOpponentMap[k] = [...assocOpponentMap[k]].sort();
}

// Event → Partners mapping (for linked dropdowns)
const eventPartnerMap = {};
for (const m of matchesData) {
  if (m.partner && m.event) {
    if (!eventPartnerMap[m.event]) eventPartnerMap[m.event] = new Set();
    eventPartnerMap[m.event].add(m.partner);
  }
}
for (const k of Object.keys(eventPartnerMap)) {
  eventPartnerMap[k] = [...eventPartnerMap[k]].sort();
}

// Stats (only 胜 and 负 count for win rate; W.O. and —— are excluded)
const total = matchesData.length;
const wins = matchesData.filter(m => m.result === '胜').length;
const losses = matchesData.filter(m => m.result === '负').length;
const winRate = ((wins / (wins + losses)) * 100).toFixed(1);

// Unique years for yearly table
const years = [...new Set(yearlyData.map(y => y.year))].sort();
---

<BaseLayout title="战绩查询系统" description="樊振东职业生涯战绩查询系统 - 按对手、搭档、赛事级别等多维度查询">

  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-content">
      <div class="hero-badge">🏓 战绩数据库</div>
      <h1>战绩查询系统</h1>
      <p class="hero-sub">樊振东职业生涯全部正式比赛记录 · 数据截止 2026.8.29</p>
    </div>
  </section>

  <!-- Intro -->
  <section class="intro">
    <p class="intro-text">
      本系统收录樊振东职业生涯正式比赛 <strong>{total}</strong> 场，涵盖大小赛事 <strong>176</strong> 站，国家及以上级冠军 <strong>117</strong> 次。
      可通过时间排序直观查看全部赛事数据，也可通过筛选功能快速查询与某一对手或搭档的交手、组队记录。
    </p>
    <p class="intro-slogan">时光淬炼王者，热爱永燃不熄。携手赴前路，步步皆传奇！</p>
  </section>

  <!-- Stats -->
  <section class="stats-grid">
    <div class="stat-card">
      <span class="stat-value">{total}</span>
      <span class="stat-label">总场次</span>
    </div>
    <div class="stat-card stat-win">
      <span class="stat-value">{wins}</span>
      <span class="stat-label">胜</span>
    </div>
    <div class="stat-card stat-loss">
      <span class="stat-value">{losses}</span>
      <span class="stat-label">负</span>
    </div>
    <div class="stat-card stat-rate">
      <span class="stat-value">{winRate}<small>%</small></span>
      <span class="stat-label">胜率</span>
    </div>
  </section>

  <!-- Dimension Toggle -->
  <section class="dim-toggle-wrap">
    <div class="dim-toggle">
      <button class="dim-btn active" data-dim="opponent">按对手查询</button>
      <button class="dim-btn" data-dim="partner">按搭档查询</button>
    </div>
  </section>

  <!-- Filters: Opponent dimension (matches Excel layout) -->
  <section class="filters" id="filters-opponent">
    <div class="filters-header">
      <span class="filters-icon">🔍</span>
      <span class="filters-title">按对手维度查询</span>
    </div>
    <div class="filter-grid">
      <!-- Left column -->
      <div class="filter-col">
        <div class="filter-group">
          <label for="o-event">比赛项目</label>
          <select id="o-event">
            <option value="">全部</option>
            {events.map(e => <option value={e}>{e}</option>)}
          </select>
        </div>
        <div class="filter-group">
          <label for="o-assoc">对手协会</label>
          <select id="o-assoc">
            <option value="">全部</option>
            {assocs.map(a => <option value={a}>{a}</option>)}
          </select>
        </div>
        <div class="filter-group">
          <label for="o-search">对手名称</label>
          <select id="o-search">
            <option value="">全部</option>
            {opponents.map(o => <option value={o}>{o}</option>)}
          </select>
        </div>
      </div>
      <!-- Right column -->
      <div class="filter-col">
        <div class="filter-group">
          <label for="o-period">周期选择</label>
          <select id="o-period">
            <option value="">全周期</option>
            {periods.map(p => <option value={p}>{p}</option>)}
          </select>
        </div>
        <div class="filter-group">
          <label for="o-level">赛事级别选择</label>
          <select id="o-level">
            <option value="">全级别</option>
            {levels.map(l => <option value={l}>{l}</option>)}
          </select>
        </div>
        <div class="filter-group">
          <label for="o-result">赛果</label>
          <select id="o-result">
            <option value="">全部</option>
            <option value="胜">胜</option>
            <option value="负">负</option>
            <option value="W.O.">W.O.</option>
          </select>
        </div>
        <div class="filter-group">
          <label>胜率</label>
          <div class="winrate-display" id="o-winrate">—</div>
        </div>
      </div>
    </div>
    <div class="filter-actions-row">
      <div class="filter-stats">
        筛选结果：<strong id="o-count">{total}</strong> 场 ·
        胜 <strong id="o-wins">{wins}</strong> ·
        负 <strong id="o-losses">{losses}</strong> ·
        胜率 <strong id="o-rate">{winRate}</strong>%
      </div>
      <button class="btn-reset" id="o-reset">重置筛选</button>
    </div>
  </section>

  <!-- Filters: Partner dimension -->
  <section class="filters" id="filters-partner" style="display:none">
    <div class="filters-header">
      <span class="filters-icon">⚙</span>
      <span class="filters-title">按搭档维度查询</span>
    </div>
    <div class="filter-grid">
      <!-- Left column -->
      <div class="filter-col">
        <div class="filter-group">
          <label for="p-event">比赛项目</label>
          <select id="p-event">
            <option value="">全部</option>
            <option value="双打">双打</option>
            <option value="混双">混双</option>
          </select>
        </div>
        <div class="filter-group">
          <label for="p-search">搭档名称</label>
          <select id="p-search">
            <option value="">全部</option>
            {partners.map(p => <option value={p}>{p}</option>)}
          </select>
        </div>
      </div>
      <!-- Right column -->
      <div class="filter-col">
        <div class="filter-group">
          <label for="p-period">周期</label>
          <select id="p-period">
            <option value="">全部</option>
            {periods.map(p => <option value={p}>{p}</option>)}
          </select>
        </div>
        <div class="filter-group">
          <label for="p-level">赛事级别</label>
          <select id="p-level">
            <option value="">全部</option>
            {levels.map(l => <option value={l}>{l}</option>)}
          </select>
        </div>
        <div class="filter-group">
          <label for="p-result">赛果</label>
          <select id="p-result">
            <option value="">全部</option>
            <option value="胜">胜</option>
            <option value="负">负</option>
            <option value="W.O.">W.O.</option>
          </select>
        </div>
      </div>
    </div>
    <div class="filter-actions-row">
      <div class="filter-stats">
        筛选结果：<strong id="p-count">0</strong> 场 ·
        胜 <strong id="p-wins">0</strong> ·
        负 <strong id="p-losses">0</strong> ·
        胜率 <strong id="p-rate">0</strong>%
      </div>
      <button class="btn-reset" id="p-reset">重置筛选</button>
    </div>
  </section>

  <!-- Table -->
  <section class="table-section">
    <div class="table-scroll">
      <table id="matches-table">
        <thead>
          <tr>
            <th>周期</th>
            <th>比赛名称</th>
            <th>赛事级别</th>
            <th class="sortable" id="th-date">比赛时间 ▼</th>
            <th>比赛场次</th>
            <th>项目</th>
            <th id="th-opponent">对手</th>
            <th id="th-partner">搭档</th>
            <th>赛果</th>
            <th>大比分</th>
            <th>小比分</th>
          </tr>
        </thead>
        <tbody id="matches-body">
        </tbody>
      </table>
    </div>
  </section>

  <!-- Ranking History Chart -->
  <section class="chart-section">
    <h2 class="section-title">世界排名走势</h2>
    <p class="section-sub">ITTF 世界排名 · 积分与位次变化</p>
    <div class="chart-container">
      <canvas id="ranking-chart"></canvas>
    </div>
  </section>

  <!-- Yearly Stats -->
  <section class="yearly-section">
    <h2 class="section-title">年度战绩统计</h2>
    <p class="section-sub">按年份和项目分类的比赛数据与胜率</p>
    <div class="table-scroll">
      <table class="yearly-table">
        <thead>
          <tr>
            <th rowspan="2">年份</th>
            <th rowspan="2">项目</th>
            <th colspan="3" class="group-header">整体</th>
            <th colspan="3" class="group-header">外战</th>
          </tr>
          <tr>
            <th>场数</th>
            <th>胜场</th>
            <th>胜率</th>
            <th>场数</th>
            <th>胜场</th>
            <th>胜率</th>
          </tr>
        </thead>
        <tbody>
          {yearlyData.map(y => (
            <tr>
              <td class="year-cell">{y.year}</td>
              <td>{y.event}</td>
              <td>{y.total}</td>
              <td>{y.wins}</td>
              <td class="rate-cell">{y.rate !== null ? `${y.rate}%` : '—'}</td>
              <td>{y.extTotal}</td>
              <td>{y.extWins}</td>
              <td class="rate-cell">{y.extRate !== null ? `${y.extRate}%` : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Credit -->
  <section class="credit">
    <p>数据来源：<a href="https://weibo.com/baiduFZDbar" target="_blank" rel="noopener noreferrer">@樊振东球迷会-天际樊星</a></p>
    <p class="credit-sub">原始 Excel 文件下载：<a href="http://t.cn/AXXbEeoc" target="_blank" rel="noopener noreferrer">http://t.cn/AXXbEeoc</a>（请下载至电脑端使用 Excel 打开）</p>
  </section>

  <!-- Chart.js CDN -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script is:inline define:vars={{ matchesData, rankingsData, assocOpponentMap, eventPartnerMap }}>
    const data = matchesData;
    const rankings = rankingsData;

    // ===== Dimension Toggle =====
    const dimBtns = document.querySelectorAll('.dim-btn');
    const filtersOpponent = document.getElementById('filters-opponent');
    const filtersPartner = document.getElementById('filters-partner');
    const thOpponent = document.getElementById('th-opponent');
    const thPartner = document.getElementById('th-partner');
    let currentDim = 'opponent';

    dimBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        dimBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentDim = btn.dataset.dim;
        if (currentDim === 'opponent') {
          filtersOpponent.style.display = '';
          filtersPartner.style.display = 'none';
          thOpponent.textContent = '对手';
          thPartner.textContent = '搭档';
        } else {
          filtersOpponent.style.display = 'none';
          filtersPartner.style.display = '';
          thOpponent.textContent = '搭档';
          thPartner.textContent = '对手';
        }
        render();
      });
    });

    // ===== Opponent filters =====
    const oEvent = document.getElementById('o-event');
    const oAssoc = document.getElementById('o-assoc');
    const oPeriod = document.getElementById('o-period');
    const oLevel = document.getElementById('o-level');
    const oResult = document.getElementById('o-result');
    const oSearch = document.getElementById('o-search');
    const oReset = document.getElementById('o-reset');
    const oCount = document.getElementById('o-count');
    const oWinrate = document.getElementById('o-winrate');
    const oWins = document.getElementById('o-wins');
    const oLosses = document.getElementById('o-losses');
    const oRate = document.getElementById('o-rate');

    // ===== Partner filters =====
    const pEvent = document.getElementById('p-event');
    const pPeriod = document.getElementById('p-period');
    const pLevel = document.getElementById('p-level');
    const pResult = document.getElementById('p-result');
    const pSearch = document.getElementById('p-search');
    const pReset = document.getElementById('p-reset');
    const pCount = document.getElementById('p-count');
    const pWins = document.getElementById('p-wins');
    const pLosses = document.getElementById('p-losses');
    const pRate = document.getElementById('p-rate');

    // ===== Common =====
    const tbody = document.getElementById('matches-body');
    const thDate = document.getElementById('th-date');
    let sortAsc = false;

    // Check if assoc matches (handles dual assocs like '德国\\瑞典')
    function assocMatches(mAssoc, filterAssoc) {
      if (!filterAssoc) return true;
      if (!mAssoc) return false;
      if (mAssoc === filterAssoc) return true;
      // Dual assoc: check if either part matches
      if (mAssoc.includes('\\')) {
        return mAssoc.split('\\').some(s => s.trim() === filterAssoc);
      }
      return false;
    }

    function getFiltered() {
      if (currentDim === 'opponent') {
        const ev = oEvent.value;
        const as = oAssoc.value;
        const pe = oPeriod.value;
        const lv = oLevel.value;
        const rs = oResult.value;
        const q = oSearch.value;
        return data.filter(m => {
          if (ev && m.event !== ev) return false;
          if (as && !assocMatches(m.assoc, as)) return false;
          if (pe && m.period !== pe) return false;
          if (lv && m.level !== lv) return false;
          if (rs && m.result !== rs) return false;
          if (q && m.opponent !== q) return false;
          return true;
        });
      } else {
        const ev = pEvent.value;
        const pe = pPeriod.value;
        const lv = pLevel.value;
        const rs = pResult.value;
        const q = pSearch.value;
        return data.filter(m => {
          if (!m.partner) return false;
          if (ev && m.event !== ev) return false;
          if (pe && m.period !== pe) return false;
          if (lv && m.level !== lv) return false;
          if (rs && m.result !== rs) return false;
          if (q && m.partner !== q) return false;
          return true;
        });
      }
    }

    function render() {
      const filtered = getFiltered();
      const sorted = [...filtered].sort((a, b) => {
        const da = a.dateSort || '0000.00.00';
        const db = b.dateSort || '0000.00.00';
        return sortAsc ? da.localeCompare(db) : db.localeCompare(da);
      });

      const w = sorted.filter(m => m.result === '胜').length;
      const l = sorted.filter(m => m.result === '负').length;
      const rate = (w + l) > 0 ? ((w / (w + l)) * 100).toFixed(1) : '0';

      if (currentDim === 'opponent') {
        oCount.textContent = sorted.length;
        oWins.textContent = w;
        oLosses.textContent = l;
        oRate.textContent = rate;

        // Match the Excel query sheet: keep the current opponent-side filters,
        // but do not let the result filter force the rate to 100% or 0%.
        const opName = oSearch.value;
        if (opName) {
          const ev = oEvent.value;
          const as = oAssoc.value;
          const pe = oPeriod.value;
          const lv = oLevel.value;
          const opMatches = data.filter(m => {
            if (ev && m.event !== ev) return false;
            if (as && !assocMatches(m.assoc, as)) return false;
            if (pe && m.period !== pe) return false;
            if (lv && m.level !== lv) return false;
            return m.opponent === opName;
          });
          const opW = opMatches.filter(m => m.result === '胜').length;
          const opL = opMatches.filter(m => m.result === '负').length;
          oWinrate.textContent = (opW + opL) > 0
            ? `${((opW / (opW + opL)) * 100).toFixed(2)}%`
            : '—';
        } else {
          oWinrate.textContent = '—';
        }
      } else {
        pCount.textContent = sorted.length;
        pWins.textContent = w;
        pLosses.textContent = l;
        pRate.textContent = rate;
      }

      const rows = sorted.map(m => {
        const cls = m.result === '胜' ? 'row-win' : m.result === '负' ? 'row-loss' : '';
        const col1 = currentDim === 'opponent'
          ? `${m.opponent}${m.assoc ? ' (' + m.assoc + ')' : ''}`
          : (m.partner || '——');
        const col2 = currentDim === 'opponent'
          ? (m.partner || '——')
          : `${m.opponent}${m.assoc ? ' (' + m.assoc + ')' : ''}`;
        return `<tr class="${cls}">
          <td>${m.period}</td>
          <td>${m.tournament}</td>
          <td>${m.level}</td>
          <td>${m.date || '——'}</td>
          <td>${m.round}</td>
          <td>${m.event}</td>
          <td>${col1}</td>
          <td>${col2}</td>
          <td class="result-cell">${m.result}</td>
          <td>${m.score}</td>
          <td class="games-cell">${m.games}</td>
        </tr>`;
      });
      tbody.innerHTML = rows.join('');
    }

    // Update opponent dropdown based on selected association
    function updateOpponentOptions() {
      const assoc = oAssoc.value;
      const list = assoc ? (assocOpponentMap[assoc] || []) : null;
      const prev = oSearch.value;
      oSearch.innerHTML = '<option value="">全部</option>';
      if (list) {
        list.forEach(name => {
          const opt = document.createElement('option');
          opt.value = name;
          opt.textContent = name;
          oSearch.appendChild(opt);
        });
      } else {
        const all = [...new Set(matchesData.map(m => m.opponent).filter(o => o && o !== '——'))].sort();
        all.forEach(name => {
          const opt = document.createElement('option');
          opt.value = name;
          opt.textContent = name;
          oSearch.appendChild(opt);
        });
      }
      if (prev && oSearch.querySelector('option[value="' + CSS.escape(prev) + '"]')) {
        oSearch.value = prev;
      } else {
        oSearch.value = '';
      }
    }

    // Update partner dropdown based on selected event
    function updatePartnerOptions() {
      const ev = pEvent.value;
      const list = ev ? (eventPartnerMap[ev] || []) : null;
      const prev = pSearch.value;
      pSearch.innerHTML = '<option value="">全部</option>';
      if (list) {
        list.forEach(name => {
          const opt = document.createElement('option');
          opt.value = name;
          opt.textContent = name;
          pSearch.appendChild(opt);
        });
      } else {
        const all = [...new Set(matchesData.map(m => m.partner).filter(Boolean))].sort();
        all.forEach(name => {
          const opt = document.createElement('option');
          opt.value = name;
          opt.textContent = name;
          pSearch.appendChild(opt);
        });
      }
      if (prev && pSearch.querySelector('option[value="' + CSS.escape(prev) + '"]')) {
        pSearch.value = prev;
      } else {
        pSearch.value = '';
      }
    }

    // Opponent events
    [oEvent, oPeriod, oLevel, oResult, oSearch].forEach(el => el.addEventListener('change', render));
    oAssoc.addEventListener('change', () => {
      updateOpponentOptions();
      render();
    });
    oReset.addEventListener('click', () => {
      oEvent.value = ''; oAssoc.value = ''; oPeriod.value = '';
      oLevel.value = ''; oResult.value = ''; oSearch.value = '';
      updateOpponentOptions();
      oWinrate.textContent = '—';
      render();
    });

    // Partner events
    [pPeriod, pLevel, pResult, pSearch].forEach(el => el.addEventListener('change', render));
    pEvent.addEventListener('change', () => {
      updatePartnerOptions();
      render();
    });
    pReset.addEventListener('click', () => {
      pEvent.value = ''; pPeriod.value = '';
      pLevel.value = ''; pResult.value = ''; pSearch.value = '';
      updatePartnerOptions();
      render();
    });

    // Sort
    thDate.addEventListener('click', () => {
      sortAsc = !sortAsc;
      thDate.textContent = sortAsc ? '比赛时间 ▲' : '比赛时间 ▼';
      render();
    });

    // Initial render
    render();

    // ===== Ranking Chart =====
    const ctx = document.getElementById('ranking-chart');
    if (ctx && typeof Chart !== 'undefined') {
      const labels = rankings.map(r => r.date.slice(0, 7));
      const rankValues = rankings.map(r => r.rank);
      const pointValues = rankings.map(r => r.points);

      new Chart(ctx, {
        type: 'line',
        data: {
          labels,
          datasets: [
            {
              label: '世界排名',
              data: rankValues,
              borderColor: '#1e88e5',
              backgroundColor: 'rgba(30,136,229,0.08)',
              fill: true,
              tension: 0.3,
              pointRadius: 0,
              pointHoverRadius: 5,
              borderWidth: 2.5,
