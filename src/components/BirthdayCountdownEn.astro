---
// Birthday Countdown Component - Temporary Module
// Birthday: January 22, 2026 (UTC+8)
---

<section class="birthday-countdown" id="birthdayCountdown">
  <div class="countdown-container">
    <div class="countdown-timer" id="countdownTimer">
      <div class="time-block">
        <span class="time-value" id="days">--</span>
        <span class="time-label">Days</span>
      </div>
      <div class="time-separator">:</div>
      <div class="time-block">
        <span class="time-value" id="hours">--</span>
        <span class="time-label">Hours</span>
      </div>
      <div class="time-separator">:</div>
      <div class="time-block">
        <span class="time-value" id="minutes">--</span>
        <span class="time-label">Min</span>
      </div>
      <div class="time-separator">:</div>
      <div class="time-block">
        <span class="time-value" id="seconds">--</span>
        <span class="time-label">Sec</span>
      </div>
    </div>
    <div class="countdown-date">January 22, 2026</div>
  </div>
</section>

<style>
  .birthday-countdown {
    padding: 1.5rem 1rem;
    background: linear-gradient(135deg, #fff5f5 0%, #ffe0e6 50%, #ffd6e0 100%);
    border-radius: 1rem;
    margin: 1.5rem auto;
    max-width: 600px;
    box-shadow: 0 4px 20px rgba(255, 107, 129, 0.15);
    border: 1px solid rgba(255, 107, 129, 0.2);
  }

  .countdown-container {
    text-align: center;
  }

  .countdown-timer {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.8rem;
  }

  .time-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #fff;
    border-radius: 12px;
    padding: 0.8rem 1rem;
    min-width: 60px;
    box-shadow: 0 2px 10px rgba(233, 30, 99, 0.1);
  }

  .time-value {
    font-size: 1.8rem;
    font-weight: bold;
    color: #e91e63;
    font-family: 'Courier New', monospace;
    line-height: 1;
  }

  .time-label {
    font-size: 0.75rem;
    color: #888;
    margin-top: 0.3rem;
  }

  .time-separator {
    font-size: 1.5rem;
    font-weight: bold;
    color: #e91e63;
    opacity: 0.6;
  }

  .countdown-date {
    font-size: 0.9rem;
    color: #999;
  }

  /* Birthday day styles */
  .birthday-countdown.is-birthday {
    background: linear-gradient(135deg, #fff9c4 0%, #ffecb3 50%, #ffe082 100%);
    border-color: rgba(255, 193, 7, 0.3);
    box-shadow: 0 4px 20px rgba(255, 193, 7, 0.2);
  }

  .birthday-countdown.is-birthday .time-value {
    color: #f57c00;
  }

  /* Responsive */
  @media (max-width: 480px) {
    .time-block {
      min-width: 50px;
      padding: 0.6rem 0.8rem;
    }
    .time-value {
      font-size: 1.4rem;
    }
  }
</style>

<script is:inline>
  (function() {
    // Birthday: January 22, 2026 00:00:00 UTC+8
    const birthdayDate = new Date('2026-01-22T00:00:00+08:00');
    const birthdayEnd = new Date('2026-01-23T00:00:00+08:00');
    
    const container = document.getElementById('birthdayCountdown');
    const daysEl = document.getElementById('days');
    const hoursEl = document.getElementById('hours');
    const minutesEl = document.getElementById('minutes');
    const secondsEl = document.getElementById('seconds');

    function updateCountdown() {
      // Get current time in UTC+8
      const now = new Date();
      const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
      const chinaTime = new Date(utc + (8 * 3600000));
      
      const diff = birthdayDate - chinaTime;
      
      // Check if it's birthday
      if (chinaTime >= birthdayDate && chinaTime < birthdayEnd) {
        container.classList.add('is-birthday');
        daysEl.textContent = 'H';
        hoursEl.textContent = 'B';
        minutesEl.textContent = 'D';
        secondsEl.textContent = '!';
        document.querySelector('.countdown-date').textContent = 'Happy Birthday Xiao Pang! 🎂';
        
        // Hide labels and separators
        document.querySelectorAll('.time-label, .time-separator').forEach(el => {
          el.style.display = 'none';
        });
        
        return;
      }
      
      // Hide if birthday has passed
      if (diff < 0 && chinaTime >= birthdayEnd) {
        container.style.display = 'none';
        return;
      }
      
      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((diff % (1000 * 60)) / 1000);
      
      daysEl.textContent = String(days).padStart(2, '0');
      hoursEl.textContent = String(hours).padStart(2, '0');
      minutesEl.textContent = String(minutes).padStart(2, '0');
      secondsEl.textContent = String(seconds).padStart(2, '0');
    }
    
    // Initial update
    updateCountdown();
    // Update every second
    setInterval(updateCountdown, 1000);
  })();
</script>
