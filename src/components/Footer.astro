---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const slogan = lang === 'en'
  ? 'May we each have a wonderful life.'
  : '祝我们各自拥有美好人生';

const copyrightYear = '2026';
const copyrightOwner = lang === 'en' ? 'Fan Zhendong Archive' : '樊振东的互联网档案馆';
---

<footer class="footer">
  <div class="container footer-inner">
    <p class="disclaimer">{t('footer.disclaimer')}</p>
    <p class="slogan">{slogan}</p>
    <p class="copyright">
      <a href="/admin/sync" style="text-decoration: none; color: inherit; cursor: default;">©</a> {copyrightYear} {copyrightOwner}
    </p>
  </div>
</footer>

<style>
  .footer {
    background: #333;
    color: #aaa;
    padding: 2rem 0;
    margin-top: 3rem;
    text-align: center;
  }
  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .slogan {
    color: #1e88e5;
    font-style: italic;
  }
  .copyright { font-size: 0.85rem; }
</style>
