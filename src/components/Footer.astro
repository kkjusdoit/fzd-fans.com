---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="footer">
  <div class="container footer-inner">
    <p class="disclaimer">{t('footer.disclaimer')}</p>
    <p class="slogan">大雪压青松，青松挺且直。要知松高洁，待到雪化时。——陈毅《青松》</p>
    <p class="copyright">© 2026 樊振东的互联网档案馆</p>
  </div>
</footer>

<style>
  .footer {
    background: #333;
    color: #aaa;
    padding: 2rem 0;
    margin-top: 3rem;
    text-align: center;
  }
  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .slogan {
    color: #c41e3a;
    font-style: italic;
  }
  .copyright { font-size: 0.85rem; }
</style>
