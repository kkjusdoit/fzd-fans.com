  }

  .levels-subtitle strong {
    color: #1e88e5;
    font-size: 0.9rem;
  }

  .levels-header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-jump-current {
    background: #e3f2fd;
    color: #1565c0;
    border: 1px solid #bbdefb;
    padding: 0.35rem 0.7rem;
    border-radius: 0.75rem;
    font-size: 0.76rem;
    font-weight: 800;
