---
interface Props {
  lang?: 'zh' | 'en';
}

const { lang = 'zh' } = Astro.props;
const isEn = lang === 'en';

// Text dictionary
const i18n = {
  title: isEn ? 'Dongdoku - Find the Dong' : '找咚 (Dongdoku)',
  ruleSingle: isEn ? 'Single-tap to mark ✖ Cross' : '单击打叉 ✖ 排除',
  ruleDouble: isEn ? 'Double-tap to place 🏓 Dong' : '双击确定 🏓 找咚',
  ruleGoal: isEn ? '1 Dong per row, column & color block' : '每行/每列/每色块正好 1 个咚',
  levelLabel: isEn ? 'Level' : '第',
  levelSuffix: isEn ? '' : '关',
  levelsBtn: isEn ? 'Levels' : '选关',
  hintBtn: isEn ? 'Hint' : '提示',
  undoBtn: isEn ? 'Undo' : '撤销',
  restartBtn: isEn ? 'Restart' : '重来',
  soundOn: isEn ? 'Sound: ON' : '声音: 开启',
  soundOff: isEn ? 'Sound: OFF' : '声音: 静音',
  placed: isEn ? 'Found' : '已找到',
  lives: isEn ? 'Lives' : '生命值',
  unlockedProgress: isEn ? 'Unlocked Progress' : '已解锁进度',
  gameOverTitle: isEn ? 'Game Over' : '挑战失败 💔',
  gameOverSubtitle: isEn ? 'You used all 3 lives! Don\'t give up, try again!' : '本关 3 次机会已用尽，别灰心，再来一次！',
  retryLevel: isEn ? 'Retry Level 🔄' : '重新挑战本关 🔄',
  winTitle: isEn ? 'Level Completed!' : '恭喜通关！',
  winSubtitle: isEn ? 'Great logic and sharp deduction!' : '大满贯级的观察力与逻辑推导！',
  nextLevel: isEn ? 'Next Level ➡️' : '下一关 ➡️',
  replayLevel: isEn ? 'Replay 🔄' : '再玩一次 🔄',
  backToLevels: isEn ? 'Levels Menu ≡' : '返回选关 ≡',
  jumpToCurrent: isEn ? 'Current Level 🚀' : '跳至最新关 🚀',
  timeSpent: isEn ? 'Time' : '用时',
  movesCount: isEn ? 'Moves' : '步数',
  close: isEn ? 'Close' : '关闭'
};
---

<div class="dongdoku-container" id="dongdoku-app" data-lang={lang}>
  <!-- 顶部简约控制与状态栏 -->
  <header class="game-header">
    <div class="header-left">
      <button type="button" class="btn-icon btn-levels" id="btn-open-levels" title={i18n.levelsBtn} aria-label={i18n.levelsBtn}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <span class="btn-text">{i18n.levelsBtn}</span>
      </button>
      <div class="level-indicator">
        <span class="level-badge" id="level-badge">{i18n.levelLabel} <strong id="cur-level-num">1</strong> {i18n.levelSuffix}</span>
      </div>
    </div>

    <div class="header-center">
      <!-- 3 条命 (Hearts) & 进度 -->
      <div class="lives-pill" id="lives-pill" title={i18n.lives}>
        <span class="lives-display" id="lives-display">❤️❤️❤️</span>
      </div>
      <div class="progress-pill" id="progress-pill" title={i18n.placed}>
        <span class="pill-icon">🏓</span>
        <span id="placed-count">0</span>/<span id="target-count">4</span>
      </div>
    </div>

    <div class="header-right">
      <button type="button" class="btn-icon" id="btn-hint" title={i18n.hintBtn} aria-label={i18n.hintBtn}>
        <span class="icon-emoji">💡</span>
        <span class="btn-text">{i18n.hintBtn}</span>
      </button>
      <button type="button" class="btn-icon" id="btn-undo" title={i18n.undoBtn} aria-label={i18n.undoBtn}>
        <span class="icon-emoji">↺</span>
        <span class="btn-text">{i18n.undoBtn}</span>
      </button>
      <button type="button" class="btn-icon" id="btn-restart" title={i18n.restartBtn} aria-label={i18n.restartBtn}>
        <span class="icon-emoji">↻</span>
        <span class="btn-text">{i18n.restartBtn}</span>
      </button>
      <button type="button" class="btn-icon btn-sound" id="btn-sound" title={i18n.soundOn} aria-label={i18n.soundOn}>
        <span id="sound-icon">🔊</span>
      </button>
    </div>
  </header>

  <!-- 简约清晰的玩法说明条（手机竖屏一目了然） -->
  <section class="game-rules-tip" aria-label="游戏规则">
    <div class="rule-tag">
      <span class="rule-icon">👆</span>
      <span class="rule-txt">单击 <strong>打叉 ✖ 排除</strong></span>
    </div>
    <div class="rule-divider">·</div>
    <div class="rule-tag">
      <span class="rule-icon">✌️</span>
      <span class="rule-txt">双击 <strong>确定 🏓 找咚</strong></span>
    </div>
    <div class="rule-divider">·</div>
    <div class="rule-tag">
      <span class="rule-icon">🎯</span>
      <span class="rule-txt">每行/列/色 <strong>各 1 咚</strong></span>
    </div>
  </section>

  <!-- 提示条 / 报错提示条 (Toast Bar) -->
  <div class="toast-message-box" id="toast-message-box" style="display: none;">
    <span class="toast-icon" id="toast-icon">💡</span>
    <span class="toast-text" id="toast-text"></span>
    <button type="button" class="toast-close" id="btn-close-toast">×</button>
  </div>

  <!-- 核心游戏棋盘区（完美适配手机端竖屏） -->
  <main class="board-wrapper">
    <div class="board-container" id="board-container">
      <div class="game-grid" id="game-grid">
        <!-- 动态生成格子 -->
      </div>
    </div>
  </main>

  <!-- 选关模态弹窗 (Premium Levels Modal) -->
  <div class="modal-backdrop" id="modal-levels" style="display: none;">
    <div class="modal-content modal-levels-content">
      <!-- 选关顶部头图与进度 -->
      <div class="levels-modal-header">
        <div class="levels-title-group">
          <div class="levels-main-title">
            <span class="title-emoji">🏆</span>
            <h2>{i18n.levelsBtn} (1 ~ 1000)</h2>
          </div>
          <p class="levels-subtitle">
            {i18n.unlockedProgress}: <strong id="levels-unlocked-count">1</strong> / 1000
          </p>
        </div>
        <div class="levels-header-actions">
          <button type="button" class="btn-jump-current" id="btn-jump-current">{i18n.jumpToCurrent}</button>
          <button type="button" class="modal-close" id="btn-close-levels">×</button>
        </div>
      </div>

      <!-- 分包分页选项卡 -->
      <div class="levels-pack-nav">
        <div class="levels-pack-tabs" id="levels-pack-tabs">
          <!-- 分页 Tabs: 1-50, 51-100, 101-150 ... -->
        </div>
      </div>

      <!-- 关卡卡片网格 -->
      <div class="levels-grid-wrapper">
        <div class="levels-grid" id="levels-grid">
          <!-- 关卡卡片 -->
        </div>
      </div>
    </div>
  </div>

  <!-- 游戏失败弹窗 (Game Over Modal) -->
  <div class="modal-backdrop" id="modal-gameover" style="display: none;">
    <div class="modal-content modal-win-content modal-gameover-content">
      <div class="gameover-icon">💔</div>
      <h2 class="gameover-title">{i18n.gameOverTitle}</h2>
      <p class="win-subtitle">{i18n.gameOverSubtitle}</p>
      
      <div class="win-avatar-showcase">
        <div class="gameover-avatar-box"></div>
      </div>

      <div class="win-actions">
        <button type="button" class="btn-primary" id="btn-gameover-restart">{i18n.retryLevel}</button>
        <button type="button" class="btn-secondary" id="btn-gameover-levels">{i18n.backToLevels}</button>
      </div>
    </div>
  </div>

  <!-- 通关胜利弹窗 (Win Modal) -->
  <div class="modal-backdrop" id="modal-win" style="display: none;">
    <div class="modal-content modal-win-content">
      <div class="win-trophy">🏆</div>
      <h2 class="win-title">{i18n.winTitle}</h2>
      <p class="win-subtitle">{i18n.winSubtitle}</p>
      
      <div class="win-avatar-showcase">
        <div class="win-avatar-large-box" id="win-avatar-box"></div>
        <div class="win-gold-badge">🥇 PARIS 2024 CHAMPION</div>
      </div>

      <div class="win-stats-grid">
        <div class="stat-box">
          <span class="stat-label">{i18n.movesCount}</span>
          <span class="stat-value" id="win-moves">8</span>
        </div>
      </div>

      <div class="win-actions">
        <button type="button" class="btn-primary" id="btn-next-level">{i18n.nextLevel}</button>
        <button type="button" class="btn-secondary" id="btn-replay-level">{i18n.replayLevel}</button>
        <button type="button" class="btn-secondary" id="btn-win-levels">{i18n.backToLevels}</button>
      </div>
    </div>
  </div>
</div>

<style>
  /* 基础容器 */
  .dongdoku-container {
    max-width: 580px;
    margin: 0 auto;
    padding: 0.2rem 0.4rem 1.5rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: #3d302c;
    user-select: none;
    -webkit-user-select: none;
    box-sizing: border-box;
  }

  /* 顶部简约控制栏 */
  .game-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem;
    background: #ffffff;
    border: 1px solid #ebdcd5;
    border-radius: 1.1rem;
    padding: 0.35rem 0.65rem;
    box-shadow: 0 3px 12px rgba(78, 64, 55, 0.06);
  }

  .header-left, .header-center, .header-right {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .level-badge {
    font-weight: 900;
    font-size: 1rem;
    color: #3d302c;
    white-space: nowrap;
  }

  .lives-pill, .progress-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    background: #fdf6f0;
    border: 1px solid #eedfd8;
    padding: 0.22rem 0.45rem;
    border-radius: 0.8rem;
    font-weight: 800;
    font-size: 0.8rem;
    color: #705851;
    white-space: nowrap;
  }

  .lives-display {
    font-size: 0.82rem;
    letter-spacing: 1px;
  }

  .btn-icon {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    background: #ffffff;
    border: 1px solid #e5d5cd;
    color: #6e554d;
    padding: 0.3rem 0.45rem;
    border-radius: 0.65rem;
    font-weight: 700;
    font-size: 0.78rem;
    cursor: pointer;
    transition: all 0.15s ease;
    box-shadow: 0 1px 3px rgba(78, 64, 55, 0.04);
  }

  .btn-levels {
    background: #fdf8f5;
    border-color: #ebdcd5;
    font-weight: 800;
  }

  .btn-icon:hover {
    background: #fbf5f2;
    color: #1e88e5;
    border-color: #bbdefb;
    transform: translateY(-1px);
  }

  .btn-icon:active {
    transform: translateY(1px);
  }

  .btn-sound {
    padding: 0.3rem 0.35rem;
  }

  .icon-emoji {
    font-size: 0.85rem;
  }

  /* 简约清晰规则说明条 */
  .game-rules-tip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin: 0.35rem 0 0.35rem;
    background: #fdfaf8;
    border: 1px solid #f2e6e0;
    border-radius: 0.9rem;
    padding: 0.3rem 0.6rem;
    font-size: 0.76rem;
    color: #6d544c;
    flex-wrap: wrap;
  }

  .rule-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    white-space: nowrap;
  }

  .rule-tag strong {
    color: #2b1f1a;
  }

  .rule-icon {
    font-size: 0.85rem;
  }

  .rule-divider {
    color: #d1b8af;
    font-weight: bold;
  }

  /* 提示与报错条 */
  .toast-message-box {
    border-radius: 0.8rem;
    padding: 0.45rem 0.75rem;
    margin: 0.25rem 0 0.35rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 700;
    animation: fadeIn 0.2s ease;
  }

  .toast-message-box.toast-hint {
    background: #fff9db;
    border: 1px solid #ffe066;
    color: #744210;
    box-shadow: 0 3px 10px rgba(230, 180, 0, 0.12);
  }

  .toast-message-box.toast-error {
    background: #ffebee;
    border: 1px solid #ffcdd2;
    color: #c62828;
    box-shadow: 0 3px 10px rgba(244, 67, 54, 0.15);
    animation: shakeToast 0.35s ease-in-out;
  }

  .toast-text {
    flex: 1;
  }

  .toast-close {
    background: none;
    border: none;
    font-size: 1.1rem;
    color: inherit;
    cursor: pointer;
    line-height: 1;
  }

  /* 核心棋盘区（手机端竖屏全屏适配） */
  .board-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0.25rem 0;
  }

  .board-container {
    background: #ffffff;
    border: 1px solid #ebdcd5;
    border-radius: 1.3rem;
    padding: 0.6rem;
    box-shadow: 0 8px 24px rgba(78, 64, 55, 0.08);
    width: 100%;
    max-width: min(94vw, 440px, calc(100vh - 170px));
    aspect-ratio: 1 / 1;
    display: flex;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
  }

  .game-grid {
    display: grid;
    width: 100%;
    height: 100%;
    gap: clamp(3px, 1.1vw, 7px);
    box-sizing: border-box;
  }

  /* 棋盘格子 */
  .grid-cell {
    position: relative !important;
    width: 100% !important;
    height: 100% !important;
    aspect-ratio: 1 / 1 !important;
    border-radius: clamp(7px, 1.6vw, 13px) !important;
    border: 2.2px solid #ffffff !important;
    cursor: pointer !important;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.08) !important;
    transition: transform 0.1s ease, filter 0.1s ease !important;
    overflow: hidden !important;
    box-sizing: border-box !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    touch-action: manipulation !important;
    user-select: none !important;
    -webkit-user-select: none !important;
    -webkit-tap-highlight-color: transparent !important;
  }

  .grid-cell:hover {
    transform: scale(1.02);
    filter: brightness(1.05);
    z-index: 2;
  }

  .grid-cell:active {
    transform: scale(0.95);
  }

  .grid-cell.cell-locked {
    cursor: default !important;
  }
  .grid-cell.cell-locked:hover {
    transform: none !important;
  }

  /* 单元格状态：白色 ✖ 排除叉（单击产生） */
  .cell-cross-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50%;
    height: 50%;
    pointer-events: none !important;
    animation: popCross 0.18s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }

  .cross-svg {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.25));
  }

  /* 单元格状态：🏓 樊振东头像容器（双击产生） */
  .cell-dong-wrap {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none !important;
    border-radius: inherit;
    overflow: hidden;
  }

  /* 精致圆形头像（基于 background-image） */
  .cell-dong-avatar {
    width: 82% !important;
    height: 82% !important;
    border-radius: 50% !important;
    background-size: cover !important;
    background-position: center 20% !important;
    background-repeat: no-repeat !important;
    border: 2.2px solid #ffffff !important;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.28) !important;
    animation: popDong 0.22s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    box-sizing: border-box !important;
    flex-shrink: 0 !important;
  }

  /* 🚫 找错咚 / 错误尝试覆盖图层 */
  .cell-ban-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(229, 57, 53, 0.28);
    border-radius: inherit;
    pointer-events: none !important;
    animation: popBan 0.22s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }

  .ban-svg {
    width: 68%;
    height: 68%;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.45));
  }

  /* 找错态外框警示 */
  .grid-cell.has-conflict {
    border-color: #ff1744 !important;
    animation: errorShake 0.4s ease-in-out;
  }

  /* 提示高亮态 */
  .grid-cell.hint-active {
    animation: pulseHint 1.2s infinite;
    border-color: #ffd700 !important;
    z-index: 5;
  }

  /* 弹窗通用样式 */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(30, 20, 15, 0.65);
    backdrop-filter: blur(6px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    animation: fadeIn 0.2s ease;
  }

  .modal-content {
    background: #ffffff;
    border-radius: 1.5rem;
    box-shadow: 0 24px 60px rgba(0,0,0,0.3);
    max-height: 90vh;
    overflow-y: auto;
    width: 100%;
    animation: scaleUp 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  /* 选关弹窗 */
  .modal-levels-content {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid #ebdcd5;
  }

  .levels-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.3rem;
    background: linear-gradient(135deg, #ffffff, #fcf8f6);
    border-bottom: 1px solid #ebdcd5;
  }

  .levels-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .levels-main-title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .levels-main-title h2 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 900;
    color: #3d302c;
  }

  .title-emoji {
    font-size: 1.3rem;
  }

  .levels-subtitle {
    margin: 0;
    font-size: 0.78rem;
    color: #8c736c;
    font-weight: 700;
  }

  .levels-subtitle strong {
    color: #1e88e5;
    font-size: 0.9rem;
  }

  .levels-header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-jump-current {
    background: #e3f2fd;
    color: #1565c0;
    border: 1px solid #bbdefb;
    padding: 0.35rem 0.7rem;
    border-radius: 0.75rem;
    font-size: 0.76rem;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-jump-current:hover {
    background: #1e88e5;
    color: #ffffff;
    border-color: #1e88e5;
  }

  .modal-close {
    background: #f5ece7;
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    font-size: 1.3rem;
    cursor: pointer;
    color: #705851;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
  }

  .modal-close:hover {
    background: #ebdcd5;
    color: #000;
  }

  /* 选关分页 Pill 选项卡 */
  .levels-pack-nav {
    background: #faf5f2;
    border-bottom: 1px solid #ebdcd5;
    padding: 0.55rem 0.8rem;
  }

  .levels-pack-tabs {
    display: flex;
    gap: 0.4rem;
    overflow-x: auto;
    padding-bottom: 0.2rem;
    scrollbar-width: thin;
  }

  .levels-pack-tabs::-webkit-scrollbar {
    height: 4px;
  }
  .levels-pack-tabs::-webkit-scrollbar-thumb {
    background: #ebdcd5;
    border-radius: 2px;
  }

  .pack-tab-btn {
    padding: 0.35rem 0.8rem;
    border-radius: 0.8rem;
    border: 1.5px solid #ebdcd5;
    background: #ffffff;
    font-size: 0.78rem;
    font-weight: 800;
    color: #705851;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .pack-tab-btn:hover {
    border-color: #1e88e5;
    color: #1e88e5;
  }

  .pack-tab-btn.active {
    background: linear-gradient(135deg, #1e88e5, #1565c0);
    color: #ffffff;
    border-color: #1e88e5;
    box-shadow: 0 3px 10px rgba(30, 136, 229, 0.35);
  }

  /* 关卡卡片网格容器 */
  .levels-grid-wrapper {
    padding: 1rem;
    overflow-y: auto;
    max-height: 55vh;
    background: #ffffff;
  }

  .levels-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
    gap: 0.65rem;
  }

  /* 关卡卡片 */
  .level-card {
    aspect-ratio: 1 / 1;
