  }

  .pack-tab-btn {
    padding: 0.35rem 0.8rem;
    border-radius: 0.8rem;
    border: 1.5px solid #ebdcd5;
    background: #ffffff;
    font-size: 0.78rem;
    font-weight: 800;
    color: #705851;
