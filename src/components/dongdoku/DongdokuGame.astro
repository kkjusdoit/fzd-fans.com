</style>

<script>
  import { INITIAL_LEVELS } from './initialLevels';

  // ==========================================
  // 《找咚》(Dongdoku) 客户端核心引擎
  // ==========================================

  // 色彩配置表（柔和莫兰迪马卡龙色盘，与 Meowdoku 一致）
  const REGION_COLORS = [
    '#6CB6DC', // 0: 天空蓝 Sky Blue
    '#A9D893', // 1: 嫩绿 Soft Green
    '#E8C94F', // 2: 暖阳黄 Soft Yellow
    '#D896B3', // 3: 蔷薇粉 Soft Pink
    '#67C5BF', // 4: 薄荷绿 Mint Teal
    '#DD84CB', // 5: 薰衣草紫 Magenta
    '#FAB1A0', // 6: 暖杏桃 Warm Peach
    '#A29BFE', // 7: 浅紫 Lavender
    '#FD79A8', // 8: 亮粉 Hot Pink
    '#81ECEC', // 9: 青碧 Bright Cyan
    '#FDCB6E', // 10: 太阳金 Sun Yellow
    '#B2BEC3', // 11: 银灰 Cool Silver
    '#55EFC4', // 12: 翡翠绿 Light Emerald
    '#E17055', // 13: 暖陶红 Terracotta
    '#74B9FF'  // 14: 湛蓝 Clear Blue
  ];

  // 24 款经典樊振东头像库（点开随机出现）
  const AVATAR_PATHS = Array.from({ length: 24 }, (_, i) => {
    const num = i.toString().padStart(3, '0');
    return `/game/assets/image-%20${num}.webp`;
  });

  // 音效控制器
  class SoundManager {
    private matchSound: HTMLAudioElement;
    private explosionSound: HTMLAudioElement;
    private winSound: HTMLAudioElement;
    private fzdSound: HTMLAudioElement;
    public enabled: boolean = true;

    constructor() {
      this.matchSound = new Audio('/audio/itemmatch.ogg');
      this.explosionSound = new Audio('/audio/new_explosion.wav');
      this.winSound = new Audio('/audio/level_win.ogg');
      this.fzdSound = new Audio('/audio/fanzhendong.wav');

      this.matchSound.volume = 0.45;
      this.explosionSound.volume = 0.25;
      this.winSound.volume = 0.55;
      this.fzdSound.volume = 0.7;
    }

    playPlace() {
      if (!this.enabled) return;
      this.matchSound.currentTime = 0;
      this.matchSound.play().catch(() => {});
    }

    playCross() {
      if (!this.enabled) return;
      this.explosionSound.currentTime = 0;
      this.explosionSound.play().catch(() => {});
    }

    playWin() {
      if (!this.enabled) return;
      this.winSound.currentTime = 0;
      this.winSound.play().catch(() => {});
      setTimeout(() => {
        this.fzdSound.currentTime = 0;
        this.fzdSound.play().catch(() => {});
      }, 500);
    }
  }

  // 游戏主控制器
  class DongdokuApp {
    private container: HTMLElement;
    private levelCache: Map<number, any> = new Map();
    private manifest: Array<{ id: number; size: number; difficulty: string; diffText: string }> = [];
    
    // 游戏状态
    private currentLevelId: number = 1;
    private maxUnlockedLevel: number = 1;
    private currentLevelData: any = null;
    private gridState: number[][] = []; // 0=Empty, 1=Cross, 2=Dong
    private cellAvatars: Map<string, string> = new Map(); // `${r},${c}` -> avatarPath
    private undoStack: string[] = []; // JSON snapshots
    private moveCount: number = 0;
    private startTime: number = 0;
    private timerInterval: any = null;
    private elapsedSeconds: number = 0;
    
    // 设置
    private touchMode: 'cycle' | 'dong' | 'cross' = 'cycle';
    private autoCross: boolean = true;
    private sounds: SoundManager;

    constructor() {
      this.container = document.getElementById('dongdoku-app')!;
      this.sounds = new SoundManager();
      
      // 将初始内嵌关卡存入缓存
      for (const [idStr, data] of Object.entries(INITIAL_LEVELS)) {
        this.levelCache.set(Number(idStr), data);
      }

      this.loadStorage();
      this.initDOMElements();
      this.initEvents();
      
      // 立即加载并渲染当前关卡（零延迟！）
      this.loadLevel(this.currentLevelId);

      // 后台静默拉取关卡总目录清单
      this.fetchManifest();
    }

    // 从 LocalStorage 加载记录
    private loadStorage() {
      try {
        const saved = localStorage.getItem('dongdoku_save_v1');
        if (saved) {
          const parsed = JSON.parse(saved);
          if (parsed.currentLevelId) this.currentLevelId = parsed.currentLevelId;
          if (parsed.maxUnlockedLevel) this.maxUnlockedLevel = parsed.maxUnlockedLevel;
          if (parsed.autoCross !== undefined) this.autoCross = parsed.autoCross;
          if (parsed.touchMode) this.touchMode = parsed.touchMode;
          if (parsed.soundEnabled !== undefined) this.sounds.enabled = parsed.soundEnabled;
        }
      } catch (e) {
        console.warn('Failed to parse localStorage', e);
      }
    }

    // 保存到 LocalStorage
    private saveStorage(saveBoard: boolean = true) {
      try {
        const payload: any = {
          currentLevelId: this.currentLevelId,
          maxUnlockedLevel: this.maxUnlockedLevel,
          autoCross: this.autoCross,
          touchMode: this.touchMode,
          soundEnabled: this.sounds.enabled
        };

        if (saveBoard) {
          payload.boardState = {
            levelId: this.currentLevelId,
            grid: this.gridState,
            elapsed: this.elapsedSeconds
          };
        }

        localStorage.setItem('dongdoku_save_v1', JSON.stringify(payload));
      } catch (e) {
        console.warn('Failed to save to localStorage', e);
      }
    }

    // 获取关卡总索引清单
    private async fetchManifest() {
      try {
        const res = await fetch('/data/dongdoku/manifest.json');
        if (res.ok) {
          this.manifest = await res.json();
        }
      } catch (e) {
        console.warn('Failed to fetch manifest', e);
      }
    }

    // 动态获取关卡数据（带分包缓存）
    private async fetchLevelData(levelId: number): Promise<any> {
      if (this.levelCache.has(levelId)) {
        return this.levelCache.get(levelId);
      }

      // 计算对应的 pack_X.json (50个一组，1-50 -> 0, 51-100 -> 1...)
      const packIdx = Math.floor((levelId - 1) / 50);
      try {
        const res = await fetch(`/data/dongdoku/pack_${packIdx}.json`);
        if (res.ok) {
          const packData = await res.json();
          for (const [lid, data] of Object.entries(packData)) {
            this.levelCache.set(Number(lid), data);
          }
          return this.levelCache.get(levelId);
        }
      } catch (e) {
        console.error(`Failed to fetch pack ${packIdx}`, e);
      }
      return null;
    }

    // 初始化 DOM 引用与状态
    private initDOMElements() {
      const chkAuto = document.getElementById('chk-auto-cross') as HTMLInputElement;
      if (chkAuto) chkAuto.checked = this.autoCross;

      const soundIcon = document.getElementById('sound-icon');
      if (soundIcon) soundIcon.textContent = this.sounds.enabled ? '🔊' : '🔇';

      this.updateModeButtons();
    }

    // 事件绑定
    private initEvents() {
      // 模式切换
      document.querySelectorAll('.mode-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const mode = (e.currentTarget as HTMLElement).getAttribute('data-mode') as any;
          this.touchMode = mode;
          this.updateModeButtons();
          this.saveStorage(false);
        });
      });

      // 自动划叉开关
      const chkAuto = document.getElementById('chk-auto-cross') as HTMLInputElement;
      if (chkAuto) {
        chkAuto.addEventListener('change', () => {
          this.autoCross = chkAuto.checked;
          this.saveStorage(false);
        });
      }

      // 音效开关
      const btnSound = document.getElementById('btn-sound');
      if (btnSound) {
        btnSound.addEventListener('click', () => {
          this.sounds.enabled = !this.sounds.enabled;
          const soundIcon = document.getElementById('sound-icon');
          if (soundIcon) soundIcon.textContent = this.sounds.enabled ? '🔊' : '🔇';
          this.saveStorage(false);
        });
      }

      // 撤销
      document.getElementById('btn-undo')?.addEventListener('click', () => this.handleUndo());

      // 重来
      document.getElementById('btn-restart')?.addEventListener('click', () => this.handleRestart());

      // 提示
      document.getElementById('btn-hint')?.addEventListener('click', () => this.handleHint());

      // 关闭提示条
      document.getElementById('btn-close-hint')?.addEventListener('click', () => {
        const hintBox = document.getElementById('hint-message-box');
        if (hintBox) hintBox.style.display = 'none';
        this.clearHintHighlights();
      });

      // 选关弹窗
      document.getElementById('btn-open-levels')?.addEventListener('click', () => this.openLevelsModal());
      document.getElementById('btn-close-levels')?.addEventListener('click', () => this.closeModal('modal-levels'));
      document.getElementById('btn-win-levels')?.addEventListener('click', () => {
        this.closeModal('modal-win');
        this.openLevelsModal();
      });

      // 胜利弹窗中的下一关 / 重玩
      document.getElementById('btn-next-level')?.addEventListener('click', () => {
        this.closeModal('modal-win');
        this.loadLevel(this.currentLevelId + 1);
      });
      document.getElementById('btn-replay-level')?.addEventListener('click', () => {
        this.closeModal('modal-win');
        this.handleRestart();
      });
    }

    private updateModeButtons() {
      document.querySelectorAll('.mode-btn').forEach(btn => {
        const mode = btn.getAttribute('data-mode');
        if (mode === this.touchMode) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    }

    // 随机获取一款樊振东头像
    private getRandomAvatar(): string {
      const idx = Math.floor(Math.random() * AVATAR_PATHS.length);
      return AVATAR_PATHS[idx];
    }

    // 加载指定关卡
    public async loadLevel(levelId: number) {
      if (levelId < 1) levelId = 1;
      if (levelId > 1000) levelId = 1000;

      this.currentLevelId = levelId;
      if (levelId > this.maxUnlockedLevel) {
        this.maxUnlockedLevel = levelId;
      }
      this.saveStorage(false);

      let data = this.levelCache.get(levelId);
      if (!data) {
        // 显示加载提示
        const gridEl = document.getElementById('game-grid');
        if (gridEl) gridEl.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:2rem;color:#999;">正在加载关卡...</div>';
        data = await this.fetchLevelData(levelId);
      }

      if (!data) {
        alert('关卡数据加载失败，请检查网络');
        return;
      }

      this.currentLevelData = data;
      this.initBoardState(data);
      this.renderUI(data);
      this.startTimer();
    }

    // 初始化棋盘数据与暂存恢复
    private initBoardState(data: any) {
      const size = data.size;
      this.gridState = Array.from({ length: size }, () => Array(size).fill(0));
      this.cellAvatars.clear();
      this.undoStack = [];
      this.moveCount = 0;

      // 检查是否有未完成的暂存进度
      try {
        const saved = localStorage.getItem('dongdoku_save_v1');
        if (saved) {
          const parsed = JSON.parse(saved);
          if (parsed.boardState && parsed.boardState.levelId === this.currentLevelId && parsed.boardState.grid) {
            this.gridState = parsed.boardState.grid;
            this.elapsedSeconds = parsed.boardState.elapsed || 0;
            // 恢复已放咚的随机头像
            for (let r = 0; r < size; r++) {
              for (let c = 0; c < size; c++) {
                if (this.gridState[r][c] === 2) {
                  this.cellAvatars.set(`${r},${c}`, this.getRandomAvatar());
                }
              }
            }
          } else {
            this.elapsedSeconds = 0;
          }
        }
      } catch (e) {}
    }

    // 渲染 UI 与网格
    private renderUI(data: any) {
      // 更新顶部信息
      const curLvlNum = document.getElementById('cur-level-num');
      if (curLvlNum) curLvlNum.textContent = data.id.toString();

      const diffBadge = document.getElementById('cur-diff-badge');
      if (diffBadge) diffBadge.textContent = data.diffText || '简单';

      const sizeBadge = document.getElementById('cur-size-badge');
      if (sizeBadge) sizeBadge.textContent = `${data.size}×${data.size}`;

      const targetCount = document.getElementById('target-count');
      if (targetCount) targetCount.textContent = data.size.toString();

      // 关闭提示条
      const hintBox = document.getElementById('hint-message-box');
      if (hintBox) hintBox.style.display = 'none';

      // 渲染棋盘
      const gridEl = document.getElementById('game-grid');
      if (!gridEl) return;

      const size = data.size;
      gridEl.style.gridTemplateColumns = `repeat(${size}, minmax(0, 1fr))`;
      gridEl.style.gridTemplateRows = `repeat(${size}, minmax(0, 1fr))`;
      gridEl.innerHTML = '';

      for (let r = 0; r < size; r++) {
        for (let c = 0; c < size; c++) {
          const regionId = data.regions[r][c];
          const cellEl = document.createElement('div');
          cellEl.className = 'grid-cell';
          cellEl.setAttribute('data-row', r.toString());
          cellEl.setAttribute('data-col', c.toString());
          cellEl.setAttribute('data-region', regionId.toString());
          
          // 设置莫兰迪马卡龙区域颜色
          const color = REGION_COLORS[regionId % REGION_COLORS.length];
          cellEl.style.backgroundColor = color;

          // 点击事件
          cellEl.addEventListener('click', () => this.handleCellClick(r, c));

          // 右键 / 长按标 ❌
          cellEl.addEventListener('contextmenu', (e) => {
            e.preventDefault();
            this.handleCellRightClick(r, c);
          });

          gridEl.appendChild(cellEl);
        }
      }

      this.updateBoardDisplay();
    }

    // 计时器
    private startTimer() {
      if (this.timerInterval) clearInterval(this.timerInterval);
      this.startTime = Date.now() - this.elapsedSeconds * 1000;
      this.timerInterval = setInterval(() => {
        this.elapsedSeconds = Math.floor((Date.now() - this.startTime) / 1000);
        const mins = Math.floor(this.elapsedSeconds / 60).toString().padStart(2, '0');
        const secs = (this.elapsedSeconds % 60).toString().padStart(2, '0');
        const disp = document.getElementById('timer-display');
        if (disp) disp.textContent = `${mins}:${secs}`;
      }, 1000);
    }

    // 单元格点击处理
    private handleCellClick(r: number, c: number) {
      this.clearHintHighlights();
      this.pushUndoSnapshot();

      const currentVal = this.gridState[r][c];
      let nextVal = 0;

      if (this.touchMode === 'cycle') {
        // 空白 (0) -> 标❌ (1) -> 放置咚 (2) -> 空白 (0)
        if (currentVal === 0) nextVal = 1;
        else if (currentVal === 1) nextVal = 2;
        else nextVal = 0;
      } else if (this.touchMode === 'dong') {
        // 放咚模式：如果是咚则清空，否则放咚
        nextVal = currentVal === 2 ? 0 : 2;
      } else if (this.touchMode === 'cross') {
        // 标叉模式：如果是叉则清空，否则标叉
        nextVal = currentVal === 1 ? 0 : 1;
      }

      this.gridState[r][c] = nextVal;
      this.moveCount++;

      // 播放音效与随机头像分配
      if (nextVal === 2) {
        this.cellAvatars.set(`${r},${c}`, this.getRandomAvatar());
        this.sounds.playPlace();
        // 自动划叉辅助
        if (this.autoCross) {
          this.applyAutoCross(r, c);
        }
      } else {
        this.cellAvatars.delete(`${r},${c}`);
        if (nextVal === 1) {
          this.sounds.playCross();
        }
      }

      this.updateBoardDisplay();
      this.saveStorage(true);
      this.checkWinCondition();
    }

    // 右键快速标 ❌
    private handleCellRightClick(r: number, c: number) {
      this.pushUndoSnapshot();
      const currentVal = this.gridState[r][c];
      const nextVal = currentVal === 1 ? 0 : 1;
      this.gridState[r][c] = nextVal;
      if (nextVal !== 2) this.cellAvatars.delete(`${r},${c}`);
      this.sounds.playCross();
      this.updateBoardDisplay();
      this.saveStorage(true);
    }

    // 自动划叉辅助：当在 (r, c) 放置咚时，自动将同行、同列、同色块、八邻域的空位标❌
    private applyAutoCross(dongRow: number, dongCol: number) {
      const size = this.currentLevelData.size;
      const regionId = this.currentLevelData.regions[dongRow][dongCol];

      for (let r = 0; r < size; r++) {
        for (let c = 0; c < size; c++) {
          if (r === dongRow && c === dongCol) continue;
          if (this.gridState[r][c] !== 0) continue; // 已有内容不覆盖

          const isSameRow = (r === dongRow);
          const isSameCol = (c === dongCol);
          const isSameRegion = (this.currentLevelData.regions[r][c] === regionId);
          const isNeighbor = Math.abs(r - dongRow) <= 1 && Math.abs(c - dongCol) <= 1;

          if (isSameRow || isSameCol || isSameRegion || isNeighbor) {
            this.gridState[r][c] = 1; // 标记 ❌
          }
        }
      }
    }

    // 保存撤销快照
    private pushUndoSnapshot() {
      if (this.undoStack.length >= 40) this.undoStack.shift();
      this.undoStack.push(JSON.stringify({
        grid: this.gridState,
        avatars: Array.from(this.cellAvatars.entries())
      }));
    }

    // 撤销操作
    private handleUndo() {
      if (this.undoStack.length === 0) return;
      const last = this.undoStack.pop();
      if (last) {
        const parsed = JSON.parse(last);
        this.gridState = parsed.grid;
        if (parsed.avatars) {
          this.cellAvatars = new Map(parsed.avatars);
        }
        this.updateBoardDisplay();
        this.saveStorage(true);
      }
    }

    // 重来本关
    private handleRestart() {
      const size = this.currentLevelData.size;
      this.pushUndoSnapshot();
      this.gridState = Array.from({ length: size }, () => Array(size).fill(0));
      this.cellAvatars.clear();
      this.elapsedSeconds = 0;
      this.startTimer();
      this.updateBoardDisplay();
      this.saveStorage(true);
    }

    // 提示功能
    private handleHint() {
      if (!this.currentLevelData) return;
      const data = this.currentLevelData;
      const hintBox = document.getElementById('hint-message-box');
      const hintText = document.getElementById('hint-text');

      let msg = data.opening || '观察只有一个可能空格的行、列或颜色区域！';
      let targetRow = -1;
      let targetCol = -1;

      // 如果关卡带有逻辑推导步数
      if (data.hints && data.hints.length > 0) {
        for (const step of data.hints) {
          if (step.action === 'cat' && step.cells && step.cells.length > 0) {
            const cell = step.cells[0];
            if (this.gridState[cell.row][cell.col] !== 2) {
              msg = step.text.replace(/猫/g, '咚');
              targetRow = cell.row;
              targetCol = cell.col;
              break;
            }
          }
        }
      }

      // 如果未找到具体步，但答案中还有未放置的咚
      if (targetRow === -1 && data.solution) {
        for (const pos of data.solution) {
          if (this.gridState[pos.row][pos.col] !== 2) {
            targetRow = pos.row;
            targetCol = pos.col;
            msg = `提示：第 ${targetRow + 1} 行、第 ${targetCol + 1} 列这里可以放置一个咚。`;
            break;
          }
        }
      }

      if (hintBox && hintText) {
        hintText.textContent = msg;
        hintBox.style.display = 'flex';
      }

      // 高亮目标格子
      if (targetRow !== -1 && targetCol !== -1) {
        const cellEl = document.querySelector(`.grid-cell[data-row="${targetRow}"][data-col="${targetCol}"]`);
        if (cellEl) {
          this.clearHintHighlights();
          cellEl.classList.add('hint-active');
        }
      }
    }

    private clearHintHighlights() {
      document.querySelectorAll('.grid-cell.hint-active').forEach(el => el.classList.remove('hint-active'));
    }

    // 刷新棋盘视图与冲突检测
    private updateBoardDisplay() {
      if (!this.currentLevelData) return;
      const size = this.currentLevelData.size;

      let dongCount = 0;
      const dongs: { r: number; c: number; region: number }[] = [];

      for (let r = 0; r < size; r++) {
        for (let c = 0; c < size; c++) {
          const val = this.gridState[r][c];
          const cellEl = document.querySelector(`.grid-cell[data-row="${r}"][data-col="${c}"]`) as HTMLElement;
          if (!cellEl) continue;

          cellEl.classList.remove('conflict');
          cellEl.innerHTML = '';

          if (val === 1) {
            // ❌ 排除
            const cross = document.createElement('div');
            cross.className = 'cell-cross';
            cellEl.appendChild(cross);
          } else if (val === 2) {
            // 🏓 樊振东随机头像
            dongCount++;
            dongs.push({ r, c, region: this.currentLevelData.regions[r][c] });

            let avatarPath = this.cellAvatars.get(`${r},${c}`);
            if (!avatarPath) {
              avatarPath = this.getRandomAvatar();
              this.cellAvatars.set(`${r},${c}`, avatarPath);
            }

            const img = document.createElement('img');
            img.className = 'cell-dong-avatar';
            img.src = avatarPath;
            img.alt = 'Dong';
            cellEl.appendChild(img);
          }
        }
      }

      // 更新进度
      const placedEl = document.getElementById('placed-count');
      if (placedEl) placedEl.textContent = dongCount.toString();

      // 冲突检测
      const conflictCells = new Set<string>();

      for (let i = 0; i < dongs.length; i++) {
        for (let j = i + 1; j < dongs.length; j++) {
          const d1 = dongs[i];
          const d2 = dongs[j];

          const isSameRow = (d1.r === d2.r);
          const isSameCol = (d1.c === d2.c);
          const isSameRegion = (d1.region === d2.region);
          const isTouching = Math.abs(d1.r - d2.r) <= 1 && Math.abs(d1.c - d2.c) <= 1;

          if (isSameRow || isSameCol || isSameRegion || isTouching) {
            conflictCells.add(`${d1.r},${d1.c}`);
            conflictCells.add(`${d2.r},${d2.c}`);
          }
        }
      }

      conflictCells.forEach(key => {
        const [r, c] = key.split(',');
        const cellEl = document.querySelector(`.grid-cell[data-row="${r}"][data-col="${c}"]`);
        if (cellEl) cellEl.classList.add('conflict');
      });
    }

    // 检查通关状态
    private checkWinCondition() {
      if (!this.currentLevelData) return;
      const size = this.currentLevelData.size;

      // 收集所有放咚的位置
      const dongs: { r: number; c: number; region: number }[] = [];
      for (let r = 0; r < size; r++) {
        for (let c = 0; c < size; c++) {
          if (this.gridState[r][c] === 2) {
            dongs.push({ r, c, region: this.currentLevelData.regions[r][c] });
          }
        }
      }

      // 数量必须等于 size
      if (dongs.length !== size) return;

      // 检查行、列、区域是否完全不重复
      const rows = new Set<number>();
      const cols = new Set<number>();
      const regions = new Set<number>();

      for (const d of dongs) {
        if (rows.has(d.r) || cols.has(d.c) || regions.has(d.region)) return;
        rows.add(d.r);
        cols.add(d.c);
        regions.add(d.region);
      }

      // 检查两两是否八邻域接触
      for (let i = 0; i < dongs.length; i++) {
        for (let j = i + 1; j < dongs.length; j++) {
          if (Math.abs(dongs[i].r - dongs[j].r) <= 1 && Math.abs(dongs[i].c - dongs[j].c) <= 1) {
            return;
          }
        }
      }

      // 验证通过！通关！
      this.handleVictory();
    }

    // 通关结算
    private handleVictory() {
      if (this.timerInterval) clearInterval(this.timerInterval);

      // 播放胜利音效
      this.sounds.playWin();

      // 解锁下一关
      if (this.currentLevelId >= this.maxUnlockedLevel) {
        this.maxUnlockedLevel = Math.min(1000, this.currentLevelId + 1);
      }

      // 记录已通关
      this.saveStorage(false);

      // 胜利头像随机展示
      const winAvatar = document.getElementById('win-avatar-img') as HTMLImageElement;
      if (winAvatar) winAvatar.src = this.getRandomAvatar();

      // 弹出胜利弹窗
      const winTime = document.getElementById('win-time');
      const winMoves = document.getElementById('win-moves');
      const mins = Math.floor(this.elapsedSeconds / 60).toString().padStart(2, '0');
      const secs = (this.elapsedSeconds % 60).toString().padStart(2, '0');

      if (winTime) winTime.textContent = `${mins}:${secs}`;
      if (winMoves) winMoves.textContent = this.moveCount.toString();

      this.openModal('modal-win');
    }

    // 选关弹窗逻辑
    private openLevelsModal() {
      const tabsEl = document.getElementById('levels-pack-tabs');
      const gridEl = document.getElementById('levels-grid');
      if (!tabsEl || !gridEl) return;

      // 确定当前选中的分页 pack
      const currentPackIdx = Math.floor((this.currentLevelId - 1) / 50);

      // 渲染分页 Tabs
      tabsEl.innerHTML = '';
      for (let p = 0; p < 20; p++) {
        const start = p * 50 + 1;
        const end = (p + 1) * 50;
        const tabBtn = document.createElement('button');
        tabBtn.className = `pack-tab-btn ${p === currentPackIdx ? 'active' : ''}`;
        tabBtn.textContent = `${start} - ${end}`;
        tabBtn.addEventListener('click', () => {
          document.querySelectorAll('.pack-tab-btn').forEach(b => b.classList.remove('active'));
          tabBtn.classList.add('active');
          this.renderLevelsGrid(p);
        });
        tabsEl.appendChild(tabBtn);
      }

      this.renderLevelsGrid(currentPackIdx);
      this.openModal('modal-levels');
    }

    // 渲染选关网格
    private renderLevelsGrid(packIdx: number) {
      const gridEl = document.getElementById('levels-grid');
      if (!gridEl) return;
      gridEl.innerHTML = '';

      const start = packIdx * 50 + 1;
      const end = (packIdx + 1) * 50;

      for (let lid = start; lid <= end; lid++) {
        const card = document.createElement('div');
        const isCurrent = lid === this.currentLevelId;
        const isCompleted = lid < this.maxUnlockedLevel;
        
        card.className = `level-card ${isCurrent ? 'current' : ''} ${isCompleted ? 'completed' : ''}`;
        
        const manifestItem = this.manifest.find(m => m.id === lid);
        const sizeText = manifestItem ? `${manifestItem.size}×${manifestItem.size}` : '';

        card.innerHTML = `
          <span class="lvl-num">${lid}</span>
          <span class="lvl-size">${sizeText}</span>
        `;

        card.addEventListener('click', () => {
          this.closeModal('modal-levels');
          this.loadLevel(lid);
        });

        gridEl.appendChild(card);
      }
    }

    // 通用弹窗开关
    private openModal(id: string) {
      const el = document.getElementById(id);
      if (el) el.style.display = 'flex';
    }

    private closeModal(id: string) {
      const el = document.getElementById(id);
      if (el) el.style.display = 'none';
    }
  }

  // 页面加载或就绪时立即启动
  function startDongdoku() {
    if (document.getElementById('dongdoku-app')) {
      new DongdokuApp();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startDongdoku);
  } else {
    startDongdoku();
  }
</script>
