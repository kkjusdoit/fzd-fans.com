</style>

<script>
  import { INITIAL_LEVELS } from './initialLevels';

  // ==========================================
  // 《找咚》(Dongdoku) 客户端核心引擎
  // 状态值定义:
  // 0 = EMPTY (空白)
  // 1 = CROSS (✖ 排除标记)
  // 2 = CORRECT_DONG (正确确定的咚咚头像，永久锁定)
  // 3 = WRONG_DONG (找错咚：显示 🚫 违规禁止标志，锁定并扣 1 条命)
  // ==========================================

  // 色彩配置表（莫兰迪马卡龙色盘）
  const REGION_COLORS = [
    '#6CB6DC', // 0: 天空蓝 Sky Blue
    '#A9D893', // 1: 嫩绿 Soft Green
    '#E8C94F', // 2: 暖阳黄 Soft Yellow
    '#D896B3', // 3: 蔷薇粉 Soft Pink
    '#67C5BF', // 4: 薄荷绿 Mint Teal
    '#DD84CB', // 5: 薰衣草紫 Magenta
    '#FAB1A0', // 6: 暖杏桃 Warm Peach
    '#A29BFE', // 7: 浅紫 Lavender
    '#FD79A8', // 8: 亮粉 Hot Pink
    '#81ECEC', // 9: 青碧 Bright Cyan
    '#FDCB6E', // 10: 太阳金 Sun Yellow
    '#B2BEC3', // 11: 银灰 Cool Silver
    '#55EFC4', // 12: 翡翠绿 Light Emerald
    '#E17055', // 13: 暖陶红 Terracotta
    '#74B9FF'  // 14: 湛蓝 Clear Blue
  ];

  // 24 款经典樊振东头像库
  const AVATAR_PATHS = Array.from({ length: 24 }, (_, i) => {
    const num = i.toString().padStart(3, '0');
    return `/game/assets/image-%20${num}.webp`;
  });

  // 关卡数据里的 hint.text 只有中文，英文侧按 rule 类型结构化生成说明
  const HINT_RULE_EN: Record<string, string> = {
    single_region: 'This colour territory has only one legal cell left.',
    single_row: 'This row has only one legal cell left.',
    single_col: 'This column has only one legal cell left.',
    locked_region_row: 'This territory’s candidates all sit in one row, so the rest of that row can be excluded.',
    locked_region_col: 'This territory’s candidates all sit in one column, so the rest of that column can be excluded.',
    locked_row_region: 'This row’s candidates all sit in one territory, so the rest of that territory can be excluded.',
    locked_col_region: 'This column’s candidates all sit in one territory, so the rest of that territory can be excluded.',
    naked_set_region_row: 'These territories fill these rows exactly, so every other cell in them can be excluded.',
    naked_set_region_col: 'These territories fill these columns exactly, so every other cell in them can be excluded.',
    intersection_cat: 'Every remaining candidate line crosses here, so the Dong belongs on this cell.',
    contradiction: 'Placing a Dong on these cells leaves some territory with nowhere to go — exclude them.',
    two_step_contradiction: 'Following these cells two steps ahead reaches a dead end — exclude them.'
  };

  // 客户端文案表（模板里的 i18n 对象取不到，脚本侧单独构造一份）
  function buildStrings(isEn: boolean) {
    return {
      loadingLevel: isEn ? 'Loading level…' : '正在加载关卡...',
      loadFailTitle: isEn ? 'Load Failed ⚠️' : '加载失败 ⚠️',
      loadFailText: isEn
        ? 'Could not load this level. Check your connection and tap Hint or pick another level.'
        : '关卡数据加载失败，请检查网络后重试，或先换一关。',
      cellEmpty: isEn ? 'empty' : '空格',
      cellCrossed: isEn ? 'marked as excluded' : '已标记排除',
      cellDong: isEn ? 'Dong found' : '已找到咚',
      cellWrong: isEn ? 'wrong guess, locked' : '找错咚，已锁定',
      cellAria: (r: number, c: number, s: string) =>
        isEn ? `Row ${r}, column ${c}, ${s}` : `第 ${r} 行第 ${c} 列，${s}`,
      beaconPlace: isEn ? 'Place' : '落子',
      beaconExclude: isEn ? 'Exclude ✖' : '排除 ✖',
      hintFallbackPrefix: isEn ? 'No deduction chain left for this level, so here is the answer: ' : '这一关的推导链已走完，直接告诉你答案：',
      hintCoords: (r: number, c: number) => (isEn ? `row ${r}, column ${c}.` : `第 ${r} 行第 ${c} 列。`),
      hintAllDone: isEn ? 'All Dongs found or no more hints available!' : '当前所有咚都已找到或盘面无需更多提示！',
      hintTutorialBusy: isEn ? 'Please follow the current tutorial step guide.' : '当前正在教学训练中，请跟随上方步骤指引操作哦！',
      hintRegionLast: isEn
        ? 'This colour territory has only 1 legal cell left — the Dong must go here!'
        : '提示：该颜色领地只剩 1 个空格，此处必定放咚！',
      hintFallbackGeneric: isEn ? 'Look at the highlighted cells.' : '请观察高亮格子'
    };
  }

  // 游戏主控制器
  class DongdokuApp {
    private container: HTMLElement;
    private isEn: boolean = false;
    private T: ReturnType<typeof buildStrings>;
    private levelCache: Map<number, any> = new Map();
    private manifest: Array<{ id: number; size: number; difficulty: string; diffText: string }> = [];
    private manifestById: Map<number, { id: number; size: number; difficulty: string; diffText: string }> = new Map();

    private currentLevelId: number = 1;
    // 可自由访问的关卡上限（历史存档遗留字段；现在全部关卡都可选，仅用于兼容）
    private maxUnlockedLevel: number = 1;
    // 真实通关纪录：只有 handleVictory 才会写，跳关不会污染
    private bestCompletedLevel: number = 0;
    private completedLevels: Set<number> = new Set();
    private currentLevelData: any = null;
    private gridState: number[][] = [];
    private cellAvatars: Map<string, string> = new Map(); // `${r},${c}` -> avatarPath
    private cellEls: HTMLButtonElement[][] = [];          // 棋盘 DOM 引用，避免每次重绘全表 querySelector
    private moveCount: number = 0;
    private lives: number = 3; // 3条命
    private rulesExpanded: boolean = true;

    // 新手引导与教学模式状态
    private isTutorialMode: boolean = false;
    private tutorialStep: number = 1;
    private hasCompletedTutorial: boolean = false;
    private shieldUsedInLevel: boolean = false;
    private toastHintTimer: any = null;
    private toastConflictTimer: any = null;
    private hintHighlightTimer: any = null;

    // 触摸/点击防抖与双击捕获状态
    private lastTapTimes: Map<string, number> = new Map();
    private singleTapTimers: Map<string, any> = new Map();
    private victoryTimer: any = null;
    private holdTimer: any = null;
    private dragMode: 'mark' | 'erase' | null = null;
    private dragPointerId: number | null = null;
    private dragVisited = new Set<string>();
    private suppressNextClick = false;
    private dragDirty = false;              // 拖拽期间攒住存档，pointerup 再落盘
    private lastFocusedBeforeModal: HTMLElement | null = null;

    constructor() {
      this.container = document.getElementById('dongdoku-app')!;
      this.isEn = this.container?.getAttribute('data-lang') === 'en';
      this.T = buildStrings(this.isEn);

      // 载入内嵌初始关卡
      for (const [idStr, data] of Object.entries(INITIAL_LEVELS)) {
        this.levelCache.set(Number(idStr), data);
      }

      this.loadStorage();
      this.initDOMElements();
      this.initEvents();
      
      // 立即加载并渲染当前关卡
      this.loadLevel(this.currentLevelId);

      // 检查是否需要提示首次新手教程
      this.checkFirstVisitTutorial();

      // 后台静默拉取关卡总清单
      this.fetchManifest();
    }

    // 从 LocalStorage 加载记录
    private loadStorage() {
      try {
        const saved = localStorage.getItem('dongdoku_save_v1');
        if (saved) {
          const parsed = JSON.parse(saved);
          if (parsed.currentLevelId !== undefined) {
            this.currentLevelId = Math.max(1, parsed.currentLevelId);
          }
          if (parsed.maxUnlockedLevel) this.maxUnlockedLevel = parsed.maxUnlockedLevel;
          if (parsed.rulesExpanded !== undefined) this.rulesExpanded = parsed.rulesExpanded;

          // 真实通关纪录。旧存档没有这两个字段：maxUnlockedLevel 曾被"跳关"顶高过，
          // 无法反推真实战绩，所以从 0 重新累计，不拿旧数字充数。
          if (Array.isArray(parsed.completedLevels)) {
            this.completedLevels = new Set(parsed.completedLevels.filter((n: any) => Number.isInteger(n) && n > 0));
          }
          if (Number.isInteger(parsed.bestCompletedLevel)) {
            this.bestCompletedLevel = Math.max(0, parsed.bestCompletedLevel);
          }
          if (this.completedLevels.size > 0) {
            this.bestCompletedLevel = Math.max(this.bestCompletedLevel, ...this.completedLevels);
          }
        }
        this.hasCompletedTutorial = localStorage.getItem('dongdoku_tutorial_completed') === 'true';
      } catch (e) {
        console.warn('Failed to parse localStorage', e);
      }
    }

    // 保存到 LocalStorage
    private saveStorage(saveBoard: boolean = true) {
      if (this.currentLevelId === 0) return; // 教学关不计入永久持久化存档
      try {
        const payload: any = {
          currentLevelId: Math.max(1, this.currentLevelId),
          maxUnlockedLevel: this.maxUnlockedLevel,
          bestCompletedLevel: this.bestCompletedLevel,
          completedLevels: Array.from(this.completedLevels),
          rulesExpanded: this.rulesExpanded
        };

        if (saveBoard) {
          payload.boardState = {
            levelId: this.currentLevelId,
            grid: this.gridState,
            // 如实写入剩余生命：归零就是归零，不能靠刷新页面白捡一条命
            lives: Math.max(0, this.lives)
          };
        } else {
          // 只更新进度类字段时必须把已存的盘面原样带回去。
          // 否则 loadLevel 里的 saveStorage(false) 会先把 boardState 抹掉，
          // 紧接着 initBoardState 就再也读不到盘面——断点续玩实际上一直没生效。
          const prev = localStorage.getItem('dongdoku_save_v1');
          if (prev) {
            const prevBoard = JSON.parse(prev).boardState;
            if (prevBoard) payload.boardState = prevBoard;
          }
        }

        localStorage.setItem('dongdoku_save_v1', JSON.stringify(payload));
      } catch (e) {
        console.warn('Failed to save to localStorage', e);
      }
    }

    // 首次进入时展示新手教学欢迎邀请（通过后或跳过后永久不再自动提示）
    private checkFirstVisitTutorial() {
      const hasSeen = localStorage.getItem('dongdoku_has_seen_guide_v2') === 'true';
      const hasCompleted = localStorage.getItem('dongdoku_tutorial_completed') === 'true';
      if (hasSeen || hasCompleted || this.maxUnlockedLevel > 1) {
        return;
      }
      setTimeout(() => {
        this.openModal('modal-welcome');
      }, 350);
    }

    // 获取关卡总索引清单
    private async fetchManifest() {
      try {
        const res = await fetch('/data/dongdoku/manifest.json');
        if (res.ok) {
          this.manifest = await res.json();
          this.manifestById = new Map(this.manifest.map(m => [m.id, m]));
          this.updateLevelsModalProgress();
        }
      } catch (e) {
        console.warn('Failed to fetch manifest', e);
      }
    }

    // 动态获取关卡数据（带分包缓存）
    private async fetchLevelData(levelId: number): Promise<any> {
      if (this.levelCache.has(levelId)) {
        return this.levelCache.get(levelId);
      }

      const packIdx = Math.floor((levelId - 1) / 50);
      try {
        const res = await fetch(`/data/dongdoku/pack_${packIdx}.json`);
        if (res.ok) {
          const packData = await res.json();
          for (const [lid, data] of Object.entries(packData)) {
            this.levelCache.set(Number(lid), data);
          }
          return this.levelCache.get(levelId);
        }
      } catch (e) {
        console.error(`Failed to fetch pack ${packIdx}`, e);
      }
      return null;
    }

    private initDOMElements() {
      this.updateLivesDisplay();
      this.updateLevelsModalProgress();
      this.applyRulesCollapseState();
    }

    private applyRulesCollapseState() {
      const cardsBox = document.getElementById('rules-cards-box');
      const arrow = document.getElementById('rules-toggle-arrow');
      const btn = document.getElementById('btn-toggle-rules');

      if (cardsBox && arrow && btn) {
        cardsBox.style.display = this.rulesExpanded ? 'grid' : 'none';
        arrow.textContent = this.rulesExpanded ? '▲' : '▼';
        btn.setAttribute('aria-expanded', this.rulesExpanded.toString());
      }
    }

    private updateLivesDisplay() {
      const livesEl = document.getElementById('lives-display');
      if (!livesEl) return;
      if (this.isTutorialMode) {
        livesEl.textContent = '❤️❤️❤️ (无限)';
        return;
      }
      const full = '❤️'.repeat(Math.max(0, this.lives));
      const lost = '🤍'.repeat(Math.max(0, 3 - this.lives));
      livesEl.textContent = full + lost;
    }

    private updateLevelsModalProgress() {
      const el = document.getElementById('levels-unlocked-count');
      if (el) el.textContent = this.bestCompletedLevel.toString();
    }

    private initEvents() {
      // 导航栏新手教学快捷按钮
      document.getElementById('btn-open-tutorial')?.addEventListener('click', () => {
        this.startTutorial();
      });

      // 规则折叠切换
      document.getElementById('btn-toggle-rules')?.addEventListener('click', () => {
        this.rulesExpanded = !this.rulesExpanded;
        this.applyRulesCollapseState();
        this.saveStorage(false);
      });

      // 提示按钮
      document.getElementById('btn-hint')?.addEventListener('click', () => this.handleHintClick());

      // 重来
      document.getElementById('btn-restart')?.addEventListener('click', () => this.handleRestart());

      // 教学指引卡片中的跳过教学与一键排除
      document.getElementById('btn-skip-tutorial')?.addEventListener('click', () => {
        localStorage.setItem('dongdoku_has_seen_guide_v2', 'true');
        this.loadLevel(1);
      });
      document.getElementById('btn-auto-cross')?.addEventListener('click', () => {
        this.autoMarkTutorialCrosses();
      });

      // 欢迎引导弹窗按钮
      document.getElementById('btn-welcome-tutorial')?.addEventListener('click', () => {
        localStorage.setItem('dongdoku_has_seen_guide_v2', 'true');
        this.closeModal('modal-welcome');
        this.startTutorial();
      });
      document.getElementById('btn-welcome-skip')?.addEventListener('click', () => {
        localStorage.setItem('dongdoku_has_seen_guide_v2', 'true');
        this.closeModal('modal-welcome');
        this.loadLevel(1);
      });

      // 教学通关弹窗按钮
      document.getElementById('btn-tutorial-start-game')?.addEventListener('click', () => {
        localStorage.setItem('dongdoku_tutorial_completed', 'true');
        localStorage.setItem('dongdoku_has_seen_guide_v2', 'true');
        this.closeModal('modal-tutorial-win');
        this.loadLevel(1);
      });
      document.getElementById('btn-tutorial-replay')?.addEventListener('click', () => {
        this.closeModal('modal-tutorial-win');
        this.startTutorial();
      });

      // 浮动 Toast 关闭按钮
      document.getElementById('btn-close-toast-hint')?.addEventListener('click', () => {
        const el = document.getElementById('toast-hint');
        if (el) el.style.display = 'none';
        this.clearHintHighlight();
      });
      document.getElementById('btn-close-toast-conflict')?.addEventListener('click', () => {
        const el = document.getElementById('toast-conflict');
        if (el) el.style.display = 'none';
      });

      // 选关弹窗
      document.getElementById('btn-open-levels')?.addEventListener('click', () => this.openLevelsModal());
      document.getElementById('btn-close-levels')?.addEventListener('click', () => this.closeModal('modal-levels'));
      document.getElementById('btn-win-levels')?.addEventListener('click', () => {
        this.closeModal('modal-win');
        this.openLevelsModal();
      });

      // 跳至最新关：真实通关纪录的下一关
      document.getElementById('btn-jump-current')?.addEventListener('click', () => {
        this.closeModal('modal-levels');
        this.loadLevel(Math.min(1000, Math.max(1, this.bestCompletedLevel + 1)));
      });

      // 胜利弹窗中的下一关
      document.getElementById('btn-next-level')?.addEventListener('click', () => {
        this.closeModal('modal-win');
        this.loadLevel(this.currentLevelId + 1);
      });

      // 游戏结束弹窗中的重新开始 / 选关
      document.getElementById('btn-gameover-restart')?.addEventListener('click', () => {
        this.closeModal('modal-gameover');
        this.handleRestart();
      });
      document.getElementById('btn-gameover-levels')?.addEventListener('click', () => {
        this.closeModal('modal-gameover');
        this.openLevelsModal();
      });

      // Esc 关闭选关弹窗（其余弹窗是必须做选择的结算界面，保留按钮出口）
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const levelsModal = document.getElementById('modal-levels');
        if (levelsModal && levelsModal.style.display === 'flex') {
          e.preventDefault();
          this.closeModal('modal-levels');
        }
      });
    }

    // 随机获取一款樊振东头像
    private getRandomAvatar(): string {
      const idx = Math.floor(Math.random() * AVATAR_PATHS.length);
      return AVATAR_PATHS[idx];
    }

    // 启动新手教学模式 (Level 0)
    public startTutorial() {
      this.loadLevel(0);
    }

    // 加载指定关卡
    public async loadLevel(levelId: number) {
      if (levelId < 0) levelId = 0;
      if (levelId > 1000) levelId = 1000;

      const isTutorial = (levelId === 0);

      // 先把关卡数据拿到手，再提交任何状态。
      // 否则加载失败时 currentLevelId 已经被改写并落盘，刷新页面会一直卡在拉不下来的那一关。
      let data = this.levelCache.get(levelId);
      if (!data) {
        const gridEl = document.getElementById('game-grid');
        if (gridEl) {
          this.cellEls = [];
          gridEl.innerHTML = `<div style="grid-column:1/-1;text-align:center;padding:2rem;color:#999;">${this.T.loadingLevel}</div>`;
        }
        data = await this.fetchLevelData(levelId);
      }

      if (!data) {
        this.showConflictToast(this.T.loadFailTitle, this.T.loadFailText);
        // 占位符把盘面清掉了，把原来那一关重新画回来，别把玩家留在空屏上
        if (this.currentLevelData) {
          this.renderUI(this.currentLevelData);
        } else {
          const gridEl = document.getElementById('game-grid');
          if (gridEl) gridEl.innerHTML = `<div style="grid-column:1/-1;text-align:center;padding:2rem;color:#999;">${this.T.loadFailText}</div>`;
        }
        return;
      }

      this.currentLevelId = levelId;
      this.isTutorialMode = isTutorial;
      this.shieldUsedInLevel = false;
      this.clearAllBeacons();
      this.hideAllToasts();

      if (levelId > this.maxUnlockedLevel && levelId > 0) {
        this.maxUnlockedLevel = levelId;
      }
      this.saveStorage(false);
      this.updateLevelsModalProgress();

      this.currentLevelData = data;
      this.initBoardState(data);
      this.renderUI(data);

      if (this.isTutorialMode) {
        this.setupTutorialMode();
      } else {
        const guideCard = document.getElementById('tutorial-guide-card');
        if (guideCard) guideCard.style.display = 'none';
        const rulesSec = document.getElementById('rules-collapse-section');
        if (rulesSec) rulesSec.style.display = 'block';
      }

      // 存档里生命值已归零：说明上次是在失败状态下离开的，直接把失败结算摆回来
      if (!this.isTutorialMode && this.lives <= 0) {
        this.handleGameOver();
      }
    }

    // 初始化棋盘数据与暂存恢复
    private initBoardState(data: any) {
      const size = data.size;
      this.gridState = Array.from({ length: size }, () => Array(size).fill(0));
      this.cellAvatars.clear();
      this.moveCount = 0;
      this.lives = 3; // 重置满血 3 条命

      if (this.isTutorialMode) {
        this.tutorialStep = 1;
        return;
      }

      try {
        const saved = localStorage.getItem('dongdoku_save_v1');
        if (saved) {
          const parsed = JSON.parse(saved);
          const board = parsed.boardState;
          const gridOk = board && board.levelId === this.currentLevelId && Array.isArray(board.grid)
            && board.grid.length === size && board.grid.every((row: any) => Array.isArray(row) && row.length === size);

          // 存档里这一关已经解完了：重玩时给个干净盘面，而不是把通关状态摆回来
          const alreadySolved = gridOk
            && board.grid.reduce((n: number, row: number[]) => n + row.filter((v) => v === 2).length, 0) >= size;

          if (gridOk && !alreadySolved) {
            this.gridState = board.grid;
            // 0 也要如实恢复（旧存档没有 lives 字段时才回落到满血）
            if (Number.isInteger(board.lives)) {
              this.lives = Math.max(0, Math.min(3, board.lives));
            }
            for (let r = 0; r < size; r++) {
              for (let c = 0; c < size; c++) {
                if (this.gridState[r][c] === 2 || this.gridState[r][c] === 3) {
                  this.cellAvatars.set(`${r},${c}`, this.getRandomAvatar());
                }
              }
            }
          }
        }
      } catch (e) {}
    }

    // 设置新手教学模式
    private setupTutorialMode() {
      const guideCard = document.getElementById('tutorial-guide-card');
      if (guideCard) guideCard.style.display = 'flex';

      const rulesSec = document.getElementById('rules-collapse-section');
      if (rulesSec) rulesSec.style.display = 'none';

      this.updateTutorialStepUI(1);
    }

    // 更新新手教学步骤与高亮引导
    private updateTutorialStepUI(step: number) {
      this.tutorialStep = step;
      const stepHints = this.currentLevelData?.hints || [];
      const currentHint = stepHints.find((h: any) => h.step === step);
      if (!currentHint) return;

      const counterEl = document.getElementById('tutorial-step-counter');
      const titleEl = document.getElementById('tutorial-step-title');
      const descEl = document.getElementById('tutorial-step-desc');
      const actionsRow = document.getElementById('tutorial-actions-row');
      const autoCrossBtn = document.getElementById('btn-auto-cross');

      if (counterEl) counterEl.textContent = `${this.isEn ? 'Step' : '步骤'} ${step}/6`;
      if (titleEl) titleEl.textContent = this.isEn ? currentHint.titleEn : currentHint.titleZh;
      if (descEl) descEl.textContent = this.isEn ? currentHint.textEn : currentHint.textZh;

      if (actionsRow) {
        actionsRow.style.display = (step >= 2 && step <= 4) ? 'flex' : 'none';
        if (autoCrossBtn) {
          autoCrossBtn.innerHTML = `<span>${
            step === 2 
              ? (this.isEn ? '⚡ Auto Mark Row' : '⚡ 一键排除同行') 
              : step === 3 
                ? (this.isEn ? '⚡ Auto Mark Column' : '⚡ 一键排除同列') 
                : (this.isEn ? '⚡ Auto Mark Diagonals' : '⚡ 一键排除对角')
          }</span>`;
        }
      }

      this.clearAllBeacons();

      const isDoubleAction = (step === 1 || step === 5 || step === 6);
      const actionLabel = isDoubleAction ? (this.isEn ? 'Double Tap' : '双击') : (this.isEn ? 'Tap' : '单击');

      // 添加高亮聚焦光圈（只对未标记格子添加）
      if (currentHint.target && this.gridState[currentHint.target.row][currentHint.target.col] === 0) {
        this.addBeaconToCell(currentHint.target.row, currentHint.target.col, 'tutorial-beacon', actionLabel);
      } else if (currentHint.targetCells) {
        currentHint.targetCells.forEach((c: any) => {
          if (this.gridState[c.row][c.col] === 0) {
            this.addBeaconToCell(c.row, c.col, 'tutorial-beacon', actionLabel);
          }
        });
      }
    }

    // 教学模式：一键自动排除
    private autoMarkTutorialCrosses() {
      if (!this.isTutorialMode) return;
      const currentHint = this.currentLevelData?.hints?.find((h: any) => h.step === this.tutorialStep);
      if (!currentHint?.targetCells) return;

      currentHint.targetCells.forEach((c: any) => {
        this.gridState[c.row][c.col] = 1;
      });

      this.updateBoardDisplay();
      setTimeout(() => {
        this.updateTutorialStepUI(this.tutorialStep + 1);
      }, 300);
    }

    // 在指定格子上添加引导光圈与操作标签
    private addBeaconToCell(r: number, c: number, className: string = 'tutorial-beacon', labelText?: string) {
      const cellEl = this.getCellEl(r, c);
      if (!cellEl) return;
      const beacon = document.createElement('div');
      beacon.className = className;
      if (labelText) {
        const labelEl = document.createElement('span');
        // hint 光圈和 tutorial 光圈的标签样式不同，按所属光圈取类名
        labelEl.className = className.includes('hint-beacon') ? 'hint-beacon-label' : 'tutorial-beacon-label';
        labelEl.textContent = labelText;
        beacon.appendChild(labelEl);
      }
      cellEl.appendChild(beacon);
    }

    // 取棋盘格子 DOM：优先用 renderUI 建好的引用表，避免每次都走属性选择器
    private getCellEl(r: number, c: number): HTMLButtonElement | null {
      return this.cellEls[r]?.[c]
        ?? (document.querySelector(`.grid-cell[data-row="${r}"][data-col="${c}"]`) as HTMLButtonElement | null);
    }

    private clearAllBeacons() {
      document.querySelectorAll('.tutorial-beacon, .hint-beacon').forEach(el => el.remove());
    }

    private clearHintHighlight() {
      document.querySelectorAll('.hint-beacon').forEach(el => el.remove());
    }

    private hideAllToasts() {
      if (this.toastHintTimer) clearTimeout(this.toastHintTimer);
      if (this.toastConflictTimer) clearTimeout(this.toastConflictTimer);
      if (this.hintHighlightTimer) clearTimeout(this.hintHighlightTimer);
      const toastHint = document.getElementById('toast-hint');
      if (toastHint) toastHint.style.display = 'none';
      const toastConflict = document.getElementById('toast-conflict');
      if (toastConflict) toastConflict.style.display = 'none';
      this.clearHintHighlight();
    }

    // 智能推导提示点击处理
    private handleHintClick() {
      if (this.isTutorialMode) {
        this.showHintToast(this.T.hintTutorialBusy);
        return;
      }

      if (!this.currentLevelData) return;
      const size = this.currentLevelData.size;

      // 1. 优先从静态 hints 数组中寻找第一条还没做完的推导步骤。
      //    关卡数据有两种 action：
      //      cat  = 此处必定落咚，做完的判定是这些格子都变成了咚 (2)
      //      mark = 这些格子可以排除，做完的判定是都打上了叉 (1) 或已被锁死 (3)
      //    早先两种都按"是否已落咚"判定，mark 的格子永远不可能变成 2，
      //    于是循环永远停在第一条 mark 提示上，提示按钮从此不再前进。
      if (this.currentLevelData.hints && this.currentLevelData.hints.length > 0) {
        for (const hint of this.currentLevelData.hints) {
          const cells = hint.cells || (hint.target ? [hint.target] : []);
          if (cells.length === 0) continue;

          const isMark = hint.action === 'mark';
          const isDone = isMark
            ? cells.every((c: any) => this.gridState[c.row][c.col] === 1 || this.gridState[c.row][c.col] === 3)
            : cells.every((c: any) => this.gridState[c.row][c.col] === 2);
          if (isDone) continue;

          this.clearHintHighlight();
          const beaconClass = isMark ? 'hint-beacon hint-beacon-exclude' : 'hint-beacon';
          const beaconLabel = isMark ? this.T.beaconExclude : this.T.beaconPlace;
          cells.forEach((c: any) => {
            const val = this.gridState[c.row][c.col];
            // 已经做到的格子不再高亮，只圈出还差的部分
            const alreadyDone = isMark ? (val === 1 || val === 3) : (val === 2);
            if (!alreadyDone) {
              this.addBeaconToCell(c.row, c.col, beaconClass, beaconLabel);
            }
          });

          const text = (this.isEn ? (hint.textEn || HINT_RULE_EN[hint.rule]) : (hint.text || hint.textZh))
            || hint.text
            || this.T.hintFallbackGeneric;
          this.showHintToast(text);
          return;
        }
      }

      // 2. 动态扫描推导：寻找只剩 1 个空格的色块
      for (let reg = 0; reg < size; reg++) {
        let emptyCells: Array<{ row: number; col: number }> = [];
        let hasDong = false;
        for (let r = 0; r < size; r++) {
          for (let c = 0; c < size; c++) {
            if (this.currentLevelData.regions[r][c] === reg) {
              if (this.gridState[r][c] === 2) hasDong = true;
              else if (this.gridState[r][c] === 0) emptyCells.push({ row: r, col: c });
            }
          }
        }
        if (!hasDong && emptyCells.length === 1) {
          const target = emptyCells[0];
          this.clearHintHighlight();
          this.addBeaconToCell(target.row, target.col, 'hint-beacon', this.T.beaconPlace);
          this.showHintToast(this.T.hintRegionLast);
          return;
        }
      }

      // 3. 兜底：推导链走完了还没解出来（约 127 关的 hints 没覆盖到底），
      //    这时直接把答案坐标给出去，并如实说明这是答案而不是推导线索。
      const unplacedSol = this.currentLevelData.solution?.find((s: any) => this.gridState[s.row][s.col] !== 2);
      if (unplacedSol) {
        this.clearHintHighlight();
        this.addBeaconToCell(unplacedSol.row, unplacedSol.col, 'hint-beacon', this.T.beaconPlace);
        this.showHintToast(this.T.hintFallbackPrefix + this.T.hintCoords(unplacedSol.row + 1, unplacedSol.col + 1));
        return;
      }

      this.showHintToast(this.T.hintAllDone);
    }

    // 显示提示 Toast
    private showHintToast(message: string) {
      if (this.toastHintTimer) clearTimeout(this.toastHintTimer);
      if (this.hintHighlightTimer) clearTimeout(this.hintHighlightTimer);

      const toast = document.getElementById('toast-hint');
      const textEl = document.getElementById('toast-hint-text');
      if (toast && textEl) {
        textEl.textContent = message;
        toast.style.display = 'flex';
      }

      this.toastHintTimer = setTimeout(() => {
        if (toast) toast.style.display = 'none';
      }, 5500);

      this.hintHighlightTimer = setTimeout(() => {
        this.clearHintHighlight();
      }, 5500);
    }

    // 冲突原因分析与新手免伤保护 (Mistake Analyzer & Explainer)
    // shielded 由调用方判定后传入：这个方法只负责解释，不再自己改 shieldUsedInLevel，
    // 否则调用方随后读到的已经是被改写后的值，扣命判断会永久失效。
    private analyzeMistakeAndWarn(r: number, c: number, shielded: boolean = false) {
      const size = this.currentLevelData.size;

      let rowConflict = false;
      for (let col = 0; col < size; col++) {
        if (col !== c && this.gridState[r][col] === 2) rowConflict = true;
      }

      let colConflict = false;
      for (let row = 0; row < size; row++) {
        if (row !== r && this.gridState[row][c] === 2) colConflict = true;
      }

      let regConflict = false;
      const myReg = this.currentLevelData.regions[r][c];
      for (let row = 0; row < size; row++) {
        for (let col = 0; col < size; col++) {
          if ((row !== r || col !== c) && this.currentLevelData.regions[row][col] === myReg && this.gridState[row][col] === 2) {
            regConflict = true;
          }
        }
      }

      let adjConflict = false;
      for (let dr = -1; dr <= 1; dr++) {
        for (let dc = -1; dc <= 1; dc++) {
          if (dr === 0 && dc === 0) continue;
          const nr = r + dr, nc = c + dc;
          if (nr >= 0 && nr < size && nc >= 0 && nc < size && this.gridState[nr][nc] === 2) {
            adjConflict = true;
          }
        }
      }

      let title = this.isEn ? 'Rule Violation' : '违规提醒';
      let message = '';

      if (adjConflict) {
        title = this.isEn ? '8-Direction Conflict ⚠️' : '八向相碰违规 ⚠️';
        message = this.isEn ? 'Dongs cannot touch each other in 8 directions (including diagonals)!' : '咚咚八方向（含对角）互不相碰，旁边已有咚！';
      } else if (rowConflict) {
        title = this.isEn ? 'Row Conflict ⚠️' : '同行冲突违规 ⚠️';
        message = this.isEn ? `Row ${r + 1} already has a Dong (only 1 per row)!` : `第 ${r + 1} 行已经有咚了（每行仅能放 1 个）！`;
      } else if (colConflict) {
        title = this.isEn ? 'Column Conflict ⚠️' : '同列冲突违规 ⚠️';
        message = this.isEn ? `Column ${c + 1} already has a Dong (only 1 per col)!` : `第 ${c + 1} 列已经有咚了（每列仅能放 1 个）！`;
      } else if (regConflict) {
        title = this.isEn ? 'Territory Conflict ⚠️' : '同色领地冲突 ⚠️';
        message = this.isEn ? 'This color territory already has a Dong (only 1 per territory)!' : '该颜色领地内已有咚（每种颜色仅能放 1 个）！';
      } else {
        title = this.isEn ? 'Deduction Mismatch ⚠️' : '逻辑不符 ⚠️';
        message = this.isEn ? 'Placing here leads to impossible remaining grid. Use ✖ to exclude first!' : '该位置会导致后续领地无解，请先用 ✖ 排除观察！';
      }

      // 新手前 3 关免伤保护（是否生效由调用方判定）
      if (shielded) {
        title = this.isEn ? '🛡️ Rookie Shield: 0 Life Lost!' : '🛡️ 新手免伤保护：本次免扣生命值！';
      }

      this.showConflictToast(title, message);
    }

    // 显示冲突 Toast
    private showConflictToast(title: string, message: string) {
      if (this.toastConflictTimer) clearTimeout(this.toastConflictTimer);

      const toast = document.getElementById('toast-conflict');
      const titleEl = document.getElementById('toast-conflict-title');
      const textEl = document.getElementById('toast-conflict-text');

      if (toast && titleEl && textEl) {
        titleEl.textContent = title;
        textEl.textContent = message;
        toast.style.display = 'flex';
      }

      this.toastConflictTimer = setTimeout(() => {
        if (toast) toast.style.display = 'none';
      }, 4500);
    }

    // 渲染 UI 与网格（手势极速分流：单击 ✖ / 双击 🏓）
    private renderUI(data: any) {
      // 注意：教学关分支写入的 innerHTML 里没有 #cur-level-num，
      // 所以不能把它当作 guard —— 否则玩过一次教学后这里就再也更新不了，
      // 关卡号会永久卡在"教学关"。
      const levelTitleContainer = document.getElementById('level-title-container');
      if (levelTitleContainer) {
        if (this.isTutorialMode) {
          levelTitleContainer.innerHTML = `🎓 <strong id="cur-level-num">${this.isEn ? 'Tutorial' : '教学关'}</strong>`;
        } else {
          levelTitleContainer.innerHTML = `${this.isEn ? 'Level' : '第'} <strong id="cur-level-num">${data.id}</strong> ${this.isEn ? '' : '关'}`;
        }
      }

      const targetCount = document.getElementById('target-count');
      if (targetCount) targetCount.textContent = data.size.toString();

      this.updateLivesDisplay();

      const gridEl = document.getElementById('game-grid');
      if (!gridEl) return;

      gridEl.onpointermove = (e) => {
        if (!this.dragMode) return;
        e.preventDefault();
        const target = document.elementFromPoint(e.clientX, e.clientY)?.closest('.grid-cell') as HTMLElement | null;
        if (!target || !gridEl.contains(target)) return;
        const row = Number(target.dataset.row);
        const col = Number(target.dataset.col);
        if (Number.isInteger(row) && Number.isInteger(col)) this.applyDragCell(row, col);
      };
      gridEl.onpointerup = () => this.cancelLongPress();
      gridEl.onpointercancel = () => this.cancelLongPress();

      const size = data.size;
      gridEl.style.gridTemplateColumns = `repeat(${size}, minmax(0, 1fr))`;
      gridEl.style.gridTemplateRows = `repeat(${size}, minmax(0, 1fr))`;
      gridEl.innerHTML = '';
      this.cellEls = Array.from({ length: size }, () => new Array(size));

      for (let r = 0; r < size; r++) {
        for (let c = 0; c < size; c++) {
          const regionId = data.regions[r][c];
          const cellEl = document.createElement('button');
          cellEl.type = 'button';
          cellEl.className = 'grid-cell';
          cellEl.setAttribute('data-row', r.toString());
          cellEl.setAttribute('data-col', c.toString());
          cellEl.setAttribute('data-region', regionId.toString());
          this.cellEls[r][c] = cellEl;

          const color = REGION_COLORS[regionId % REGION_COLORS.length];
          cellEl.style.backgroundColor = color;

          const key = `${r},${c}`;

          // 长按进入连续标记模式
          cellEl.addEventListener('pointerdown', (e) => {
            if (e.button !== 0 || (this.lives <= 0 && !this.isTutorialMode)) return;
            this.cancelLongPress();
            this.dragPointerId = e.pointerId;
            this.dragVisited.clear();
            this.holdTimer = setTimeout(() => {
              const value = this.gridState[r][c];
              if (value === 2 || value === 3) return;
              this.dragMode = value === 1 ? 'erase' : 'mark';
              this.suppressNextClick = true;
              this.applyDragCell(r, c);
              try { cellEl.setPointerCapture(e.pointerId); } catch {}
            }, 350);
          });

          cellEl.addEventListener('pointerenter', () => {
            if (this.dragMode) this.applyDragCell(r, c);
          });

          cellEl.addEventListener('pointerup', () => this.cancelLongPress());
          cellEl.addEventListener('pointercancel', () => this.cancelLongPress());

          // 单一点击与双击分发
          cellEl.addEventListener('click', (e) => {
            e.preventDefault();
            if (this.suppressNextClick) {
              this.suppressNextClick = false;
              return;
            }
            if (this.lives <= 0 && !this.isTutorialMode) return;
            const currentVal = this.gridState[r][c];
            if (currentVal === 2 || currentVal === 3) return;

            const now = Date.now();
            const lastTap = this.lastTapTimes.get(key) || 0;
            const isDoubleTap = lastTap > 0 && now - lastTap <= 420;

            if (isDoubleTap) {
              if (this.singleTapTimers.has(key)) {
                clearTimeout(this.singleTapTimers.get(key));
                this.singleTapTimers.delete(key);
              }
              this.lastTapTimes.delete(key);
              this.handleDoubleClick(r, c);
            } else {
              this.lastTapTimes.set(key, now);
              if (this.singleTapTimers.has(key)) {
                clearTimeout(this.singleTapTimers.get(key));
              }
              this.handleSingleClick(r, c);
              const timer = setTimeout(() => {
                this.lastTapTimes.delete(key);
                this.singleTapTimers.delete(key);
              }, 420);
              this.singleTapTimers.set(key, timer);
            }
          });

          // 电脑端右键单击：0 毫秒标记/清除 ✖
          cellEl.addEventListener('contextmenu', (e) => {
            e.preventDefault();
            if (this.dragMode || this.suppressNextClick) return;
            if (this.singleTapTimers.has(key)) {
              clearTimeout(this.singleTapTimers.get(key));
              this.singleTapTimers.delete(key);
            }
            this.handleSingleClick(r, c);
          });

          // 键盘操作：Enter / Space 走原生 click（切换 ✖），Shift+Enter 等价于双击落子。
          // 否则键盘用户只能靠 420ms 内连按两次 Enter 才能落子。
          cellEl.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && e.shiftKey) {
              e.preventDefault();
              e.stopPropagation();
              if (this.lives <= 0 && !this.isTutorialMode) return;
              this.handleDoubleClick(r, c);
            }
          });

          gridEl.appendChild(cellEl);
        }
      }

      this.updateBoardDisplay();
    }

    private cancelLongPress() {
      if (this.holdTimer) {
        clearTimeout(this.holdTimer);
        this.holdTimer = null;
      }
      this.dragMode = null;
      this.dragPointerId = null;
      this.dragVisited.clear();
      // 拖拽期间攒下的改动在这里一次性落盘
      if (this.dragDirty) {
        this.dragDirty = false;
        this.saveStorage(true);
      }
    }

    private applyDragCell(r: number, c: number) {
      if (!this.dragMode || (this.lives <= 0 && !this.isTutorialMode)) return;
      const key = `${r},${c}`;
      if (this.dragVisited.has(key)) return;
      this.dragVisited.add(key);
      const value = this.gridState[r][c];
      if (value === 2 || value === 3) return;
      const next = this.dragMode === 'mark' ? 1 : 0;
      if (value === next) return;
      this.gridState[r][c] = next;
      this.moveCount++;
      this.updateBoardDisplay();
      // 每划过一格就 JSON.stringify 整个棋盘同步写 localStorage 会明显拖慢长距离拖拽，
      // 攒到 pointerup / pointercancel 再写一次。
      this.dragDirty = true;
    }

    // 【单击逻辑】：标记 ✖ 排除 / 取消 ✖
    private handleSingleClick(r: number, c: number) {
      if (this.lives <= 0 && !this.isTutorialMode) return;

      const currentVal = this.gridState[r][c];
      if (currentVal === 2 || currentVal === 3) return;

      const nextVal = (currentVal === 1) ? 0 : 1;
      this.gridState[r][c] = nextVal;
      this.moveCount++;

      this.updateBoardDisplay();
      this.saveStorage(true);

      // 教学模式排除步骤检查 (Step 2: 行排除, Step 3: 列排除, Step 4: 对角排除)
      if (this.isTutorialMode && this.tutorialStep >= 2 && this.tutorialStep <= 4) {
        const currentHint = this.currentLevelData?.hints?.find((h: any) => h.step === this.tutorialStep);
        if (currentHint?.targetCells) {
          const allMarked = currentHint.targetCells.every((cell: any) => this.gridState[cell.row][cell.col] === 1);
          if (allMarked) {
            setTimeout(() => {
              this.updateTutorialStepUI(this.tutorialStep + 1);
            }, 300);
          }
        }
      }
    }

    // 【双击逻辑】：判定找对/找错
    private handleDoubleClick(r: number, c: number) {
      if (this.lives <= 0 && !this.isTutorialMode) return;

      const currentVal = this.gridState[r][c];
      if (currentVal === 2 || currentVal === 3) return;

      this.moveCount++;

      // 核心校验：检查是否为正确解
      const isSolutionDong = this.currentLevelData?.solution?.some((s: any) => s.row === r && s.col === c);

      if (isSolutionDong) {
        // ✅ 找对了！
        this.gridState[r][c] = 2;
        if (!this.cellAvatars.has(`${r},${c}`)) {
          this.cellAvatars.set(`${r},${c}`, this.getRandomAvatar());
        }
        this.updateBoardDisplay();
        const foundCell = this.getCellEl(r, c);
        foundCell?.classList.add('last-found');
        setTimeout(() => foundCell?.classList.remove('last-found'), 1250);
        this.saveStorage(true);

        // 教学模式步骤推进
        if (this.isTutorialMode) {
          if (this.tutorialStep === 1 && r === 1 && c === 0) {
            setTimeout(() => this.updateTutorialStepUI(2), 350);
          } else if (this.tutorialStep === 5 && r === 2 && c === 3) {
            // 顺便帮玩家自动打叉绿咚周围的冲突格
            const eliminateCells = [{r: 2, c: 2}, {r: 0, c: 3}, {r: 3, c: 2}, {r: 3, c: 3}];
            eliminateCells.forEach(cell => {
              if (this.gridState[cell.r][cell.c] === 0) this.gridState[cell.r][cell.c] = 1;
            });
            this.updateBoardDisplay();
            setTimeout(() => this.updateTutorialStepUI(6), 350);
          }
        }

        this.checkWinCondition();
      } else {
        // ❌ 找错了！
        if (this.isTutorialMode) {
          this.showConflictToast(this.isEn ? 'Tutorial Guide' : '教学引导', this.isEn ? 'Please double click the highlighted spot!' : '请按照当前步骤的高亮指示双击哦！');
          return;
        }

        this.gridState[r][c] = 3;

        // 免伤保护只吃掉本关的第一次失误：先判定，再消耗，之后照常扣命。
        // 旧写法把标记的赋值放在 analyzeMistakeAndWarn 里，而扣命条件又去读同一个标记，
        // 结果第 1~3 关一旦犯过一次错就再也扣不动命，整关变成无限命。
        const shielded = this.currentLevelId <= 3 && !this.shieldUsedInLevel;
        this.analyzeMistakeAndWarn(r, c, shielded);

        if (shielded) {
          this.shieldUsedInLevel = true;
        } else {
          this.lives--;
        }
        this.updateLivesDisplay();
        this.updateBoardDisplay();
        this.saveStorage(true);

        if (this.lives <= 0) {
          this.handleGameOver();
        }
      }
    }

    // 重来本关
    private handleRestart() {
      if (this.victoryTimer) {
        clearTimeout(this.victoryTimer);
        this.victoryTimer = null;
      }
      const size = this.currentLevelData.size;
      this.gridState = Array.from({ length: size }, () => Array(size).fill(0));
      this.cellAvatars.clear();
      this.lives = 3;
      this.shieldUsedInLevel = false;
      this.hideAllToasts();
      this.updateLivesDisplay();
      this.updateBoardDisplay();
      this.saveStorage(true);

      if (this.isTutorialMode) {
        this.setupTutorialMode();
      }
    }

    // 刷新棋盘视图
    private updateBoardDisplay() {
      if (!this.currentLevelData) return;
      const size = this.currentLevelData.size;

      let correctDongCount = 0;

      for (let r = 0; r < size; r++) {
        for (let c = 0; c < size; c++) {
          const val = this.gridState[r][c];
          if (val === 2) correctDongCount++;

          const cellEl = this.cellEls[r]?.[c];
          if (!cellEl) continue;

          const renderedState = Number(cellEl.dataset.renderedState ?? '-1');
          if (renderedState === val) continue;
          cellEl.dataset.renderedState = val.toString();
          cellEl.classList.toggle('cell-locked', val === 2 || val === 3);
          cellEl.classList.toggle('has-conflict', val === 3);
          cellEl.innerHTML = '';
          const stateText = val === 1 ? this.T.cellCrossed
            : val === 2 ? this.T.cellDong
            : val === 3 ? this.T.cellWrong
            : this.T.cellEmpty;
          cellEl.setAttribute('aria-label', this.T.cellAria(r + 1, c + 1, stateText));

          if (val === 1) {
            const crossWrap = document.createElement('div');
            crossWrap.className = 'cell-cross-wrap';
            crossWrap.innerHTML = `
              <svg viewBox="0 0 24 24" class="cross-svg">
                <line x1="5.5" y1="5.5" x2="18.5" y2="18.5" stroke="#ffffff" stroke-width="4.2" stroke-linecap="round"/>
                <line x1="18.5" y1="5.5" x2="5.5" y2="18.5" stroke="#ffffff" stroke-width="4.2" stroke-linecap="round"/>
              </svg>
            `;
            cellEl.appendChild(crossWrap);
          } else if (val === 2) {
            let avatarPath = this.cellAvatars.get(`${r},${c}`);
            if (!avatarPath) {
              avatarPath = this.getRandomAvatar();
              this.cellAvatars.set(`${r},${c}`, avatarPath);
            }

            const dongWrap = document.createElement('div');
            dongWrap.className = 'cell-dong-wrap';
            
            const avatarDiv = document.createElement('div');
            avatarDiv.className = 'cell-dong-avatar';
            avatarDiv.style.backgroundImage = `url("${avatarPath}")`;
            dongWrap.appendChild(avatarDiv);

            cellEl.appendChild(dongWrap);
          } else if (val === 3) {
            const dongWrap = document.createElement('div');
            dongWrap.className = 'cell-dong-wrap';

            const banOverlay = document.createElement('div');
            banOverlay.className = 'cell-ban-overlay';
            banOverlay.innerHTML = `
              <svg viewBox="0 0 24 24" class="ban-svg">
                <circle cx="12" cy="12" r="9.2" fill="rgba(229, 57, 53, 0.28)" stroke="#e53935" stroke-width="3"/>
                <line x1="5.4" y1="5.4" x2="18.6" y2="18.6" stroke="#e53935" stroke-width="3" stroke-linecap="round"/>
              </svg>
            `;
            dongWrap.appendChild(banOverlay);

            cellEl.appendChild(dongWrap);
          }
        }
      }

      const placedEl = document.getElementById('placed-count');
      if (placedEl) placedEl.textContent = correctDongCount.toString();
    }

    // 检查通关状态
    private checkWinCondition() {
      if (!this.currentLevelData) return;
      if (this.lives <= 0 && !this.isTutorialMode) return;
      const size = this.currentLevelData.size;

      let correctDongs = 0;
      for (let r = 0; r < size; r++) {
        for (let c = 0; c < size; c++) {
          if (this.gridState[r][c] === 2) {
            correctDongs++;
          }
        }
      }

      if (correctDongs === size) {
        if (this.victoryTimer) return;
        this.victoryTimer = setTimeout(() => {
          this.victoryTimer = null;
          if (this.isTutorialMode) {
            this.handleTutorialVictory();
          } else {
            this.handleVictory();
          }
        }, 1100);
      }
    }

    // 挑战失败结算
    private handleGameOver() {
      this.openModal('modal-gameover');
    }

    // 教学关通关结算
    private handleTutorialVictory() {
      localStorage.setItem('dongdoku_tutorial_completed', 'true');
      localStorage.setItem('dongdoku_has_seen_guide_v2', 'true');
      this.hasCompletedTutorial = true;

      const tutAvatar = document.getElementById('tutorial-win-avatar');
      if (tutAvatar) {
        tutAvatar.style.backgroundImage = `url("${this.getRandomAvatar()}")`;
      }

      this.openModal('modal-tutorial-win');
    }

    // 正式关卡胜利结算
    private handleVictory() {
      if (this.currentLevelId >= this.maxUnlockedLevel) {
        this.maxUnlockedLevel = Math.min(1000, this.currentLevelId + 1);
      }

      // 真实通关纪录只在这里增长——选关跳关不会碰它
      this.completedLevels.add(this.currentLevelId);
      this.bestCompletedLevel = Math.max(this.bestCompletedLevel, this.currentLevelId);

      this.saveStorage(false);
      this.updateLevelsModalProgress();

      const winAvatarBox = document.getElementById('win-avatar-box');
      if (winAvatarBox) {
        winAvatarBox.style.backgroundImage = `url("${this.getRandomAvatar()}")`;
      }

      const winRating = document.getElementById('win-rating');
      if (winRating) {
        const stars = Math.max(1, Math.min(3, this.lives));
        winRating.textContent = '★'.repeat(stars) + '☆'.repeat(3 - stars);
        winRating.setAttribute('aria-label', `${stars} / 3`);
      }

      this.openModal('modal-win');
    }

    // 选关弹窗逻辑
    private openLevelsModal() {
      const tabsEl = document.getElementById('levels-pack-tabs');
      const gridEl = document.getElementById('levels-grid');
      if (!tabsEl || !gridEl) return;

      this.updateLevelsModalProgress();
      const currentPackIdx = Math.max(0, Math.floor(((this.currentLevelId || 1) - 1) / 50));

      tabsEl.innerHTML = '';
      for (let p = 0; p < 20; p++) {
        const start = p * 50 + 1;
        const end = (p + 1) * 50;
        const tabBtn = document.createElement('button');
        tabBtn.className = `pack-tab-btn ${p === currentPackIdx ? 'active' : ''}`;
        tabBtn.textContent = `${start} - ${end}`;
        tabBtn.addEventListener('click', () => {
          document.querySelectorAll('.pack-tab-btn').forEach(b => b.classList.remove('active'));
          tabBtn.classList.add('active');
          this.renderLevelsGrid(p);
        });
        tabsEl.appendChild(tabBtn);
      }

      this.renderLevelsGrid(currentPackIdx);
      this.openModal('modal-levels');

      setTimeout(() => {
        const activeTab = tabsEl.querySelector('.pack-tab-btn.active') as HTMLElement;
        if (activeTab) {
          activeTab.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        }
      }, 50);
    }

    // 渲染选关网格
    private renderLevelsGrid(packIdx: number) {
      const gridEl = document.getElementById('levels-grid');
      if (!gridEl) return;
      gridEl.innerHTML = '';

      // 在第一个分页的最前头添加 🎓 0 教学关卡
      if (packIdx === 0) {
        const tutCard = document.createElement('button');
        tutCard.type = 'button';
        const isCurrentTut = (this.currentLevelId === 0);
        tutCard.className = `level-card tutorial-card ${isCurrentTut ? 'current' : ''}`;
        tutCard.innerHTML = `
          <span class="lvl-num">🎓 0</span>
          <span class="lvl-badge diff-0">${this.isEn ? 'Tutorial' : '教学关'}</span>
        `;
        tutCard.addEventListener('click', () => {
          this.closeModal('modal-levels');
          this.startTutorial();
        });
        gridEl.appendChild(tutCard);
      }

      const start = packIdx * 50 + 1;
      const end = (packIdx + 1) * 50;

      for (let lid = start; lid <= end; lid++) {
        // 用 button 而不是 div，键盘用户才能 Tab 到关卡卡片
        const card = document.createElement('button');
        card.type = 'button';
        const isCurrent = (lid === this.currentLevelId);
        // 走真实通关纪录，而不是"访问过的最大关号"
        const isCompleted = this.completedLevels.has(lid);

        card.className = `level-card ${isCurrent ? 'current' : ''} ${isCompleted ? 'completed' : ''}`;

        const manifestItem = this.manifestById.get(lid);
        const size = manifestItem ? manifestItem.size : (lid <= 5 ? 4 : (lid <= 10 ? 5 : 8));
        const sizeText = `${size}×${size}`;

        card.innerHTML = `
          <span class="lvl-num">${lid}</span>
          <span class="lvl-badge diff-${size}">${sizeText}</span>
        `;
        card.setAttribute('aria-label', this.isEn
          ? `Level ${lid}, ${sizeText}${isCompleted ? ', completed' : ''}`
          : `第 ${lid} 关，${sizeText}${isCompleted ? '，已通关' : ''}`);
        if (isCurrent) card.setAttribute('aria-current', 'true');

        card.addEventListener('click', () => {
          this.closeModal('modal-levels');
          this.loadLevel(lid);
        });

        gridEl.appendChild(card);
      }
    }

    // 通用弹窗开关
    private openModal(id: string) {
      const el = document.getElementById(id);
      if (!el) return;
      // 记住触发弹窗前的焦点，关闭时还回去
      const active = document.activeElement;
      if (active instanceof HTMLElement && !el.contains(active)) {
        this.lastFocusedBeforeModal = active;
      }
      el.style.display = 'flex';
      const firstBtn = el.querySelector('button, [href]') as HTMLElement | null;
      firstBtn?.focus();
    }

    private closeModal(id: string) {
      const el = document.getElementById(id);
      if (!el) return;
      const hadFocus = el.contains(document.activeElement);
      el.style.display = 'none';
      if (hadFocus && this.lastFocusedBeforeModal?.isConnected) {
        this.lastFocusedBeforeModal.focus();
      }
      this.lastFocusedBeforeModal = null;
    }
  }

  // 页面加载或就绪时立即启动
  function startDongdoku() {
    if (document.getElementById('dongdoku-app')) {
      new DongdokuApp();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startDongdoku);
  } else {
    startDongdoku();
  }
</script>
