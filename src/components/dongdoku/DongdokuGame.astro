    max-height: 55vh;
    background: #ffffff;
  }

  .levels-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
    gap: 0.65rem;
  }

  .level-card {
    aspect-ratio: 1 / 1;
    border-radius: 0.95rem;
    border: 1.5px solid #ebdcd5;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    font-weight: 900;
    cursor: pointer;
    transition: all 0.15s ease;
    position: relative;
    box-shadow: 0 2px 6px rgba(78, 64, 55, 0.05);
    padding: 0.3rem;
    box-sizing: border-box;
  }

  .level-card:hover {
    transform: translateY(-2px);
    border-color: #1e88e5;
    box-shadow: 0 5px 14px rgba(30, 136, 229, 0.22);
  }

  .level-card:active {
