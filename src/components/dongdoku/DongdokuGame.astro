    margin: 0 auto;
  }

  .gameover-avatar-box {
    border-color: #ef5350;
    box-shadow: 0 8px 24px rgba(239, 83, 80, 0.4);
    background-image: url('/game/assets/image-%20002.webp');
  }

  .win-gold-badge {
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    background: #ffd700;
    color: #5d4037;
    font-size: 0.65rem;
    font-weight: 900;
    padding: 0.2rem 0.6rem;
    border-radius: 1rem;
    white-space: nowrap;
    box-shadow: 0 2px 6px rgba(0,0,0,0.2);
  }

  .win-stats-grid {
    display: flex;
    justify-content: center;
