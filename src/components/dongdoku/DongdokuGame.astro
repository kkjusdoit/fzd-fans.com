</style>

<script>
  import { INITIAL_LEVELS } from './initialLevels';

  // ==========================================
  // 《找咚》(Dongdoku) 客户端核心引擎
  // 状态值定义:
  // 0 = EMPTY (空白)
  // 1 = CROSS (✖ 排除标记)
  // 2 = CORRECT_DONG (正确确定的咚咚头像，永久锁定)
  // 3 = WRONG_DONG (找错咚：显示 🚫 违规禁止标志，锁定并扣 1 条命)
  // ==========================================

  // 色彩配置表（莫兰迪马卡龙色盘）
  const REGION_COLORS = [
    '#6CB6DC', // 0: 天空蓝 Sky Blue
    '#A9D893', // 1: 嫩绿 Soft Green
    '#E8C94F', // 2: 暖阳黄 Soft Yellow
    '#D896B3', // 3: 蔷薇粉 Soft Pink
    '#67C5BF', // 4: 薄荷绿 Mint Teal
    '#DD84CB', // 5: 薰衣草紫 Magenta
    '#FAB1A0', // 6: 暖杏桃 Warm Peach
    '#A29BFE', // 7: 浅紫 Lavender
    '#FD79A8', // 8: 亮粉 Hot Pink
    '#81ECEC', // 9: 青碧 Bright Cyan
    '#FDCB6E', // 10: 太阳金 Sun Yellow
    '#B2BEC3', // 11: 银灰 Cool Silver
    '#55EFC4', // 12: 翡翠绿 Light Emerald
    '#E17055', // 13: 暖陶红 Terracotta
    '#74B9FF'  // 14: 湛蓝 Clear Blue
  ];

  // 24 款经典樊振东头像库
  const AVATAR_PATHS = Array.from({ length: 24 }, (_, i) => {
    const num = i.toString().padStart(3, '0');
    return `/game/assets/image-%20${num}.webp`;
  });

  // 游戏主控制器
  class DongdokuApp {
    private container: HTMLElement;
    private levelCache: Map<number, any> = new Map();
    private manifest: Array<{ id: number; size: number; difficulty: string; diffText: string }> = [];
    
    private currentLevelId: number = 1;
    private maxUnlockedLevel: number = 1;
    private currentLevelData: any = null;
    private gridState: number[][] = []; 
    private cellAvatars: Map<string, string> = new Map(); // `${r},${c}` -> avatarPath
    private moveCount: number = 0;
    private lives: number = 3; // 3条命
    private rulesExpanded: boolean = true;

    // 触摸/点击防抖与双击捕获状态
    private lastTapTimes: Map<string, number> = new Map();
    private singleTapTimers: Map<string, any> = new Map();

    constructor() {
      this.container = document.getElementById('dongdoku-app')!;
      
      // 载入内嵌初始关卡
      for (const [idStr, data] of Object.entries(INITIAL_LEVELS)) {
        this.levelCache.set(Number(idStr), data);
      }

      this.loadStorage();
      this.initDOMElements();
      this.initEvents();
      
      // 立即加载并渲染当前关卡
      this.loadLevel(this.currentLevelId);

      // 后台静默拉取关卡总清单
      this.fetchManifest();
    }

    // 从 LocalStorage 加载记录
    private loadStorage() {
      try {
        const saved = localStorage.getItem('dongdoku_save_v1');
        if (saved) {
          const parsed = JSON.parse(saved);
          if (parsed.currentLevelId) this.currentLevelId = parsed.currentLevelId;
          if (parsed.maxUnlockedLevel) this.maxUnlockedLevel = parsed.maxUnlockedLevel;
          if (parsed.rulesExpanded !== undefined) this.rulesExpanded = parsed.rulesExpanded;
        }
      } catch (e) {
        console.warn('Failed to parse localStorage', e);
      }
    }

    // 保存到 LocalStorage
    private saveStorage(saveBoard: boolean = true) {
      try {
        const payload: any = {
          currentLevelId: this.currentLevelId,
          maxUnlockedLevel: this.maxUnlockedLevel,
          rulesExpanded: this.rulesExpanded
        };

        if (saveBoard) {
          payload.boardState = {
            levelId: this.currentLevelId,
            grid: this.gridState,
            lives: Math.max(1, this.lives)
          };
        }

        localStorage.setItem('dongdoku_save_v1', JSON.stringify(payload));
      } catch (e) {
        console.warn('Failed to save to localStorage', e);
      }
    }

    // 获取关卡总索引清单
    private async fetchManifest() {
      try {
        const res = await fetch('/data/dongdoku/manifest.json');
        if (res.ok) {
          this.manifest = await res.json();
          this.updateLevelsModalProgress();
        }
      } catch (e) {
        console.warn('Failed to fetch manifest', e);
      }
    }

    // 动态获取关卡数据（带分包缓存）
    private async fetchLevelData(levelId: number): Promise<any> {
      if (this.levelCache.has(levelId)) {
        return this.levelCache.get(levelId);
      }

      const packIdx = Math.floor((levelId - 1) / 50);
      try {
        const res = await fetch(`/data/dongdoku/pack_${packIdx}.json`);
        if (res.ok) {
          const packData = await res.json();
          for (const [lid, data] of Object.entries(packData)) {
            this.levelCache.set(Number(lid), data);
          }
          return this.levelCache.get(levelId);
        }
      } catch (e) {
        console.error(`Failed to fetch pack ${packIdx}`, e);
      }
      return null;
    }

    private initDOMElements() {
      this.updateLivesDisplay();
      this.updateLevelsModalProgress();
      this.applyRulesCollapseState();
    }

    private applyRulesCollapseState() {
      const cardsBox = document.getElementById('rules-cards-box');
      const arrow = document.getElementById('rules-toggle-arrow');
      const btn = document.getElementById('btn-toggle-rules');

      if (cardsBox && arrow && btn) {
        cardsBox.style.display = this.rulesExpanded ? 'grid' : 'none';
        arrow.textContent = this.rulesExpanded ? '▲' : '▼';
        btn.setAttribute('aria-expanded', this.rulesExpanded.toString());
      }
    }

    private updateLivesDisplay() {
      const livesEl = document.getElementById('lives-display');
      if (!livesEl) return;
      const full = '❤️'.repeat(Math.max(0, this.lives));
      const lost = '🤍'.repeat(Math.max(0, 3 - this.lives));
      livesEl.textContent = full + lost;
    }

    private updateLevelsModalProgress() {
      const el = document.getElementById('levels-unlocked-count');
      if (el) el.textContent = this.maxUnlockedLevel.toString();
    }

    private initEvents() {
      // 规则折叠切换
      document.getElementById('btn-toggle-rules')?.addEventListener('click', () => {
        this.rulesExpanded = !this.rulesExpanded;
        this.applyRulesCollapseState();
        this.saveStorage(false);
      });

      // 重来
      document.getElementById('btn-restart')?.addEventListener('click', () => this.handleRestart());

      // 选关弹窗
      document.getElementById('btn-open-levels')?.addEventListener('click', () => this.openLevelsModal());
      document.getElementById('btn-close-levels')?.addEventListener('click', () => this.closeModal('modal-levels'));
      document.getElementById('btn-win-levels')?.addEventListener('click', () => {
        this.closeModal('modal-win');
        this.openLevelsModal();
      });

      // 跳至最新关
      document.getElementById('btn-jump-current')?.addEventListener('click', () => {
        this.closeModal('modal-levels');
        this.loadLevel(this.maxUnlockedLevel);
      });

      // 胜利弹窗中的下一关
      document.getElementById('btn-next-level')?.addEventListener('click', () => {
        this.closeModal('modal-win');
        this.loadLevel(this.currentLevelId + 1);
      });

      // 游戏结束弹窗中的重新开始 / 选关
      document.getElementById('btn-gameover-restart')?.addEventListener('click', () => {
        this.closeModal('modal-gameover');
        this.handleRestart();
      });
      document.getElementById('btn-gameover-levels')?.addEventListener('click', () => {
        this.closeModal('modal-gameover');
        this.openLevelsModal();
      });
    }

    // 随机获取一款樊振东头像
    private getRandomAvatar(): string {
      const idx = Math.floor(Math.random() * AVATAR_PATHS.length);
      return AVATAR_PATHS[idx];
    }

    // 加载指定关卡
    public async loadLevel(levelId: number) {
      if (levelId < 1) levelId = 1;
      if (levelId > 1000) levelId = 1000;

      this.currentLevelId = levelId;
      if (levelId > this.maxUnlockedLevel) {
        this.maxUnlockedLevel = levelId;
      }
      this.saveStorage(false);
      this.updateLevelsModalProgress();

      let data = this.levelCache.get(levelId);
      if (!data) {
        const gridEl = document.getElementById('game-grid');
        if (gridEl) gridEl.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:2rem;color:#999;">正在加载关卡...</div>';
        data = await this.fetchLevelData(levelId);
      }

      if (!data) {
        alert('关卡数据加载失败，请检查网络');
        return;
      }

      this.currentLevelData = data;
      this.initBoardState(data);
      this.renderUI(data);
    }

    // 初始化棋盘数据与暂存恢复
    private initBoardState(data: any) {
      const size = data.size;
      this.gridState = Array.from({ length: size }, () => Array(size).fill(0));
      this.cellAvatars.clear();
      this.moveCount = 0;
      this.lives = 3; // 重置满血 3 条命

      try {
        const saved = localStorage.getItem('dongdoku_save_v1');
        if (saved) {
          const parsed = JSON.parse(saved);
          if (parsed.boardState && parsed.boardState.levelId === this.currentLevelId && parsed.boardState.grid) {
            this.gridState = parsed.boardState.grid;
            if (parsed.boardState.lives && parsed.boardState.lives > 0) {
              this.lives = parsed.boardState.lives;
            }
            for (let r = 0; r < size; r++) {
              for (let c = 0; c < size; c++) {
                if (this.gridState[r][c] === 2 || this.gridState[r][c] === 3) {
                  this.cellAvatars.set(`${r},${c}`, this.getRandomAvatar());
                }
              }
            }
          }
        }
      } catch (e) {}
    }

    // 渲染 UI 与网格（手势极速分流：单击 ✖ / 双击 🏓）
    private renderUI(data: any) {
      const curLvlNum = document.getElementById('cur-level-num');
      if (curLvlNum) curLvlNum.textContent = data.id.toString();

      const targetCount = document.getElementById('target-count');
      if (targetCount) targetCount.textContent = data.size.toString();

      this.updateLivesDisplay();

      const gridEl = document.getElementById('game-grid');
      if (!gridEl) return;

      const size = data.size;
      gridEl.style.gridTemplateColumns = `repeat(${size}, minmax(0, 1fr))`;
      gridEl.style.gridTemplateRows = `repeat(${size}, minmax(0, 1fr))`;
      gridEl.innerHTML = '';

      for (let r = 0; r < size; r++) {
        for (let c = 0; c < size; c++) {
          const regionId = data.regions[r][c];
          const cellEl = document.createElement('button');
          cellEl.type = 'button';
          cellEl.className = 'grid-cell';
          cellEl.setAttribute('data-row', r.toString());
          cellEl.setAttribute('data-col', c.toString());
          cellEl.setAttribute('data-region', regionId.toString());
          
          const color = REGION_COLORS[regionId % REGION_COLORS.length];
          cellEl.style.backgroundColor = color;

          const key = `${r},${c}`;

          // 单一点击分发：第一次点击等待短窗口，第二次同格点击提交。
          // 不再同时监听 click 和 dblclick，避免两个事件重复或互相抢占。
          cellEl.addEventListener('click', (e) => {
            e.preventDefault();
            if (this.lives <= 0) return;
            const currentVal = this.gridState[r][c];
            if (currentVal === 2 || currentVal === 3) return;

            const now = Date.now();
            const lastTap = this.lastTapTimes.get(key) || 0;
            const isDoubleTap = lastTap > 0 && now - lastTap <= 420;

            if (isDoubleTap) {
              // 判定为双击 -> 立即清除单击计时器并执行确定找咚
              if (this.singleTapTimers.has(key)) {
                clearTimeout(this.singleTapTimers.get(key));
                this.singleTapTimers.delete(key);
              }
              this.lastTapTimes.delete(key);
              this.handleDoubleClick(r, c);
            } else {
              // 第一次轻点 -> 记录时间并设置防抖
              this.lastTapTimes.set(key, now);
              if (this.singleTapTimers.has(key)) {
                clearTimeout(this.singleTapTimers.get(key));
              }
              const timer = setTimeout(() => {
                this.singleTapTimers.delete(key);
                this.lastTapTimes.delete(key);
                this.handleSingleClick(r, c);
              }, 420);
              this.singleTapTimers.set(key, timer);
            }
          });

          // 电脑端右键单击：0 毫秒标记/清除 ✖
          cellEl.addEventListener('contextmenu', (e) => {
            e.preventDefault();
            if (this.singleTapTimers.has(key)) {
              clearTimeout(this.singleTapTimers.get(key));
              this.singleTapTimers.delete(key);
            }
            this.handleSingleClick(r, c);
          });

          gridEl.appendChild(cellEl);
        }
      }

      this.updateBoardDisplay();
    }

    // 【单击逻辑】：仅针对当前格子标记 ✖ 排除 / 取消 ✖
    private handleSingleClick(r: number, c: number) {
      if (this.lives <= 0) return;

      const currentVal = this.gridState[r][c];
      if (currentVal === 2 || currentVal === 3) return; // 锁定格不能改

      const nextVal = (currentVal === 1) ? 0 : 1;
      this.gridState[r][c] = nextVal;
      this.moveCount++;

      this.updateBoardDisplay();
      this.saveStorage(true);
    }

    // 【双击逻辑】：仅针对当前格子判定找对/找错（对则亮头像，错则亮 🚫 扣 1 条命）
    private handleDoubleClick(r: number, c: number) {
      if (this.lives <= 0) return;

      const currentVal = this.gridState[r][c];
      if (currentVal === 2 || currentVal === 3) return; // 已经确定过，无再次机会

      this.moveCount++;

      // 核心校验：检查该格是否为本关正确解（Ground Truth Solution）
      const isSolutionDong = this.currentLevelData?.solution?.some((s: any) => s.row === r && s.col === c);

      if (isSolutionDong) {
        // ✅ 找对了！仅在该格子点亮樊振东头像
        this.gridState[r][c] = 2;
        if (!this.cellAvatars.has(`${r},${c}`)) {
          this.cellAvatars.set(`${r},${c}`, this.getRandomAvatar());
        }
        this.updateBoardDisplay();
        this.saveStorage(true);
        this.checkWinCondition();
      } else {
        // ❌ 找错了！仅在该格子显示异常禁止标志 🚫 并扣除 1 条命
        this.gridState[r][c] = 3;

        this.lives--;
        this.updateLivesDisplay();
        this.updateBoardDisplay();
        this.saveStorage(true);

        if (this.lives <= 0) {
          this.handleGameOver();
        }
      }
    }

    // 重来本关
    private handleRestart() {
      const size = this.currentLevelData.size;
      this.gridState = Array.from({ length: size }, () => Array(size).fill(0));
      this.cellAvatars.clear();
      this.lives = 3;
      this.updateLivesDisplay();
      this.updateBoardDisplay();
      this.saveStorage(true);
    }

    // 刷新棋盘视图
    private updateBoardDisplay() {
      if (!this.currentLevelData) return;
      const size = this.currentLevelData.size;

      let correctDongCount = 0;

      for (let r = 0; r < size; r++) {
        for (let c = 0; c < size; c++) {
          const val = this.gridState[r][c];
          const cellEl = document.querySelector(`.grid-cell[data-row="${r}"][data-col="${c}"]`) as HTMLButtonElement;
          if (!cellEl) continue;

          if (val === 2) correctDongCount++;
          const renderedState = Number(cellEl.dataset.renderedState ?? '-1');
          if (renderedState === val) continue;
          cellEl.dataset.renderedState = val.toString();
          cellEl.classList.toggle('cell-locked', val === 2 || val === 3);
          cellEl.classList.toggle('has-conflict', val === 3);
          cellEl.innerHTML = '';
          const stateText = val === 1 ? '已标记排除' : val === 2 ? '已找到咚' : val === 3 ? '找错咚，已锁定' : '空格';
          cellEl.setAttribute('aria-label', `第 ${r + 1} 行第 ${c + 1} 列，${stateText}`);

          if (val === 1) {
            // ✖ 排除白色交叉
            const crossWrap = document.createElement('div');
            crossWrap.className = 'cell-cross-wrap';
            crossWrap.innerHTML = `
              <svg viewBox="0 0 24 24" class="cross-svg">
                <line x1="5.5" y1="5.5" x2="18.5" y2="18.5" stroke="#ffffff" stroke-width="4.2" stroke-linecap="round"/>
                <line x1="18.5" y1="5.5" x2="5.5" y2="18.5" stroke="#ffffff" stroke-width="4.2" stroke-linecap="round"/>
              </svg>
            `;
            cellEl.appendChild(crossWrap);
          } else if (val === 2) {
            // ✅ 正确咚咚头像（永久锁定）
            let avatarPath = this.cellAvatars.get(`${r},${c}`);
            if (!avatarPath) {
              avatarPath = this.getRandomAvatar();
              this.cellAvatars.set(`${r},${c}`, avatarPath);
            }

            const dongWrap = document.createElement('div');
            dongWrap.className = 'cell-dong-wrap';
            
            const avatarDiv = document.createElement('div');
            avatarDiv.className = 'cell-dong-avatar';
            avatarDiv.style.backgroundImage = `url("${avatarPath}")`;
            dongWrap.appendChild(avatarDiv);

            cellEl.appendChild(dongWrap);
          } else if (val === 3) {
            // ❌ 找错咚：只显示红色 🚫 禁止标志，不显示头像
            const dongWrap = document.createElement('div');
            dongWrap.className = 'cell-dong-wrap';

            const banOverlay = document.createElement('div');
            banOverlay.className = 'cell-ban-overlay';
            banOverlay.innerHTML = `
              <svg viewBox="0 0 24 24" class="ban-svg">
                <circle cx="12" cy="12" r="9.2" fill="rgba(229, 57, 53, 0.28)" stroke="#e53935" stroke-width="3"/>
                <line x1="5.4" y1="5.4" x2="18.6" y2="18.6" stroke="#e53935" stroke-width="3" stroke-linecap="round"/>
              </svg>
            `;
            dongWrap.appendChild(banOverlay);

            cellEl.appendChild(dongWrap);
          }
        }
      }

      const placedEl = document.getElementById('placed-count');
      if (placedEl) placedEl.textContent = correctDongCount.toString();
    }

    // 检查通关状态
    private checkWinCondition() {
      if (!this.currentLevelData || this.lives <= 0) return;
      const size = this.currentLevelData.size;

      let correctDongs = 0;
      for (let r = 0; r < size; r++) {
        for (let c = 0; c < size; c++) {
          if (this.gridState[r][c] === 2) {
            correctDongs++;
          }
        }
      }

      if (correctDongs === size) {
        this.handleVictory();
      }
    }

    // 挑战失败结算
    private handleGameOver() {
      this.openModal('modal-gameover');
    }

    // 通关胜利结算
    private handleVictory() {
      if (this.currentLevelId >= this.maxUnlockedLevel) {
        this.maxUnlockedLevel = Math.min(1000, this.currentLevelId + 1);
      }

      this.saveStorage(false);
      this.updateLevelsModalProgress();

      const winAvatarBox = document.getElementById('win-avatar-box');
      if (winAvatarBox) {
        winAvatarBox.style.backgroundImage = `url("${this.getRandomAvatar()}")`;
      }

      const winMoves = document.getElementById('win-moves');
      if (winMoves) winMoves.textContent = this.moveCount.toString();

      this.openModal('modal-win');
    }

    // 选关弹窗逻辑
    private openLevelsModal() {
      const tabsEl = document.getElementById('levels-pack-tabs');
      const gridEl = document.getElementById('levels-grid');
      if (!tabsEl || !gridEl) return;

      this.updateLevelsModalProgress();
      const currentPackIdx = Math.floor((this.currentLevelId - 1) / 50);

      tabsEl.innerHTML = '';
      for (let p = 0; p < 20; p++) {
        const start = p * 50 + 1;
        const end = (p + 1) * 50;
        const tabBtn = document.createElement('button');
        tabBtn.className = `pack-tab-btn ${p === currentPackIdx ? 'active' : ''}`;
        tabBtn.textContent = `${start} - ${end}`;
        tabBtn.addEventListener('click', () => {
          document.querySelectorAll('.pack-tab-btn').forEach(b => b.classList.remove('active'));
          tabBtn.classList.add('active');
          this.renderLevelsGrid(p);
        });
        tabsEl.appendChild(tabBtn);
      }

      this.renderLevelsGrid(currentPackIdx);
      this.openModal('modal-levels');

      setTimeout(() => {
        const activeTab = tabsEl.querySelector('.pack-tab-btn.active') as HTMLElement;
        if (activeTab) {
          activeTab.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        }
      }, 50);
    }

    // 渲染选关网格
    private renderLevelsGrid(packIdx: number) {
      const gridEl = document.getElementById('levels-grid');
      if (!gridEl) return;
      gridEl.innerHTML = '';

      const start = packIdx * 50 + 1;
      const end = (packIdx + 1) * 50;

      for (let lid = start; lid <= end; lid++) {
        const card = document.createElement('div');
        const isCurrent = (lid === this.currentLevelId);
        const isCompleted = (lid < this.maxUnlockedLevel);
        
        card.className = `level-card ${isCurrent ? 'current' : ''} ${isCompleted ? 'completed' : ''}`;
        
        const manifestItem = this.manifest.find(m => m.id === lid);
        const size = manifestItem ? manifestItem.size : (lid <= 5 ? 4 : (lid <= 10 ? 5 : 8));
        const sizeText = `${size}×${size}`;

        card.innerHTML = `
          <span class="lvl-num">${lid}</span>
          <span class="lvl-badge diff-${size}">${sizeText}</span>
        `;

        card.addEventListener('click', () => {
          this.closeModal('modal-levels');
          this.loadLevel(lid);
        });

        gridEl.appendChild(card);
      }
    }

    // 通用弹窗开关
    private openModal(id: string) {
      const el = document.getElementById(id);
      if (el) el.style.display = 'flex';
    }

    private closeModal(id: string) {
      const el = document.getElementById(id);
      if (el) el.style.display = 'none';
    }
  }

  // 页面加载或就绪时立即启动
  function startDongdoku() {
    if (document.getElementById('dongdoku-app')) {
      new DongdokuApp();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startDongdoku);
  } else {
    startDongdoku();
  }
</script>
