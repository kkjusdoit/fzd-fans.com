---
interface Props {
  lang?: 'zh' | 'en';
}

const { lang = 'zh' } = Astro.props;
const isEn = lang === 'en';

// Text dictionary
const i18n = {
  title: isEn ? 'Dongdoku - Find the Dong' : '找咚 (Dongdoku)',
  rule1Title: isEn ? '1. 行列唯一' : '1. 行列唯一',
  rule1Desc: isEn ? '每行每列正好 1 个咚' : '每行每列正好 1 个咚',
  rule2Title: isEn ? '2. 领地唯一' : '2. 领地唯一',
  rule2Desc: isEn ? '每个色块正好 1 个咚' : '每个色块正好 1 个咚',
  rule3Title: isEn ? '3. 八向隔离' : '3. 八向隔离',
  rule3Desc: isEn ? '咚咚互不相碰(含对角)' : '咚咚互不相碰(含对角)',
  tipGesture: isEn ? '💡 Single click (or Right-click) to mark ✖ | Double click to find Dong 🏓' : '💡 单击/右击标记 ✖ 排除，双击确定 🏓 咚咚（找对出头像，找错亮 🚫 扣 1 条命）',
  levelLabel: isEn ? 'Level' : '第',
  levelSuffix: isEn ? '' : '关',
  levelsBtn: isEn ? 'Levels' : '选关',
  hintBtn: isEn ? 'Hint' : '提示',
  undoBtn: isEn ? 'Undo' : '撤销',
  restartBtn: isEn ? 'Restart' : '重来',
  soundOn: isEn ? 'Sound: ON' : '声音: 开启',
  soundOff: isEn ? 'Sound: OFF' : '声音: 静音',
  placed: isEn ? 'Found' : '已找到',
  lives: isEn ? 'Lives' : '生命值',
  difficulty: {
    easy: isEn ? 'Easy' : '简单',
    medium: isEn ? 'Medium' : '中等',
    hard: isEn ? 'Hard' : '困难',
    expert: isEn ? 'Expert' : '大师',
    tutorial: isEn ? 'Tutorial' : '教学'
  },
  gameOverTitle: isEn ? 'Game Over' : '挑战失败 💔',
  gameOverSubtitle: isEn ? 'You used all 3 lives! Don\'t give up, try again!' : '本关 3 次机会已用尽，别灰心，再来一次！',
  retryLevel: isEn ? 'Retry Level 🔄' : '重新挑战本关 🔄',
  winTitle: isEn ? 'Level Completed!' : '恭喜通关！',
  winSubtitle: isEn ? 'Great logic and sharp deduction!' : '大满贯级的观察力与逻辑推导！',
  nextLevel: isEn ? 'Next Level ➡️' : '下一关 ➡️',
  replayLevel: isEn ? 'Replay 🔄' : '再玩一次 🔄',
  backToLevels: isEn ? 'Levels Menu ≡' : '返回选关 ≡',
  timeSpent: isEn ? 'Time' : '用时',
  movesCount: isEn ? 'Moves' : '步数',
  close: isEn ? 'Close' : '关闭'
};
---

<div class="dongdoku-container" id="dongdoku-app" data-lang={lang}>
  <!-- 顶部控制与状态栏 -->
  <header class="game-header">
    <div class="header-left">
      <button type="button" class="btn-icon" id="btn-open-levels" title={i18n.levelsBtn} aria-label={i18n.levelsBtn}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <span class="btn-text">{i18n.levelsBtn}</span>
      </button>
      <div class="level-indicator">
        <span class="level-badge" id="level-badge">{i18n.levelLabel} <strong id="cur-level-num">1</strong> {i18n.levelSuffix}</span>
        <span class="diff-badge" id="cur-diff-badge">{i18n.difficulty.easy}</span>
        <span class="size-badge" id="cur-size-badge">4×4</span>
      </div>
    </div>

    <div class="header-center">
      <!-- 3 条命 (Hearts) -->
      <div class="lives-pill" id="lives-pill" title={i18n.lives}>
        <span class="lives-display" id="lives-display">❤️❤️❤️</span>
      </div>
      <div class="progress-pill" id="progress-pill" title={i18n.placed}>
        <span class="pill-icon">🏓</span>
        <span id="placed-count">0</span> / <span id="target-count">4</span>
      </div>
      <div class="timer-pill" id="timer-pill">
        <span class="timer-icon">⏱️</span>
        <span id="timer-display">00:00</span>
      </div>
    </div>

    <div class="header-right">
      <button type="button" class="btn-icon" id="btn-hint" title={i18n.hintBtn} aria-label={i18n.hintBtn}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M9 18h6M10 22h4M8.4 14.3a6 6 0 1 1 7.2 0c-.9.7-1.2 1.4-1.2 2.2H9.6c0-.8-.3-1.5-1.2-2.2Z"></path>
        </svg>
        <span class="btn-text">{i18n.hintBtn}</span>
      </button>
      <button type="button" class="btn-icon" id="btn-undo" title={i18n.undoBtn} aria-label={i18n.undoBtn}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M9 7 5 11l4 4M5 11h9a5 5 0 0 1 0 10h-3"></path>
        </svg>
        <span class="btn-text">{i18n.undoBtn}</span>
      </button>
      <button type="button" class="btn-icon" id="btn-restart" title={i18n.restartBtn} aria-label={i18n.restartBtn}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M20 12a8 8 0 1 1-2.3-5.6M20 4v5h-5"></path>
        </svg>
        <span class="btn-text">{i18n.restartBtn}</span>
      </button>
      <button type="button" class="btn-icon btn-sound" id="btn-sound" title={i18n.soundOn} aria-label={i18n.soundOn}>
        <span id="sound-icon">🔊</span>
      </button>
    </div>
  </header>

  <!-- 上方三大规则卡片 -->
  <section class="rules-banner" id="rules-banner" aria-label={i18n.rulesTitle}>
    <div class="rule-card">
      <div class="rule-icon">🏓</div>
      <div class="rule-body">
        <h3>{i18n.rule1Title}</h3>
        <p>{i18n.rule1Desc}</p>
      </div>
    </div>
    <div class="rule-card">
      <div class="rule-icon">🎨</div>
      <div class="rule-body">
        <h3>{i18n.rule2Title}</h3>
        <p>{i18n.rule2Desc}</p>
      </div>
    </div>
    <div class="rule-card">
      <div class="rule-icon">🚫</div>
      <div class="rule-body">
        <h3>{i18n.rule3Title}</h3>
        <p>{i18n.rule3Desc}</p>
      </div>
    </div>
  </section>

  <!-- 操作小贴士 -->
  <div class="gesture-tip-bar">
    <span>{i18n.tipGesture}</span>
  </div>

  <!-- 提示条 / 报错提示条 (Toast Bar) -->
  <div class="toast-message-box" id="toast-message-box" style="display: none;">
    <span class="toast-icon" id="toast-icon">💡</span>
    <span class="toast-text" id="toast-text"></span>
    <button type="button" class="toast-close" id="btn-close-toast">×</button>
  </div>

  <!-- 核心游戏棋盘区 -->
  <main class="board-wrapper">
    <div class="board-container" id="board-container">
      <div class="game-grid" id="game-grid">
        <!-- 动态生成格子 -->
      </div>
    </div>
  </main>

  <!-- 选关模态弹窗 (Levels Modal) -->
  <div class="modal-backdrop" id="modal-levels" style="display: none;">
    <div class="modal-content modal-levels-content">
      <div class="modal-header">
        <h2>{i18n.levelsBtn} (1 ~ 1000)</h2>
        <button type="button" class="modal-close" id="btn-close-levels">×</button>
      </div>
      <div class="levels-pack-tabs" id="levels-pack-tabs">
        <!-- 分页 Tabs: 1-50, 51-100, 101-150 ... -->
      </div>
      <div class="levels-grid-wrapper">
        <div class="levels-grid" id="levels-grid">
          <!-- 关卡卡片 -->
        </div>
      </div>
    </div>
  </div>

  <!-- 游戏失败弹窗 (Game Over Modal) -->
  <div class="modal-backdrop" id="modal-gameover" style="display: none;">
    <div class="modal-content modal-win-content modal-gameover-content">
      <div class="gameover-icon">💔</div>
      <h2 class="gameover-title">{i18n.gameOverTitle}</h2>
      <p class="win-subtitle">{i18n.gameOverSubtitle}</p>
      
      <div class="win-avatar-showcase">
        <div class="gameover-avatar-box"></div>
      </div>

      <div class="win-actions">
        <button type="button" class="btn-primary" id="btn-gameover-restart">{i18n.retryLevel}</button>
        <button type="button" class="btn-secondary" id="btn-gameover-levels">{i18n.backToLevels}</button>
      </div>
    </div>
  </div>

  <!-- 通关胜利弹窗 (Win Modal) -->
  <div class="modal-backdrop" id="modal-win" style="display: none;">
    <div class="modal-content modal-win-content">
      <div class="win-trophy">🏆</div>
      <h2 class="win-title">{i18n.winTitle}</h2>
      <p class="win-subtitle">{i18n.winSubtitle}</p>
      
      <div class="win-avatar-showcase">
        <div class="win-avatar-large-box" id="win-avatar-box"></div>
        <div class="win-gold-badge">🥇 PARIS 2024 CHAMPION</div>
      </div>

      <div class="win-stats-grid">
        <div class="stat-box">
          <span class="stat-label">{i18n.timeSpent}</span>
          <span class="stat-value" id="win-time">00:24</span>
        </div>
        <div class="stat-box">
          <span class="stat-label">{i18n.movesCount}</span>
          <span class="stat-value" id="win-moves">8</span>
        </div>
      </div>

      <div class="win-actions">
        <button type="button" class="btn-primary" id="btn-next-level">{i18n.nextLevel}</button>
        <button type="button" class="btn-secondary" id="btn-replay-level">{i18n.replayLevel}</button>
        <button type="button" class="btn-secondary" id="btn-win-levels">{i18n.backToLevels}</button>
      </div>
    </div>
  </div>
</div>

<style>
  /* 基础容器 */
  .dongdoku-container {
    max-width: 720px;
    margin: 0 auto;
    padding: 0.2rem 0.5rem 2rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: #3d302c;
    user-select: none;
    -webkit-user-select: none;
    box-sizing: border-box;
  }

  /* 顶部控制栏 */
  .game-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    background: #ffffff;
    border: 1px solid #ebdcd5;
    border-radius: 1.2rem;
    padding: 0.45rem 0.8rem;
    box-shadow: 0 4px 16px rgba(78, 64, 55, 0.08);
    flex-wrap: wrap;
  }

  .header-left, .header-center, .header-right {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .level-indicator {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .level-badge {
    font-weight: 900;
    font-size: 1.05rem;
    color: #3d302c;
  }

  .diff-badge, .size-badge {
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.18rem 0.45rem;
    border-radius: 0.55rem;
    text-transform: uppercase;
  }

  .diff-badge {
    background: #eef7f2;
    color: #2e7d32;
  }

  .size-badge {
    background: #f4effa;
    color: #6a1b9a;
  }

  .lives-pill, .progress-pill, .timer-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background: #fdf6f0;
    border: 1px solid #eedfd8;
    padding: 0.25rem 0.55rem;
    border-radius: 0.9rem;
    font-weight: 800;
    font-size: 0.82rem;
    color: #705851;
  }

  .lives-display {
    font-size: 0.9rem;
    letter-spacing: 2px;
  }

  .btn-icon {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    background: #ffffff;
    border: 1px solid #e5d5cd;
    color: #6e554d;
    padding: 0.35rem 0.55rem;
    border-radius: 0.75rem;
    font-weight: 700;
    font-size: 0.82rem;
    cursor: pointer;
    transition: all 0.15s ease;
    box-shadow: 0 2px 4px rgba(78, 64, 55, 0.05);
  }

  .btn-icon:hover {
    background: #fbf5f2;
    color: #1e88e5;
    border-color: #bbdefb;
    transform: translateY(-1px);
  }

  .btn-icon:active {
    transform: translateY(1px);
  }

  .btn-sound {
    padding: 0.35rem 0.45rem;
  }

  /* 上方三大规则面板 */
  .rules-banner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin: 0.5rem 0 0.35rem;
  }

  .rule-card {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    background: #ffffff;
    border: 1px solid #f0e2db;
    border-radius: 0.85rem;
    padding: 0.45rem 0.6rem;
    box-shadow: 0 2px 8px rgba(78, 64, 55, 0.04);
  }

  .rule-icon {
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .rule-body h3 {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 800;
    color: #3d302c;
    white-space: nowrap;
  }

  .rule-body p {
    margin: 0.1rem 0 0;
    font-size: 0.68rem;
    color: #7d655f;
    line-height: 1.2;
    white-space: nowrap;
  }

  /* 手势提示条 */
  .gesture-tip-bar {
    text-align: center;
    font-size: 0.76rem;
    font-weight: 700;
    color: #8c736c;
    margin: 0.2rem 0 0.3rem;
  }

  /* 提示与报错条 */
  .toast-message-box {
    border-radius: 0.8rem;
    padding: 0.5rem 0.8rem;
    margin: 0.3rem 0 0.4rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 700;
    animation: fadeIn 0.2s ease;
  }

  .toast-message-box.toast-hint {
    background: #fff9db;
    border: 1px solid #ffe066;
    color: #744210;
    box-shadow: 0 3px 10px rgba(230, 180, 0, 0.12);
  }

  .toast-message-box.toast-error {
    background: #ffebee;
    border: 1px solid #ffcdd2;
    color: #c62828;
    box-shadow: 0 3px 10px rgba(244, 67, 54, 0.15);
    animation: shakeToast 0.35s ease-in-out;
  }

  .toast-text {
    flex: 1;
  }

  .toast-close {
    background: none;
    border: none;
    font-size: 1.1rem;
    color: inherit;
    cursor: pointer;
    line-height: 1;
  }

  /* 核心棋盘区 */
  .board-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0.4rem 0;
  }

  .board-container {
    background: #ffffff;
    border: 1px solid #ebdcd5;
    border-radius: 1.5rem;
    padding: 0.75rem;
    box-shadow: 0 10px 30px rgba(78, 64, 55, 0.10);
    width: 100%;
    max-width: min(90vw, 490px, calc(100vh - 220px));
    aspect-ratio: 1 / 1;
    display: flex;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
  }

  .game-grid {
    display: grid;
    width: 100%;
    height: 100%;
    gap: clamp(4px, 1.2vw, 8px);
    box-sizing: border-box;
  }

  /* 棋盘格子 */
  :global(.grid-cell) {
    appearance: none !important;
    -webkit-appearance: none !important;
    padding: 0 !important;
    margin: 0 !important;
    font: inherit !important;
    color: inherit !important;
    position: relative !important;
    width: 100% !important;
    height: 100% !important;
    aspect-ratio: 1 / 1 !important;
    border-radius: clamp(8px, 1.8vw, 14px) !important;
    border: 2.5px solid #ffffff !important;
    cursor: pointer !important;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.08) !important;
    transition: transform 0.12s ease, filter 0.12s ease !important;
    overflow: hidden !important;
    box-sizing: border-box !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    touch-action: manipulation !important;
    user-select: none !important;
    -webkit-user-select: none !important;
    -webkit-tap-highlight-color: transparent !important;
  }

  :global(.grid-cell:hover) {
    transform: scale(1.03);
    filter: brightness(1.06);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    z-index: 2;
  }

  :global(.grid-cell:active) {
    transform: scale(0.96);
  }

  :global(.grid-cell.cell-locked) {
    cursor: default !important;
  }
  :global(.grid-cell.cell-locked:hover) {
    transform: none !important;
  }

  /* 单元格状态：白色 ✖ 排除叉（单击产生） */
  :global(.cell-cross-wrap) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50%;
    height: 50%;
    pointer-events: none !important;
    animation: popCross 0.18s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }

  :global(.cross-svg) {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.25));
  }

  /* 单元格状态：🏓 樊振东头像容器（双击产生） */
  :global(.cell-dong-wrap) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none !important;
    border-radius: inherit;
    overflow: hidden;
  }

  /* 精致圆形头像（基于 background-image，绝对保证为圆形且 100% 适配单元格不溢出） */
  :global(.cell-dong-avatar) {
    width: 82% !important;
    height: 82% !important;
    border-radius: 50% !important;
    background-size: cover !important;
    background-position: center 20% !important;
    background-repeat: no-repeat !important;
    border: 2.5px solid #ffffff !important;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.28) !important;
    animation: popDong 0.22s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    box-sizing: border-box !important;
    flex-shrink: 0 !important;
  }

  /* 🚫 找错咚 / 错误尝试覆盖图层 */
  :global(.cell-ban-overlay) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(229, 57, 53, 0.28);
    border-radius: inherit;
    pointer-events: none !important;
    animation: popBan 0.22s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }

  :global(.ban-svg) {
    width: 68%;
    height: 68%;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.45));
  }

  /* 找错态外框警示 */
  :global(.grid-cell.has-conflict) {
    border-color: #ff1744 !important;
    animation: errorShake 0.4s ease-in-out;
  }

  /* 提示高亮态 */
  :global(.grid-cell.hint-active) {
    animation: pulseHint 1.2s infinite;
    border-color: #ffd700 !important;
    z-index: 5;
  }

  /* 弹窗通用样式 */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(30, 20, 15, 0.6);
    backdrop-filter: blur(5px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    animation: fadeIn 0.2s ease;
  }

  .modal-content {
    background: #ffffff;
    border-radius: 1.5rem;
    box-shadow: 0 20px 50px rgba(0,0,0,0.25);
    max-height: 90vh;
    overflow-y: auto;
    width: 100%;
    animation: scaleUp 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.2rem 1.5rem;
    border-bottom: 1px solid #f0e4dd;
  }

  .modal-header h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 900;
    color: #3d302c;
  }

  .modal-close {
    background: #f5ece7;
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    font-size: 1.3rem;
    cursor: pointer;
    color: #705851;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
  }

  .modal-close:hover {
    background: #ebdcd5;
    color: #000;
  }

  /* 选关弹窗 */
  .modal-levels-content {
    max-width: 680px;
    display: flex;
    flex-direction: column;
  }

  .levels-pack-tabs {
    display: flex;
    gap: 0.4rem;
    padding: 0.8rem 1.2rem;
    overflow-x: auto;
    border-bottom: 1px solid #f0e4dd;
    background: #fcf9f7;
  }

  .pack-tab-btn {
    padding: 0.35rem 0.75rem;
    border-radius: 0.75rem;
    border: 1px solid #ebdcd5;
    background: white;
    font-size: 0.78rem;
    font-weight: 800;
    color: #705851;
    cursor: pointer;
    white-space: nowrap;
  }

  .pack-tab-btn.active {
    background: #1e88e5;
