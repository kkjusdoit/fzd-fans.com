  }

  .level-card .lvl-badge {
    font-size: 0.65rem;
    font-weight: 800;
    padding: 0.12rem 0.4rem;
    border-radius: 0.5rem;
    line-height: 1;
  }

  .lvl-badge.diff-4, .lvl-badge.diff-5 {
    background: #e8f5e9;
    color: #2e7d32;
  }
  .lvl-badge.diff-6, .lvl-badge.diff-7 {
    background: #fff3e0;
    color: #e65100;
  }
  .lvl-badge.diff-8, .lvl-badge.diff-9 {
    background: #f3e5f5;
    color: #6a1b9a;
  }
  .lvl-badge.diff-10 {
    background: #fffde7;
    color: #f57f17;
    font-weight: 900;
  }

  .level-card.completed {
