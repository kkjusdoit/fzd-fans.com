---
// Birthday Audio Component
// Valid until: 2026-01-23 00:00:00 (UTC+8)
---

<div id="birthday-audio-container" style="display: none;">
  <audio id="bgm" loop>
    <source src="/audio/happybirthday.mp3" type="audio/mpeg">
  </audio>
  <button id="music-toggle" class="music-btn" aria-label="Toggle Music">
    <span class="icon">🎵</span>
  </button>
</div>

<style>
  .music-btn {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: white;
    border: 2px solid #e91e63;
    box-shadow: 0 2px 10px rgba(233, 30, 99, 0.2);
    cursor: pointer;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    animation: spin 4s linear infinite;
  }
  
  .music-btn.paused {
    animation-play-state: paused;
    filter: grayscale(1);
    opacity: 0.7;
  }

  .icon {
    font-size: 24px;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>

<script>
  (function() {
    const now = new Date();
    // UTC+8 
    const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
    const chinaTime = new Date(utc + (8 * 3600000));
    const deadline = new Date('2026-01-23T00:00:00+08:00');

    if (chinaTime < deadline) {
      const container = document.getElementById('birthday-audio-container');
      const audio = document.getElementById('bgm') as HTMLAudioElement;
      const btn = document.getElementById('music-toggle');
      
      if (container && audio && btn) {
        container.style.display = 'block';
        
        // Try autoplay
        const playPromise = audio.play();
        
        if (playPromise !== undefined) {
          playPromise.then(_ => {
            // Autoplay started!
            btn.classList.remove('paused');
          }).catch(error => {
            // Auto-play was prevented
            // Show paused state
            btn.classList.add('paused');
          });
        }

        // Toggle handler
        btn.addEventListener('click', () => {
          if (audio.paused) {
            audio.play();
            btn.classList.remove('paused');
          } else {
            audio.pause();
            btn.classList.add('paused');
          }
        });

        // Handle visibility change to save battery/resources? 
        // Optional, but for loop BGM maybe better to keep playing or pause?
        // Usually background music continues unless user stops it.
      }
    }
  })();
</script>
