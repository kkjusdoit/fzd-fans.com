---
/**
 * 图片上传组件
 * 支持拖拽上传和粘贴上传
 */

import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

interface UploadedImage {
  url: string;
  name: string;
}

let uploadedImages: UploadedImage[] = [];
let isUploading = false;
let uploadStatus = '';

const trans = {
    valUnsupported: t('imgupload.val.unsupported'),
    valInvalidName: t('imgupload.val.invalidName'),
    valReqTitle: t('imgupload.val.reqTitle'),
    valReqDetail: t('imgupload.val.reqDetail'),
    successAudit: t('imgupload.successAudit'),
  };
---

<div id="image-uploader" class="image-uploader">
  <!-- 紧凑型上传区域 -->
  <div
    id="drop-zone"
    class="drop-zone"
    class:dragging={false}
    class:uploading={isUploading}
  >
    <div class="upload-icon-large">
      📸
    </div>
    <div class="upload-content">
      <h3>{t('imgupload.dragTitle')}</h3>
      <p class="upload-hint">{t('imgupload.dragHint')}</p>
    </div>
    
    <div class="warning-section">
      <div class="warning-item text-orange">
        ⚠️ {t('imgupload.watermark')}
      </div>
      <div class="warning-item text-gray">
        ℹ️ {t('imgupload.auditNotice')}
      </div>
      <div class="warning-item text-gray" style="margin-top: 0.5rem; font-size: 0.85rem; opacity: 0.9; border-top: 1px dashed rgba(0,0,0,0.1); padding-top: 0.5rem;">
        {t('imgupload.disclaimer')}
      </div>
    </div>

    <input
      type="file"
      id="file-input"
      accept=".jpg,.jpeg,.png,.gif,.webp"
      multiple
      style="display: none;"
    />
  </div>

  <!-- 上传遮罩层 (进度条) -->
  <div id="upload-overlay" class="upload-overlay" style="display: none;">
    <div class="progress-box">
      <!-- 上传中状态 -->
      <div id="uploading-state">
        <h3>{t('imgupload.overlay.uploading')}</h3>
        <p>{t('imgupload.overlay.stay')}</p>
        <div class="progress-bar-container">
          <div id="progress-bar" class="progress-bar"></div>
        </div>
        <div id="progress-text" class="progress-text">0%</div>
      </div>

      <!-- 成功状态 -->
      <div id="success-state" style="display: none;">
        <div class="success-icon">✅</div>
        <h3>{t('imgupload.success')}</h3>
        <p class="success-hint">{t('imgupload.successAudit')}</p>
        <button id="confirm-btn" class="select-btn" style="margin-top: 1rem; width: 100%;">
          确定
        </button>
      </div>
    </div>
  </div>

  {uploadStatus && !isUploading && (
    <div class={`upload-status ${uploadStatus.includes('成功') ? 'success' : 'error'}`}>
      {uploadStatus}
    </div>
  )}
</div>

<style>
  .image-uploader {
    width: 100%;
    max-width: 800px;
    margin: 0 auto 2rem;
    padding: 0 1rem;
  }

  /* Drop Zone Style */
  .drop-zone {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #f8f9fa; /* Light gray background for generic look */
    border: 2px dashed #dee2e6; /* Gray dashed border */
    border-radius: 12px;
    padding: 3rem 2rem;
    cursor: pointer;
    transition: all 0.3s ease;
    gap: 1.5rem;
    min-height: 300px;
    justify-content: center;
    color: #495057;
  }

  .drop-zone:hover,
  .drop-zone.dragging {
    background: #e9ecef;
    border-color: #adb5bd;
  }

  .drop-zone.uploading {
    opacity: 0.6;
    pointer-events: none;
  }

  .upload-icon-large {
    font-size: 4rem;
    margin-bottom: 0.5rem;
  }
  
  .upload-icon-large img {
    width: 80px;
    height: auto;
  }

  .upload-content h3 {
    font-size: 1.5rem;
    color: #343a40;
    margin: 0 0 0.5rem 0;
    font-weight: 500;
  }

  .upload-hint {
    color: #6c757d;
    font-size: 1rem;
    margin: 0;
  }

  /* Warning Box Style */
  .warning-section {
    background: #fff3cd; /* Light yellow */
    border: 1px solid #ffeeba;
    border-radius: 8px;
    padding: 1rem;
    width: 100%;
    max-width: 500px;
    margin: 1rem 0 0;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .warning-item {
    font-size: 0.9rem;
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    line-height: 1.5;
  }
  
  .warning-item .icon {
    font-size: 1.1rem;
  }

  .text-orange { color: #d46b08; font-weight: bold; }
  .text-gray { color: #666; }

  /* Select Button */
  .select-btn {
    background: #1890ff;
    color: white;
    border: none;
    padding: 0.8rem 3rem;
    border-radius: 2rem;
    font-size: 1.1rem;
    cursor: pointer;
    transition: background 0.2s;
    box-shadow: 0 4px 12px rgba(24, 144, 255, 0.3);
  }

  .select-btn:hover {
    background: #096dd9;
  }

  /* 遮罩层 & 进度条 (保持原样) */
  .upload-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.7);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(5px);
  }

  .progress-box {
    background: white;
    padding: 2.5rem;
    border-radius: 16px;
    width: 90%;
    max-width: 400px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    animation: slideUp 0.3s ease;
  }

  .progress-box h3 { margin: 0 0 0.5rem 0; color: #333; font-size: 1.5rem; }
  .progress-box p { margin: 0 0 1.5rem 0; color: #666; }

  .progress-bar-container {
    width: 100%;
    height: 10px;
    background: #f0f0f0;
    border-radius: 5px;
    overflow: hidden;
    margin-bottom: 0.5rem;
  }

  .progress-bar {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, #1e88e5, #42a5f5);
    border-radius: 5px;
    transition: width 0.3s ease;
  }

  .progress-text { font-size: 0.9rem; color: #1e88e5; font-weight: bold; }

  .success-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }
  
  .success-hint {
    color: #666;
    margin-bottom: 1.5rem;
    line-height: 1.6;
    font-size: 0.95rem;
  }

  @keyframes slideUp {
    from { transform: translateY(20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  /* 响应式适配 */
  @media (max-width: 768px) {
    .drop-zone {
      padding: 1.5rem 1rem;
      min-height: 250px;
    }
    
    .upload-content h3 { font-size: 1rem; }
    .upload-hint { font-size: 0.8rem; }
    .warning-item { font-size: 0.75rem; }
  }
</style>

<script define:vars={{ trans }}>
  // @ts-nocheck
  document.addEventListener('DOMContentLoaded', () => {
    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('file-input');
    const overlay = document.getElementById('upload-overlay');
    const progressBar = document.getElementById('progress-bar');
    const progressText = document.getElementById('progress-text');
    const uploadingState = document.getElementById('uploading-state');
    const successState = document.getElementById('success-state');
    const confirmBtn = document.getElementById('confirm-btn');

    // 绑定确定按钮事件
    confirmBtn?.addEventListener('click', () => {
      window.location.reload();
    });

    // 点击整个区域触发选择
    dropZone?.addEventListener('click', () => {
      fileInput?.click();
    });

    // 允许的文件类型
    const ALLOWED_TYPES = [
      'image/jpeg',
      'image/png',
      'image/gif',
      'image/webp'
    ];

    function validateFiles(files) {
      const validFiles = [];
      const invalidTypeFiles = [];

      files.forEach(file => {
        // 1. Check type
        if (!ALLOWED_TYPES.includes(file.type)) {
          invalidTypeFiles.push(file.name);
          return;
        }
        validFiles.push(file);
      });

      let errorMsg = '';
      if (invalidTypeFiles.length > 0) {
        errorMsg += `${trans.valUnsupported}${invalidTypeFiles.join('\n')}\n\n`;
      }

      if (errorMsg) {
        alert(errorMsg);
      }

      return validFiles;
    }

    // 文件选择
    fileInput?.addEventListener('change', (e) => {
      const files = Array.from(e.target.files || []);
      const validFiles = validateFiles(files);
      if (validFiles.length > 0) {
        uploadFiles(validFiles);
      } else {
        fileInput.value = '';
      }
    });

    // 拖拽上传
    dropZone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('dragging');
    });

    dropZone?.addEventListener('dragleave', (e) => {
      e.preventDefault();
      dropZone.classList.remove('dragging');
    });

    dropZone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('dragging');
      e.stopPropagation(); // 防止浏览器打开图片

      const files = Array.from(e.dataTransfer?.files || []);
      const validFiles = validateFiles(files);

      if (validFiles.length > 0) {
        uploadFiles(validFiles);
      }
    });

    // 粘贴上传
    document.addEventListener('paste', (e) => {
      const items = e.clipboardData?.items;
      if (!items) return;

      const files = [];

      for (const item of items) {
        if (item.type.startsWith('image/')) {
          const file = item.getAsFile();
          if (file) files.push(file);
        }
      }

      const validFiles = validateFiles(files);

      if (validFiles.length > 0) {
        uploadFiles(validFiles);
      }
    });

    // 更新进度条
    function updateProgress(percent) {
      if (progressBar) progressBar.style.width = `${percent}%`;
      if (progressText) progressText.textContent = `${percent}%`;
    }

    // 上传文件
    async function uploadFiles(files) {
      if (files.length === 0) return;

      // 重置状态
      if (uploadingState) uploadingState.style.display = 'block';
      if (successState) successState.style.display = 'none';
      if (overlay) overlay.style.display = 'flex';
      
      let progress = 0;
      const progressInterval = setInterval(() => {
        if (progress < 30) {
          progress += 5;
        } else if (progress < 80) {
          progress += 1;
        } else if (progress < 95) {
          progress += 0.5;
        }
        updateProgress(Math.min(95, Math.round(progress)));
      }, 100);

      try {
        for (const file of files) {
          await uploadFile(file);
        }
        
        // 上传完成
        clearInterval(progressInterval);
        updateProgress(100);
        
        setTimeout(() => {
          // 切换到成功状态
          if (uploadingState) uploadingState.style.display = 'none';
          if (successState) successState.style.display = 'block';
        }, 200);

      } catch (error) {
        clearInterval(progressInterval);
        if (overlay) overlay.style.display = 'none';
        updateProgress(0);
        alert(error.message || '上传失败');
      }
    }

    async function uploadFile(file) {
      console.log('开始处理文件 (Base64):', file.name);

      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        
        reader.onload = async (e) => {
          try {
            const base64Data = e.target.result;
            const ext = file.name.split('.').pop() || '';
            const safeName = `upload_${Date.now()}_${Math.random().toString(36).substr(2, 9)}.${ext}`;
            
            console.log('准备发送上传请求:', safeName);

            const payload = {
              file: base64Data, // Data URL
              name: safeName,
              originalName: file.name,
              type: file.type
            };

            const response = await fetch('/api/upload', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify(payload)
            });

            if (!response.ok) {
              let errorMessage = `HTTP ${response.status}: ${response.statusText}`;
              try {
                 const errorData = await response.json();
                 if (errorData.error) {
                   errorMessage += `\nDetails: ${errorData.error}`;
                   if (errorData.details) errorMessage += `\n${errorData.details}`;
                   if (errorData.debug) errorMessage += `\nDebug: ${JSON.stringify(errorData.debug, null, 2)}`;
                 }
              } catch (e) {
                // Ignore JSON parse error
              }
              throw new Error(errorMessage);
            }

            const result = await response.json();
            console.log('Upload success result:', result);
            
            resolve(result);
          } catch (error) {
            console.error('Upload error in component:', error);
            reject(error);
          }
        };

        reader.onerror = (error) => {
          console.error('File reading error:', error);
          reject(new Error('Failed to read file'));
        };

        reader.readAsDataURL(file);
      });
    }
  });
</script>
