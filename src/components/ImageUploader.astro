---
/**
 * 图片上传组件
 * 支持拖拽上传和粘贴上传
 */

import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

interface UploadedImage {
  url: string;
  name: string;
}

let uploadedImages: UploadedImage[] = [];
let isUploading = false;
let uploadStatus = '';

const trans = {
  valUnsupported: t('imgupload.val.unsupported'),
  valInvalidName: t('imgupload.val.invalidName'),
  valReqTitle: t('imgupload.val.reqTitle'),
  valReqDetail: t('imgupload.val.reqDetail'),
  successAudit: t('imgupload.successAudit'),
};
---

<div id="image-uploader" class="image-uploader">
  <div class="uploader-container">
    <!-- 上传区域 -->
    <div
      id="drop-zone"
      class="drop-zone"
      class:dragging={false}
      class:uploading={isUploading}
    >
      <div class="upload-icon">📸</div>
      <h3>{t('imgupload.dragTitle')}</h3>
      <p class="upload-hint">{t('imgupload.dragHint')}</p>
      <div class="naming-rules">
         <p style="margin-top: 0.8rem; color: #e65100; font-weight: bold;">{t('imgupload.watermark')}</p>
         <p style="margin-top: 0.5rem; color: #666; font-size: 0.85rem; border-top: 1px dashed #e0e0e0; padding-top: 0.5rem;">{t('imgupload.auditNotice')}</p>
      </div>
      <input
        type="file"
        id="file-input"
        accept=".jpg,.jpeg,.png,.gif,.webp"
        multiple
        style="display: none;"
      />
      <button id="select-btn" class="select-btn">{t('imgupload.selectBtn')}</button>
    </div>

    <!-- 上传遮罩层 (进度条) -->
    <div id="upload-overlay" class="upload-overlay" style="display: none;">
      <div class="progress-box">
        <h3>{t('imgupload.overlay.uploading')}</h3>
        <p>{t('imgupload.overlay.stay')}</p>
        <div class="progress-bar-container">
          <div id="progress-bar" class="progress-bar"></div>
        </div>
        <div id="progress-text" class="progress-text">0%</div>
      </div>
    </div>

    {uploadStatus && !isUploading && (
      <div class={`upload-status ${uploadStatus.includes('成功') ? 'success' : 'error'}`}>
        {uploadStatus}
      </div>
    )}

<style>
  /* 遮罩层 */
  .upload-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.7);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(5px);
  }

  .progress-box {
    background: white;
    padding: 2.5rem;
    border-radius: 16px;
    width: 90%;
    max-width: 400px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    animation: slideUp 0.3s ease;
  }

  .progress-box h3 {
    margin: 0 0 0.5rem 0;
    color: #333;
    font-size: 1.5rem;
  }

  .progress-box p {
    margin: 0 0 1.5rem 0;
    color: #666;
  }

  .progress-bar-container {
    width: 100%;
    height: 10px;
    background: #f0f0f0;
    border-radius: 5px;
    overflow: hidden;
    margin-bottom: 0.5rem;
  }

  .progress-bar {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, #1e88e5, #42a5f5);
    border-radius: 5px;
    transition: width 0.3s ease;
  }

  .progress-text {
    font-size: 0.9rem;
    color: #1e88e5;
    font-weight: bold;
  }

  @keyframes slideUp {
    from { transform: translateY(20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  .image-uploader {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .uploader-container {
    background: #fff;
    border-radius: 12px;
    padding: 2rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  /* 上传区域 */
  .drop-zone {
    border: 3px dashed #bbdefb;
    border-radius: 12px;
    padding: 3rem 2rem;
    text-align: center;
    transition: all 0.3s;
    cursor: pointer;
    background: linear-gradient(135deg, #e3f2fd 0%, #fff 100%);
  }

  .drop-zone:hover,
  .drop-zone.dragging {
    border-color: #1e88e5;
    background: linear-gradient(135deg, #bbdefb 0%, #e3f2fd 100%);
    transform: scale(1.02);
  }

  .drop-zone.uploading {
    pointer-events: none;
    opacity: 0.6;
  }

  .upload-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
  }

  .drop-zone h3 {
    color: #1e88e5;
    margin-bottom: 0.5rem;
    font-size: 1.3rem;
  }

  .upload-hint {
    color: #888;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }

  .select-btn {
    background: #1e88e5;
    color: #fff;
    border: none;
    padding: 0.8rem 2rem;
    border-radius: 2rem;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s;
  }

  .select-btn:hover {
    background: #0d47a1;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(30, 136, 229, 0.3);
  }

  /* 上传状态 */
  .upload-status {
    margin-top: 1rem;
    padding: 1rem;
    border-radius: 8px;
    text-align: center;
    font-size: 0.95rem;
  }

  .upload-status.uploading {
    background: #e3f2fd;
    color: #1e88e5;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .upload-status.success {
    background: #e8f5e9;
    color: #2e7d32;
  }

  .upload-status.error {
    background: #ffebee;
    color: #c62828;
  }

  .spinner {
    width: 20px;
    height: 20px;
    border: 3px solid #bbdefb;
    border-top-color: #1e88e5;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* 已上传图片 */
  .uploaded-images {
    margin-top: 2rem;
  }

  .uploaded-images h4 {
    color: #333;
    margin-bottom: 1rem;
    font-size: 1.1rem;
  }

  .images-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }

  .image-item {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    background: #fff;
  }

  .image-item img {
    width: 100%;
    height: 150px;
    object-fit: cover;
    display: block;
  }

  .image-actions {
    display: flex;
    gap: 0.25rem;
    padding: 0.5rem;
    background: #f5f5f5;
  }

  .action-btn {
    flex: 1;
    padding: 0.5rem 0.25rem;
    border: none;
    background: #fff;
    border-radius: 4px;
    font-size: 0.75rem;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .action-btn:hover {
    background: #1e88e5;
    color: #fff;
    transform: translateY(-1px);
  }

  .delete-btn:hover {
    background: #c62828;
  }

  /* Markdown 输出 */
  .markdown-output {
    margin-top: 2rem;
  }

  .markdown-output h4 {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #333;
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
  }

  .copy-all-btn {
    background: #1e88e5;
    color: #fff;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .copy-all-btn:hover {
    background: #0d47a1;
  }

  #markdown-textarea {
    width: 100%;
    min-height: 150px;
    padding: 1rem;
    border: 2px solid #e0e0e0;
    border-radius: 8px;
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
    font-size: 0.9rem;
    resize: vertical;
    background: #fafafa;
  }

  #markdown-textarea:focus {
    outline: none;
    border-color: #1e88e5;
    background: #fff;
  }

  .naming-rules {
    background: #fff3e0;
    color: #e65100;
    padding: 1rem;
    border-radius: 8px;
    margin-bottom: 2rem;
    text-align: left;
    font-size: 0.9rem;
    border: 1px solid #ffe0b2;
  }

  .naming-rules p {
    margin: 0.4rem 0;
  }

  /* 响应式 */
  @media (max-width: 768px) {
    .image-uploader {
      padding: 1rem;
    }

    .uploader-container {
      padding: 1rem;
    }

    .drop-zone {
      padding: 2rem 1rem;
    }

    .images-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .action-btn {
      font-size: 0.7rem;
      padding: 0.4rem 0.2rem;
    }
  }
</style>

<script define:vars={{ trans }}>
  // @ts-nocheck
  document.addEventListener('DOMContentLoaded', () => {
    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('file-input');
    const selectBtn = document.getElementById('select-btn');
    const overlay = document.getElementById('upload-overlay');
    const progressBar = document.getElementById('progress-bar');
    const progressText = document.getElementById('progress-text');

    // 点击选择文件
    selectBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      fileInput?.click();
    });

    dropZone?.addEventListener('click', () => {
      fileInput?.click();
    });

      // 允许的文件类型
    const ALLOWED_TYPES = [
      'image/jpeg',
      'image/png',
      'image/gif',
      'image/webp'
    ];

    function validateFiles(files) {
      const validFiles = [];
      const invalidTypeFiles = [];

      files.forEach(file => {
        // 1. Check type
        if (!ALLOWED_TYPES.includes(file.type)) {
          invalidTypeFiles.push(file.name);
          return;
        }
        validFiles.push(file);
      });

      let errorMsg = '';
      if (invalidTypeFiles.length > 0) {
        errorMsg += `${trans.valUnsupported}${invalidTypeFiles.join('\n')}\n\n`;
      }

      if (errorMsg) {
        alert(errorMsg);
      }

      if (errorMsg) {
        alert(errorMsg);
      }

      return validFiles;
    }

    // 文件选择
    fileInput?.addEventListener('change', (e) => {
      const files = Array.from(e.target.files || []);
      const validFiles = validateFiles(files);
      if (validFiles.length > 0) {
        uploadFiles(validFiles);
      } else {
        // 清空选择，防止再次选择同个无效文件不触发 change
        fileInput.value = '';
      }
    });

    // 拖拽上传
    dropZone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('dragging');
    });

    dropZone?.addEventListener('dragleave', (e) => {
      e.preventDefault();
      dropZone.classList.remove('dragging');
    });

    dropZone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('dragging');

      const files = Array.from(e.dataTransfer?.files || []);
      const validFiles = validateFiles(files);

      if (validFiles.length > 0) {
        uploadFiles(validFiles);
      }
    });

    // 粘贴上传
    document.addEventListener('paste', (e) => {
      const items = e.clipboardData?.items;
      if (!items) return;

      const files = [];

      for (const item of items) {
        if (item.type.startsWith('image/')) {
          const file = item.getAsFile();
          if (file) files.push(file);
        }
      }

      const validFiles = validateFiles(files);

      if (validFiles.length > 0) {
        uploadFiles(validFiles);
      }
    });

    // 更新进度条
    function updateProgress(percent) {
      if (progressBar) progressBar.style.width = `${percent}%`;
      if (progressText) progressText.textContent = `${percent}%`;
    }

    // 上传文件
    async function uploadFiles(files) {
      if (files.length === 0) return;

      // 显示遮罩层
      if (overlay) overlay.style.display = 'flex';
      
      // 这里的逻辑是串行上传，为了演示进度条，只针对当前单个或总进度
      // 简单起见，我们对所有文件统一处理，或者只上传第一个
      // 假设一次上传一个或多个，我们用一个总进度假象
      
      let progress = 0;
      const progressInterval = setInterval(() => {
        // 假进度：快速到 30%，然后慢速到 90%
        if (progress < 30) {
          progress += 5;
        } else if (progress < 80) {
          progress += 1;
        } else if (progress < 95) {
          progress += 0.5;
        }
        updateProgress(Math.min(95, Math.round(progress)));
      }, 100);

      try {
        for (const file of files) {
          await uploadFile(file);
        }
        
        // 上传完成
        clearInterval(progressInterval);
        updateProgress(100);
        
        setTimeout(() => {
          // 刷新页面
          window.location.reload();
        }, 500);

      } catch (error) {
        clearInterval(progressInterval);
        if (overlay) overlay.style.display = 'none';
        updateProgress(0);
        alert(error.message || '上传失败');
      }
    }

    async function uploadFile(file) {
      console.log('开始处理文件 (Base64):', file.name);

      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        
        reader.onload = async (e) => {
          try {
            const base64Data = e.target.result;
            const ext = file.name.split('.').pop() || '';
            const safeName = `upload_${Date.now()}_${Math.random().toString(36).substr(2, 9)}.${ext}`;
            
            console.log('准备发送上传请求:', safeName);

            const payload = {
              file: base64Data, // Data URL
              name: safeName,
              originalName: file.name,
              type: file.type
            };

            const response = await fetch('/api/upload', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify(payload)
            });

            if (!response.ok) {
              let errorMessage = `HTTP ${response.status}: ${response.statusText}`;
              try {
                 const errorData = await response.json();
                 if (errorData.error) {
                   errorMessage += `\nDetails: ${errorData.error}`;
                   if (errorData.details) errorMessage += `\n${errorData.details}`;
                   if (errorData.debug) errorMessage += `\nDebug: ${JSON.stringify(errorData.debug, null, 2)}`;
                 }
              } catch (e) {
                // Ignore JSON parse error
              }
              throw new Error(errorMessage);
            }

            const result = await response.json();
            console.log('Upload success result:', result);
            
            // Use timeout to allow progress bar to finish visual update
            setTimeout(() => {
              alert(trans.successAudit);
              console.log('Reloading page after successful upload');
              window.location.reload();
            }, 500);
            
            resolve(result);
          } catch (error) {
            console.error('Upload error in component:', error);
            reject(error);
          }
        };

        reader.onerror = (error) => {
          console.error('File reading error:', error);
          reject(new Error('Failed to read file'));
        };

        reader.readAsDataURL(file);
      });
    }
  });
</script>
