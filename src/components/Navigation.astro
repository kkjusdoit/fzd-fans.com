---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';
import { languages } from '../i18n/ui';
import LanguagePicker from './LanguagePicker.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: t('nav.home') },
  { href: '/arena', label: t('nav.arena') },
  { href: '/quotes', label: t('nav.quotes') },
  // { href: '/friends', label: t('nav.friends') }, // 暂时隐藏
  { href: '/tributes', label: t('nav.tributes') },
  { href: '/links', label: t('nav.links') },
  { href: '/stars', label: t('nav.stars') },
  { href: '/warrior', label: t('nav.warrior') },
  { href: '/breakit', label: t('nav.breakit') },
  { href: '/infographic', label: t('nav.infographic') },
  // { href: '/quiz', label: t('nav.quiz') }, // 暂时隐藏
  { href: '/about', label: t('nav.about') },
];

function isActive(href: string) {
  if (href === '/') {
    return currentPath === '/' || currentPath === '/zh' || currentPath === '/zh/';
  }
  return currentPath.startsWith(href);
}
---

<header class="header">
  <div class="container header-inner">
    <a href={getLocalizedPath('/', lang)} class="logo">
      <span class="logo-icon">🏓</span>
      <span class="logo-text">{t('site.title')}</span>
    </a>
    <nav class="nav">
      {navItems.map(item => (
        <a 
          href={getLocalizedPath(item.href, lang)} 
          class:list={['nav-link', { active: isActive(item.href) }]}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <LanguagePicker />
  </div>
</header>

<style>
  .header {
    background: #fff;
    border-bottom: 1px solid #eee;
    padding: 1rem 0;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .header-inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: bold;
    font-size: 1.2rem;
    color: #c41e3a;
  }
  .logo:hover { text-decoration: none; }
  .logo-icon { font-size: 1.5rem; }
  .nav {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .nav-link {
    color: #555;
    font-size: 0.9rem;
    transition: color 0.2s;
  }
  .nav-link:hover { color: #c41e3a; }
  .nav-link.active {
    color: #c41e3a;
    font-weight: 600;
  }
</style>
