---
import { languages } from '../i18n/ui';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
// 移除语言前缀获取纯路径
const pathname = Astro.url.pathname.replace(/^\/(en)/, '') || '/';

// 只显示另一种语言：中文时显示 English，英文时显示中文
const targetLang = lang === 'zh' ? 'en' : 'zh';
const targetLabel = languages[targetLang];

function getLanguageHref(code: string) {
  // 中文是默认语言，不需要前缀
  if (code === 'zh') {
    return pathname;
  }
  return `/${code}${pathname}`;
}
---

<div class="lang-picker">
  <a href={getLanguageHref(targetLang)} class="lang-link">
    {targetLabel}
  </a>
</div>

<style>
  .lang-picker {
    display: flex;
    gap: 0.5rem;
  }
  .lang-link {
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.85rem;
    color: #666;
    border: 1px solid #ddd;
    transition: all 0.2s;
  }
  .lang-link:hover { 
    text-decoration: none;
    color: #c41e3a;
    border-color: #c41e3a;
  }
</style>
