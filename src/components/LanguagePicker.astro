---
import { languages } from '../i18n/ui';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
// 移除语言前缀获取纯路径
const pathname = Astro.url.pathname.replace(/^\/(en)/, '') || '/';

// 暂时隐藏英文入口
const visibleLanguages = Object.entries(languages).filter(([code]) => code === 'zh');

function getLanguageHref(code: string) {
  // 中文是默认语言，不需要前缀
  if (code === 'zh') {
    return pathname;
  }
  return `/${code}${pathname}`;
}
---

<div class="lang-picker">
  {visibleLanguages.map(([code, label]) => (
    <a 
      href={getLanguageHref(code)} 
      class:list={['lang-link', { active: code === lang }]}
    >
      {label}
    </a>
  ))}
</div>

<style>
  .lang-picker {
    display: flex;
    gap: 0.5rem;
  }
  .lang-link {
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.85rem;
    color: #666;
  }
  .lang-link.active {
    background: #c41e3a;
    color: #fff;
  }
  .lang-link:hover { text-decoration: none; }
</style>
